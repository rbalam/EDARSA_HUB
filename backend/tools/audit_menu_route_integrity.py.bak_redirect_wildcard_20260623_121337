from pathlib import Path
import re
import json
from datetime import datetime

from core.config.edarsahub_sql import get_edarsahub_connection

APP = Path("/app/frontend/src/App.js")
OUT_DIR = Path("/app/docs/reports")
OUT_DIR.mkdir(parents=True, exist_ok=True)


def norm(route):
    if not route:
        return ""
    route = "/" + str(route).strip().strip("/")
    return "" if route == "/" else route.rstrip("/")


def frontend_routes():
    text = APP.read_text(encoding="utf-8")
    rows = []

    for m in re.finditer(r'<Route\s+path="([^"]+)"\s+element=\{<([^ />]+)', text):
        ruta = norm(m.group(1))
        componente = m.group(2)

        if ruta in {"", "/*"}:
            continue
        if ":" in ruta or "*" in ruta:
            continue
        if componente in {
            "Navigate",
            "ProtectedRoute",
            "CatchAllRedirect",
            "Login",
            "ForgotPassword",
            "ResetPassword",
        }:
            continue

        rows.append({"ruta": ruta, "componente": componente})

    return rows


