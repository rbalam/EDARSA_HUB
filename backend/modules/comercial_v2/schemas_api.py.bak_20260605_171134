from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
SCHEMAS API - COMERCIAL V2
===========================

Modelos Pydantic para los endpoints v2.
Contrato de respuesta compatible con v1 + campos de trazabilidad v2.
"""

from datetime import date, datetime
from decimal import Decimal
from typing import Optional, List, Dict, Any
from pydantic import BaseModel, Field


# =============================================================================
# MODELOS BASE
# =============================================================================

class UnidadKPIResponse(BaseModel):
    """KPIs de una unidad de negocio."""
    unidad_negocio_id: str
    unidad_negocio_nombre: str
    sistema_origen: Optional[str] = None
    
    # Métricas
    ventas_total: float
    ventas_sin_propina: Optional[float] = None
    propinas_total: Optional[float] = None
    tickets_total: int
    pax_total: int
    ticket_promedio: Optional[float] = None
    pax_promedio: Optional[float] = None
    
    # Período
    dias: Optional[int] = None
    fecha_min: Optional[str] = None
    fecha_max: Optional[str] = None
    
    # Trazabilidad v2
    _v2_fuente: str = "EDARSAHUB"
    _v2_tabla: str = "vw_Comercial_KPIs_Diarios_v2_Runtime"


class TotalesResponse(BaseModel):
    """Totales agregados."""
    ventas_total: float
    tickets_total: int
    pax_total: int
    total_registros: Optional[int] = None
    total_unidades: Optional[int] = None
    total_dias: Optional[int] = None


class MetadataV2(BaseModel):
    """Metadata de respuesta v2."""
    version: str = "v2"
    fuente: str = "EDARSAHUB_V2"
    tabla_principal: str = "vw_Comercial_KPIs_Diarios_v2_Runtime"
    feature_flag: str = "COMERCIAL_V2_ENABLED"
    sql_vivo: bool = False
    mongodb_cache: bool = False
    timestamp: str = Field(default_factory=lambda: datetime.utcnow().isoformat())


# =============================================================================
# RESPUESTAS DE ENDPOINTS
# =============================================================================

class HealthResponse(BaseModel):
    """Respuesta del endpoint /health."""
    status: str
    source: str = "EDARSAHUB_V2"
    table: Optional[str] = None
    total_registros: Optional[int] = None
    total_unidades: Optional[int] = None
    rango_datos: Optional[Dict[str, str]] = None
    message: Optional[str] = None


class DashboardResponse(BaseModel):
    """Respuesta del endpoint /dashboard."""
    success: bool = True
    data: Dict[str, Any]
    metadata: MetadataV2 = Field(default_factory=MetadataV2)


class KPIsDiariosResponse(BaseModel):
    """Respuesta del endpoint /kpis-diarios."""
    success: bool = True
    data: List[Dict[str, Any]]
    total: int
    periodo: Dict[str, str]
    metadata: MetadataV2 = Field(default_factory=MetadataV2)


class KPIsMensualesResponse(BaseModel):
    """Respuesta del endpoint /kpis-mensuales."""
    success: bool = True
    data: List[Dict[str, Any]]
    total: int
    anio: int
    metadata: MetadataV2 = Field(default_factory=MetadataV2)


class VentasDiaResponse(BaseModel):
    """Respuesta del endpoint /ventas-dia."""
    success: bool = True
    data: Dict[str, Any]  # Contiene resumen + por_unidad
    fecha: str
    metadata: MetadataV2 = Field(default_factory=MetadataV2)


class UnidadesResponse(BaseModel):
    """Respuesta del endpoint /unidades."""
    success: bool = True
    unidades: List[Dict[str, Any]]
    total: int
    metadata: MetadataV2 = Field(default_factory=MetadataV2)


class SyncStatusResponse(BaseModel):
    """Respuesta del endpoint /sync-status."""
    success: bool = True
    logs: List[Dict[str, Any]]
    ultima_sync_por_unidad: List[Dict[str, Any]]
    metadata: MetadataV2 = Field(default_factory=MetadataV2)


# =============================================================================
# PARÁMETROS DE QUERY
# =============================================================================

class DashboardParams(BaseModel):
    """Parámetros para el dashboard."""
    fecha_inicio: date
    fecha_fin: date
    unidad_negocio_id: Optional[str] = None


class KPIsDiariosParams(BaseModel):
    """Parámetros para KPIs diarios."""
    fecha_inicio: date
    fecha_fin: date
    unidad_negocio_id: Optional[str] = None


class KPIsMensualesParams(BaseModel):
    """Parámetros para KPIs mensuales."""
    anio: int
    mes_inicio: int = 1
    mes_fin: int = 12
    unidad_negocio_id: Optional[str] = None
