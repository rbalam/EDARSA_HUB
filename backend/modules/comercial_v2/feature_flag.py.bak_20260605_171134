from core.corporate_filters.service import CorporateFilterService
"""
FEATURE FLAG - COMERCIAL V2
============================

Control de activación gradual de Comercial v2.

Reglas:
- Default OFF (COMERCIAL_V2_ENABLED=false)
- No reemplaza automáticamente el tablero actual
- Permite probar endpoints v2 sin afectar usuarios
- Rollback inmediato: cambiar a false
"""

import os
from typing import Optional
import logging

logger = logging.getLogger(__name__)


def is_comercial_v2_enabled(user_id: str = None, role: str = None) -> bool:
    """
    Verifica si Comercial v2 está habilitado para el contexto.
    
    Args:
        user_id: ID del usuario (opcional, para pruebas por usuario)
        role: Rol del usuario (opcional, para pruebas por rol)
        
    Returns:
        True si v2 está habilitado para el contexto
    """
    # 1. Verificar flag global
    global_enabled = os.environ.get("COMERCIAL_V2_ENABLED", "false").lower() == "true"
    
    if not global_enabled:
        return False
    
    # 2. Si está habilitado globalmente, verificar restricciones
    allowed_users = [u.strip() for u in os.environ.get("COMERCIAL_V2_USERS", "").split(",") if u.strip()]
    allowed_roles = [r.strip() for r in os.environ.get("COMERCIAL_V2_ROLES", "").split(",") if r.strip()]
    
    # Si no hay restricciones, está habilitado para todos
    if not allowed_users and not allowed_roles:
        return True
    
    # Verificar usuario específico
    if user_id and user_id in allowed_users:
        return True
    
    # Verificar rol
    if role and role in allowed_roles:
        return True
    
    # Si hay restricciones pero no coincide, denegar
    return False


def get_v2_status() -> dict:
    """
    Obtiene el estado actual del feature flag.
    
    Returns:
        Diccionario con información del estado
    """
    global_enabled = os.environ.get("COMERCIAL_V2_ENABLED", "false").lower() == "true"
    allowed_users = [u.strip() for u in os.environ.get("COMERCIAL_V2_USERS", "").split(",") if u.strip()]
    allowed_roles = [r.strip() for r in os.environ.get("COMERCIAL_V2_ROLES", "").split(",") if r.strip()]
    
    return {
        "global_enabled": global_enabled,
        "restricted_to_users": allowed_users if allowed_users else None,
        "restricted_to_roles": allowed_roles if allowed_roles else None,
        "mode": "unrestricted" if (global_enabled and not allowed_users and not allowed_roles) 
                else "restricted" if global_enabled 
                else "disabled"
    }
