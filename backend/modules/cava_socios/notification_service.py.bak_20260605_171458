from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
EDARSA HUB - Servicio de Notificaciones para Cava de Socios
============================================================
Envío de reportes PDF por Email (SMTP) y WhatsApp (Twilio).

Funcionalidades:
- Enviar reportes por correo electrónico
- Enviar reportes por WhatsApp vía Twilio
- Logs de envío para auditoría
"""

import os
import logging
import smtplib
import ssl
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText
from email.mime.application import MIMEApplication
from typing import Dict, Any, Optional, List
from datetime import datetime

logger = logging.getLogger(__name__)


class NotificationService:
    """Servicio para envío de notificaciones por Email y WhatsApp."""
    
    def __init__(self):
        # Configuración Email SMTP
        self.email_host = os.environ.get('EMAIL_HOST', 'mail.edarsa.com.mx')
        self.email_port = int(os.environ.get('EMAIL_PORT', '587'))
        self.email_user = os.environ.get('EMAIL_USER', '')
        self.email_password = os.environ.get('EMAIL_PASSWORD', '')
        self.email_from = os.environ.get('EMAIL_FROM', self.email_user)
        self.email_from_name = os.environ.get('EMAIL_FROM_NAME', 'EDARSA HUB')
        self.email_use_tls = os.environ.get('EMAIL_USE_TLS', 'true').lower() == 'true'
        self.email_enabled = os.environ.get('EMAIL_ENABLED', 'true').lower() == 'true'
        
        # Configuración Twilio WhatsApp
        self.twilio_sid = os.environ.get('TWILIO_ACCOUNT_SID', '')
        self.twilio_token = os.environ.get('TWILIO_AUTH_TOKEN', '')
        self.twilio_whatsapp_from = os.environ.get('TWILIO_WHATSAPP_FROM', '')
        self.whatsapp_enabled = os.environ.get('WHATSAPP_ENABLED', 'true').lower() == 'true'
        
        # Cliente Twilio (lazy load)
        self._twilio_client = None
    
    @property
    def twilio_client(self):
        """Lazy load del cliente Twilio."""
        if self._twilio_client is None and self.twilio_sid and self.twilio_token:
            try:
                from twilio.rest import Client
                self._twilio_client = Client(self.twilio_sid, self.twilio_token)
            except ImportError:
                logger.warning("[Notificaciones] Twilio SDK no instalado. pip install twilio")
            except Exception as e:
                logger.error(f"[Notificaciones] Error inicializando Twilio: {e}")
        return self._twilio_client
    
    # ==================== EMAIL ====================
    
    def enviar_email(
        self,
        destinatario: str,
        asunto: str,
        cuerpo_html: str,
        adjuntos: List[Dict[str, Any]] = None
    ) -> Dict[str, Any]:
        """
        Envía un correo electrónico con adjuntos opcionales.
        
        Args:
            destinatario: Email del destinatario
            asunto: Asunto del correo
            cuerpo_html: Contenido HTML del correo
            adjuntos: Lista de {'nombre': str, 'contenido': bytes, 'tipo': str}
        
        Returns:
            Dict con status y mensaje
        """
        if not self.email_enabled:
            return {"success": False, "error": "Email deshabilitado en configuración"}
        
        if not self.email_user or not self.email_password:
            return {"success": False, "error": "Credenciales de email no configuradas"}
        
        try:
            # Crear mensaje
            msg = MIMEMultipart('mixed')
            msg['From'] = f"{self.email_from_name} <{self.email_from}>"
            msg['To'] = destinatario
            msg['Subject'] = asunto
            
            # Cuerpo HTML
            body_part = MIMEMultipart('alternative')
            html_part = MIMEText(cuerpo_html, 'html', 'utf-8')
            body_part.attach(html_part)
            msg.attach(body_part)
            
            # Adjuntos
            if adjuntos:
                for adj in adjuntos:
                    attachment = MIMEApplication(adj['contenido'], _subtype='pdf')
                    attachment.add_header(
                        'Content-Disposition', 
                        'attachment', 
                        filename=adj['nombre']
                    )
                    msg.attach(attachment)
            
            # Conectar y enviar
            if self.email_use_tls:
                context = ssl.create_default_context()
                with smtplib.SMTP(self.email_host, self.email_port) as server:
                    server.starttls(context=context)
                    server.login(self.email_user, self.email_password)
                    server.sendmail(self.email_from, destinatario, msg.as_string())
            else:
                with smtplib.SMTP(self.email_host, self.email_port) as server:
                    server.login(self.email_user, self.email_password)
                    server.sendmail(self.email_from, destinatario, msg.as_string())
            
            logger.info(f"[Notificaciones] Email enviado a {destinatario}: {asunto}")
            return {"success": True, "mensaje": f"Email enviado a {destinatario}"}
            
        except smtplib.SMTPAuthenticationError as e:
            logger.error(f"[Notificaciones] Error de autenticación SMTP: {e}")
            return {"success": False, "error": "Error de autenticación con servidor de correo"}
        except smtplib.SMTPException as e:
            logger.error(f"[Notificaciones] Error SMTP: {e}")
            return {"success": False, "error": f"Error de servidor SMTP: {str(e)}"}
        except Exception as e:
            logger.error(f"[Notificaciones] Error enviando email: {e}")
            return {"success": False, "error": str(e)}
    
    def enviar_reporte_email(
        self,
        socio: Dict[str, Any],
        tipo_reporte: str,
        pdf_bytes: bytes,
        email_destino: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Envía un reporte PDF por email al socio.
        
        Args:
            socio: Datos del socio
            tipo_reporte: 'ficha', 'consumos', 'estado_cuenta'
            pdf_bytes: Contenido del PDF
            email_destino: Email alternativo (opcional)
        
        Returns:
            Dict con status y mensaje
        """
        email = email_destino or socio.get('email')
        if not email:
            return {"success": False, "error": "El socio no tiene email registrado"}
        
        # Mapeo de tipos de reporte
        tipos = {
            'ficha': {
                'nombre': 'Ficha de Socio',
                'archivo': f"ficha_socio_{socio.get('numero_socio', 'NA')}.pdf"
            },
            'consumos': {
                'nombre': 'Historial de Consumos',
                'archivo': f"consumos_{socio.get('numero_socio', 'NA')}.pdf"
            },
            'estado_cuenta': {
                'nombre': 'Estado de Cuenta',
                'archivo': f"estado_cuenta_{socio.get('numero_socio', 'NA')}.pdf"
            }
        }
        
        info = tipos.get(tipo_reporte, {'nombre': 'Reporte', 'archivo': 'reporte.pdf'})
        
        asunto = f"EDARSA - {info['nombre']} | {socio.get('nombre_completo', 'Socio')}"
        
        cuerpo_html = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="utf-8">
            <style>
                body {{ font-family: Arial, sans-serif; line-height: 1.6; color: #333; }}
                .header {{ background: linear-gradient(135deg, #6b21a8, #9333ea); color: white; padding: 20px; text-align: center; }}
                .content {{ padding: 20px; }}
                .footer {{ background: #f3f4f6; padding: 15px; text-align: center; font-size: 12px; color: #666; }}
                .highlight {{ color: #6b21a8; font-weight: bold; }}
            </style>
        </head>
        <body>
            <div class="header">
                <h1>EDARSA HUB</h1>
                <h2>Cava de Socios</h2>
            </div>
            <div class="content">
                <p>Estimado/a <span class="highlight">{socio.get('nombre_completo', 'Socio')}</span>,</p>
                
                <p>Adjunto encontrará su <strong>{info['nombre']}</strong> actualizado al día de hoy.</p>
                
                <p>
                    <strong>Número de Socio:</strong> {socio.get('numero_socio', 'N/A')}<br>
                    <strong>Tipo de Membresía:</strong> {socio.get('tipo_membresia', 'N/A')}<br>
                    <strong>Fecha de Generación:</strong> {datetime.now().strftime('%d/%m/%Y %H:%M')}
                </p>
                
                <p>Si tiene alguna duda o requiere información adicional, no dude en contactarnos.</p>
                
                <p>Saludos cordiales,<br>
                <strong>Equipo EDARSA</strong></p>
            </div>
            <div class="footer">
                <p>Este es un mensaje automático generado por EDARSA HUB.<br>
                Por favor no responda a este correo.</p>
            </div>
        </body>
        </html>
        """
        
        adjuntos = [{
            'nombre': info['archivo'],
            'contenido': pdf_bytes,
            'tipo': 'application/pdf'
        }]
        
        return self.enviar_email(email, asunto, cuerpo_html, adjuntos)
    
    # ==================== WHATSAPP ====================
    
    def enviar_whatsapp(
        self,
        telefono: str,
        mensaje: str,
        media_url: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Envía un mensaje de WhatsApp vía Twilio.
        
        Args:
            telefono: Número del destinatario (con código país, ej: +521234567890)
            mensaje: Texto del mensaje
            media_url: URL pública del archivo adjunto (opcional)
        
        Returns:
            Dict con status y mensaje
        """
        if not self.whatsapp_enabled:
            return {"success": False, "error": "WhatsApp deshabilitado en configuración"}
        
        if not self.twilio_client:
            return {"success": False, "error": "Cliente Twilio no configurado"}
        
        if not self.twilio_whatsapp_from:
            return {"success": False, "error": "Número WhatsApp origen no configurado"}
        
        try:
            # Formatear número (asegurar formato whatsapp:+XXXX)
            telefono_limpio = telefono.replace(' ', '').replace('-', '')
            if not telefono_limpio.startswith('+'):
                # Asumir México si no tiene código país
                telefono_limpio = f"+52{telefono_limpio.lstrip('0')}"
            
            to_whatsapp = f"whatsapp:{telefono_limpio}"
            from_whatsapp = f"whatsapp:{self.twilio_whatsapp_from}"
            
            # Parámetros del mensaje
            params = {
                'from_': from_whatsapp,
                'to': to_whatsapp,
                'body': mensaje
            }
            
            if media_url:
                params['media_url'] = [media_url]
            
            # Enviar mensaje
            message = self.twilio_client.messages.create(**params)
            
            logger.info(f"[Notificaciones] WhatsApp enviado a {telefono}: SID={message.sid}")
            return {
                "success": True, 
                "mensaje": f"WhatsApp enviado a {telefono}",
                "sid": message.sid,
                "status": message.status
            }
            
        except Exception as e:
            logger.error(f"[Notificaciones] Error enviando WhatsApp: {e}")
            return {"success": False, "error": str(e)}
    
    def enviar_reporte_whatsapp(
        self,
        socio: Dict[str, Any],
        tipo_reporte: str,
        pdf_url: Optional[str] = None,
        telefono_destino: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Envía notificación de reporte por WhatsApp.
        
        Nota: WhatsApp no soporta adjuntos PDF directos. Se envía:
        - Mensaje con resumen
        - Link para descargar el PDF (si se proporciona URL)
        
        Args:
            socio: Datos del socio
            tipo_reporte: 'ficha', 'consumos', 'estado_cuenta'
            pdf_url: URL pública para descargar el PDF (opcional)
            telefono_destino: Teléfono alternativo (opcional)
        
        Returns:
            Dict con status y mensaje
        """
        telefono = telefono_destino or socio.get('telefono')
        if not telefono:
            return {"success": False, "error": "El socio no tiene teléfono registrado"}
        
        # Mapeo de tipos
        tipos = {
            'ficha': 'Ficha de Socio',
            'consumos': 'Historial de Consumos',
            'estado_cuenta': 'Estado de Cuenta'
        }
        nombre_reporte = tipos.get(tipo_reporte, 'Reporte')
        
        # Construir mensaje
        mensaje = f"""*EDARSA HUB - Cava de Socios*

Hola {socio.get('nombre_completo', 'Socio')},

Tu *{nombre_reporte}* ha sido generado.

*Socio:* #{socio.get('numero_socio', 'N/A')}
*Fecha:* {datetime.now().strftime('%d/%m/%Y %H:%M')}"""
        
        if pdf_url:
            mensaje += f"\n\n*Descarga tu reporte:*\n{pdf_url}"
        else:
            mensaje += "\n\nPuedes descargarlo desde el portal web o solicitar que te lo enviemos por correo."
        
        mensaje += "\n\n_Mensaje automático de EDARSA HUB_"
        
        return self.enviar_whatsapp(telefono, mensaje)
    
    # ==================== NOTIFICACIÓN COMBINADA ====================
    
    def enviar_reporte_multicanal(
        self,
        socio: Dict[str, Any],
        tipo_reporte: str,
        pdf_bytes: bytes,
        pdf_url: Optional[str] = None,
        canales: List[str] = None
    ) -> Dict[str, Any]:
        """
        Envía reporte por múltiples canales (Email y/o WhatsApp).
        
        Args:
            socio: Datos del socio
            tipo_reporte: 'ficha', 'consumos', 'estado_cuenta'
            pdf_bytes: Contenido del PDF
            pdf_url: URL pública del PDF (para WhatsApp)
            canales: Lista de canales ['email', 'whatsapp']
        
        Returns:
            Dict con resultados por canal
        """
        if canales is None:
            canales = ['email']
        
        resultados = {
            "socio_id": socio.get('socio_id'),
            "numero_socio": socio.get('numero_socio'),
            "tipo_reporte": tipo_reporte,
            "canales": {}
        }
        
        if 'email' in canales:
            resultado_email = self.enviar_reporte_email(socio, tipo_reporte, pdf_bytes)
            resultados["canales"]["email"] = resultado_email
        
        if 'whatsapp' in canales:
            resultado_wa = self.enviar_reporte_whatsapp(socio, tipo_reporte, pdf_url)
            resultados["canales"]["whatsapp"] = resultado_wa
        
        # Resumen general
        exitos = sum(1 for c in resultados["canales"].values() if c.get("success"))
        resultados["exitos"] = exitos
        resultados["total_canales"] = len(canales)
        resultados["success"] = exitos > 0
        
        return resultados


# Singleton
_notification_service = None

def get_notification_service() -> NotificationService:
    """Factory para obtener el servicio de notificaciones."""
    global _notification_service
    if _notification_service is None:
        _notification_service = NotificationService()
    return _notification_service
