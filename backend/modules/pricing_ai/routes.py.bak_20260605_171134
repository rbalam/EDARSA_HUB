from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
from fastapi import APIRouter, Depends, Query
from core.security import get_current_user
from .service import pricing_resumen

router = APIRouter(prefix="/api/pricing-ai", tags=["Pricing IA"])

@router.get("/resumen")
async def get_pricing_resumen(
    server_id: str = Query(default=""),
    limite: int = Query(default=100, ge=1, le=500),
    current_user: dict = Depends(get_current_user)
):
    return pricing_resumen(server_id=server_id, limite=limite)
