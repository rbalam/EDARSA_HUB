from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
from typing import Dict, Any, List
from core.config.edarsahub_sql import get_edarsahub_connection


def pricing_resumen(server_id: str = "", limite: int = 100) -> Dict[str, Any]:
    cn = get_edarsahub_connection(timeout=30)
    cur = cn.cursor()

    where = ""
    params = []

    if server_id:
        where = "WHERE CAST(p.ServerID AS NVARCHAR(100)) = CAST(%s AS NVARCHAR(100))"
        params.append(server_id)

    cur.execute(f"""
    SELECT TOP ({int(limite)})
        p.ServerID,
        p.ProductoID,
        p.ProductoCodigo,
        p.ProductoNombre,
        p.PrecioFinal,
        p.FechaVigencia,
        s.nombre AS servidor_nombre
    FROM Sync_Precios_Historicos p
    LEFT JOIN Servidores_Conexiones s
        ON CAST(s.id AS NVARCHAR(100)) = CAST(p.ServerID AS NVARCHAR(100))
    {where}
    ORDER BY p.FechaVigencia DESC, p.ProductoNombre
    """, tuple(params))

    precios = list(cur.fetchall())  # as_dict=True ya devuelve dicts

    cur.execute("""
    SELECT
        COUNT(*) AS productos_precio,
        COUNT(DISTINCT ServerID) AS servidores,
        MIN(FechaVigencia) AS primera_fecha,
        MAX(FechaVigencia) AS ultima_fecha
    FROM Sync_Precios_Historicos
    """)
    resumen = cur.fetchone()  # as_dict=True ya devuelve dict

    cn.close()

    return {
        "success": True,
        "source": "EDARSAHUB_SQL",
        "modo": "BASE_SIN_IA_EXTERNA",
        "resumen": resumen,
        "precios": precios,
        "nota": "Base Pricing IA creada. No usa scraping, no usa APIs externas, no usa Mongo."
    }
