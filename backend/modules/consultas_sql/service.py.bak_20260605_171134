from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
EDARSA HUB - Consultas SQL: Service Layer
=========================================
FASE 3: Capa de servicio con lógica de negocio.

RESPONSABILIDADES:
- Aplicar reglas de negocio (Activo, SoloLectura, etc.)
- Coordinar validación y repository
- Preparar contextos de ejecución
- Preparar para RBAC futuro

NO HACE:
- Ejecutar consultas contra servidores LIVE
- Modificar datos del catálogo (read-only en esta fase)
"""

import logging
from typing import List, Optional, Dict, Any
from datetime import datetime, timezone

from .models import (
    ConsultaSQLCatalogo,
    ConsultaSQLParametro,
    ConsultaSQLVersion,
    ConsultaSQLServidor,
    ConsultaSQLFilter,
    ConsultaSQLValidationResult,
)
from .repository import ConsultasSQLRepository, get_repository
from .validator import SQLValidator, get_validator

logger = logging.getLogger(__name__)


class ConsultasSQLService:
    """
    Service layer para el catálogo de consultas SQL.
    Aplica lógica de negocio sobre el repository.
    """
    
    def __init__(self, repository: Optional[ConsultasSQLRepository] = None):
        """
        Inicializa el servicio.
        
        Args:
            repository: Instancia de ConsultasSQLRepository.
                       Si None, usa la instancia singleton.
        """
        self._repo = repository or get_repository()
        self._validator = get_validator()
    
    # ========================================================================
    # LISTADOS
    # ========================================================================
    
    def listar_consultas(
        self,
        sistema: Optional[str] = None,
        modulo: Optional[str] = None,
        solo_activas: bool = True,
        solo_manuales: bool = False,
        buscar: Optional[str] = None,
        limit: int = 100
    ) -> List[ConsultaSQLCatalogo]:
        """
        Lista consultas con filtros de negocio.
        
        Args:
            sistema: 'SOFTRESTAURANT', 'MPRO' o None para todos
            modulo: Nombre del módulo o None para todos
            solo_activas: Si True, solo consultas activas
            solo_manuales: Si True, solo las que permiten ejecución manual
            buscar: Texto de búsqueda
            limit: Máximo de resultados
            
        Returns:
            Lista de ConsultaSQLCatalogo
        """
        filters = ConsultaSQLFilter(
            codigo_sistema=sistema,
            modulo=modulo,
            activo=True if solo_activas else None,
            permite_ejecucion_manual=True if solo_manuales else None,
            buscar=buscar,
            limit=limit
        )
        
        return self._repo.list_consultas(filters)
    
    def listar_consultas_por_modulo(self) -> Dict[str, List[Dict]]:
        """
        Agrupa consultas por módulo.
        
        Returns:
            Dict con módulo como key y lista de consultas simplificadas
        """
        consultas = self._repo.list_consultas(ConsultaSQLFilter(activo=True, limit=500))
        
        por_modulo: Dict[str, List[Dict]] = {}
        
        for c in consultas:
            modulo = c.modulo or "General"
            if modulo not in por_modulo:
                por_modulo[modulo] = []
            
            por_modulo[modulo].append({
                'consulta_id': c.consulta_id,
                'codigo': c.codigo_consulta,
                'nombre': c.nombre_consulta,
                'descripcion': c.descripcion,
                'sistema': c.get_codigo_sistema(),
                'permite_manual': c.permite_ejecucion_manual,
            })
        
        return por_modulo
    
    # ========================================================================
    # OBTENER CONSULTA
    # ========================================================================
    
    def obtener_consulta(
        self,
        consulta_id: Optional[int] = None,
        codigo: Optional[str] = None,
        uuid: Optional[str] = None,
        include_sql: bool = False
    ) -> Optional[ConsultaSQLCatalogo]:
        """
        Obtiene una consulta por ID, código o UUID.
        
        Args:
            consulta_id: ID interno
            codigo: CodigoConsulta (ej: 'SR_VENTAS_DIA')
            uuid: PublicUUID
            include_sql: Si True, incluye el SQL en el resultado
            
        Returns:
            ConsultaSQLCatalogo o None
        """
        consulta = None
        
        if consulta_id is not None:
            consulta = self._repo.get_by_id(consulta_id)
        elif codigo:
            consulta = self._repo.get_by_codigo(codigo)
        elif uuid:
            consulta = self._repo.get_by_uuid(uuid)
        
        if consulta and not include_sql:
            # Por seguridad, no devolver SQL por defecto
            consulta.consulta_sql = "[OCULTO - use include_sql=True]"
        
        return consulta
    
    def obtener_consulta_con_parametros(
        self,
        consulta_id: Optional[int] = None,
        codigo: Optional[str] = None
    ) -> Optional[Dict[str, Any]]:
        """
        Obtiene una consulta con sus parámetros cargados.
        
        Args:
            consulta_id: ID interno
            codigo: CodigoConsulta
            
        Returns:
            Dict con consulta y parámetros o None
        """
        # Obtener consulta
        consulta = None
        if consulta_id is not None:
            consulta = self._repo.get_by_id(consulta_id)
        elif codigo:
            consulta = self._repo.get_by_codigo(codigo)
        
        if not consulta:
            return None
        
        # Obtener parámetros
        parametros = self._repo.get_parametros(consulta.consulta_id)
        consulta.parametros = parametros
        
        return {
            'consulta': consulta.to_dict(include_sql=False),
            'parametros': [p.to_dict() for p in parametros],
            'count_parametros': len(parametros),
            'sistema': consulta.get_codigo_sistema(),
        }
    
    # ========================================================================
    # VALIDACIÓN
    # ========================================================================
    
    def validar_consulta(
        self,
        consulta_id: Optional[int] = None,
        codigo: Optional[str] = None,
        sql_text: Optional[str] = None
    ) -> ConsultaSQLValidationResult:
        """
        Valida una consulta del catálogo o un texto SQL arbitrario.
        
        Args:
            consulta_id: ID de consulta existente
            codigo: Código de consulta existente
            sql_text: Texto SQL a validar directamente
            
        Returns:
            ConsultaSQLValidationResult
        """
        if sql_text:
            # Validar texto SQL directo
            return self._repo.validate_sql_text(sql_text)
        
        # Buscar consulta
        consulta = None
        if consulta_id is not None:
            consulta = self._repo.get_by_id(consulta_id)
        elif codigo:
            consulta = self._repo.get_by_codigo(codigo)
        
        if not consulta:
            result = ConsultaSQLValidationResult(is_valid=False)
            result.add_error(
                code="QUERY_NOT_FOUND",
                message="Consulta no encontrada",
                severity="CRITICAL"
            )
            return result
        
        return self._repo.validate_catalog_query(consulta.consulta_id)
    
    def validar_todas_las_consultas(self) -> Dict[str, Any]:
        """
        Valida todas las consultas del catálogo.
        
        Returns:
            Dict con resumen de validación
        """
        consultas = self._repo.list_consultas(ConsultaSQLFilter(limit=500))
        
        resultados = {
            'total': len(consultas),
            'validas': 0,
            'con_warnings': 0,
            'invalidas': 0,
            'detalle_invalidas': [],
            'detalle_warnings': [],
            'timestamp': datetime.now(timezone.utc).isoformat()
        }
        
        for c in consultas:
            validation = self._repo.validate_catalog_query(c.consulta_id)
            
            if validation.is_valid:
                resultados['validas'] += 1
                if validation.warnings:
                    resultados['con_warnings'] += 1
                    resultados['detalle_warnings'].append({
                        'consulta_id': c.consulta_id,
                        'codigo': c.codigo_consulta,
                        'warnings': validation.warnings
                    })
            else:
                resultados['invalidas'] += 1
                resultados['detalle_invalidas'].append({
                    'consulta_id': c.consulta_id,
                    'codigo': c.codigo_consulta,
                    'nombre': c.nombre_consulta,
                    'errors': validation.errors,
                    'severity': 'CRITICAL' if any(
                        e.get('severity') == 'CRITICAL' for e in validation.errors
                    ) else 'ERROR'
                })
        
        return resultados
    
    # ========================================================================
    # CONTEXTO DE EJECUCIÓN
    # ========================================================================
    
    def preparar_contexto_ejecucion(
        self,
        consulta_id: Optional[int] = None,
        codigo: Optional[str] = None,
        parametros: Optional[Dict[str, Any]] = None,
        usuario_contexto: Optional[Dict[str, Any]] = None
    ) -> Dict[str, Any]:
        """
        Prepara el contexto para ejecución futura de una consulta.
        
        NOTA: No ejecuta la consulta. Solo valida y prepara.
        
        Args:
            consulta_id: ID de la consulta
            codigo: Código de la consulta
            parametros: Valores de parámetros
            usuario_contexto: Info del usuario
            
        Returns:
            Dict con contexto preparado o error
        """
        # Resolver consulta_id si se proporciona código
        if codigo and not consulta_id:
            consulta = self._repo.get_by_codigo(codigo)
            if consulta:
                consulta_id = consulta.consulta_id
        
        if not consulta_id:
            return {
                'ready': False,
                'error': 'Debe proporcionar consulta_id o codigo',
                'error_code': 'MISSING_IDENTIFIER'
            }
        
        return self._repo.build_execution_context(
            consulta_id=consulta_id,
            parametros=parametros or {},
            usuario_contexto=usuario_contexto or {}
        )
    
    # ========================================================================
    # INFORMACIÓN DE CATÁLOGO
    # ========================================================================
    
    def obtener_estadisticas(self) -> Dict[str, Any]:
        """
        Obtiene estadísticas del catálogo.
        
        Returns:
            Dict con estadísticas
        """
        counts = self._repo.get_counts()
        modulos = self._repo.get_modulos()
        
        return {
            'conteos': counts,
            'modulos': modulos,
            'sistemas': ['SOFTRESTAURANT', 'MPRO'],
            'timestamp': datetime.now(timezone.utc).isoformat()
        }
    
    def verificar_integridad(self) -> Dict[str, Any]:
        """
        Verifica integridad del catálogo.
        
        Checks:
        - Consultas sin SQL
        - Consultas sin ConfigOrigen
        - Duplicados de CodigoConsulta
        - Parámetros huérfanos
        
        Returns:
            Dict con resultado de verificación
        """
        consultas = self._repo.list_consultas(ConsultaSQLFilter(limit=500))
        
        issues = []
        codigos_vistos = set()
        
        for c in consultas:
            # SQL vacío
            if not c.consulta_sql or not c.consulta_sql.strip():
                issues.append({
                    'tipo': 'SQL_VACIO',
                    'consulta_id': c.consulta_id,
                    'codigo': c.codigo_consulta,
                    'severity': 'CRITICAL'
                })
            
            # ConfigOrigen vacío
            if not c.config_origen:
                issues.append({
                    'tipo': 'CONFIG_ORIGEN_VACIO',
                    'consulta_id': c.consulta_id,
                    'codigo': c.codigo_consulta,
                    'severity': 'WARNING'
                })
            
            # Duplicados
            codigo_upper = c.codigo_consulta.upper()
            if codigo_upper in codigos_vistos:
                issues.append({
                    'tipo': 'CODIGO_DUPLICADO',
                    'consulta_id': c.consulta_id,
                    'codigo': c.codigo_consulta,
                    'severity': 'ERROR'
                })
            codigos_vistos.add(codigo_upper)
        
        return {
            'total_consultas': len(consultas),
            'issues': issues,
            'total_issues': len(issues),
            'has_critical': any(i['severity'] == 'CRITICAL' for i in issues),
            'has_errors': any(i['severity'] == 'ERROR' for i in issues),
            'timestamp': datetime.now(timezone.utc).isoformat()
        }


# Instancia singleton opcional
_service_instance: Optional[ConsultasSQLService] = None


def get_service() -> ConsultasSQLService:
    """Obtiene instancia singleton del servicio."""
    global _service_instance
    if _service_instance is None:
        _service_instance = ConsultasSQLService()
    return _service_instance


__all__ = [
    'ConsultasSQLService',
    'get_service',
]
