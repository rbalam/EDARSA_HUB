from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
from typing import Dict, Any, List
from fastapi import HTTPException
from core.pool import execute_hub_query

def evaluar_margen_pedido(pedido_id: int, umbral_minimo_margen: float = 15.0) -> Dict[str, Any]:
    """
    COSTOS-ALERTAS-001-E: Motor de evaluación de rentabilidad local.
    Calcula el costo real y el margen de ganancia de un pedido en base a la 
    data consolidada de inventarios físicos y ventas en EDARSAHUB SQL.
    """
    # 1. Obtener el detalle del pedido y sus precios de venta desde el módulo blindado
    query_pedido = """
        SELECT PedidoID, ProductoID, Cantidad, PrecioUnitario, (Cantidad * PrecioUnitario) as TotalLinea
        FROM dbo.Venta_PedidosDetalle
        WHERE PedidoID = %s
    """
    lineas_pedido = execute_hub_query(query_pedido, (pedido_id,))
    
    if not lineas_pedido:
        raise HTTPException(status_code=404, detail=f"No se encontraron líneas de detalle para el Pedido ID {pedido_id}")
    
    total_venta = 0.0
    total_costo_teorico = 0.0
    alertas_productos: List[Dict[str, Any]] = []

    # 2. Auditar cada producto contra el catálogo de costos consolidados de inventario
    for linea in lineas_pedido:
        producto_id = linea["ProductoID"]
        cantidad = float(linea["Cantidad"])
        precio_venta = float(linea["PrecioUnitario"])
        total_linea_venta = float(linea["TotalLinea"])
        
        total_venta += total_linea_venta

        # Consultar el costo unitario consolidado en el historial de inventarios físicos síncronos
        query_costo = """
            SELECT TOP 1 CostoUnitario 
            FROM dbo.Compras_Inventarios_Fisicos_Sync
            WHERE ProductoID = %s
            ORDER BY FechaRegistro DESC
        """
        res_costo = execute_hub_query(query_costo, (producto_id,))
        costo_unitario = float(res_costo[0]["CostoUnitario"]) if res_costo else 0.0
        
        total_linea_costo = cantidad * costo_unitario
        total_costo_teorico += total_linea_costo

        # Calcular el margen porcentual de la línea individual
        margen_linea = ((total_linea_venta - total_linea_costo) / total_linea_venta * 100) if total_linea_venta > 0 else 0.0

        if margen_linea < umbral_minimo_margen:
            alertas_productos.append({
                "ProductoID": producto_id,
                "MargenCalculado": round(margen_linea, 2),
                "CostoUnitario": costo_unitario,
                "PrecioVenta": precio_venta
            })

    # 3. Consolidar métricas finales del pedido
    utilidad_bruta = total_venta - total_costo_teorico
    margen_global = (utilidad_bruta / total_venta * 100) if total_venta > 0 else 0.0
    requiere_aprobacion = margen_global < umbral_minimo_margen or len(alertas_productos) > 0

    return {
        "PedidoID": pedido_id,
        "TotalVenta": round(total_venta, 2),
        "CostoTotalEstimado": round(total_costo_teorico, 2),
        "UtilidadBruta": round(utilidad_bruta, 2),
        "MargenGlobal": round(margen_global, 2),
        "RequiereAprobacionDireccion": requiere_aprobacion,
        "ProductosEnAlerta": alertas_productos
    }
