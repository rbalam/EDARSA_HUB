                    ano_ant_ultimo_dia = (datetime(hoy.year - 1, hoy.month + 1, 1) - timedelta(days=1)).day if hoy.month < 12 else 31
                    dia_ano_ant = min(dia_actual - 1, ano_ant_ultimo_dia)
