from typing import List, Dict, Optional, Any
from pydantic import BaseModel
from datetime import datetime


class VentaSucursal(BaseModel):
    """Modelo de ventas por sucursal."""
    nombre: str
    ventas: float = 0.0
    pax: int = 0
    cheques: int = 0
    ticket_promedio: float = 0.0
    consumo_promedio: float = 0.0
    status: str = "online"
    server_id: Optional[str] = None
    system_type: Optional[str] = None
    origen: Optional[str] = None  # "nube", "api_local"


class MetaSucursal(BaseModel):
    """Modelo de metas por sucursal."""
    sucursal: str
    meta_ventas: float = 0.0
    meta_pax: int = 0
    meta_cheques: int = 0
    avance_ventas: float = 0.0
    avance_pax: int = 0
    avance_cheques: int = 0
    porcentaje_cumplimiento: float = 0.0


class TicketPerfecto(BaseModel):
    """Modelo de ticket perfecto."""
    sucursal: str
    total_tickets: int = 0
    tickets_perfectos: int = 0
    porcentaje_perfecto: float = 0.0
    detalle: List[Dict] = []


class DashboardComercialResponse(BaseModel):
    """Respuesta del dashboard comercial."""
    sucursales: List[VentaSucursal] = []
    totales: Dict[str, Any] = {}
    periodo: Dict[str, Any] = {}


class TableroEjecutivoResponse(BaseModel):
    """Respuesta del tablero ejecutivo."""
    sucursales: List[VentaSucursal] = []
    totales: Dict[str, Any] = {}
    periodo: Dict[str, Any] = {}
    modo_ventas_dia: bool = False


class ReportePaxRequest(BaseModel):
    """Request para reporte de PAX."""
    server_id: str
    sucursal: Optional[str] = None
    fecha_inicio: str
    fecha_fin: str
    agrupar_por: str = "dia"  # "dia", "semana", "mes"


__all__ = [
    'VentaSucursal',
    'MetaSucursal',
    'TicketPerfecto',
    'DashboardComercialResponse',
    'TableroEjecutivoResponse',
    'ReportePaxRequest',
]
