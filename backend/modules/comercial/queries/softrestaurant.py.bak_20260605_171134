def _format_fecha_sr(fecha_iso: str) -> str:
    """
    Convierte fecha ISO (YYYY-MM-DD) a formato SoftRestaurant (YYYYMMDD).
    
    Args:
        fecha_iso: Fecha en formato YYYY-MM-DD
        
    Returns:
        Fecha en formato YYYYMMDD para comparación SQL
    """
    return fecha_iso.replace('-', '')


def _build_sucursal_filter_sr(sucursal_id: Optional[str], alias: str = "cheques") -> str:
    """
    Construye filtro SQL para sucursal en SoftRestaurant.
    
    BLINDAJE (Abril 2026): 
    - Ignora el filtro si la sucursal es 'default', vacía, o tiene un valor especial.
    - La columna idestacion puede no existir en algunas versiones de SoftRestaurant.
    - Para bases de datos con una sola sucursal (CIENFUEGOS, LA ESTELAR), no aplicar filtro.
    
    Args:
        sucursal_id: ID de sucursal o None para todas
        alias: Alias de la tabla (default: cheques)
        
    Returns:
        String SQL del filtro (vacío si no aplica o no es válido)
    """
    # Valores que indican "todas las sucursales" o que deben ignorarse
    ignore_values = ('all', 'todos', 'default', '', 'none', 'null')
    
    if not sucursal_id:
        return ""
    
    sucursal_clean = str(sucursal_id).strip().lower()
    
    # Ignorar valores especiales
    if sucursal_clean in ignore_values:
        return ""
    
    # BLINDAJE: Ignorar nombres de sucursal que son claramente texto (no IDs de estación)
    # Esto aplica para CIENFUEGOS, LA ESTELAR, ORIGEN, QUERETARO, MERIDA, ESTELAR, etc.
    # La columna idestacion en SoftRestaurant tiene IDs como '130GRADOSCAJA', no nombres
    nombres_ignorar = ('cienfuegos', 'la estelar', 'estelar', 'origen', 'queretaro', 'merida', '130 mid', '130mid')
    if sucursal_clean in nombres_ignorar:
        logging.debug(f"[BLINDAJE] Ignorando filtro de sucursal por nombre: {sucursal_id}")
        return ""
    
    # BLINDAJE: Ignorar IDs numéricos cortos para evitar filtros erróneos
    # en bases de datos que no tienen idestacion o usan IDs diferentes
    if sucursal_clean.isdigit() and len(sucursal_clean) <= 4:
        logging.debug(f"[BLINDAJE] Ignorando filtro de sucursal numérico corto: {sucursal_id}")
        return ""
    
    # Solo aplicar filtro si parece un ID de estación válido (ej: '130GRADOSCAJA')
    return f"AND {alias}.idestacion = '{sucursal_id}'"
