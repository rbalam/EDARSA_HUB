# =============================================================================

def query_ventas_periodo_sr(
    server: Dict,
    fecha_ini: str,  # YYYY-MM-DD
    fecha_fin: str,   # YYYY-MM-DD
    sucursal_id: Optional[str] = None
) -> VentasPeriodoResult:
    """
    Query base ÚNICA de ventas para SoftRestaurant.
    
    ORIGEN: Extraída de service.py líneas 341-363 (get_kpis_softrestaurant)
    FECHA EXTRACCIÓN: 2026-04-23
    
    MÉTRICAS RETORNADAS:
    - total_venta: SUM(cheques.total - cheques.propina) - Venta total en pesos (SIN propinas)
    - pax: SUM(cheques.nopersonas) - Total de comensales/personas
    - cheques: COUNT(DISTINCT cheques.folio) - Número de tickets/cuentas
    
    LÓGICA SQL:
    - JOIN con turnos para filtrar por fecha de apertura del turno
    - CONVERT(varchar, fecha, 112) para comparación segura de fechas
    - Filtro cheques.cancelado = 0 para excluir cancelados
    - ISNULL para manejar NULL como 0
    
    CONSUMIDORES PREVISTOS:
    - get_kpis_softrestaurant() en service.py (migración Bloque 4)
    - /comercial/dashboard/{server_id} (migración Fase 2)
    - SYNC-S scheduler (migración Fase 2)
    
    Args:
        server: Dict con configuración SQL (host, port, database, username, password)
        fecha_ini: Fecha inicio en formato YYYY-MM-DD
        fecha_fin: Fecha fin en formato YYYY-MM-DD
        sucursal_id: ID de sucursal/estación (opcional, None = todas)
        
    Returns:
        VentasPeriodoResult con métricas o error
    """
    # FASE 3A.3: Migrado a helper centralizado
    system_type = server.get('system_type', '')
    if not is_softrestaurant_system(system_type):
        return VentasPeriodoResult(
            success=False,
            error=f"Server {server.get('name')} no es SoftRestaurant (es {system_type})"
        )
    
    # Validar configuración mínima
    required_fields = ['host', 'port', 'database', 'username', 'password']
    missing = [f for f in required_fields if not server.get(f)]
    if missing:
        return VentasPeriodoResult(
            success=False,
            error=f"Configuración incompleta: faltan {missing}"
        )
    
    # Convertir fechas a formato YYYYMMDD para SQL Server
    fi = _format_fecha_sr(fecha_ini)
    ff = _format_fecha_sr(fecha_fin)
    
    # Construir filtro de sucursal
    filtro_suc = _build_sucursal_filter_sr(sucursal_id, alias="cheques")
    
    # Verificar si la tabla cheques tiene columna 'propina'
    has_propina = check_column_exists(
        server['host'], server['port'], server['database'],
        server['username'], server['password'], 'cheques', 'propina'
    )
    propina_expr = get_propina_safe_column(has_propina)
    
    # Query SQL - EXACTAMENTE igual a service.py líneas 341-351
    # NOTA: Se excluyen propinas de las ventas SI la columna existe
    query = f"""
SELECT 
    COUNT(DISTINCT cheques.folio) as cheques,
    ISNULL(SUM(cheques.total{propina_expr}), 0) as ventas,
    ISNULL(SUM(cheques.nopersonas), 0) as pax
FROM cheques
INNER JOIN turnos ON turnos.idturno = cheques.idturno
WHERE CONVERT(varchar, turnos.apertura, 112) >= '{fi}'
  AND CONVERT(varchar, turnos.apertura, 112) <= '{ff}'
  AND cheques.cancelado = 0
  {filtro_suc}
"""
    
    try:
        result = execute_sql_query(
            server['host'], 
            server['port'], 
            server['database'],
            server['username'], 
            server['password'], 
            query
        )
        
        if result and len(result) > 0:
            return VentasPeriodoResult(
                success=True,
                total_venta=float(result[0].get('ventas') or 0),
                pax=int(result[0].get('pax') or 0),
                cheques=int(result[0].get('cheques') or 0),
                source="SQL_LIVE"
            )
        else:
            # Query exitosa pero sin resultados
            return VentasPeriodoResult(
                success=True,
                total_venta=0.0,
                pax=0,
                cheques=0,
                source="SQL_LIVE"
            )
            
    except Exception as e:
        logging.warning(f"[{MODULE_NAME}] Error en query_ventas_periodo_sr para {server.get('name')}: {e}")
        return VentasPeriodoResult(
            success=False,
            error=str(e)
        )


