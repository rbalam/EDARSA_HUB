def obtener_resumen_benchmark(unidad_negocio_id: int, empresa_id: int) -> BenchmarkResumenResponse:
    """
    Obtiene resumen de benchmark para una unidad de negocio.
    
    NO ejecuta IA - solo estadísticas de la BD.
    """
    conn = _get_conn()
    
    # Estadísticas de competidores
    stats_competidores = obtener_estadisticas_competidores(unidad_negocio_id)
    
    # Estadísticas de items
    stats_items = obtener_estadisticas_menu_items(unidad_negocio_id)
    
    # Estadísticas de benchmark
    query_benchmark = f"""
    SELECT 
        COUNT(DISTINCT b.CodigoProducto) as productos_con_benchmark,
        COUNT(*) as total_mapeos,
        SUM(CASE WHEN b.ValidadoPorUsuario = 1 THEN 1 ELSE 0 END) as mapeos_validados,
        MAX(b.FechaModificacion) as ultima_actualizacion
    FROM Comercial_PricingBenchmarkProducto b
    WHERE b.UnidadNegocioID = {UnidadNegocioID}
      AND b.Activo = 1
    """
    
    result_benchmark = execute_sql_query(*conn, query_benchmark)
    
    productos_con_benchmark = 0
    fecha_actualizacion = None
    
    if result_benchmark and len(result_benchmark) > 0:
        row = result_benchmark[0]
        productos_con_benchmark = row.get('productos_con_benchmark', 0) or 0
        fecha_actualizacion = row.get('ultima_actualizacion')
    
    # Contar productos propios (de Sync_Productos)
    query_productos = f"""
    SELECT COUNT(DISTINCT sp.CodigoFuente) as total_productos
    FROM Sync_Productos sp
    JOIN Sistema_EmpresasServidores ses ON sp.ServerID = ses.server_id
    WHERE ses.empresa_id = {empresa_id}
      AND ses.visible_operaciones = 1
    """
    
    result_productos = execute_sql_query(*conn, query_productos)
    total_productos = 0
    
    if result_productos and len(result_productos) > 0:
        total_productos = result_productos[0].get('total_productos', 0) or 0
    
    productos_sin_benchmark = total_productos - productos_con_benchmark
    cobertura = (productos_con_benchmark / total_productos * 100) if total_productos > 0 else 0
    
    # Determinar estado
    if stats_competidores['total_competidores'] == 0:
        estado = "SIN_CONFIGURAR"
    elif stats_items['total_items'] == 0:
        estado = "SIN_DATOS_COMPETENCIA"
    elif productos_con_benchmark == 0:
        estado = "SIN_MAPEOS"
    elif cobertura < 50:
        estado = "PARCIAL"
    else:
        estado = "COMPLETO"
    
    return BenchmarkResumenResponse(
        unidad_negocio_id=unidad_negocio_id,
        empresa_id=empresa_id,
        competidores_configurados=stats_competidores['total_competidores'],
        competidores_directos=stats_competidores['directos'],
        competidores_aspiracionales=stats_competidores['aspiracionales'],
        items_competencia_capturados=stats_items['total_items'],
        items_alta_confianza=stats_items['alta_confianza'],
        items_media_confianza=stats_items['media_confianza'],
        items_baja_confianza=stats_items['baja_confianza'],
        productos_propios_total=total_productos,
        productos_con_benchmark=productos_con_benchmark,
        productos_sin_benchmark=productos_sin_benchmark,
        cobertura_benchmark=round(cobertura, 1),
        fecha_ultima_actualizacion=fecha_actualizacion,
        estado=estado,
    )


def obtener_estado_preparacion_ia(unidad_negocio_id: int, empresa_id: int) -> BenchmarkEstadoPreparacionResponse:
    """
    Verifica si una unidad está lista para análisis IA.
    
    NO ejecuta IA - solo verifica requisitos.
    
    Requisitos para estar listo:
    1. Perfil digital completo (nombre, concepto, tipo, segmento, ciudad)
    2. Al menos 3 competidores configurados
    3. Al menos 10 items de competencia capturados
    4. Al menos 1 mapeo de benchmark validado
    """
    # Verificar perfil
    perfil_check = verificar_perfil_completo(unidad_negocio_id)
    urls = obtener_urls_perfil(unidad_negocio_id)
    
    urls_disponibles = [k for k, v in urls.items() if v]
    urls_faltantes = [k for k, v in urls.items() if not v]
    
    # Estadísticas
    stats_competidores = obtener_estadisticas_competidores(unidad_negocio_id)
    stats_items = obtener_estadisticas_menu_items(unidad_negocio_id)
    
    # Contar mapeos validados
    conn = _get_conn()
    query_validados = f"""
    SELECT 
        COUNT(DISTINCT CodigoProducto) as productos_mapeados,
        SUM(CASE WHEN ValidadoPorUsuario = 1 THEN 1 ELSE 0 END) as mapeos_validados
    FROM Comercial_PricingBenchmarkProducto
    WHERE UnidadNegocioID = {UnidadNegocioID}
      AND Activo = 1
    """
    
    result = execute_sql_query(*conn, query_validados)
    productos_mapeados = 0
    mapeos_validados = 0
    
    if result and len(result) > 0:
        productos_mapeados = result[0].get('productos_mapeados', 0) or 0
        mapeos_validados = result[0].get('mapeos_validados', 0) or 0
    
    # Verificar requisitos
    faltantes = []
    razones_no_listo = []
    recomendaciones = []
    
    # 1. Perfil digital
    if not perfil_check.get('existe'):
        faltantes.append("perfil_digital")
        razones_no_listo.append("No existe perfil digital configurado")
        recomendaciones.append("Crear perfil digital de la unidad con concepto, tipo y segmento")
    elif not perfil_check.get('completo'):
        for campo in perfil_check.get('faltantes_requeridos', []):
            faltantes.append(f"perfil.{campo}")
        razones_no_listo.append(f"Perfil digital incompleto: faltan {', '.join(perfil_check.get('faltantes_requeridos', []))}")
        recomendaciones.append("Completar campos obligatorios del perfil digital")
    
    # 2. Competidores mínimos
    min_competidores = 3
    if stats_competidores['total_competidores'] < min_competidores:
        faltantes.append("competidores")
        razones_no_listo.append(f"Solo {stats_competidores['total_competidores']} competidores (mínimo: {min_competidores})")
        recomendaciones.append(f"Configurar al menos {min_competidores - stats_competidores['total_competidores']} competidores más")
    
    # 3. Items de competencia mínimos
    min_items = 10
    if stats_items['total_items'] < min_items:
        faltantes.append("items_competencia")
        razones_no_listo.append(f"Solo {stats_items['total_items']} items de competencia (mínimo: {min_items})")
        recomendaciones.append(f"Capturar al menos {min_items - stats_items['total_items']} precios de la competencia")
    
    # 4. Competidores con menú capturado
    competidores_con_menu = 0
    query_con_menu = f"""
    SELECT COUNT(DISTINCT c.CompetidorID) as con_menu
    FROM Comercial_Competidores c
    JOIN Comercial_CompetidoresMenuItems mi ON c.CompetidorID = mi.CompetidorID
    WHERE c.UnidadNegocioID = {unidad_negocio_id}
      AND c.Activo = 1
      AND mi.Activo = 1
    """
    result_menu = execute_sql_query(*conn, query_con_menu)
    if result_menu and len(result_menu) > 0:
        competidores_con_menu = result_menu[0].get('con_menu', 0) or 0
    
    # Determinar si está listo
    listo = (
        perfil_check.get('completo', False) and
        stats_competidores['total_competidores'] >= min_competidores and
        stats_items['total_items'] >= min_items
    )
    
    # Agregar recomendaciones adicionales
    if listo and mapeos_validados == 0:
        recomendaciones.append("Validar al menos algunos mapeos de benchmark para mejorar confianza del análisis IA")
    
    if listo and 'menu_digital' in urls_faltantes:
        recomendaciones.append("Agregar URL del menú digital para mejor análisis comparativo")
    
    return BenchmarkEstadoPreparacionResponse(
        unidad_negocio_id=unidad_negocio_id,
        empresa_id=empresa_id,
        perfil_digital_completo=perfil_check.get('completo', False),
        urls_disponibles=urls_disponibles,
        urls_faltantes=urls_faltantes,
        competidores_configurados=stats_competidores['total_competidores'],
        minimo_competidores_recomendado=min_competidores,
        competidores_con_menu=competidores_con_menu,
        items_capturados=stats_items['total_items'],
        minimo_items_recomendado=min_items,
        productos_mapeados=productos_mapeados,
        productos_validados=mapeos_validados,
        faltantes=faltantes,
        listo_para_ia=listo,
        razones_no_listo=razones_no_listo,
        recomendaciones=recomendaciones,
    )


