def _get_conn() -> Tuple:
    """Retorna parámetros de conexión a EDARSAHUB."""
    return (
        EDARSAHUB_CONFIG['host'],
        EDARSAHUB_CONFIG['port'],
        EDARSAHUB_CONFIG['database'],
        EDARSAHUB_CONFIG['username'],
        EDARSAHUB_CONFIG['password']
    )


def _row_to_benchmark(row: Dict) -> PricingBenchmarkProductoResponse:
    """Convierte fila SQL a PricingBenchmarkProductoResponse."""
    return PricingBenchmarkProductoResponse(
        benchmark_producto_id=str(row.get('BenchmarkProductoID', '')),
        empresa_id=row.get('EmpresaID', 0),
        unidad_negocio_id=row.get('UnidadNegocioID', 0),
        producto_id=str(row.get('ProductoID', '')) if row.get('ProductoID') else None,
        codigo_producto=row.get('CodigoProducto', ''),
        server_id=str(row.get('ServerID', '')),
        competidor_id=str(row.get('CompetidorID', '')),
        competidor_menu_item_id=str(row.get('CompetidorMenuItemID', '')),
        similitud=float(row.get('Similitud', 0)),
        tipo_comparacion=row.get('TipoComparacion', 'PRODUCTO_SIMILAR'),
        comentario_ia=row.get('ComentarioIA'),
        validado_por_usuario=bool(row.get('ValidadoPorUsuario', False)),
        usuario_validacion=row.get('UsuarioValidacion'),
        fecha_validacion=row.get('FechaValidacion'),
        activo=bool(row.get('Activo', True)),
        fecha_creacion=row.get('FechaCreacion') or datetime.now(),
        usuario_creacion=row.get('UsuarioCreacion'),
        fecha_modificacion=row.get('FechaModificacion'),
        usuario_modificacion=row.get('UsuarioModificacion'),
        # Datos agregados
        nombre_competidor=row.get('NombreCompetidor'),
        nombre_producto_competidor=row.get('NombreProductoCompetidor'),
        precio_competidor=float(row['PrecioCompetidor']) if row.get('PrecioCompetidor') else None,
    )


