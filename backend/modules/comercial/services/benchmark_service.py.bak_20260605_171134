def crear_benchmark(data: PricingBenchmarkProductoCreate, usuario: str) -> PricingBenchmarkProductoResponse:
    """
    Crea un nuevo mapeo de benchmark.
    """
    conn = _get_conn()
    
    benchmark_id = str(uuid.uuid4())
    
    # Preparar valores SQL
    producto_id_sql = f"'{data.producto_id}'" if data.producto_id else "NULL"
    comentario_sql = f"N'{data.comentario_ia}'" if data.comentario_ia else "NULL"
    
    insert_query = f"""
    INSERT INTO Comercial_PricingBenchmarkProducto (
        BenchmarkProductoID,
        ProductoID,
        CodigoProducto,
        ServerID,
        EmpresaID,
        UnidadNegocioID,
        CompetidorID,
        CompetidorMenuItemID,
        Similitud,
        TipoComparacion,
        ComentarioIA,
        ValidadoPorUsuario,
        Activo,
        FechaCreacion,
        UsuarioCreacion
    ) VALUES (
        '{benchmark_id}',
        {producto_id_sql},
        '{data.codigo_producto}',
        '{data.ServerID}',
        {data.EmpresaID},
        {data.UnidadNegocioID},
        '{data.competidor_id}',
        '{data.competidor_menu_item_id}',
        {data.Similitud},
        '{data.tipo_comparacion.value}',
        {comentario_sql},
        0,
        1,
        GETDATE(),
        N'{usuario}'
    )
    """
    
    execute_sql_query(*conn, insert_query)
    logger.info(f"[BENCHMARK] Creado {benchmark_id} para producto {data.codigo_producto} por {usuario}")
    
    return obtener_benchmark_por_id(benchmark_id)


def actualizar_benchmark(
    benchmark_id: str,
    data: PricingBenchmarkProductoUpdate,
    usuario: str
) -> Optional[PricingBenchmarkProductoResponse]:
    """
    Actualiza un benchmark existente.
    """
    conn = _get_conn()
    
    benchmark_actual = obtener_benchmark_por_id(benchmark_id)
    if not benchmark_actual:
        return None
    
    set_clauses = []
    
    if data.similitud is not None:
        set_clauses.append(f"Similitud = {data.similitud}")
    if data.tipo_comparacion is not None:
        set_clauses.append(f"TipoComparacion = '{data.tipo_comparacion.value}'")
    if data.comentario_ia is not None:
        set_clauses.append(f"ComentarioIA = N'{data.comentario_ia}'")
    if data.validado_por_usuario is not None:
        set_clauses.append(f"ValidadoPorUsuario = {1 if data.validado_por_usuario else 0}")
        if data.validado_por_usuario:
            set_clauses.append(f"UsuarioValidacion = N'{data.usuario_validacion or usuario}'")
            set_clauses.append("FechaValidacion = GETDATE()")
    
    if not set_clauses:
        return benchmark_actual
    
    set_clauses.append("FechaModificacion = GETDATE()")
    set_clauses.append(f"UsuarioModificacion = N'{usuario}'")
    
    set_sql = ", ".join(set_clauses)
    
    update_query = f"""
    UPDATE Comercial_PricingBenchmarkProducto
    SET {set_sql}
    WHERE BenchmarkProductoID = '{benchmark_id}'
    """
    
    execute_sql_query(*conn, update_query)
    logger.info(f"[BENCHMARK] Actualizado {benchmark_id} por {usuario}")
    
    return obtener_benchmark_por_id(benchmark_id)


def validar_benchmark(benchmark_id: str, usuario: str) -> Optional[PricingBenchmarkProductoResponse]:
    """
    Marca un benchmark como validado por un usuario.
    """
    conn = _get_conn()
    
    update_query = f"""
    UPDATE Comercial_PricingBenchmarkProducto
    SET ValidadoPorUsuario = 1,
        UsuarioValidacion = N'{usuario}',
        FechaValidacion = GETDATE(),
        FechaModificacion = GETDATE(),
        UsuarioModificacion = N'{usuario}'
    WHERE BenchmarkProductoID = '{benchmark_id}'
    """
    
    execute_sql_query(*conn, update_query)
    logger.info(f"[BENCHMARK] Validado {benchmark_id} por {usuario}")
    
    return obtener_benchmark_por_id(benchmark_id)


def inactivar_benchmark(benchmark_id: str, usuario: str) -> bool:
    """
    Inactiva un benchmark (baja lógica).
    """
    conn = _get_conn()
    
    update_query = f"""
    UPDATE Comercial_PricingBenchmarkProducto
    SET Activo = 0,
        FechaModificacion = GETDATE(),
        UsuarioModificacion = N'{usuario}'
    WHERE BenchmarkProductoID = '{benchmark_id}'
    """
    
    execute_sql_query(*conn, update_query)
    logger.info(f"[BENCHMARK] Inactivado {benchmark_id} por {usuario}")
    
    return True


