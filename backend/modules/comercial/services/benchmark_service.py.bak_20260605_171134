def obtener_precios_competencia_producto(
    codigo_producto: str,
    server_id: str
) -> Dict[str, Any]:
    """
    Obtiene estadísticas de precios de competencia para un producto.
    
    Útil para calcular posición vs competencia.
    """
    benchmarks = obtener_benchmarks_producto(codigo_producto, server_id)
    
    if not benchmarks:
        return {
            'tiene_datos': False,
            'mensaje': 'Sin mapeos de benchmark para este producto'
        }
    
    # Filtrar solo los que tienen precio
    precios = [b.precio_competidor for b in benchmarks if b.precio_competidor and b.precio_competidor > 0]
    
    if not precios:
        return {
            'tiene_datos': False,
            'mensaje': 'Mapeos sin precios de competidor'
        }
    
    return {
        'tiene_datos': True,
        'total_comparables': len(precios),
        'precio_minimo': min(precios),
        'precio_maximo': max(precios),
        'precio_promedio': sum(precios) / len(precios),
        'competidores': [
            {
                'nombre': b.nombre_competidor,
                'producto': b.nombre_producto_competidor,
                'precio': b.precio_competidor,
                'similitud': b.similitud,
                'validado': b.validado_por_usuario
            }
            for b in benchmarks if b.precio_competidor and b.precio_competidor > 0
        ]
    }


