def listar_benchmarks(
    empresa_id: Optional[int] = None,
    unidad_negocio_id: Optional[int] = None,
    codigo_producto: Optional[str] = None,
    competidor_id: Optional[str] = None,
    solo_activos: bool = True,
    solo_validados: Optional[bool] = None,
    page: int = 1,
    page_size: int = 50
) -> Tuple[List[PricingBenchmarkProductoResponse], int]:
    """
    Lista mapeos de benchmark con filtros opcionales.
    """
    conn = _get_conn()
    
    where_clauses = []
    if empresa_id:
        where_clauses.append(f"b.EmpresaID = {empresa_id}")
    if unidad_negocio_id:
        where_clauses.append(f"b.UnidadNegocioID = {unidad_negocio_id}")
    if codigo_producto:
        where_clauses.append(f"b.CodigoProducto = '{codigo_producto}'")
    if competidor_id:
        where_clauses.append(f"b.CompetidorID = '{competidor_id}'")
    if solo_activos:
        where_clauses.append("b.Activo = 1")
    if solo_validados is not None:
        where_clauses.append(f"b.ValidadoPorUsuario = {1 if solo_validados else 0}")
    
    where_sql = f"WHERE {' AND '.join(where_clauses)}" if where_clauses else ""
    
    # Contar total
    count_query = f"""
    SELECT COUNT(*) as total
    FROM Comercial_PricingBenchmarkProducto b
    {where_sql}
    """
    count_result = execute_sql_query(*conn, count_query)
    total = count_result[0]['total'] if count_result else 0
    
    # Obtener página con info de competidor
    offset = (page - 1) * page_size
    query = f"""
    SELECT 
        CAST(b.BenchmarkProductoID AS NVARCHAR(36)) as BenchmarkProductoID,
        b.EmpresaID,
        b.UnidadNegocioID,
        CAST(b.ProductoID AS NVARCHAR(36)) as ProductoID,
        b.CodigoProducto,
        CAST(b.ServerID AS NVARCHAR(36)) as ServerID,
        CAST(b.CompetidorID AS NVARCHAR(36)) as CompetidorID,
        CAST(b.CompetidorMenuItemID AS NVARCHAR(36)) as CompetidorMenuItemID,
        b.Similitud,
        b.TipoComparacion,
        b.ComentarioIA,
        b.ValidadoPorUsuario,
        b.UsuarioValidacion,
        b.FechaValidacion,
        b.Activo,
        b.FechaCreacion,
        b.UsuarioCreacion,
        b.FechaModificacion,
        b.UsuarioModificacion,
        c.NombreCompetidor,
        mi.NombreProductoCompetidor,
        mi.Precio as PrecioCompetidor
    FROM Comercial_PricingBenchmarkProducto b
    LEFT JOIN Comercial_Competidores c ON b.CompetidorID = c.CompetidorID
    LEFT JOIN Comercial_CompetidoresMenuItems mi ON b.CompetidorMenuItemID = mi.CompetidorMenuItemID
    {where_sql}
    ORDER BY b.CodigoProducto, c.NombreCompetidor
    OFFSET {offset} ROWS FETCH NEXT {page_size} ROWS ONLY
    """
    
    result = execute_sql_query(*conn, query)
    
    benchmarks = [_row_to_benchmark(row) for row in (result or [])]
    
    return benchmarks, total


