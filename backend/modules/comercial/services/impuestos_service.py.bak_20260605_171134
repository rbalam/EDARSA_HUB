"""
Servicio de Resolución de Impuestos - FASE 1C-3G-C

Este módulo proporciona la función `resolver_tasa_impuesto` que determina
la tasa de impuesto aplicable a un producto según la jerarquía:

1. Override autorizado por producto/unidad/sucursal
2. Tasa específica por producto sincronizada desde origen
3. Tasa por familia/subfamilia
4. Tasa por unidad/sucursal
5. Tasa por región/estado
6. Tasa por país
7. Tasa default global autorizada

Si no existe tasa válida, devuelve IMPUESTO_NO_CONFIGURADO.
"""

from typing import Optional, Dict, Any, Tuple
from decimal import Decimal
from enum import Enum

from core.db import execute_sql_query
from core.server_registry import EDARSAHUB_CONFIG


class EstadoFiscal(str, Enum):
    """Estados fiscales posibles para un producto."""
    CONFIGURADO = "CONFIGURADO"
    NO_CONFIGURADO = "NO_CONFIGURADO"
    PENDIENTE_HOMOLOGACION = "PENDIENTE_HOMOLOGACION"
    EXENTO_VALIDADO = "EXENTO_VALIDADO"
    TASA_CERO_VALIDADA = "TASA_CERO_VALIDADA"
    ERROR_MAPEO = "ERROR_MAPEO"


class ResultadoResolucionImpuesto:
    """Resultado de la resolución de tasa de impuesto."""
    
    def __init__(
        self,
        tasa: Optional[float],
        estado_fiscal: EstadoFiscal,
        fuente: str,
        impuesto_canonico_id: Optional[str] = None,
        mensaje: Optional[str] = None
    ):
        self.tasa = tasa
        self.estado_fiscal = estado_fiscal
        self.fuente = fuente  # OVERRIDE, PRODUCTO, FAMILIA, UNIDAD, REGION, PAIS, DEFAULT
        self.impuesto_canonico_id = impuesto_canonico_id
        self.mensaje = mensaje
        self.permite_calculo_precio = estado_fiscal in [
            EstadoFiscal.CONFIGURADO, 
            EstadoFiscal.TASA_CERO_VALIDADA,
            EstadoFiscal.EXENTO_VALIDADO
        ]
    
    def to_dict(self) -> Dict[str, Any]:
        return {
            'tasa': self.tasa,
            'estado_fiscal': self.estado_fiscal.value,
            'fuente': self.fuente,
            'impuesto_canonico_id': self.impuesto_canonico_id,
            'mensaje': self.mensaje,
            'permite_calculo_precio': self.permite_calculo_precio
        }


def _get_edarsahub_connection() -> Tuple:
    """Retorna parámetros de conexión a EDARSAHUB."""
    return (
        EDARSAHUB_CONFIG['host'],
        EDARSAHUB_CONFIG['port'],
        EDARSAHUB_CONFIG['database'],
        EDARSAHUB_CONFIG['username'],
        EDARSAHUB_CONFIG['password']
    )


def resolver_tasa_impuesto(
    codigo_producto: str,
    server_id: str,
    unidad_negocio_id: Optional[str] = None,
    sucursal_id: Optional[str] = None,
    familia_codigo: Optional[str] = None,
    region_codigo: Optional[str] = None,
    pais_codigo: str = "MEX"
) -> ResultadoResolucionImpuesto:
    """
    Resuelve la tasa de impuesto aplicable a un producto.
    
    JERARQUÍA DE RESOLUCIÓN (mayor a menor prioridad):
    1. Override autorizado por producto/unidad/sucursal
    2. Tasa específica por producto sincronizada desde origen
    3. Tasa por familia/subfamilia (TODO: implementar cuando se requiera)
    4. Tasa por unidad/sucursal (TODO: implementar cuando se requiera)
    5. Tasa por región/estado (TODO: implementar cuando se requiera)
    6. Tasa por país (TODO: implementar cuando se requiera)
    7. Tasa default global (TODO: implementar cuando se requiera)
    
    Args:
        codigo_producto: Código del producto en sistema origen
        server_id: UUID del servidor origen
        unidad_negocio_id: UUID de la unidad de negocio (opcional)
        sucursal_id: UUID de la sucursal (opcional)
        familia_codigo: Código de familia del producto (opcional)
        region_codigo: Código de región (opcional)
        pais_codigo: Código ISO del país (default: MEX)
    
    Returns:
        ResultadoResolucionImpuesto con la tasa resuelta o estado NO_CONFIGURADO
    """
    conn = _get_edarsahub_connection()
    
    # ========================================
    # NIVEL 1: Buscar override autorizado
    # ========================================
    override_query = f"""
    SELECT TOP 1
        TasaOverride,
        CAST(ImpuestoCanonicoID AS NVARCHAR(36)) as ImpuestoCanonicoID,
        TipoOverride
    FROM Comercial_ImpuestosOverrides
    WHERE Activo = 1
      AND (VigenciaHasta IS NULL OR VigenciaHasta >= GETDATE())
      AND VigenciaDesde <= GETDATE()
      AND (
          -- Override por producto específico
          (TipoOverride = 'PRODUCTO' AND CodigoProducto = '{codigo_producto}' AND ServerID = '{ServerID}')
          -- Override por unidad
          OR (TipoOverride = 'UNIDAD' AND UnidadNegocioID = '{UnidadNegocioID}' AND '{UnidadNegocioID}' IS NOT NULL)
          -- Override por sucursal
          OR (TipoOverride = 'SUCURSAL' AND SucursalID = '{SucursalID}' AND '{SucursalID}' IS NOT NULL)
          -- Override por familia
          OR (TipoOverride = 'FAMILIA' AND FamiliaCodigoFuente = '{familia_codigo}' AND '{familia_codigo}' IS NOT NULL)
          -- Override por región
          OR (TipoOverride = 'REGION' AND RegionCodigo = '{region_codigo}' AND '{region_codigo}' IS NOT NULL)
          -- Override por país
          OR (TipoOverride = 'PAIS' AND PaisCodigo = '{pais_codigo}')
      )
    ORDER BY 
        CASE TipoOverride 
            WHEN 'PRODUCTO' THEN 1
            WHEN 'SUCURSAL' THEN 2
            WHEN 'UNIDAD' THEN 3
            WHEN 'FAMILIA' THEN 4
            WHEN 'REGION' THEN 5
            WHEN 'PAIS' THEN 6
        END
    """
    
    override_result = execute_sql_query(*conn, override_query)
    
    if override_result and len(override_result) > 0:
        row = override_result[0]
        tasa = float(row['TasaOverride']) if row['TasaOverride'] is not None else None
        
        if tasa is not None:
            estado = EstadoFiscal.CONFIGURADO if tasa > 0 else EstadoFiscal.TASA_CERO_VALIDADA
            return ResultadoResolucionImpuesto(
                tasa=tasa,
                estado_fiscal=estado,
                fuente=f"OVERRIDE_{row['TipoOverride']}",
                impuesto_canonico_id=row['ImpuestoCanonicoID'],
                mensaje=f"Tasa override por {row['TipoOverride'].lower()}"
            )
    
    # ========================================
    # NIVEL 2: Buscar en mapeo de producto
    # ========================================
    producto_query = f"""
    SELECT TOP 1
        TasaEfectiva,
        EstadoFiscal,
        CAST(ImpuestoCanonicoID AS NVARCHAR(36)) as ImpuestoCanonicoID,
        FuenteOrigen
    FROM Comercial_ImpuestosMapeo
    WHERE ServerID = '{ServerID}'
      AND CodigoProducto = '{codigo_producto}'
    """
    
    producto_result = execute_sql_query(*conn, producto_query)
    
    if producto_result and len(producto_result) > 0:
        row = producto_result[0]
        tasa = float(row['TasaEfectiva']) if row['TasaEfectiva'] is not None else None
        estado_str = row['EstadoFiscal']
        
        # Mapear estado
        try:
            estado = EstadoFiscal(estado_str)
        except ValueError:
            estado = EstadoFiscal.ERROR_MAPEO
        
        # Si el estado es NO_CONFIGURADO, no permite cálculo
        if estado == EstadoFiscal.NO_CONFIGURADO:
            return ResultadoResolucionImpuesto(
                tasa=None,
                estado_fiscal=EstadoFiscal.NO_CONFIGURADO,
                fuente="PRODUCTO",
                impuesto_canonico_id=row['ImpuestoCanonicoID'],
                mensaje="Producto sin tasa de impuesto homologada. Requiere configuración fiscal."
            )
        
        return ResultadoResolucionImpuesto(
            tasa=tasa,
            estado_fiscal=estado,
            fuente="PRODUCTO",
            impuesto_canonico_id=row['ImpuestoCanonicoID'],
            mensaje=f"Tasa desde {row['FuenteOrigen'].lower()}"
        )
    
    # ========================================
    # NIVEL 3-7: Fallback a Sync_Productos
    # (Si no existe en mapeo canónico)
    # ========================================
    sync_query = f"""
    SELECT TOP 1
        TasaImpuesto
    FROM Sync_Productos
    WHERE ServerID = '{ServerID}'
      AND CodigoFuente = '{codigo_producto}'
    """
    
    sync_result = execute_sql_query(*conn, sync_query)
    
    if sync_result and len(sync_result) > 0:
        tasa_raw = sync_result[0]['TasaImpuesto']
        
        if tasa_raw is None or tasa_raw == -1:
            return ResultadoResolucionImpuesto(
                tasa=None,
                estado_fiscal=EstadoFiscal.NO_CONFIGURADO,
                fuente="SYNC_PRODUCTOS",
                mensaje="Producto sin configuración fiscal en sistema origen"
            )
        
        tasa = float(tasa_raw)
        estado = EstadoFiscal.CONFIGURADO if tasa > 0 else EstadoFiscal.TASA_CERO_VALIDADA
        
        return ResultadoResolucionImpuesto(
            tasa=tasa,
            estado_fiscal=estado,
            fuente="SYNC_PRODUCTOS",
            mensaje="Tasa desde sincronización origen (sin mapeo canónico)"
        )
    
    # ========================================
    # No se encontró el producto
    # ========================================
    return ResultadoResolucionImpuesto(
        tasa=None,
        estado_fiscal=EstadoFiscal.NO_CONFIGURADO,
        fuente="NO_ENCONTRADO",
        mensaje="Producto no encontrado en sistema"
    )


def get_estado_fiscal_producto(codigo_producto: str, server_id: str) -> Dict[str, Any]:
    """
    Obtiene el estado fiscal completo de un producto.
    
    Útil para UI de administración y validación de datos.
    """
    conn = _get_edarsahub_connection()
    
    query = f"""
    SELECT 
        m.CodigoProducto,
        m.NombreProducto,
        m.SystemType,
        m.EstadoFiscal,
        m.TasaEfectiva,
        m.FuenteOrigen,
        m.Observaciones,
        m.FechaSincronizacion,
        ic.Codigo as ImpuestoCanonicoCodigio,
        ic.Nombre as ImpuestoCanonicoNombre,
        ic.TipoImpuesto
    FROM Comercial_ImpuestosMapeo m
    LEFT JOIN Comercial_ImpuestosCatalogo ic ON m.ImpuestoCanonicoID = ic.ImpuestoID
    WHERE m.ServerID = '{server_id}'
      AND m.CodigoProducto = '{codigo_producto}'
    """
    
    result = execute_sql_query(*conn, query)
    
    if result and len(result) > 0:
        row = result[0]
        return {
            'encontrado': True,
            'codigo_producto': row['CodigoProducto'],
            'nombre_producto': row['NombreProducto'],
            'system_type': row['SystemType'],
            'estado_fiscal': row['EstadoFiscal'],
            'tasa_efectiva': float(row['TasaEfectiva']) if row['TasaEfectiva'] else None,
            'fuente_origen': row['FuenteOrigen'],
            'observaciones': row['Observaciones'],
            'fecha_sincronizacion': row['FechaSincronizacion'],
            'impuesto_canonico': {
                'codigo': row['ImpuestoCanonicoCodigio'],
                'nombre': row['ImpuestoCanonicoNombre'],
                'tipo': row['TipoImpuesto']
            } if row['ImpuestoCanonicoCodigio'] else None
        }
    
    return {
        'encontrado': False,
        'mensaje': 'Producto no tiene mapeo fiscal configurado'
    }


def get_productos_sin_impuesto(server_id: Optional[str] = None, limit: int = 100) -> list:
    """
    Obtiene lista de productos con estado NO_CONFIGURADO.
    
    Útil para UI de administración fiscal.
    """
    conn = _get_edarsahub_connection()
    
    where_clause = "WHERE m.EstadoFiscal = 'NO_CONFIGURADO'"
    if server_id:
        where_clause += f" AND m.ServerID = '{server_id}'"
    
    query = f"""
    SELECT TOP {limit}
        m.CodigoProducto,
        m.NombreProducto,
        m.SystemType,
        CAST(m.ServerID AS NVARCHAR(36)) as ServerID,
        sc.nombre as ServidorNombre,
        m.FechaSincronizacion
    FROM Comercial_ImpuestosMapeo m
    JOIN Servidores_Conexiones sc ON m.ServerID = sc.id
    {where_clause}
    ORDER BY sc.nombre, m.NombreProducto
    """
    
    result = execute_sql_query(*conn, query)
    
    return [
        {
            'codigo_producto': r['CodigoProducto'],
            'nombre_producto': r['NombreProducto'],
            'system_type': r['SystemType'],
            'server_id': r['ServerID'],
            'servidor_nombre': r['ServidorNombre'],
            'fecha_sincronizacion': r['FechaSincronizacion']
        }
        for r in (result or [])
    ]
