"""
Servicio consolidado de precios sugeridos para Costos y Márgenes.

FASE 1C-3G-F: Integra precios sugeridos de múltiples fuentes:
- VINOS_RANGOS: Regla administrativa para vinos (INTOCABLE)
- COSTO_MARGEN: Fórmula matemática basada en costo y margen objetivo
- IA_COMPETENCIA: Análisis de benchmark con IA (si hay datos)
- MARGEN_OBJETIVO: Margen estándar cuando no hay otras fuentes

REGLAS:
- NO modifica precios oficiales
- EDARSAHUB SQL es la fuente de verdad
- CERO MongoDB
"""

import logging
from typing import Dict, Any, List, Optional, Tuple
from datetime import datetime
from enum import Enum

from core.db import execute_sql_query
from core.server_registry import EDARSAHUB_CONFIG

logger = logging.getLogger(__name__)


class FuenteSugerencia(str, Enum):
    """Fuentes de precio sugerido"""
    VINOS_RANGOS = "VINOS_RANGOS"
    COSTO_MARGEN = "COSTO_MARGEN"
    IA_COMPETENCIA = "IA_COMPETENCIA"
    MARGEN_OBJETIVO = "MARGEN_OBJETIVO"
    SIN_DATOS = "SIN_DATOS"


class EstadoRevision(str, Enum):
    """Estados de revisión del precio"""
    DENTRO_RANGO = "DENTRO_RANGO"
    FUERA_RANGO = "FUERA_RANGO"
    REQUIERE_REVISION = "REQUIERE_REVISION"
    SIN_DATOS = "SIN_DATOS"
    PRECIO_NEGATIVO = "PRECIO_NEGATIVO"


# Familias que se consideran vinos
FAMILIAS_VINO = [
    'B CHAMPAGNES Y  COGNACS', 'B CHAMPAGNES Y COGNACS', 'B VINOS', 
    'B VINOS DE POSTRE', 'C CAVAS', 'CAVAS', 'CHAMPAGNES Y COGNACS',
    'VINOS BLANCOS', 'VINOS ESPUMOSOS/POSTRE', 'VINOS ROSADOS', 'VINOS TINTOS'
]


def _get_conn() -> Tuple:
    """Obtiene conexión a EDARSAHUB"""
    return (
        EDARSAHUB_CONFIG['host'],
        EDARSAHUB_CONFIG['port'],
        EDARSAHUB_CONFIG['database'],
        EDARSAHUB_CONFIG['username'],
        EDARSAHUB_CONFIG['password']
    )


def _obtener_rangos_vinos() -> List[Dict]:
    """Obtiene los rangos activos de VINOS_RANGOS_MX"""
    conn = _get_conn()
    query = """
    SELECT 
        r.LimiteInferior, r.LimiteSuperior, r.MargenMultiplicador, r.Descripcion
    FROM Comercial_ReglasPrecioRangos r
    JOIN Comercial_ReglasPrecio p ON r.ReglaPrecioID = p.ReglaPrecioID
    WHERE p.Codigo = 'VINOS_RANGOS_MX' AND r.Activo = 1
    ORDER BY r.Orden
    """
    result = execute_sql_query(*conn, query)
    return result or []


def _calcular_precio_vino(costo_botella: float, rangos: List[Dict]) -> Tuple[Optional[float], Optional[str], Optional[float]]:
    """
    Calcula el precio sugerido para un vino usando VINOS_RANGOS.
    
    Returns:
        (precio_sugerido, rango_aplicado, multiplicador)
    """
    if not costo_botella or costo_botella <= 0:
        return None, None, None
    
    for rango in rangos:
        limite_inf = float(rango['LimiteInferior'] or 0)
        limite_sup = float(rango['LimiteSuperior'] or 999999)
        multiplicador = float(rango['MargenMultiplicador'] or 1)
        
        if limite_inf <= costo_botella <= limite_sup:
            precio_sugerido = costo_botella * multiplicador
            # Redondear a múltiplo de 5
            precio_sugerido = round(precio_sugerido / 5) * 5
            rango_desc = rango.get('Descripcion', f"${limite_inf:.0f} - ${limite_sup:.0f}")
            return precio_sugerido, rango_desc, multiplicador
    
    return None, "FUERA_DE_RANGOS", None


def _es_vino(familia: str) -> bool:
    """Verifica si la familia corresponde a vino"""
    if not familia:
        return False
    return familia.upper().strip() in [f.upper() for f in FAMILIAS_VINO]


def obtener_precios_sugeridos(
    server_id: str = None,
    familia: str = None,
    subfamilia: str = None,
    solo_vinos: bool = False,
    solo_fuera_rango: bool = False,
    solo_requiere_revision: bool = False,
    fuente: str = None,
    margen_bajo: bool = False,
    solo_con_receta: bool = False,
    incluir_inactivos: bool = False,  # BUG-COSTOS-001
    search: str = None,
    page: int = 1,
    page_size: int = 50,
    margen_objetivo: float = 0.35
) -> Dict[str, Any]:
    """
    Obtiene lista de productos con precios sugeridos calculados.
    
    Para vinos: Usa VINOS_RANGOS
    Para otros: Usa COSTO_MARGEN o MARGEN_OBJETIVO
    
    BUG-COSTOS-001: Por defecto solo muestra productos activos.
    BUG-COSTOS-001-R2: El filtro correcto es SOLO Activo = 1.
    NO usar PrecioVenta > 0 como criterio de activo.
    Productos con precio $0 pueden ser activos.
    
    NO modifica precios oficiales.
    """
    conn = _get_conn()
    
    # Obtener rangos de vinos una vez
    rangos_vinos = _obtener_rangos_vinos()
    
    # BUG-COSTOS-001-R2: Solo usar Activo = 1, NO PrecioVenta > 0
    if not incluir_inactivos:
        where_clauses = ["p.Activo = 1"]
    else:
        where_clauses = ["1=1"]
    
    if server_id:
        where_clauses.append(f"p.ServerID = '{server_id}'")
    
    if familia:
        where_clauses.append(f"p.FamiliaNombre = '{familia}'")
    
    if subfamilia:
        where_clauses.append(f"p.SubfamiliaNombre = '{subfamilia}'")
    
    if solo_vinos:
        familias_str = "', '".join(FAMILIAS_VINO)
        where_clauses.append(f"p.FamiliaNombre IN ('{familias_str}')")
    
    if solo_con_receta:
        where_clauses.append("p.TieneReceta = 1")
    
    if margen_bajo:
        where_clauses.append("""(
            p.TieneReceta = 1
            AND p.PrecioVenta > 0 
            AND COALESCE(
                (SELECT SUM(r.CostoTotal) FROM Sync_Productos_Recetas r 
                 WHERE r.ProductoCodigoFuente = p.CodigoFuente AND r.ServerID = p.ServerID),
                p.CostoReceta, 0
            ) > 0
            AND (
                (p.PrecioVenta - COALESCE(
                    (SELECT SUM(r.CostoTotal) FROM Sync_Productos_Recetas r 
                     WHERE r.ProductoCodigoFuente = p.CodigoFuente AND r.ServerID = p.ServerID),
                    p.CostoReceta, 0
                )) / p.PrecioVenta * 100
            ) < 20
        )""")
    
    if search:
        where_clauses.append(f"(p.Nombre LIKE '%{search}%' OR p.CodigoFuente LIKE '%{search}%')")
    
    where_sql = " AND ".join(where_clauses)
    
    # Query principal
    offset = (page - 1) * page_size
    
    query = f"""
    SELECT 
        p.CodigoFuente as producto_id,
        p.CodigoFuente as clave,
        p.Nombre as nombre,
        p.FamiliaNombre as familia,
        p.SubfamiliaNombre as subfamilia,
        sc.nombre as unidad,
        p.PrecioVenta as precio_actual,
        COALESCE(
            (SELECT SUM(r.CostoTotal) FROM Sync_Productos_Recetas r 
             WHERE r.ProductoCodigoFuente = p.CodigoFuente AND r.ServerID = p.ServerID),
            p.CostoReceta, 0
        ) as costo_receta,
        p.TieneReceta as tiene_receta,
        p.ServerID as server_id,
        p.CostoReceta as costo_botella,
        p.Activo
    FROM Sync_Productos p
    LEFT JOIN Servidores_Conexiones sc ON CAST(p.ServerID AS NVARCHAR(36)) = CAST(sc.id AS NVARCHAR(36))
    WHERE {where_sql}
    ORDER BY p.Nombre
    OFFSET {offset} ROWS FETCH NEXT {page_size} ROWS ONLY
    """
    
    # Query de conteo
    count_query = f"""
    SELECT COUNT(*) as total
    FROM Sync_Productos p
    WHERE {where_sql}
    """
    
    productos_raw = execute_sql_query(*conn, query) or []
    count_result = execute_sql_query(*conn, count_query)
    total = count_result[0]['total'] if count_result else 0
    
    # Procesar productos y calcular precios sugeridos
    productos = []
    
    for p in productos_raw:
        precio_actual = float(p.get('precio_actual') or 0)
        costo_receta = float(p.get('costo_receta') or 0)
        costo_botella = float(p.get('costo_botella') or 0)
        familia_prod = p.get('familia') or ''
        es_vino = _es_vino(familia_prod)
        
        # Calcular margen actual
        margen_monto = precio_actual - costo_receta if precio_actual > 0 and costo_receta > 0 else 0
        margen_porcentaje = (margen_monto / precio_actual * 100) if precio_actual > 0 else 0
        
        # Inicializar valores
        precio_sugerido = None
        fuente_sugerencia = FuenteSugerencia.SIN_DATOS.value
        rango_aplicado = None
        multiplicador = None
        confianza_ia = None
        regla_aplicada = None
        
        # Calcular precio sugerido según tipo
        if es_vino:
            # VINOS: Usar VINOS_RANGOS
            costo_base = costo_botella if costo_botella > 0 else costo_receta
            if costo_base > 0:
                precio_sugerido, rango_aplicado, multiplicador = _calcular_precio_vino(costo_base, rangos_vinos)
                if precio_sugerido:
                    fuente_sugerencia = FuenteSugerencia.VINOS_RANGOS.value
                    regla_aplicada = "VINOS_RANGOS_MX"
                else:
                    fuente_sugerencia = FuenteSugerencia.SIN_DATOS.value
                    rango_aplicado = "COSTO_FUERA_DE_RANGOS"
        else:
            # NO VINOS: Usar COSTO_MARGEN
            if costo_receta > 0 and margen_objetivo > 0 and margen_objetivo < 1:
                # precio = costo / (1 - margen)
                precio_minimo = costo_receta / (1 - margen_objetivo)
                # Redondear a múltiplo de 5
                precio_sugerido = round(precio_minimo / 5) * 5
                fuente_sugerencia = FuenteSugerencia.COSTO_MARGEN.value
                regla_aplicada = f"MARGEN_{int(margen_objetivo*100)}%"
            elif costo_receta <= 0:
                fuente_sugerencia = FuenteSugerencia.SIN_DATOS.value
        
        # Calcular diferencias
        diferencia_monto = None
        diferencia_porcentaje = None
        if precio_sugerido and precio_actual > 0:
            diferencia_monto = precio_sugerido - precio_actual
            diferencia_porcentaje = (diferencia_monto / precio_actual * 100)
        
        # Determinar estado de revisión
        if precio_sugerido is None:
            estado_revision = EstadoRevision.SIN_DATOS.value
        elif precio_actual <= 0:
            estado_revision = EstadoRevision.PRECIO_NEGATIVO.value
        elif diferencia_porcentaje is not None:
            if abs(diferencia_porcentaje) <= 5:
                estado_revision = EstadoRevision.DENTRO_RANGO.value
            elif abs(diferencia_porcentaje) <= 15:
                estado_revision = EstadoRevision.REQUIERE_REVISION.value
            else:
                estado_revision = EstadoRevision.FUERA_RANGO.value
        else:
            estado_revision = EstadoRevision.REQUIERE_REVISION.value
        
        # Aplicar filtros de fuente/estado si corresponde
        if fuente and fuente_sugerencia != fuente:
            continue
        if solo_fuera_rango and estado_revision != EstadoRevision.FUERA_RANGO.value:
            continue
        if solo_requiere_revision and estado_revision != EstadoRevision.REQUIERE_REVISION.value:
            continue
        
        producto = {
            'producto_id': p.get('producto_id'),
            'clave': p.get('clave'),
            'nombre': p.get('nombre'),
            'familia': familia_prod,
            'subfamilia': p.get('subfamilia'),
            'unidad': p.get('unidad'),
            'precio_actual': precio_actual,
            'costo_receta': costo_receta,
            'margen_monto': round(margen_monto, 2),
            'margen_porcentaje': round(margen_porcentaje, 2),
            'precio_sugerido': round(precio_sugerido, 2) if precio_sugerido else None,
            'fuente_sugerencia': fuente_sugerencia,
            'diferencia_monto': round(diferencia_monto, 2) if diferencia_monto else None,
            'diferencia_porcentaje': round(diferencia_porcentaje, 2) if diferencia_porcentaje else None,
            'estado_revision': estado_revision,
            'confianza_ia': confianza_ia,
            'requiere_revision_humana': estado_revision in [EstadoRevision.FUERA_RANGO.value, EstadoRevision.REQUIERE_REVISION.value],
            'regla_aplicada': regla_aplicada,
            'rango_vinos_aplicado': rango_aplicado,
            'multiplicador': multiplicador,
            'es_vino': es_vino,
            'tiene_receta': p.get('tiene_receta'),
            'server_id': p.get('server_id'),
            'ultima_actualizacion': datetime.now().isoformat(),
            # BUG-COSTOS-001-R2: Campo activo para badges en UI
            'activo': bool(p.get('Activo', 1))
        }
        
        productos.append(producto)
    
    return {
        'success': True,
        'productos': productos,
        'total': total,
        'page': page,
        'page_size': page_size,
        'total_pages': (total + page_size - 1) // page_size,
        'rangos_vinos_configurados': len(rangos_vinos),
        'margen_objetivo_usado': margen_objetivo,
        'fuente': 'EDARSAHUB_SQL'
    }


