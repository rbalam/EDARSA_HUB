    @staticmethod
    def convertir_lead(
        lead_id: UUID,
        crear_cuenta: bool,
        crear_contacto: bool,
        crear_oportunidad: bool,
        nombre_oportunidad: Optional[str],
        monto_estimado: Optional[float],
        pipeline_id: Optional[int],
        user_id: UUID
    ) -> Dict[str, Any]:
        """
        Convierte un Lead a Cuenta/Contacto/Oportunidad.
        Retorna IDs de entidades creadas.
        """
        conn = get_connection()
        try:
            cursor = conn.cursor(as_dict=True)
            now = now_mexico()
            
            # Obtener Lead
            cursor.execute("""
                SELECT * FROM CRM_Leads WHERE LeadID = %s AND Activo = 1
            """, (str(lead_id),))
            lead = cursor.fetchone()
            if not lead:
                raise ValueError("Lead no encontrado")
            
            if lead.get('ConvertidoACuenta'):
                raise ValueError("Lead ya fue convertido")
            
            result = {
                'lead_id': lead_id,
                'cuenta_id': None,
                'contacto_id': None,
                'oportunidad_id': None
            }
            
            cuenta_id = None
            
            # Crear Cuenta si se solicita
            if crear_cuenta and lead.get('NombreEmpresa'):
                # Verificar si ya existe cuenta con mismo nombre
                cursor.execute("""
                    SELECT ClienteID FROM Cliente_Catalogo 
                    WHERE RazonSocial = %s OR NombreComercial = %s
                """, (lead['NombreEmpresa'], lead['NombreEmpresa']))
                existing = cursor.fetchone()
                
                if existing:
                    cuenta_id = existing['ClienteID']
                    logger.info(f"[CRM] Cuenta existente encontrada: {cuenta_id}")
                else:
                    # Crear nueva cuenta en Cliente_Catalogo
                    cursor.execute("""
                        INSERT INTO Cliente_Catalogo (
                            EmpresaID, RazonSocial, NombreComercial,
                            EmailPrincipal, TelefonoPrincipal, EsProspecto,
                            FechaAlta, Activo, CreatedBy, CreatedAt
                        )
                        OUTPUT INSERTED.ClienteID
                        VALUES (%s, %s, %s, %s, %s, 0, %s, 1, %s, %s)
                    """, (
                        str(lead['EmpresaID']),
                        lead['NombreEmpresa'],
                        lead['NombreEmpresa'],
                        lead.get('Email'),
                        lead.get('Telefono'),
                        now, str(user_id), now
                    ))
                    new_cuenta = cursor.fetchone()
                    cuenta_id = new_cuenta['ClienteID']
                    logger.info(f"[CRM] Cuenta creada: {cuenta_id}")
                
                result['cuenta_id'] = cuenta_id
            
            # Crear Contacto si se solicita
            if crear_contacto and cuenta_id:
                cursor.execute("""
                    INSERT INTO Cliente_Contactos (
                        ClienteID, Nombre, ApellidoPaterno, ApellidoMaterno,
                        Email, Telefono, Celular, Puesto,
                        EsPrincipal, Activo, CreatedBy, CreatedAt
                    )
                    OUTPUT INSERTED.ContactoID
                    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, 1, 1, %s, %s)
                """, (
                    str(cuenta_id),
                    lead['NombreContacto'],
                    lead.get('ApellidoPaterno'),
                    lead.get('ApellidoMaterno'),
                    lead.get('Email'),
                    lead.get('Telefono'),
                    lead.get('TelefonoMovil'),
                    lead.get('Puesto'),
                    str(user_id), now
                ))
                new_contacto = cursor.fetchone()
                result['contacto_id'] = new_contacto['ContactoID']
                logger.info(f"[CRM] Contacto creado: {result['contacto_id']}")
            
            # Crear Oportunidad si se solicita
            if crear_oportunidad:
                opp_data = {
                    'empresa_id': lead['EmpresaID'],
                    'sucursal_id': lead.get('SucursalID'),
                    'cuenta_id': cuenta_id,
                    'contacto_principal_id': result.get('contacto_id'),
                    'lead_origen_id': lead_id,
                    'nombre_oportunidad': nombre_oportunidad or f"Oportunidad - {lead.get('NombreEmpresa', lead['NombreContacto'])}",
                    'monto_estimado': monto_estimado or lead.get('Presupuesto'),
                    'fecha_estimada_cierre': lead.get('FechaEstimadaCierre'),
                    'pipeline_id': pipeline_id or 1,
                    'etapa_actual_id': 1,
                    'ejecutivo_responsable_user_id': lead.get('EjecutivoAsignadoUserID'),
                    'descripcion_oportunidad': lead.get('Descripcion')
                }
                
                # Usar el repositorio para crear oportunidad
                # Nota: hacemos commit parcial aquí para obtener el ID
                conn.commit()
                opp = OportunidadesRepository.crear(opp_data, user_id)
                result['oportunidad_id'] = opp['oportunidad_id']
                logger.info(f"[CRM] Oportunidad creada: {result['oportunidad_id']}")
                
                # Reconectar para actualizar lead
                conn = get_connection()
                cursor = conn.cursor()
            
            # Marcar Lead como convertido
            cursor.execute("""
                UPDATE CRM_Leads
                SET ConvertidoACuenta = 1,
                    CuentaConvertidaID = %s,
                    ContactoConvertidoID = %s,
                    OportunidadConvertidaID = %s,
                    FechaConversion = %s,
                    EstatusLeadID = (SELECT EstatusID FROM CRM_Cat_EstatusLead WHERE Codigo = 'CONVERTIDO'),
                    UpdatedBy = %s,
                    UpdatedAt = %s
                WHERE LeadID = %s
            """, (
                str(cuenta_id) if cuenta_id else None,
                str(result.get('contacto_id')) if result.get('contacto_id') else None,
                str(result.get('oportunidad_id')) if result.get('oportunidad_id') else None,
                now, str(user_id), now, str(lead_id)
            ))
            
            conn.commit()
            logger.info(f"[CRM] Lead {lead_id} convertido exitosamente")
            return result
            
        except Exception as e:
            conn.rollback()
            logger.error(f"[CRM] Error convirtiendo lead: {e}")
            raise
        finally:
            conn.close()
    
