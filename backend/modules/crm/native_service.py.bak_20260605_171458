    # ==================== DASHBOARD / KPIs ====================
    
    @staticmethod
    def obtener_dashboard(empresa_id: UUID) -> Dict[str, Any]:
        """Obtiene métricas del dashboard CRM"""
        conn = get_connection()
        try:
            cursor = conn.cursor(as_dict=True)
            now = now_mexico()
            
            # KPIs de Leads
            cursor.execute("""
                SELECT 
                    COUNT(*) as total,
                    SUM(CASE WHEN MONTH(CreatedAt) = MONTH(%s) AND YEAR(CreatedAt) = YEAR(%s) THEN 1 ELSE 0 END) as nuevos_mes,
                    SUM(CASE WHEN ConvertidoACuenta = 1 THEN 1 ELSE 0 END) as convertidos
                FROM CRM_Leads
                WHERE EmpresaID = %s AND Activo = 1
            """, (now, now, str(empresa_id)))
            leads_stats = cursor.fetchone()
            
            # Leads por estatus
            cursor.execute("""
                SELECT e.Nombre, e.ColorHex, COUNT(l.LeadID) as count
                FROM CRM_Cat_EstatusLead e
                LEFT JOIN CRM_Leads l ON e.EstatusID = l.EstatusLeadID 
                    AND l.EmpresaID = %s AND l.Activo = 1
                WHERE e.Activo = 1
                GROUP BY e.EstatusID, e.Nombre, e.ColorHex, e.Orden
                ORDER BY e.Orden
            """, (str(empresa_id),))
            leads_por_estatus = [dict(r) for r in cursor.fetchall()]
            
            # KPIs de Oportunidades
            cursor.execute("""
                SELECT 
                    COUNT(*) as total,
                    SUM(CASE WHEN EstatusOportunidadID = 1 THEN 1 ELSE 0 END) as abiertas,
                    SUM(CASE WHEN EstatusOportunidadID = 1 THEN ISNULL(MontoEstimado, 0) ELSE 0 END) as monto_pipeline,
                    SUM(CASE WHEN EstatusOportunidadID = 1 THEN ISNULL(MontoEstimado, 0) * ProbabilidadActual / 100.0 ELSE 0 END) as monto_ponderado
                FROM CRM_Oportunidades
                WHERE EmpresaID = %s AND Activo = 1
            """, (str(empresa_id),))
            opp_stats = cursor.fetchone()
            
            # Oportunidades por etapa (pipeline default)
            cursor.execute("""
                SELECT e.Nombre, e.ColorHex, 
                       COUNT(o.OportunidadID) as count,
                       SUM(ISNULL(o.MontoEstimado, 0)) as monto
                FROM CRM_Config_PipelineEtapas e
                JOIN CRM_Config_Pipelines p ON e.PipelineID = p.PipelineID AND p.EsDefault = 1
                LEFT JOIN CRM_Oportunidades o ON e.EtapaID = o.EtapaActualID 
                    AND o.EmpresaID = %s AND o.Activo = 1 AND o.EstatusOportunidadID = 1
                WHERE e.Activo = 1
                GROUP BY e.EtapaID, e.Nombre, e.ColorHex, e.Orden
                ORDER BY e.Orden
            """, (str(empresa_id),))
            opp_por_etapa = [dict(r) for r in cursor.fetchall()]
            
            # Actividad reciente (últimos 10 cambios)
            cursor.execute("""
                SELECT TOP 10
                    h.FechaCambio,
                    o.FolioOportunidad,
                    o.NombreOportunidad,
                    ea.Nombre as EtapaAnterior,
                    en.Nombre as EtapaNueva,
                    CONCAT(u.Nombre, ' ', u.Apellidos) as Usuario
                FROM CRM_Oportunidades_HistorialEtapas h
                JOIN CRM_Oportunidades o ON h.OportunidadID = o.OportunidadID
                LEFT JOIN CRM_Config_PipelineEtapas ea ON h.EtapaAnteriorID = ea.EtapaID
                LEFT JOIN CRM_Config_PipelineEtapas en ON h.EtapaNuevaID = en.EtapaID
                LEFT JOIN Usuario_Catalogo u ON h.CambiadoPor = u.PublicUUID
                WHERE o.EmpresaID = %s
                ORDER BY h.FechaCambio DESC
            """, (str(empresa_id),))
            actividad = [dict(r) for r in cursor.fetchall()]
            
            # Tasa de conversión
            tasa_conversion = 0
            if leads_stats['total'] > 0:
                tasa_conversion = round((leads_stats['convertidos'] / leads_stats['total']) * 100, 1)
            
            return {
                'leads': {
                    'total': leads_stats['total'],
                    'nuevos_mes': leads_stats['nuevos_mes'],
                    'convertidos': leads_stats['convertidos'],
                    'por_estatus': leads_por_estatus
                },
                'oportunidades': {
                    'total': opp_stats['total'],
                    'abiertas': opp_stats['abiertas'],
                    'monto_pipeline': float(opp_stats['monto_pipeline'] or 0),
                    'monto_ponderado': float(opp_stats['monto_ponderado'] or 0),
                    'por_etapa': opp_por_etapa
                },
                'conversion': {
                    'leads_convertidos': leads_stats['convertidos'],
                    'tasa_conversion': tasa_conversion
                },
                'actividad_reciente': actividad,
                'generado_at': now.isoformat()
            }
            
        finally:
            conn.close()
