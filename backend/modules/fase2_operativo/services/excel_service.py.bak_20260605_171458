from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Servicio de Generación de Excel
CAB-003 | EDARSA HUB - Fase 2B.2

Genera archivos Excel con el detalle completo de un workflow.
Consume datos desde DocumentDataService (fuente única).
"""
from typing import Dict, Any
from datetime import datetime, timezone
from io import BytesIO
import logging

from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

from .document_data_service import (
    DocumentDataService, 
    get_document_data_service,
    WorkflowNoEncontradoError
)

logger = logging.getLogger(__name__)


class ExcelServiceError(Exception):
    """Excepción base para errores del servicio Excel."""
    pass


class ExcelService:
    """
    Servicio para generar archivos Excel de workflows.
    
    Genera un libro con 4 hojas:
    1. Resumen - Información ejecutiva del workflow
    2. Diferencias - Detalle de todas las diferencias
    3. Justificaciones - Registro de justificaciones
    4. Auditoria - Historial de decisiones de auditoría
    """
    
    # Estilos predefinidos
    HEADER_FILL = PatternFill(start_color="1E40AF", end_color="1E40AF", fill_type="solid")
    HEADER_FONT = Font(bold=True, color="FFFFFF", size=11)
    TITLE_FONT = Font(bold=True, size=14, color="1E40AF")
    SUBTITLE_FONT = Font(bold=True, size=11, color="475569")
    VALUE_FONT = Font(size=10)
    MONEY_POSITIVE = Font(size=10, color="16A34A")  # Verde
    MONEY_NEGATIVE = Font(size=10, color="DC2626")  # Rojo
    
    THIN_BORDER = Border(
        left=Side(style='thin'),
        right=Side(style='thin'),
        top=Side(style='thin'),
        bottom=Side(style='thin')
    )
    
    ALT_ROW_FILL = PatternFill(start_color="F1F5F9", end_color="F1F5F9", fill_type="solid")
    
    def __init__(self, db):
        """
        Inicializa el servicio.
        
        Args:
            db: Conexión a la base de datos
        """
        self.data_service = get_document_data_service(db)
    
    async def generar_excel_workflow(self, workflow_id: str) -> BytesIO:
        """
        Genera un archivo Excel completo para un workflow.
        
        Args:
            workflow_id: ID del workflow
            
        Returns:
            BytesIO con el contenido del archivo Excel
            
        Raises:
            WorkflowNoEncontradoError: Si el workflow no existe
        """
        logger.info(f"Generando Excel para workflow: {workflow_id}")
        
        # Obtener todos los datos
        datos = await self.data_service.obtener_datos_completos_workflow(workflow_id)
        
        # Crear libro
        wb = Workbook()
        
        # Eliminar hoja por defecto
        if "Sheet" in wb.sheetnames:
            del wb["Sheet"]
        
        # Crear las 4 hojas
        self._crear_hoja_resumen(wb, datos)
        self._crear_hoja_diferencias(wb, datos)
        self._crear_hoja_justificaciones(wb, datos)
        self._crear_hoja_auditoria(wb, datos)
        
        # Guardar en BytesIO
        output = BytesIO()
        wb.save(output)
        output.seek(0)
        
        logger.info(f"Excel generado exitosamente para workflow: {workflow_id}")
        
        return output
    
    def _crear_hoja_resumen(self, wb: Workbook, datos: Dict[str, Any]):
        """
        Crea la hoja de Resumen ejecutivo.
        
        Args:
            wb: Libro de trabajo
            datos: Datos completos del workflow
        """
        ws = wb.create_sheet("Resumen", 0)
        resumen = datos["resumen"]
        metricas = resumen["metricas"]
        
        # Configurar anchos de columna
        ws.column_dimensions['A'].width = 30
        ws.column_dimensions['B'].width = 35
        ws.column_dimensions['C'].width = 5
        ws.column_dimensions['D'].width = 30
        ws.column_dimensions['E'].width = 35
        
        row = 1
        
        # Título
        ws.merge_cells(f'A{row}:E{row}')
        cell = ws[f'A{row}']
        cell.value = "REPORTE DE WORKFLOW DE INVENTARIO"
        cell.font = self.TITLE_FONT
        cell.alignment = Alignment(horizontal='center')
        row += 2
        
        # Información general
        ws[f'A{row}'] = "INFORMACIÓN GENERAL"
        ws[f'A{row}'].font = self.SUBTITLE_FONT
        row += 1
        
        info_general = [
            ("Workflow ID:", resumen.get("workflow_id", "N/A")),
            ("Procesado ID:", resumen.get("procesado_id", "N/A")),
            ("Sucursal ID:", resumen.get("sucursal_id", "N/A")),
            ("Estado:", resumen.get("estado_workflow", "N/A")),
            ("Ciclo Actual:", resumen.get("ciclo_actual", 1)),
            ("Fecha Creación:", self._formatear_fecha(resumen.get("fecha_creacion"))),
            ("Última Actualización:", self._formatear_fecha(resumen.get("fecha_ultima_actualizacion"))),
        ]
        
        for label, value in info_general:
            ws[f'A{row}'] = label
            ws[f'A{row}'].font = Font(bold=True)
            ws[f'B{row}'] = value
            row += 1
        
        row += 1
        
        # Métricas de diferencias
        ws[f'A{row}'] = "MÉTRICAS DE DIFERENCIAS"
        ws[f'A{row}'].font = self.SUBTITLE_FONT
        ws[f'D{row}'] = "ESTADO DE TAREAS"
        ws[f'D{row}'].font = self.SUBTITLE_FONT
        row += 1
        
        metricas_dif = [
            ("Total Diferencias:", metricas.get("total_diferencias", 0)),
            ("Productos Faltantes:", metricas.get("productos_faltantes", 0)),
            ("Productos Sobrantes:", metricas.get("productos_sobrantes", 0)),
            ("Diferencias Justificadas:", metricas.get("diferencias_justificadas", 0)),
            ("Diferencias Pendientes:", metricas.get("diferencias_pendientes", 0)),
        ]
        
        metricas_tareas = [
            ("Total Tareas:", metricas.get("total_tareas", 0)),
            ("Completadas:", metricas.get("tareas_completadas", 0)),
            ("Pendientes:", metricas.get("tareas_pendientes", 0)),
        ]
        
        for i, (label, value) in enumerate(metricas_dif):
            ws[f'A{row + i}'] = label
            ws[f'A{row + i}'].font = Font(bold=True)
            ws[f'B{row + i}'] = value
        
        for i, (label, value) in enumerate(metricas_tareas):
            ws[f'D{row + i}'] = label
            ws[f'D{row + i}'].font = Font(bold=True)
            ws[f'E{row + i}'] = value
        
        row += max(len(metricas_dif), len(metricas_tareas)) + 1
        
        # Valor total
        ws[f'A{row}'] = "VALOR TOTAL DIFERENCIA:"
        ws[f'A{row}'].font = Font(bold=True, size=12)
        valor = metricas.get("valor_total_diferencia", 0)
        ws[f'B{row}'] = f"${valor:,.2f}"
        ws[f'B{row}'].font = self.MONEY_NEGATIVE if valor < 0 else self.MONEY_POSITIVE
        ws[f'B{row}'].font = Font(bold=True, size=12, color="DC2626" if valor < 0 else "16A34A")
        
        row += 2
        
        # Estado de auditoría
        auditoria = resumen.get("auditoria", {})
        ws[f'A{row}'] = "ESTADO DE AUDITORÍA"
        ws[f'A{row}'].font = self.SUBTITLE_FONT
        row += 1
        
        if auditoria.get("tiene_decision"):
            ws[f'A{row}'] = "Última Decisión:"
            ws[f'B{row}'] = auditoria.get("ultima_decision", "N/A")
            row += 1
            ws[f'A{row}'] = "Fecha Decisión:"
            ws[f'B{row}'] = self._formatear_fecha(auditoria.get("fecha_ultima_decision"))
            row += 1
            ws[f'A{row}'] = "Auditor:"
            ws[f'B{row}'] = auditoria.get("auditor", "N/A")
        else:
            ws[f'A{row}'] = "Sin decisiones de auditoría registradas"
        
        row += 2
        
        # Metadata
        ws[f'A{row}'] = f"Generado: {datos['metadata']['fecha_generacion']}"
        ws[f'A{row}'].font = Font(size=9, italic=True, color="94A3B8")
    
    def _crear_hoja_diferencias(self, wb: Workbook, datos: Dict[str, Any]):
        """
        Crea la hoja de Diferencias.
        
        Args:
            wb: Libro de trabajo
            datos: Datos completos del workflow
        """
        ws = wb.create_sheet("Diferencias", 1)
        diferencias = datos["diferencias"]
        
        # Headers
        headers = [
            "ID", "Producto ID", "Descripción", "Unidad",
            "Cant. Sistema", "Cant. Física", "Diferencia",
            "Precio Unit.", "Valor Diferencia",
            "Justificada", "Tipo Justificación", "Motivo"
        ]
        
        # Anchos de columna
        column_widths = [15, 15, 35, 10, 12, 12, 12, 14, 16, 12, 18, 40]
        
        for i, width in enumerate(column_widths, 1):
            ws.column_dimensions[get_column_letter(i)].width = width
        
        # Escribir headers
        for col, header in enumerate(headers, 1):
            cell = ws.cell(row=1, column=col, value=header)
            cell.font = self.HEADER_FONT
            cell.fill = self.HEADER_FILL
            cell.alignment = Alignment(horizontal='center')
            cell.border = self.THIN_BORDER
        
        # Escribir datos
        for row_num, dif in enumerate(diferencias, 2):
            # Mapear campos de la DB a las columnas del Excel
            row_data = [
                dif.get("id", ""),
                dif.get("codigo_producto", dif.get("producto_id", "")),
                dif.get("nombre_producto", dif.get("descripcion_producto", "")),
                dif.get("unidad", dif.get("unidad_medida", "")),
                dif.get("inv_teorico_cantidad", dif.get("cantidad_sistema", 0)),
                dif.get("inv_final_cantidad", dif.get("cantidad_fisica", 0)),
                dif.get("diferencia_cantidad", 0),
                dif.get("costo_unitario", dif.get("precio_unitario", 0)),
                dif.get("diferencia_costo", dif.get("diferencia_valor", 0)),
                "Sí" if dif.get("tiene_justificacion") else "No",
                dif.get("tipo_justificacion", "") or "",
                dif.get("motivo_justificacion", "") or ""
            ]
            
            for col, value in enumerate(row_data, 1):
                cell = ws.cell(row=row_num, column=col, value=value)
                cell.border = self.THIN_BORDER
                
                # Alternar color de fila
                if row_num % 2 == 0:
                    cell.fill = self.ALT_ROW_FILL
                
                # Formato especial para columnas de dinero
                if col in [8, 9]:  # Precio y Valor
                    if isinstance(value, (int, float)):
                        cell.number_format = '$#,##0.00'
                        if col == 9:  # Valor diferencia
                            cell.font = self.MONEY_NEGATIVE if value < 0 else self.MONEY_POSITIVE
                
                # Formato para cantidades
                if col in [5, 6, 7]:
                    cell.alignment = Alignment(horizontal='right')
        
        # Congelar primera fila
        ws.freeze_panes = "A2"
    
    def _crear_hoja_justificaciones(self, wb: Workbook, datos: Dict[str, Any]):
        """
        Crea la hoja de Justificaciones.
        
        Args:
            wb: Libro de trabajo
            datos: Datos completos del workflow
        """
        ws = wb.create_sheet("Justificaciones", 2)
        justificaciones = datos["justificaciones"]
        
        # Headers
        headers = [
            "ID", "Diferencia ID", "Tipo", "Motivo",
            "Descripción Detallada", "Evidencia",
            "Usuario", "Fecha Justificación"
        ]
        
        # Anchos de columna
        column_widths = [15, 15, 12, 25, 50, 20, 20, 22]
        
        for i, width in enumerate(column_widths, 1):
            ws.column_dimensions[get_column_letter(i)].width = width
        
        # Escribir headers
        for col, header in enumerate(headers, 1):
            cell = ws.cell(row=1, column=col, value=header)
            cell.font = self.HEADER_FONT
            cell.fill = self.HEADER_FILL
            cell.alignment = Alignment(horizontal='center')
            cell.border = self.THIN_BORDER
        
        # Escribir datos
        for row_num, just in enumerate(justificaciones, 2):
            row_data = [
                just.get("id", ""),
                just.get("diferencia_id", ""),
                just.get("tipo_justificacion", ""),
                just.get("motivo", ""),
                just.get("descripcion", ""),
                just.get("evidencia_adjunta", "No"),
                just.get("usuario_justificador_id", ""),
                self._formatear_fecha(just.get("fecha_justificacion"))
            ]
            
            for col, value in enumerate(row_data, 1):
                cell = ws.cell(row=row_num, column=col, value=value)
                cell.border = self.THIN_BORDER
                cell.alignment = Alignment(wrap_text=True, vertical='top')
                
                if row_num % 2 == 0:
                    cell.fill = self.ALT_ROW_FILL
        
        # Congelar primera fila
        ws.freeze_panes = "A2"
    
    def _crear_hoja_auditoria(self, wb: Workbook, datos: Dict[str, Any]):
        """
        Crea la hoja de Auditoría.
        
        Args:
            wb: Libro de trabajo
            datos: Datos completos del workflow
        """
        ws = wb.create_sheet("Auditoria", 3)
        auditoria = datos["auditoria"]
        
        # Headers
        headers = [
            "ID", "Decisión", "Comentarios",
            "Auditor", "Fecha Decisión"
        ]
        
        # Anchos de columna
        column_widths = [15, 20, 60, 20, 22]
        
        for i, width in enumerate(column_widths, 1):
            ws.column_dimensions[get_column_letter(i)].width = width
        
        # Escribir headers
        for col, header in enumerate(headers, 1):
            cell = ws.cell(row=1, column=col, value=header)
            cell.font = self.HEADER_FONT
            cell.fill = self.HEADER_FILL
            cell.alignment = Alignment(horizontal='center')
            cell.border = self.THIN_BORDER
        
        # Escribir datos
        for row_num, aud in enumerate(auditoria, 2):
            row_data = [
                aud.get("id", ""),
                aud.get("decision", ""),
                aud.get("comentarios", ""),
                aud.get("usuario_auditor_id", ""),
                self._formatear_fecha(aud.get("fecha_decision"))
            ]
            
            for col, value in enumerate(row_data, 1):
                cell = ws.cell(row=row_num, column=col, value=value)
                cell.border = self.THIN_BORDER
                cell.alignment = Alignment(wrap_text=True, vertical='top')
                
                if row_num % 2 == 0:
                    cell.fill = self.ALT_ROW_FILL
                
                # Color para decisión
                if col == 2:
                    if value == "APROBADO":
                        cell.font = Font(bold=True, color="16A34A")
                    elif value == "RECHAZADO":
                        cell.font = Font(bold=True, color="DC2626")
                    elif value == "DEVUELTO_PARA_CORRECCION":
                        cell.font = Font(bold=True, color="D97706")
        
        # Congelar primera fila
        ws.freeze_panes = "A2"
        
        # Si no hay datos de auditoría, agregar mensaje
        if not auditoria:
            ws.cell(row=2, column=1, value="Sin decisiones de auditoría registradas")
            ws.merge_cells('A2:E2')
    
    def _formatear_fecha(self, fecha_str: str) -> str:
        """
        Formatea una fecha ISO a formato legible.
        
        Args:
            fecha_str: Fecha en formato ISO
            
        Returns:
            Fecha formateada o "N/A"
        """
        if not fecha_str:
            return "N/A"
        
        try:
            # Parsear fecha ISO
            if isinstance(fecha_str, str):
                fecha = datetime.fromisoformat(fecha_str.replace("Z", "+00:00"))
                return fecha.strftime("%Y-%m-%d %H:%M")
            return str(fecha_str)
        except Exception:
            return str(fecha_str)


# Singleton del servicio
_excel_service = None


def get_excel_service(db) -> ExcelService:
    """
    Obtiene instancia del servicio de Excel.
    
    Args:
        db: Conexión a la base de datos
        
    Returns:
        Instancia de ExcelService
    """
    global _excel_service
    if _excel_service is None:
        _excel_service = ExcelService(db)
    return _excel_service
