from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Servicio de Datos para Documentos - Fuente Única de Verdad
CAB-003 | EDARSA HUB - Fase 2B.2

Este servicio centraliza la obtención de datos para la generación
de documentos (Excel, PDF). Evita duplicación de lógica.
"""
from typing import Optional, Dict, List, Any
from datetime import datetime, timezone
import logging

from ..repositories.workflow_repository import WorkflowRepository
from ..repositories.detalle_diferencias_repository import DetalleDiferenciasRepository
from ..repositories.justificacion_repository import JustificacionRepository
from ..repositories.auditoria_repository import AuditoriaRepository
from ..repositories.tarea_repository import TareaRepository

logger = logging.getLogger(__name__)


class DocumentDataServiceError(Exception):
    """Excepción base para errores del servicio de datos."""
    pass


class WorkflowNoEncontradoError(DocumentDataServiceError):
    """El workflow solicitado no existe."""
    pass


class DocumentDataService:
    """
    Servicio que centraliza la obtención de todos los datos 
    necesarios para generar documentos de un workflow.
    
    Es la ÚNICA fuente de datos para Excel y PDF.
    
    MIGRACIÓN SQL SERVER (Mayo 2026):
    - Operaciones de MongoDB pasan por StubDatabase sin fallar
    """
    
    def __init__(self, db):
        """
        Inicializa el servicio con conexión a BD.
        
        Args:
            db: Instancia de la base de datos MongoDB
        """
        self.db = db
        self._is_stub = self._check_is_stub(db)
        self.workflow_repo = WorkflowRepository(db)
        self.detalle_repo = DetalleDiferenciasRepository(db)
        self.justificacion_repo = JustificacionRepository(db)
        self.auditoria_repo = AuditoriaRepository(db)
        self.tarea_repo = TareaRepository(db)
    
    def _check_is_stub(self, db) -> bool:
        """Verifica si estamos usando StubDatabase."""
        if db is None:
            return True
        try:
            from core.mongo_stub import StubDatabase
            return isinstance(db, StubDatabase)
        except ImportError:
            return False
    
    async def _obtener_workflow_por_uuid(self, workflow_id: str) -> Optional[Dict]:
        """
        Obtiene un workflow buscando por el campo 'id' (UUID).
        FASE B-P2: SQL-only, sin fallback a MongoDB.
        """
        # FASE B-P2: Usar repositorio SQL
        try:
            from ..repositories.sql_base_repository import SQLBaseRepository
            repo = SQLBaseRepository("workflow_inventarios")
            workflow = repo.find_one({"id": workflow_id})
            return workflow
        except Exception as e:
            logger.error(f"Error buscando workflow en SQL: {e}")
            return None
    
    async def obtener_datos_completos_workflow(
        self, 
        workflow_id: str
    ) -> Dict[str, Any]:
        """
        Obtiene TODOS los datos necesarios para generar documentos
        de un workflow específico.
        
        Args:
            workflow_id: ID del workflow
            
        Returns:
            Dict con todas las secciones de datos:
            - resumen: Información general del workflow
            - diferencias: Lista de diferencias de inventario
            - justificaciones: Lista de justificaciones registradas
            - auditoria: Lista de decisiones de auditoría
            - tareas: Lista de tareas del workflow
            - historial: Historial de estados
            - metadata: Información de generación
            
        Raises:
            WorkflowNoEncontradoError: Si el workflow no existe
        """
        # Obtener workflow base buscando por campo 'id' (UUID)
        workflow = await self._obtener_workflow_por_uuid(workflow_id)
        if not workflow:
            raise WorkflowNoEncontradoError(
                f"Workflow no encontrado: {workflow_id}"
            )
        
        # Obtener datos relacionados
        diferencias = await self.detalle_repo.get_by_workflow(workflow_id)
        justificaciones = await self.justificacion_repo.get_by_workflow(workflow_id)
        decisiones_auditoria = await self.auditoria_repo.get_by_workflow(workflow_id)
        tareas = await self.tarea_repo.get_by_workflow(workflow_id)
        
        # Enriquecer datos del workflow
        resumen = self._construir_resumen(
            workflow, 
            diferencias, 
            justificaciones, 
            decisiones_auditoria,
            tareas
        )
        
        # Enriquecer diferencias con justificaciones
        diferencias_enriquecidas = self._enriquecer_diferencias(
            diferencias, 
            justificaciones
        )
        
        # Construir respuesta completa
        return {
            "resumen": resumen,
            "diferencias": diferencias_enriquecidas,
            "justificaciones": justificaciones,
            "auditoria": decisiones_auditoria,
            "tareas": tareas,
            "metadata": {
                "fecha_generacion": datetime.now(timezone.utc).isoformat(),
                "version": "2B.2",
                "workflow_id": workflow_id
            }
        }
    
    def _construir_resumen(
        self, 
        workflow: Dict,
        diferencias: List[Dict],
        justificaciones: List[Dict],
        auditoria: List[Dict],
        tareas: List[Dict]
    ) -> Dict[str, Any]:
        """
        Construye la sección de resumen ejecutivo.
        
        Args:
            workflow: Datos del workflow
            diferencias: Lista de diferencias
            justificaciones: Lista de justificaciones
            auditoria: Lista de decisiones
            tareas: Lista de tareas
            
        Returns:
            Dict con resumen ejecutivo
        """
        # Calcular métricas de diferencias
        total_diferencias = len(diferencias)
        diferencias_con_justificacion = sum(
            1 for d in diferencias 
            if any(j.get("diferencia_id") == d.get("id") for j in justificaciones)
        )
        
        # Calcular valor total de diferencias (usar diferencia_costo si existe)
        valor_total = sum(
            d.get("diferencia_costo", d.get("diferencia_valor", 0)) or 0 
            for d in diferencias
        )
        
        # Calcular estadísticas por tipo
        faltantes = [d for d in diferencias if (d.get("diferencia_cantidad", 0) or 0) < 0]
        sobrantes = [d for d in diferencias if (d.get("diferencia_cantidad", 0) or 0) > 0]
        
        # Obtener última decisión de auditoría
        ultima_auditoria = auditoria[0] if auditoria else None
        
        # Contar tareas por estado
        tareas_completadas = sum(1 for t in tareas if t.get("estado_tarea") == "COMPLETADA")
        tareas_pendientes = sum(1 for t in tareas if t.get("estado_tarea") in ["PENDIENTE", "EN_PROGRESO"])
        
        return {
            "workflow_id": workflow.get("id"),
            "procesado_id": workflow.get("procesado_id"),
            "estado_workflow": workflow.get("estado_workflow"),
            "sucursal_id": workflow.get("sucursal_id"),
            "ciclo_actual": workflow.get("ciclo_actual", 1),
            "fecha_creacion": workflow.get("fecha_creacion"),
            "fecha_ultima_actualizacion": workflow.get("fecha_ultima_actualizacion"),
            "metricas": {
                "total_diferencias": total_diferencias,
                "diferencias_justificadas": diferencias_con_justificacion,
                "diferencias_pendientes": total_diferencias - diferencias_con_justificacion,
                "valor_total_diferencia": valor_total,
                "productos_faltantes": len(faltantes),
                "productos_sobrantes": len(sobrantes),
                "total_tareas": len(tareas),
                "tareas_completadas": tareas_completadas,
                "tareas_pendientes": tareas_pendientes
            },
            "auditoria": {
                "tiene_decision": ultima_auditoria is not None,
                "ultima_decision": ultima_auditoria.get("decision") if ultima_auditoria else None,
                "fecha_ultima_decision": ultima_auditoria.get("fecha_decision") if ultima_auditoria else None,
                "auditor": ultima_auditoria.get("usuario_auditor_id") if ultima_auditoria else None
            }
        }
    
    def _enriquecer_diferencias(
        self, 
        diferencias: List[Dict],
        justificaciones: List[Dict]
    ) -> List[Dict]:
        """
        Enriquece las diferencias con información de justificación.
        
        Args:
            diferencias: Lista de diferencias
            justificaciones: Lista de justificaciones
            
        Returns:
            Lista de diferencias enriquecidas
        """
        # Crear índice de justificaciones por diferencia_id
        justificaciones_por_diferencia = {}
        for j in justificaciones:
            dif_id = j.get("diferencia_id")
            if dif_id:
                if dif_id not in justificaciones_por_diferencia:
                    justificaciones_por_diferencia[dif_id] = []
                justificaciones_por_diferencia[dif_id].append(j)
        
        # Enriquecer cada diferencia
        resultado = []
        for dif in diferencias:
            dif_id = dif.get("id")
            dif_enriquecida = {**dif}
            
            # Agregar info de justificación
            just_list = justificaciones_por_diferencia.get(dif_id, [])
            dif_enriquecida["justificaciones"] = just_list
            dif_enriquecida["tiene_justificacion"] = len(just_list) > 0
            dif_enriquecida["cantidad_justificaciones"] = len(just_list)
            
            # Calcular estado de justificación
            if just_list:
                # Tomar la última justificación
                ultima = max(just_list, key=lambda x: x.get("fecha_justificacion", ""))
                dif_enriquecida["tipo_justificacion"] = ultima.get("tipo_justificacion")
                dif_enriquecida["motivo_justificacion"] = ultima.get("motivo")
            else:
                dif_enriquecida["tipo_justificacion"] = None
                dif_enriquecida["motivo_justificacion"] = None
            
            resultado.append(dif_enriquecida)
        
        return resultado
    
    async def obtener_resumen_rapido(self, workflow_id: str) -> Dict[str, Any]:
        """
        Obtiene un resumen rápido sin todos los detalles.
        Útil para vistas de lista o dashboards.
        
        Args:
            workflow_id: ID del workflow
            
        Returns:
            Dict con resumen básico
        """
        workflow = await self._obtener_workflow_por_uuid(workflow_id)
        if not workflow:
            raise WorkflowNoEncontradoError(
                f"Workflow no encontrado: {workflow_id}"
            )
        
        total_diferencias = await self.detalle_repo.contar_por_workflow(workflow_id)
        valor_total = await self.detalle_repo.calcular_total_diferencia(workflow_id)
        total_justificaciones = await self.justificacion_repo.contar_por_workflow(workflow_id)
        
        return {
            "workflow_id": workflow_id,
            "estado": workflow.get("estado_workflow"),
            "total_diferencias": total_diferencias,
            "valor_total": valor_total,
            "total_justificaciones": total_justificaciones
        }


# Singleton del servicio
_document_data_service = None


def get_document_data_service(db) -> DocumentDataService:
    """
    Obtiene instancia del servicio de datos de documentos.
    
    Args:
        db: Conexión a la base de datos
        
    Returns:
        Instancia de DocumentDataService
    """
    global _document_data_service
    if _document_data_service is None:
        _document_data_service = DocumentDataService(db)
    return _document_data_service
