"""
Schemas Pydantic para Justificaciones de Inventario
CAB-003 | EDARSA HUB - Fase 2A

Define los modelos de datos para las justificaciones con regla híbrida.
"""
from pydantic import BaseModel, Field, field_validator
from typing import Optional, List, Dict, Any
from datetime import datetime
from .enums import TipoJustificacion


class JustificacionBase(BaseModel):
    """Campos base de una justificación."""
    workflow_id: str = Field(..., description="FK al workflow")
    diferencia_id: str = Field(..., description="FK al detalle de diferencia")
    tipo_justificacion: TipoJustificacion = Field(..., description="SIMPLE o COMPLETA")
    texto_justificacion: str = Field(
        ..., 
        min_length=20, 
        description="Texto de justificación (mínimo 20 caracteres)"
    )
    evidencia_documental: Optional[Dict[str, Any]] = Field(
        None, 
        description="Evidencia (requerida solo para COMPLETA)"
    )
    umbral_aplicado: float = Field(..., description="Snapshot del umbral vigente al momento")


class JustificacionCreate(BaseModel):
    """Schema para crear una justificación."""
    workflow_id: str
    diferencia_id: str
    tipo_justificacion: TipoJustificacion
    texto_justificacion: str = Field(..., min_length=20)
    evidencia_documental: Optional[Dict[str, Any]] = None
    usuario_justificador_id: str = Field(..., description="ID del usuario que justifica")

    @field_validator('evidencia_documental')
    @classmethod
    def validar_evidencia_segun_tipo(cls, v, info):
        """
        Valida que si el tipo es COMPLETA, la evidencia sea obligatoria.
        NOTA: Esta validación se hace de forma segura sin acceso a BD.
        """
        # La validación completa se hará en el service donde se conoce el tipo
        # Aquí solo validamos estructura básica si se proporciona
        if v is not None:
            if not isinstance(v, dict):
                raise ValueError('evidencia_documental debe ser un diccionario')
        return v


class JustificacionInDB(JustificacionBase):
    """Schema de justificación como está almacenada en BD."""
    id: str = Field(..., alias="_id")
    usuario_justificador_id: str
    fecha_justificacion: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class JustificacionResponse(BaseModel):
    """Schema de respuesta para una justificación."""
    id: str = Field(..., alias="_id")
    workflow_id: str
    diferencia_id: str
    tipo_justificacion: TipoJustificacion
    texto_justificacion: str
    evidencia_documental: Optional[Dict[str, Any]] = None
    umbral_aplicado: float
    usuario_justificador_id: str
    fecha_justificacion: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class JustificacionListResponse(BaseModel):
    """Schema de respuesta para lista de justificaciones."""
    total: int
    items: List[JustificacionResponse] = Field(default_factory=list)


class DetalleDiferenciaBase(BaseModel):
    """Campos base de un detalle de diferencia."""
    workflow_id: str = Field(..., description="FK al workflow")
    producto_id: str = Field(..., description="ID del producto")
    descripcion: str = Field(..., description="Descripción del producto")
    cantidad_soft: float = Field(..., description="Cantidad en SOFT")
    cantidad_mpro: float = Field(..., description="Cantidad en MPRO")
    diferencia_cantidad: float = Field(..., description="Diferencia de cantidad")
    diferencia_valor: float = Field(..., description="Diferencia en valor monetario")
    requiere_justificacion_completa: bool = Field(
        ..., 
        description="True si diferencia_valor > umbral"
    )


class DetalleDiferenciaCreate(BaseModel):
    """Schema para crear un detalle de diferencia."""
    workflow_id: str
    producto_id: str
    descripcion: str
    cantidad_soft: float
    cantidad_mpro: float
    diferencia_cantidad: float
    diferencia_valor: float
    requiere_justificacion_completa: bool = False


class DetalleDiferenciaInDB(DetalleDiferenciaBase):
    """Schema de detalle como está almacenado en BD."""
    id: str = Field(..., alias="_id")
    fecha_creacion: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class DetalleDiferenciaResponse(DetalleDiferenciaInDB):
    """Schema de respuesta para detalle de diferencia."""
    pass
