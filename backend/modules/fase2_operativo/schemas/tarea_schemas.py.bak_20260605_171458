from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Schemas Pydantic para Tareas de Inventario
CAB-003 | EDARSA HUB - Fase 2A

Define los modelos de datos para la gestión de tareas.
"""
from pydantic import BaseModel, Field
from typing import Optional, List
from datetime import datetime
from .enums import TipoTarea, EstadoTarea


class TareaBase(BaseModel):
    """Campos base de una tarea."""
    workflow_id: str = Field(..., description="FK al workflow asociado")
    tipo_tarea: TipoTarea = Field(..., description="Tipo de tarea")
    usuario_asignado_id: Optional[str] = Field(None, description="ID del usuario asignado")
    fecha_limite: Optional[datetime] = Field(None, description="Fecha límite para completar")
    es_reasignacion: bool = Field(default=False, description="Indica si es una reasignación")


class TareaCreate(BaseModel):
    """Schema para crear una nueva tarea."""
    workflow_id: str
    tipo_tarea: TipoTarea
    usuario_asignado_id: Optional[str] = None
    fecha_limite: Optional[datetime] = None


class TareaAsignar(BaseModel):
    """Schema para asignar una tarea a un usuario."""
    usuario_asignado_id: str = Field(..., description="ID del usuario a asignar")
    fecha_limite: Optional[datetime] = Field(None, description="Fecha límite opcional")


class TareaReasignar(BaseModel):
    """Schema para reasignar una tarea (motivo obligatorio)."""
    usuario_nuevo_id: str = Field(..., description="ID del nuevo usuario")
    motivo_cambio: str = Field(
        ..., 
        min_length=10, 
        description="Motivo de la reasignación (mínimo 10 caracteres)"
    )


class TareaInDB(TareaBase):
    """Schema de tarea como está almacenada en BD."""
    id: str = Field(..., alias="_id")
    estado_tarea: EstadoTarea = Field(default=EstadoTarea.PENDIENTE)
    fecha_asignacion: Optional[datetime] = None
    fecha_creacion: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class TareaResponse(BaseModel):
    """Schema de respuesta para una tarea."""
    id: str = Field(..., alias="_id")
    workflow_id: str
    tipo_tarea: TipoTarea
    estado_tarea: EstadoTarea
    usuario_asignado_id: Optional[str] = None
    fecha_asignacion: Optional[datetime] = None
    fecha_limite: Optional[datetime] = None
    es_reasignacion: bool
    fecha_creacion: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class TareaListResponse(BaseModel):
    """Schema de respuesta para lista de tareas."""
    total: int
    items: List[TareaResponse] = Field(default_factory=list)


class HistorialAsignacionBase(BaseModel):
    """Campos base del historial de asignaciones."""
    tarea_id: str = Field(..., description="FK a la tarea")
    usuario_anterior_id: Optional[str] = Field(None, description="Usuario anterior (null si es primera asignación)")
    usuario_nuevo_id: str = Field(..., description="Nuevo usuario asignado")
    motivo_cambio: str = Field(..., description="Motivo del cambio")
    cambiado_por_id: str = Field(..., description="Usuario que realizó el cambio")


class HistorialAsignacionCreate(HistorialAsignacionBase):
    """Schema para crear registro de historial."""
    pass


class HistorialAsignacionInDB(HistorialAsignacionBase):
    """Schema de historial como está almacenado en BD."""
    id: str = Field(..., alias="_id")
    fecha_cambio: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class HistorialAsignacionResponse(HistorialAsignacionInDB):
    """Schema de respuesta para historial."""
    pass
