"""
Schemas Pydantic para Workflow de Inventarios
CAB-003 | EDARSA HUB - Fase 2A

Define los modelos de datos para el workflow operativo.
"""
from pydantic import BaseModel, Field
from typing import Optional, List, Any
from datetime import datetime
from .enums import EstadoWorkflow


class WorkflowBase(BaseModel):
    """Campos base de un workflow."""
    procesado_id: str = Field(..., description="FK conceptual a folios_procesados.procesado_id")
    estado_workflow: EstadoWorkflow = Field(
        default=EstadoWorkflow.PENDIENTE_ASIGNACION,
        description="Estado actual del workflow"
    )
    ciclo_actual: int = Field(default=1, ge=1, description="Número de ciclo (reasignaciones)")


class WorkflowCreate(BaseModel):
    """Schema para crear un nuevo workflow."""
    procesado_id: str = Field(..., description="ID del folio procesado en Fase 1")


class WorkflowUpdate(BaseModel):
    """Schema para actualizar un workflow."""
    estado_workflow: Optional[EstadoWorkflow] = None
    ciclo_actual: Optional[int] = Field(None, ge=1)


class WorkflowInDB(WorkflowBase):
    """Schema de workflow como está almacenado en BD."""
    id: str = Field(..., alias="_id", description="ID del documento MongoDB")
    fecha_creacion: datetime
    fecha_ultima_actualizacion: datetime

    class Config:
        populate_by_name = True
        from_attributes = True


class WorkflowResponse(BaseModel):
    """Schema de respuesta para un workflow."""
    id: str = Field(..., alias="_id")
    procesado_id: str
    estado_workflow: EstadoWorkflow
    ciclo_actual: int
    fecha_creacion: datetime
    fecha_ultima_actualizacion: datetime
    # Campos opcionales para cuando se incluyen relaciones
    diferencias: Optional[List[Any]] = None
    tareas: Optional[List[Any]] = None

    class Config:
        populate_by_name = True
        from_attributes = True


class WorkflowListResponse(BaseModel):
    """Schema de respuesta para lista de workflows."""
    total: int = Field(..., description="Total de workflows que coinciden con filtros")
    items: List[WorkflowResponse] = Field(default_factory=list)
