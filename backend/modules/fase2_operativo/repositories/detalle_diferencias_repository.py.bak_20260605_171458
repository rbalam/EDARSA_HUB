from typing import Optional, List, Dict

from .sql_base_repository import SQLBaseRepository


class DetalleDiferenciasRepository(SQLBaseRepository):
    """
    Repository para la tabla Workflow_DetalleDiferencias.
    Migrado de MongoDB a SQL Server EDARSAHUB.
    """
    
    def __init__(self, db=None):
        """
        Inicializa el repository SQL.
        Args:
            db: IGNORADO - Solo para compatibilidad. Todo va a SQL.
        """
        super().__init__("detalle_diferencias")
    
    async def get_by_workflow(self, workflow_id: str) -> List[Dict]:
        """
        Obtiene todos los detalles de diferencia de un workflow.
        """
        cursor = self.find({"workflow_id": workflow_id})
        return list(cursor)
    
    async def get_by_producto(self, producto_id: str) -> List[Dict]:
        """
        Obtiene detalles de diferencia por producto.
        """
        cursor = self.find({"producto_id": producto_id})
        return list(cursor)
    
    async def get_pendientes_justificacion(self, workflow_id: str) -> List[Dict]:
        """
        Obtiene diferencias que requieren justificación completa.
        """
        cursor = self.find({
            "workflow_id": workflow_id,
            "requiere_justificacion_completa": True
        })
        return list(cursor)
    
    async def calcular_total_diferencia(self, workflow_id: str) -> float:
        """
        Calcula el total de diferencia de valor de un workflow.
        """
        pipeline = [
            {"$match": {"workflow_id": workflow_id}},
            {"$group": {"_id": None, "total": {"$sum": "$diferencia_valor"}}}
        ]
        
        result = list(self.aggregate(pipeline))
        return result[0].get("total", 0.0) if result else 0.0
    
    async def contar_por_workflow(self, workflow_id: str) -> int:
        """
        Cuenta el número de diferencias en un workflow.
        """
        return await self.count({"workflow_id": workflow_id})
    
    # Métodos de compatibilidad
    def _serialize_id(self, doc: Optional[Dict]) -> Optional[Dict]:
        """Compatibilidad - No necesario en SQL."""
        return doc
    
    def _serialize_list(self, docs: List[Dict]) -> List[Dict]:
        """Compatibilidad - No necesario en SQL."""
        return docs
