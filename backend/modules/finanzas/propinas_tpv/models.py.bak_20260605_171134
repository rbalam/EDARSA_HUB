from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Modelos Pydantic para el módulo de Control de Propinas TPV
FASE 1 MVP - Solo SoftRestaurant

CAB Aprobado: 2026-04-14
"""

from pydantic import BaseModel, Field
from typing import Optional, List
from datetime import datetime
from enum import Enum


# ============================================================================
# ENUMS
# ============================================================================

class TipoDatoOrigen(str, Enum):
    """Tipo de dato del origen (exacto o estimado)"""
    EXACTO = "EXACTO"
    ESTIMADO = "ESTIMADO"


class EstadoCuadre(str, Enum):
    """Estados del cuadre de propinas"""
    PENDIENTE = "PENDIENTE"           # Sincronizado, sin pago registrado
    PAGADO = "PAGADO"                 # Pago registrado, pendiente validar
    CUADRADO = "CUADRADO"             # Cuadre correcto (diferencia = 0 o dentro de tolerancia)
    DESCUADRE = "DESCUADRE"           # Diferencia fuera de tolerancia
    CON_AJUSTE = "CON_AJUSTE"         # Cuadrado con ajuste manual


class MetodoPago(str, Enum):
    """Métodos de pago de propinas a meseros"""
    EFECTIVO = "EFECTIVO"
    TRANSFERENCIA = "TRANSFERENCIA"
    OTRO = "OTRO"


class TipoAlcanceConfig(str, Enum):
    """Tipos de alcance para configuración"""
    GLOBAL = "GLOBAL"
    EMPRESA = "EMPRESA"
    SUCURSAL = "SUCURSAL"


# ============================================================================
# SCHEMAS DE ORIGEN (Datos leídos de SQL Server)
# ============================================================================

class OrigenDatos(BaseModel):
    """Datos de origen sincronizados desde SQL Server"""
    tipo_dato: TipoDatoOrigen = Field(..., description="EXACTO o ESTIMADO")
    metodo_calculo: str = Field(..., description="Método usado para obtener el dato")
    confianza: float = Field(1.0, ge=0.0, le=1.0, description="Nivel de confianza 0-1")
    
    propinas_totales_corte: float = Field(..., description="Propinas totales del corte")
    ventas_tarjeta: float = Field(0.0, description="Ventas con tarjeta del corte")
    ventas_totales: float = Field(0.0, description="Ventas totales del corte")
    propinas_tpv: float = Field(..., description="Propinas TPV (base para comisión)")
    
    formula_aplicada: str = Field(..., description="Query o fórmula usada")
    fecha_sincronizacion: datetime = Field(default_factory=datetime.utcnow)
    advertencia: Optional[str] = Field(None, description="Advertencia si dato es estimado")


# ============================================================================
# SCHEMAS DE CÁLCULO
# ============================================================================

class CalculoComision(BaseModel):
    """Cálculos de comisión realizados en EDARSA HUB"""
    config_aplicada_id: Optional[str] = Field(None, description="ID de config usada")
    porcentaje_comision: float = Field(0.02, description="Porcentaje aplicado (ej: 0.02 = 2%)")
    comision_calculada: float = Field(..., description="Monto de comisión a retener")
    monto_a_pagar_meseros: float = Field(..., description="Monto neto a pagar")


# ============================================================================
# SCHEMAS DE PAGO
# ============================================================================

class RegistroPago(BaseModel):
    """Registro de pago de propinas a meseros"""
    registrado: bool = Field(False, description="Si se ha registrado pago")
    monto_pagado: Optional[float] = Field(None, description="Monto efectivamente pagado")
    fecha_pago: Optional[datetime] = Field(None, description="Fecha del pago")
    metodo: Optional[MetodoPago] = Field(None, description="Método de pago")
    registrado_por: Optional[str] = Field(None, description="Email del usuario que registró")
    observaciones: Optional[str] = Field(None, description="Notas adicionales")


# ============================================================================
# SCHEMAS DE CUADRE
# ============================================================================

class EstadoCuadreInfo(BaseModel):
    """Información del estado de cuadre"""
    estado: EstadoCuadre = Field(EstadoCuadre.PENDIENTE)
    diferencia: Optional[float] = Field(None, description="Diferencia detectada")
    fecha_cuadre: Optional[datetime] = Field(None)
    observaciones: Optional[str] = Field(None)


# ============================================================================
# SCHEMA PRINCIPAL: propinas_control
# ============================================================================

class PropinasControlBase(BaseModel):
    """Schema base para documento de control de propinas"""
    # Llave única (4 campos)
    server_id: str = Field(..., description="ID del servidor en EDARSA HUB")
    sucursal_id: str = Field(..., description="ID de sucursal")
    folio_corte: str = Field(..., description="Folio del corte Z")
    fecha_corte: datetime = Field(..., description="Fecha del corte")
    
    # Contexto
    server_name: str = Field(..., description="Nombre del servidor")
    system_type: str = Field("SoftRestaurant", description="Tipo de sistema origen")
    sucursal_nombre: str = Field(..., description="Nombre de sucursal")
    empresa_id: Optional[str] = Field(None, description="ID de empresa (para config)")


class PropinasControlCreate(PropinasControlBase):
    """Schema para crear un nuevo registro de propinas"""
    origen: OrigenDatos
    calculo: CalculoComision


class PropinasControlInDB(PropinasControlBase):
    """Schema completo del documento en MongoDB"""
    id: str = Field(..., description="UUID del documento")
    origen: OrigenDatos
    calculo: CalculoComision
    pago: RegistroPago = Field(default_factory=RegistroPago)
    cuadre: EstadoCuadreInfo = Field(default_factory=EstadoCuadreInfo)
    created_at: datetime = Field(default_factory=datetime.utcnow)
    updated_at: datetime = Field(default_factory=datetime.utcnow)
    
    class Config:
        json_encoders = {
            datetime: lambda v: v.isoformat()
        }


class PropinasControlResponse(PropinasControlInDB):
    """Schema de respuesta para API"""
    pass


# ============================================================================
# SCHEMAS DE CONFIGURACIÓN: propinas_config
# ============================================================================

class AlcanceConfig(BaseModel):
    """Alcance de aplicación de una configuración"""
    tipo: TipoAlcanceConfig = Field(TipoAlcanceConfig.GLOBAL)
    server_id: Optional[str] = Field(None)
    empresa_id: Optional[str] = Field(None)
    sucursal_id: Optional[str] = Field(None)


class VigenciaConfig(BaseModel):
    """Vigencia de una configuración"""
    fecha_inicio: datetime = Field(default_factory=datetime.utcnow)
    fecha_fin: Optional[datetime] = Field(None, description="null = indefinido")
    activa: bool = Field(True)


class ParametrosConfig(BaseModel):
    """Parámetros de configuración"""
    porcentaje_comision: float = Field(0.02, description="2% por defecto")
    tolerancia_descuadre: float = Field(5.0, description="$5 MXN tolerancia")
    dias_para_cuadrar: int = Field(1, description="Días hábiles para completar")


class FormasPagoTPV(BaseModel):
    """Mapeo de formas de pago que se consideran TPV"""
    conceptos: List[int] = Field(default=[10, 11, 12], description="IDs de concepto en movtoscajadetalles")
    nombres: List[str] = Field(default=["VISA", "MASTERCARD", "AMEX"])


class PropinasConfigBase(BaseModel):
    """Schema base de configuración"""
    alcance: AlcanceConfig
    vigencia: VigenciaConfig
    parametros: ParametrosConfig
    formas_pago_tpv_softrestaurant: FormasPagoTPV = Field(default_factory=FormasPagoTPV)


class PropinasConfigCreate(PropinasConfigBase):
    """Schema para crear configuración"""
    motivo_cambio: Optional[str] = Field(None)


class PropinasConfigInDB(PropinasConfigBase):
    """Schema completo en MongoDB"""
    id: str
    created_at: datetime = Field(default_factory=datetime.utcnow)
    created_by: Optional[str] = None
    updated_at: datetime = Field(default_factory=datetime.utcnow)
    updated_by: Optional[str] = None
    motivo_cambio: Optional[str] = None
    
    class Config:
        json_encoders = {
            datetime: lambda v: v.isoformat()
        }


# ============================================================================
# SCHEMAS DE REQUEST/RESPONSE
# ============================================================================

class SincronizarRequest(BaseModel):
    """Request para sincronizar propinas"""
    fecha_inicio: str = Field(..., description="Fecha inicio YYYY-MM-DD")
    fecha_fin: str = Field(..., description="Fecha fin YYYY-MM-DD")
    server_id: Optional[str] = Field(None, description="Filtrar por servidor específico")


class SincronizarResponse(BaseModel):
    """Response de sincronización"""
    success: bool
    registros_creados: int
    registros_actualizados: int
    errores: List[dict] = []
    detalle_por_servidor: List[dict] = []


class RegistrarPagoRequest(BaseModel):
    """Request para registrar pago de propinas"""
    monto_pagado: float = Field(..., gt=0)
    fecha_pago: Optional[datetime] = Field(None)
    metodo: MetodoPago = Field(MetodoPago.EFECTIVO)
    observaciones: Optional[str] = Field(None)


class PropinasListResponse(BaseModel):
    """Response para listado de propinas"""
    propinas: List[PropinasControlResponse]
    total: int
    totales: dict = Field(default_factory=dict)


class ResumenPropinasResponse(BaseModel):
    """Response para resumen de propinas"""
    periodo: dict
    total_propinas_tpv: float
    total_comision: float
    total_a_pagar: float
    total_pagado: float
    pendiente_pago: float
    registros: int
    por_estado: dict
