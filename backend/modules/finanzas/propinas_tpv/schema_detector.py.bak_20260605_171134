from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Detector de esquema para SoftRestaurant.
Permite adaptar queries a diferentes versiones del sistema.

DEFINICIÓN TÉCNICA FINAL (15/04/2026):
========================================
- Fuente de propinas TPV: cheques.propinatarjeta
- Relación: cheques.idturno → turnos.idturno → movtoscaja (Corte Z)
- Llave: (server_id, estacion_id, folio_corte, fecha_corte)

ESTRATEGIA ÚNICA: CHEQUES_PROPINATARJETA
- Compatible con versiones 10, 12, 95 Pro de SoftRestaurant
- Dato EXACTO (no inferido)
"""

import logging
from typing import Dict, Any, Optional, List

from core.db import execute_sql_query

logger = logging.getLogger(__name__)


class SoftRestaurantSchemaDetector:
    """
    Detecta y mapea el esquema de SoftRestaurant para queries adaptativas.
    
    ESTRATEGIA FINAL:
    - Fuente de propinas TPV: cheques.propinatarjeta
    - Relación: cheques.idturno → turnos.idturno → movtoscaja (Corte Z)
    """
    
    _cache: Dict[str, Dict[str, Any]] = {}
    
    @classmethod
    def detect_schema(cls, server: Dict[str, Any]) -> Dict[str, Any]:
        """
        Detecta el esquema de un servidor SoftRestaurant.
        
        Verifica existencia de:
        - Tabla cheques con columna propinatarjeta
        - Tabla turnos
        - Tabla movtoscaja
        """
        cache_key = f"{server['host']}:{server['port']}/{server['database']}"
        
        if cache_key in cls._cache:
            logger.debug(f"Usando esquema cacheado para {cache_key}")
            return cls._cache[cache_key]
        
        logger.info(f"Detectando esquema para {server.get('name')}...")
        
        try:
            # Query para verificar tablas y columnas necesarias
            query = """
            SELECT TABLE_NAME, COLUMN_NAME
            FROM INFORMATION_SCHEMA.COLUMNS 
            WHERE TABLE_NAME IN ('cheques', 'turnos', 'movtoscaja')
            ORDER BY TABLE_NAME, ORDINAL_POSITION
            """
            
            result = execute_sql_query(
                server['host'],
                server['port'],
                server['database'],
                server['username'],
                server['password'],
                query
            )
            
            # Organizar columnas por tabla
            tables = {}
            for row in result or []:
                table = row.get('TABLE_NAME', '').lower()
                column = row.get('COLUMN_NAME', '').lower()
                if table not in tables:
                    tables[table] = []
                tables[table].append(column)
            
            # Construir esquema
            schema = cls._build_schema(tables, server)
            
            # Cachear
            cls._cache[cache_key] = schema
            logger.info(f"Esquema detectado para {server.get('name')}: compatible={schema['compatible']}")
            
            return schema
            
        except Exception as e:
            error_schema = {
                'error': str(e),
                'compatible': False,
                'server_name': server.get('name', cache_key),
                'server_host': server.get('host'),
                'database': server.get('database'),
                'compatibility_issues': [f"Error de conexión: {str(e)}"],
                'estrategia': None
            }
            logger.error(f"Error detectando esquema: {e}")
            return error_schema
    
    @classmethod
    def _build_schema(cls, tables: Dict[str, List[str]], server: Dict[str, Any]) -> Dict[str, Any]:
        """
        Construye el esquema basado en las tablas detectadas.
        
        Estrategia única: CHEQUES_PROPINATARJETA
        """
        schema = {
            'server_name': server.get('name'),
            'server_host': server.get('host'),
            'database': server.get('database'),
            'detected_tables': list(tables.keys()),
            'estrategia': 'CHEQUES_PROPINATARJETA',
            'mapping': {}
        }
        
        # Verificar tabla cheques
        if 'cheques' in tables:
            schema['tabla_cheques'] = 'cheques'
            cols = tables['cheques']
            
            # Columna principal: propinatarjeta
            if 'propinatarjeta' in cols:
                schema['col_propina_tarjeta'] = 'propinatarjeta'
            
            # Columnas adicionales
            if 'propina' in cols:
                schema['col_propina_total'] = 'propina'
            if 'tarjeta' in cols:
                schema['col_tarjeta'] = 'tarjeta'
            if 'efectivo' in cols:
                schema['col_efectivo'] = 'efectivo'
            if 'total' in cols:
                schema['col_total'] = 'total'
            if 'idturno' in cols:
                schema['col_turno_cheques'] = 'idturno'
            if 'idestacion' in cols:
                schema['col_estacion_cheques'] = 'idestacion'
        
        # Verificar tabla turnos
        if 'turnos' in tables:
            schema['tabla_turnos'] = 'turnos'
        
        # Verificar tabla movtoscaja
        if 'movtoscaja' in tables:
            schema['tabla_cortes'] = 'movtoscaja'
            cols = tables['movtoscaja']
            
            if 'folio' in cols:
                schema['col_folio'] = 'folio'
            if 'fecha' in cols:
                schema['col_fecha'] = 'fecha'
            if 'idturno' in cols:
                schema['col_turno_cortes'] = 'idturno'
            if 'idestacion' in cols:
                schema['col_estacion_cortes'] = 'idestacion'
            if 'idtipomovtocaja' in cols:
                schema['col_tipo_movimiento'] = 'idtipomovtocaja'
            if 'saldo' in cols:
                schema['col_saldo'] = 'saldo'
        
        # Verificar compatibilidad
        schema['compatible'] = cls._check_compatibility(schema)
        schema['compatibility_issues'] = cls._get_compatibility_issues(schema)
        
        return schema
    
    @classmethod
    def _check_compatibility(cls, schema: Dict[str, Any]) -> bool:
        """
        Verifica compatibilidad para la estrategia CHEQUES_PROPINATARJETA.
        
        Requisitos:
        1. Tabla cheques con columna propinatarjeta
        2. Tabla turnos
        3. Tabla movtoscaja
        """
        return all([
            schema.get('tabla_cheques'),
            schema.get('col_propina_tarjeta'),
            schema.get('tabla_turnos'),
            schema.get('tabla_cortes'),
        ])
    
    @classmethod
    def _get_compatibility_issues(cls, schema: Dict[str, Any]) -> List[str]:
        """Obtiene lista de problemas de compatibilidad."""
        issues = []
        
        if not schema.get('tabla_cheques'):
            issues.append("CRÍTICO: No se encontró tabla 'cheques'")
        elif not schema.get('col_propina_tarjeta'):
            issues.append("CRÍTICO: No se encontró columna 'propinatarjeta' en cheques")
        
        if not schema.get('tabla_turnos'):
            issues.append("CRÍTICO: No se encontró tabla 'turnos'")
        
        if not schema.get('tabla_cortes'):
            issues.append("CRÍTICO: No se encontró tabla 'movtoscaja'")
        
        # Advertencias (no críticas)
        if not schema.get('col_turno_cheques'):
            issues.append("ADVERTENCIA: No se encontró columna 'idturno' en cheques")
        
        if not schema.get('col_estacion_cheques'):
            issues.append("ADVERTENCIA: No se encontró columna 'idestacion' en cheques")
        
        return issues
    
    @classmethod
    def build_propinas_query(cls, schema: Dict[str, Any], fecha_inicio: str, fecha_fin: str) -> str:
        """
        Construye la query OFICIAL de propinas TPV.
        
        QUERY FINAL basada en DEFINICIÓN TÉCNICA (15/04/2026):
        - Fuente: cheques.propinatarjeta
        - Relación: cheques → turnos → movtoscaja
        
        Args:
            schema: Esquema detectado
            fecha_inicio: Fecha inicio YYYY-MM-DD
            fecha_fin: Fecha fin YYYY-MM-DD
            
        Returns:
            Query SQL
        """
        if not schema.get('compatible'):
            raise ValueError(f"Esquema no compatible: {schema.get('compatibility_issues')}")
        
        # Nombres de columnas (con defaults seguros)
        col_propina_tpv = schema.get('col_propina_tarjeta', 'propinatarjeta')
        col_propina_total = schema.get('col_propina_total', 'propina')
        col_tarjeta = schema.get('col_tarjeta', 'tarjeta')
        col_efectivo = schema.get('col_efectivo', 'efectivo')
        col_total = schema.get('col_total', 'total')
        col_folio = schema.get('col_folio', 'folio')
        col_fecha = schema.get('col_fecha', 'fecha')
        col_tipo = schema.get('col_tipo_movimiento', 'idtipomovtocaja')
        col_saldo = schema.get('col_saldo', 'saldo')
        
        query = f"""
        SELECT 
            mc.idmovtocaja AS corte_id,
            mc.{col_folio} AS folio_corte,
            CONVERT(DATE, mc.{col_fecha}) AS fecha_corte,
            mc.idestacion AS estacion_id,
            mc.idturno AS turno_id,
            ISNULL(SUM(ch.{col_propina_tpv}), 0) AS propinas_tpv,
            ISNULL(SUM(ch.{col_propina_total}), 0) AS propinas_totales,
            ISNULL(SUM(ch.{col_tarjeta}), 0) AS ventas_tarjeta,
            ISNULL(SUM(ch.{col_efectivo}), 0) AS ventas_efectivo,
            ISNULL(SUM(ch.{col_total}), 0) AS ventas_totales,
            COUNT(ch.idcheque) AS total_cheques,
            mc.{col_saldo} AS saldo_corte,
            'CHEQUES_PROPINATARJETA' AS estrategia_usada
        FROM movtoscaja mc
        LEFT JOIN turnos t 
            ON mc.idturno = t.idturno 
            AND mc.idestacion = t.idestacion
        LEFT JOIN cheques ch 
            ON ch.idturno = t.idturno 
            AND ch.idestacion = t.idestacion
        WHERE mc.{col_tipo} = 3
          AND mc.{col_fecha} >= '{fecha_inicio} 00:00:00'
          AND mc.{col_fecha} <= '{fecha_fin} 23:59:59'
        GROUP BY 
            mc.idmovtocaja, 
            mc.{col_folio}, 
            mc.{col_fecha}, 
            mc.idestacion, 
            mc.idturno, 
            mc.{col_saldo}
        ORDER BY mc.{col_fecha} DESC, mc.{col_folio} DESC
        """
        
        return query
    
    @classmethod
    def clear_cache(cls, server_key: Optional[str] = None):
        """Limpia el caché de esquemas."""
        if server_key:
            cls._cache.pop(server_key, None)
        else:
            cls._cache.clear()
        logger.info(f"Caché de esquemas limpiado: {server_key or 'todos'}")


def get_schema_summary(schema: Dict[str, Any]) -> Dict[str, Any]:
    """Genera un resumen legible del esquema detectado."""
    return {
        'servidor': schema.get('server_name'),
        'host': schema.get('server_host'),
        'database': schema.get('database'),
        'compatible': schema.get('compatible', False),
        'estrategia': schema.get('estrategia'),
        'tablas_detectadas': schema.get('detected_tables', []),
        'tabla_cheques': schema.get('tabla_cheques'),
        'tabla_turnos': schema.get('tabla_turnos'),
        'tabla_cortes': schema.get('tabla_cortes'),
        'columna_propina_tarjeta': schema.get('col_propina_tarjeta'),
        'problemas': schema.get('compatibility_issues', []),
    }
