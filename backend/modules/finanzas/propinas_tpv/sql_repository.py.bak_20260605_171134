    def _format_propinas_result(self, rows: List[Dict]) -> List[Dict[str, Any]]:
        """
        Formatea resultados SQL al formato esperado por el frontend.
        Estructura compatible con el formato anterior (MongoDB).
        """
        propinas = []
        for row in rows:
            propina = {
                'id': row.get('id'),
                'server_id': row.get('server_id'),
                'sucursal_id': row.get('sucursal_id'),
                'folio_corte': row.get('folio_corte'),
                'fecha_corte': row.get('fecha_corte'),
                'server_name': row.get('server_name'),
                'system_type': row.get('system_type'),
                'sucursal_nombre': row.get('sucursal_nombre'),
                'empresa_id': row.get('empresa_id'),
                'origen': {
                    'tipo_dato': row.get('tipo_dato', 'EXACTO'),
                    'metodo_calculo': row.get('metodo_calculo'),
                    'confianza': float(row.get('confianza', 1.0) or 1.0),
                    'propinas_totales_corte': float(row.get('propinas_totales_corte', 0) or 0),
                    'ventas_tarjeta': float(row.get('ventas_tarjeta', 0) or 0),
                    'ventas_totales': float(row.get('ventas_totales', 0) or 0),
                    'propinas_tpv': float(row.get('propinas_tpv', 0) or 0),
                    'ventas_efectivo': float(row.get('ventas_efectivo', 0) or 0),
                    'formula_aplicada': row.get('query_origen'),
                    'advertencia': row.get('advertencia'),
                    'fecha_sincronizacion': row.get('fecha_sincronizacion')
                },
                'calculo': {
                    'config_aplicada_id': row.get('config_aplicada_id'),
                    'porcentaje_comision': float(row.get('porcentaje_comision', 0.02) or 0.02),
                    'comision_calculada': float(row.get('comision_calculada', 0) or 0),
                    'monto_a_pagar_meseros': float(row.get('monto_a_pagar_meseros', 0) or 0)
                },
                'pago': {
                    'registrado': bool(row.get('pago_registrado', False)),
                    'monto_pagado': float(row.get('pago_monto', 0) or 0) if row.get('pago_monto') else None,
                    'fecha_pago': row.get('pago_fecha'),
                    'metodo': row.get('pago_metodo'),
                    'registrado_por': row.get('pago_usuario_email'),
                    'observaciones': row.get('pago_observaciones')
                },
                'cuadre': {
                    'estado': row.get('cuadre_estado', 'PENDIENTE'),
                    'diferencia': float(row.get('cuadre_diferencia', 0) or 0) if row.get('cuadre_diferencia') else None,
                    'fecha_cuadre': row.get('cuadre_fecha'),
                    'observaciones': row.get('cuadre_observaciones')
                },
                'created_at': row.get('created_at'),
                'updated_at': row.get('updated_at'),
                'version': row.get('version', 1)
            }
            propinas.append(propina)
        
        return propinas
    
