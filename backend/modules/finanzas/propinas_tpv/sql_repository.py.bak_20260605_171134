    async def registrar_pago(
        self,
        propina_id: str,
        pago_data: Dict[str, Any],
        usuario_id: str,
        usuario_email: str,
        tolerancia: float = 5.0
    ) -> bool:
        """
        Registra el pago de propinas y calcula el estado de cuadre.
        
        Args:
            propina_id: ID de la propina
            pago_data: {monto_pagado, fecha_pago, metodo, observaciones}
            usuario_id: ID del usuario que registra
            usuario_email: Email del usuario
            tolerancia: Tolerancia para cuadre en pesos
            
        Returns:
            bool indicando si se actualizó
        """
        server = await self.get_edarsa_hub_server()
        if not server:
            return False
        
        # Primero obtener la propina para calcular diferencia
        propina = await self.obtener_propina_por_id(propina_id)
        if not propina:
            return False
        
        monto_pagado = pago_data['monto_pagado']
        monto_a_pagar = propina['calculo']['monto_a_pagar_meseros']
        diferencia = abs(monto_a_pagar - monto_pagado)
        
        # Determinar estado de cuadre
        if diferencia <= tolerancia:
            estado_cuadre = 'CUADRADO'
        else:
            estado_cuadre = 'DESCUADRE'
        
        fecha_pago = pago_data.get('fecha_pago') or datetime.now(timezone.utc)
        
        query = f"""
        UPDATE propinas_tpv_control
        SET 
            pago_registrado = 1,
            pago_monto = {monto_pagado},
            pago_fecha = {self._escape_sql(fecha_pago)},
            pago_metodo = {self._escape_sql(pago_data.get('metodo', 'EFECTIVO'))},
            pago_usuario_id = {self._escape_sql(usuario_id)},
            pago_usuario_email = {self._escape_sql(usuario_email)},
            pago_observaciones = {self._escape_sql(pago_data.get('observaciones'))},
            cuadre_estado = '{estado_cuadre}',
            cuadre_diferencia = {diferencia},
            cuadre_fecha = GETDATE(),
            cuadre_usuario_id = {self._escape_sql(usuario_id)},
            cuadre_usuario_email = {self._escape_sql(usuario_email)},
            updated_at = GETDATE(),
            version = version + 1
        WHERE id = {self._escape_sql(propina_id)}
        """
        
        try:
            self._execute_hub_query(server, query)
            
            # Registrar en historial
            await self._registrar_historial(
                propina_id=propina_id,
                accion='PAGO_REGISTRADO',
                estado_anterior=propina['cuadre']['estado'],
                estado_nuevo=estado_cuadre,
                usuario_id=usuario_id,
                usuario_email=usuario_email,
                observaciones=f"Monto pagado: ${monto_pagado}, Diferencia: ${diferencia}"
            )
            
            return True
            
        except Exception as e:
            logger.error(f"Error registrando pago: {e}")
            return False
    
    async def obtener_resumen(
        self,
        fecha_inicio: str,
        fecha_fin: str,
        server_id: Optional[str] = None
    ) -> Dict[str, Any]:
        """Obtiene resumen agregado de propinas."""
        server = await self.get_edarsa_hub_server()
        if not server:
            return self._resumen_vacio()
        
        where_server = f"AND server_id = {self._escape_sql(server_id)}" if server_id else ""
        
        query = f"""
        SELECT 
            ISNULL(SUM(propinas_tpv), 0) AS total_propinas_tpv,
            ISNULL(SUM(comision_calculada), 0) AS total_comision,
            ISNULL(SUM(monto_a_pagar_meseros), 0) AS total_a_pagar,
            ISNULL(SUM(CASE WHEN pago_registrado = 1 THEN pago_monto ELSE 0 END), 0) AS total_pagado,
            COUNT(*) AS registros
        FROM propinas_tpv_control
        WHERE fecha_corte >= '{fecha_inicio}'
          AND fecha_corte <= '{fecha_fin}'
          {where_server}
        """
        
        try:
            result = self._execute_hub_query(server, query)
            
            if result and len(result) > 0:
                data = result[0]
                return {
                    'total_propinas_tpv': float(data.get('total_propinas_tpv', 0) or 0),
                    'total_comision': float(data.get('total_comision', 0) or 0),
                    'total_a_pagar': float(data.get('total_a_pagar', 0) or 0),
                    'total_pagado': float(data.get('total_pagado', 0) or 0),
                    'pendiente_pago': float(data.get('total_a_pagar', 0) or 0) - float(data.get('total_pagado', 0) or 0),
                    'registros': int(data.get('registros', 0) or 0)
                }
            
            return self._resumen_vacio()
            
        except Exception as e:
            logger.error(f"Error obteniendo resumen: {e}")
            return self._resumen_vacio()
    
    def _resumen_vacio(self) -> Dict[str, Any]:
        """Retorna un resumen vacío."""
        return {
            'total_propinas_tpv': 0,
            'total_comision': 0,
            'total_a_pagar': 0,
            'total_pagado': 0,
            'pendiente_pago': 0,
            'registros': 0
        }
    
