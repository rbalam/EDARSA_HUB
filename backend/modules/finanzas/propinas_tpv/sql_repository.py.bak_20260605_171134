    async def upsert_propina(self, propina_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Crea o actualiza un registro de propina en SQL Server.
        
        Usa MERGE para upsert basado en llave única:
        (server_id, sucursal_id, folio_corte, fecha_corte)
        
        Args:
            propina_data: Diccionario con datos de la propina
            
        Returns:
            Dict con resultado (created, modified, id)
        """
        server = await self.get_edarsa_hub_server()
        if not server:
            raise Exception("Servidor EDARSA HUB no encontrado")
        
        # Generar UUID si no existe
        propina_id = propina_data.get('id') or str(uuid.uuid4())
        
        # Preparar valores
        server_id = self._escape_sql(propina_data['server_id'])
        sucursal_id = self._escape_sql(propina_data['sucursal_id'])
        folio_corte = self._escape_sql(propina_data['folio_corte'])
        fecha_corte = self._escape_sql(propina_data['fecha_corte'])
        
        # Datos de origen
        origen = propina_data.get('origen', {})
        calculo = propina_data.get('calculo', {})
        
        query = f"""
        MERGE propinas_tpv_control AS target
        USING (SELECT 
            {server_id} AS server_id,
            {sucursal_id} AS sucursal_id,
            {folio_corte} AS folio_corte,
            CAST({fecha_corte} AS DATE) AS fecha_corte
        ) AS source
        ON target.server_id = source.server_id 
           AND target.sucursal_id = source.sucursal_id
           AND target.folio_corte = source.folio_corte
           AND target.fecha_corte = source.fecha_corte
        
        WHEN MATCHED THEN
            UPDATE SET
                server_name = {self._escape_sql(propina_data.get('server_name'))},
                system_type = {self._escape_sql(propina_data.get('system_type', 'SoftRestaurant'))},
                sucursal_nombre = {self._escape_sql(propina_data.get('sucursal_nombre'))},
                empresa_id = {self._escape_sql(propina_data.get('empresa_id'))},
                estacion_id = {self._escape_sql(propina_data.get('estacion_id'))},
                propinas_totales_corte = {origen.get('propinas_totales_corte', 0)},
                propinas_tpv = {origen.get('propinas_tpv', 0)},
                ventas_tarjeta = {origen.get('ventas_tarjeta', 0)},
                ventas_totales = {origen.get('ventas_totales', 0)},
                ventas_efectivo = {origen.get('ventas_efectivo', 0)},
                total_cheques = {origen.get('total_cheques', 0)},
                saldo_corte = {origen.get('saldo_corte', 0)},
                corte_id_origen = {self._escape_sql(propina_data.get('corte_id_origen'))},
                turno_id_origen = {self._escape_sql(propina_data.get('turno_id_origen'))},
                tipo_dato = {self._escape_sql(origen.get('tipo_dato', 'EXACTO'))},
                metodo_calculo = {self._escape_sql(origen.get('metodo_calculo'))},
                confianza = {origen.get('confianza', 1.0)},
                query_origen = {self._escape_sql(origen.get('formula_aplicada', '')[:500] if origen.get('formula_aplicada') else None)},
                advertencia = {self._escape_sql(origen.get('advertencia'))},
                porcentaje_comision = {calculo.get('porcentaje_comision', 0.02)},
                comision_calculada = {calculo.get('comision_calculada', 0)},
                monto_a_pagar_meseros = {calculo.get('monto_a_pagar_meseros', 0)},
                fecha_sincronizacion = GETDATE(),
                sincronizado_por = {self._escape_sql(propina_data.get('sincronizado_por', 'sistema'))},
                updated_at = GETDATE(),
                version = version + 1
        
        WHEN NOT MATCHED THEN
            INSERT (
                id, server_id, sucursal_id, folio_corte, fecha_corte,
                server_name, system_type, sucursal_nombre, empresa_id, estacion_id,
                propinas_totales_corte, propinas_tpv, ventas_tarjeta, ventas_totales, ventas_efectivo,
                total_cheques, saldo_corte, corte_id_origen, turno_id_origen,
                tipo_dato, metodo_calculo, confianza, query_origen, advertencia,
                porcentaje_comision, comision_calculada, monto_a_pagar_meseros,
                cuadre_estado, fecha_sincronizacion, sincronizado_por
            )
            VALUES (
                {self._escape_sql(propina_id)},
                {server_id}, {sucursal_id}, {folio_corte}, {fecha_corte},
                {self._escape_sql(propina_data.get('server_name'))},
                {self._escape_sql(propina_data.get('system_type', 'SoftRestaurant'))},
                {self._escape_sql(propina_data.get('sucursal_nombre'))},
                {self._escape_sql(propina_data.get('empresa_id'))},
                {self._escape_sql(propina_data.get('estacion_id'))},
                {origen.get('propinas_totales_corte', 0)},
                {origen.get('propinas_tpv', 0)},
                {origen.get('ventas_tarjeta', 0)},
                {origen.get('ventas_totales', 0)},
                {origen.get('ventas_efectivo', 0)},
                {origen.get('total_cheques', 0)},
                {origen.get('saldo_corte', 0)},
                {self._escape_sql(propina_data.get('corte_id_origen'))},
                {self._escape_sql(propina_data.get('turno_id_origen'))},
                {self._escape_sql(origen.get('tipo_dato', 'EXACTO'))},
                {self._escape_sql(origen.get('metodo_calculo'))},
                {origen.get('confianza', 1.0)},
                {self._escape_sql(origen.get('formula_aplicada', '')[:500] if origen.get('formula_aplicada') else None)},
                {self._escape_sql(origen.get('advertencia'))},
                {calculo.get('porcentaje_comision', 0.02)},
                {calculo.get('comision_calculada', 0)},
                {calculo.get('monto_a_pagar_meseros', 0)},
                'PENDIENTE',
                GETDATE(),
                {self._escape_sql(propina_data.get('sincronizado_por', 'sistema'))}
            )
        OUTPUT $action AS action, inserted.id AS id;
        """
        
        try:
            result = self._execute_hub_query(server, query)
            
            if result and len(result) > 0:
                action = result[0].get('action', 'UNKNOWN')
                return {
                    'created': action == 'INSERT',
                    'modified': action == 'UPDATE',
                    'id': str(result[0].get('id', propina_id))
                }
            
            return {'created': False, 'modified': False, 'id': propina_id}
            
        except Exception as e:
            logger.error(f"Error en upsert_propina: {e}")
            raise
    
    async def obtener_propinas(
        self,
        fecha_inicio: Optional[str] = None,
        fecha_fin: Optional[str] = None,
        server_id: Optional[str] = None,
        sucursal_id: Optional[str] = None,
        estado: Optional[str] = None,
        skip: int = 0,
        limit: int = 100
    ) -> List[Dict[str, Any]]:
        """
        Obtiene propinas desde SQL Server con filtros opcionales.
        """
        server = await self.get_edarsa_hub_server()
        if not server:
            return []
        
        where_clauses = ["1=1"]
        
        if fecha_inicio:
            where_clauses.append(f"fecha_corte >= '{fecha_inicio}'")
        if fecha_fin:
            where_clauses.append(f"fecha_corte <= '{fecha_fin}'")
        if server_id:
            where_clauses.append(f"server_id = {self._escape_sql(server_id)}")
        if sucursal_id:
            where_clauses.append(f"sucursal_id = {self._escape_sql(sucursal_id)}")
        if estado:
            where_clauses.append(f"cuadre_estado = {self._escape_sql(estado)}")
        
        where_sql = " AND ".join(where_clauses)
        
        query = f"""
        SELECT 
            CAST(id AS VARCHAR(36)) AS id,
            server_id, sucursal_id, folio_corte,
            CONVERT(VARCHAR(10), fecha_corte, 120) AS fecha_corte,
            server_name, system_type, sucursal_nombre, empresa_id, estacion_id,
            propinas_totales_corte, propinas_efectivo, propinas_tpv,
            ventas_tarjeta, ventas_totales, ventas_efectivo,
            tipo_dato, metodo_calculo, confianza, query_origen, advertencia,
            CAST(config_aplicada_id AS VARCHAR(36)) AS config_aplicada_id,
            porcentaje_comision, comision_calculada, monto_a_pagar_meseros,
            pago_registrado, pago_monto, pago_fecha, pago_metodo,
            pago_usuario_id, pago_usuario_email, pago_observaciones,
            cuadre_estado, cuadre_diferencia, cuadre_fecha,
            cuadre_usuario_id, cuadre_usuario_email, cuadre_observaciones,
            fecha_sincronizacion, sincronizado_por,
            created_at, updated_at, version
        FROM propinas_tpv_control
        WHERE {where_sql}
        ORDER BY fecha_corte DESC, folio_corte DESC
        OFFSET {skip} ROWS FETCH NEXT {limit} ROWS ONLY
        """
        
        try:
            result = self._execute_hub_query(server, query)
            return self._format_propinas_result(result) if result else []
        except Exception as e:
            logger.error(f"Error obteniendo propinas: {e}")
            return []
    
