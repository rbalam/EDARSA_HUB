            {self._escape_sql(valor_anterior)},
            {self._escape_sql(valor_nuevo)},
            {self._escape_sql(estado_anterior)},
            {self._escape_sql(estado_nuevo)},
            {self._escape_sql(usuario_id)},
            {self._escape_sql(usuario_email)},
            {self._escape_sql(observaciones)}
        )
        """
        
        try:
            self._execute_hub_query(server, query)
        except Exception as e:
            logger.warning(f"Error registrando historial: {e}")
    
