    async def obtener_config_vigente(
        self,
        server_id: Optional[str] = None,
        empresa_id: Optional[str] = None,
        sucursal_id: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Obtiene la configuración vigente aplicando jerarquía:
        SUCURSAL > EMPRESA > GLOBAL
        """
        server = await self.get_edarsa_hub_server()
        if not server:
            return self._config_default()
        
        # Buscar config por jerarquía
        for alcance, filtro in [
            ('SUCURSAL', f"alcance_sucursal_id = {self._escape_sql(sucursal_id)}" if sucursal_id else None),
            ('EMPRESA', f"alcance_empresa_id = {self._escape_sql(empresa_id)}" if empresa_id else None),
            ('GLOBAL', "alcance_tipo = 'GLOBAL'")
        ]:
            if filtro:
                query = f"""
                SELECT TOP 1
                    CAST(id AS VARCHAR(36)) AS id,
                    alcance_tipo, alcance_server_id, alcance_empresa_id, alcance_sucursal_id,
                    vigencia_inicio, vigencia_fin, activa,
                    porcentaje_comision, tolerancia_descuadre, dias_para_cuadrar,
                    soft_concepto_propinas, soft_conceptos_tarjeta, soft_concepto_efectivo,
                    created_at, created_by, updated_at, updated_by, motivo_cambio
                FROM propinas_tpv_config
                WHERE {filtro}
                  AND activa = 1
                  AND vigencia_inicio <= GETDATE()
                  AND (vigencia_fin IS NULL OR vigencia_fin >= GETDATE())
                ORDER BY vigencia_inicio DESC
                """
                
                try:
                    result = self._execute_hub_query(server, query)
                    if result and len(result) > 0:
                        return self._format_config(result[0])
                except Exception as e:
                    logger.warning(f"Error buscando config {alcance}: {e}")
        
        return self._config_default()
    
