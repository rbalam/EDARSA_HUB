        observaciones: Optional[str] = None
    ):
        """Registra un evento en el historial de auditoría."""
        server = await self.get_edarsa_hub_server()
        if not server:
            return
        
        query = f"""
        INSERT INTO propinas_tpv_historial (
            propina_id, accion, campo_modificado,
            valor_anterior, valor_nuevo,
            estado_anterior, estado_nuevo,
            usuario_id, usuario_email, observaciones
        ) VALUES (
            {self._escape_sql(propina_id)},
