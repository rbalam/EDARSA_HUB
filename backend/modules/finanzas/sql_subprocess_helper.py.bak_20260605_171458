"""
EDARSA HUB - SQL Query Helper con Subprocess
=============================================

Este módulo ejecuta queries SQL en un subprocess separado
con locale UTF-8 forzado para evitar problemas de encoding
con pytds en ambiente supervisor.

DICIEMBRE 2026 - FINANZAS-CXP-MPRO-CREDENTIALS-SECURITY-01:
- execute_sql_subprocess_secure: Pasa credenciales via stdin (no argv)
- execute_sql_subprocess: LEGACY - Mantiene compatibilidad pero usa argv (INSEGURO)

USO SEGURO:
    from modules.finanzas.sql_subprocess_helper import execute_sql_subprocess_secure
    
    results = await execute_sql_subprocess_secure(
        host='server.example.com',
        port=1433,
        database='mydatabase',
        username='user',
        password='secret',
        query='SELECT TOP 10 * FROM mytable'
    )
"""
import asyncio
import json
import base64
import logging
import os
import sys
from typing import Dict, List, Any, Optional
from pathlib import Path

logger = logging.getLogger(__name__)

# Ruta al worker script
WORKER_PATH = Path(__file__).parent / 'sql_query_worker.py'
WORKER_SECURE_PATH = Path(__file__).parent / 'sql_query_worker_secure.py'

# Python del virtualenv (el mismo que está ejecutando este módulo)
PYTHON_PATH = sys.executable


async def execute_sql_subprocess_secure(
    host: str,
    port: int,
    database: str,
    username: str,
    password: str,
    query: str,
    timeout: int = 60
) -> Dict[str, Any]:
    """
    Ejecuta una query SQL en un subprocess con encoding UTF-8 forzado.
    
    SEGURIDAD: Las credenciales se pasan via stdin como JSON, NO como argumentos CLI.
    Esto evita que el password sea visible en `ps aux` o `/proc/[pid]/cmdline`.
    
    Args:
        host: Servidor SQL
        port: Puerto
        database: Base de datos
        username: Usuario
        password: Contraseña (NO se pasa por argv)
        query: Query SQL a ejecutar
        timeout: Timeout en segundos
        
    Returns:
        Dict con:
        - success: bool
        - data: List[Dict] si success=True
        - count: int si success=True
        - error: str si success=False
        - error_type: str si success=False
    """
    # Codificar query en base64
    query_b64 = base64.b64encode(query.encode('utf-8')).decode('ascii')
    
    # Preparar payload JSON para stdin (incluye credenciales)
    stdin_payload = json.dumps({
        'host': host,
        'port': port,
        'database': database,
        'username': username,
        'password': password,
        'query_b64': query_b64
    })
    
    # Comando SIN credenciales en argumentos
    cmd = [
        PYTHON_PATH,
        str(WORKER_SECURE_PATH)
    ]
    
    # Configurar environment con locale UTF-8
    env = os.environ.copy()
    env['PYTHONIOENCODING'] = 'utf-8'
    env['LANG'] = 'C.UTF-8'
    env['LC_ALL'] = 'C.UTF-8'
    
    try:
        # Ejecutar subprocess con stdin
        process = await asyncio.create_subprocess_exec(
            *cmd,
            stdin=asyncio.subprocess.PIPE,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
            env=env
        )
        
        # Enviar payload por stdin y esperar resultado
        try:
            stdout, stderr = await asyncio.wait_for(
                process.communicate(input=stdin_payload.encode('utf-8')),
                timeout=timeout
            )
        except asyncio.TimeoutError:
            process.kill()
            await process.wait()
            return {
                "success": False,
                "error": f"Query timeout después de {timeout}s",
                "error_type": "TIMEOUT"
            }
        
        # Decodificar salida
        stdout_str = stdout.decode('utf-8', errors='replace').strip()
        stderr_str = stderr.decode('utf-8', errors='replace').strip()
        
        # Log sin incluir credenciales
        if stderr_str:
            # Filtrar cualquier posible leak de credenciales en stderr
            safe_stderr = stderr_str
            if password and password in safe_stderr:
                safe_stderr = safe_stderr.replace(password, '***')
            logger.warning(f"[SQL Subprocess Secure] stderr: {safe_stderr[:200]}")
        
        if not stdout_str:
            return {
                "success": False,
                "error": "No output from worker",
                "error_type": "NO_OUTPUT"
            }
        
        # Parsear JSON
        try:
            result = json.loads(stdout_str)
            return result
        except json.JSONDecodeError as e:
            return {
                "success": False,
                "error": f"JSON decode error: {e}",
                "error_type": "JSON_ERROR"
            }
    
    except Exception as e:
        return {
            "success": False,
            "error": str(e),
            "error_type": type(e).__name__
        }


async def execute_sql_subprocess(
    host: str,
    port: int,
    database: str,
    username: str,
    password: str,
    query: str,
    timeout: int = 60
) -> Dict[str, Any]:
    """
    Ejecuta una query SQL en un subprocess con encoding UTF-8 forzado.
    
    Args:
        host: Servidor SQL
        port: Puerto
        database: Base de datos
        username: Usuario
        password: Contraseña
        query: Query SQL a ejecutar
        timeout: Timeout en segundos
        
    Returns:
        Dict con:
        - success: bool
        - data: List[Dict] si success=True
        - count: int si success=True
        - error: str si success=False
    """
    # Codificar query en base64
    query_b64 = base64.b64encode(query.encode('utf-8')).decode('ascii')
    
    # Construir comando usando el mismo python del virtualenv
    cmd = [
        PYTHON_PATH,  # Usar el mismo python que está ejecutando este módulo
        str(WORKER_PATH),
        host,
        str(port),
        database,
        username,
        password,
        query_b64
    ]
    
    # Configurar environment con locale UTF-8
    env = os.environ.copy()
    env['PYTHONIOENCODING'] = 'utf-8'
    env['LANG'] = 'C.UTF-8'
    env['LC_ALL'] = 'C.UTF-8'
    
    try:
        # Ejecutar subprocess
        process = await asyncio.create_subprocess_exec(
            *cmd,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
            env=env
        )
        
        # Esperar con timeout
        try:
            stdout, stderr = await asyncio.wait_for(
                process.communicate(),
                timeout=timeout
            )
        except asyncio.TimeoutError:
            process.kill()
            await process.wait()
            return {
                "success": False,
                "error": f"Query timeout después de {timeout}s",
                "error_type": "TIMEOUT"
            }
        
        # Decodificar salida
        stdout_str = stdout.decode('utf-8', errors='replace').strip()
        stderr_str = stderr.decode('utf-8', errors='replace').strip()
        
        logger.warning(f"[SQL Subprocess] stdout raw (primeros 200 chars): {stdout_str[:200] if stdout_str else 'VACIO'}")
        
        if stderr_str:
            logger.warning(f"[SQL Subprocess] stderr completo: {stderr_str}")
        
        if not stdout_str:
            return {
                "success": False,
                "error": "No output from worker",
                "stderr": stderr_str
            }
        
        # Parsear JSON
        try:
            result = json.loads(stdout_str)
            return result
        except json.JSONDecodeError as e:
            logger.error(f"[SQL Subprocess] JSON decode error: {e}")
            return {
                "success": False,
                "error": f"JSON decode error: {e}",
                "stdout": stdout_str[:500]
            }
    
    except Exception as e:
        logger.error(f"[SQL Subprocess] Error ejecutando subprocess: {e}")
        return {
            "success": False,
            "error": str(e),
            "error_type": type(e).__name__
        }


async def execute_sql_subprocess_batch(
    connections: List[Dict[str, Any]],
    query: str,
    timeout: int = 60
) -> List[Dict[str, Any]]:
    """
    Ejecuta la misma query en múltiples conexiones en paralelo.
    
    Args:
        connections: Lista de dicts con host, port, database, username, password, name
        query: Query SQL a ejecutar
        timeout: Timeout en segundos
        
    Returns:
        Lista de resultados, uno por conexión
    """
    tasks = []
    
    for conn in connections:
        task = execute_sql_subprocess(
            host=conn['host'],
            port=conn['port'],
            database=conn['database'],
            username=conn['username'],
            password=conn['password'],
            query=query,
            timeout=timeout
        )
        tasks.append(task)
    
    results = await asyncio.gather(*tasks, return_exceptions=True)
    
    # Procesar resultados
    processed = []
    for i, result in enumerate(results):
        conn = connections[i]
        if isinstance(result, Exception):
            processed.append({
                "success": False,
                "connection": conn.get('name', conn['host']),
                "error": str(result)
            })
        else:
            result['connection'] = conn.get('name', conn['host'])
            processed.append(result)
    
    return processed
