"""
P1-FASE5A.1 - Utilidades para Cuentas y Saldos Bancarios
=========================================================
Funciones de enmascaramiento, validación y helpers.

NO EXPONER datos bancarios completos en ningún endpoint ni log.
"""

import re
from typing import Optional
from decimal import Decimal, InvalidOperation


# =============================================================================
# ENMASCARAMIENTO DE DATOS SENSIBLES
# =============================================================================

def mask_numero_cuenta(numero: Optional[str]) -> str:
    """
    Enmascara número de cuenta bancaria.
    
    Entrada: '0123456789'
    Salida:  '****6789'
    
    REGLA: NUNCA exponer número completo en respuestas API.
    """
    if not numero or len(numero) < 4:
        return "****"
    return f"****{numero[-4:]}"


def mask_clabe(clabe: Optional[str]) -> str:
    """
    Enmascara CLABE interbancaria.
    
    Entrada: '012345678901234567'
    Salida:  '****4567'
    
    REGLA: NUNCA exponer CLABE completa en respuestas API.
    """
    if not clabe or len(clabe) < 4:
        return "****"
    return f"****{clabe[-4:]}"


# =============================================================================
# VALIDACIONES
# =============================================================================

def validar_clabe(clabe: str) -> tuple[bool, str]:
    """
    Valida formato de CLABE interbancaria mexicana.
    
    Reglas:
    - Exactamente 18 dígitos
    - Solo números
    
    Returns:
        (es_valida, mensaje_error)
    """
    if not clabe:
        return True, ""  # CLABE es opcional
    
    # Remover espacios
    clabe = clabe.strip()
    
    if len(clabe) != 18:
        return False, "CLABE debe tener exactamente 18 dígitos"
    
    if not clabe.isdigit():
        return False, "CLABE solo debe contener números"
    
    return True, ""


def validar_numero_cuenta(numero: str) -> tuple[bool, str]:
    """
    Valida número de cuenta bancaria.
    
    Reglas:
    - Entre 10 y 20 caracteres
    - Solo números
    
    Returns:
        (es_valido, mensaje_error)
    """
    if not numero:
        return False, "Número de cuenta es requerido"
    
    numero = numero.strip()
    
    if len(numero) < 10 or len(numero) > 20:
        return False, "Número de cuenta debe tener entre 10 y 20 dígitos"
    
    if not numero.isdigit():
        return False, "Número de cuenta solo debe contener números"
    
    return True, ""


def validar_moneda(moneda: str) -> tuple[bool, str]:
    """
    Valida código de moneda.
    
    Monedas permitidas: MXN, USD, EUR, CAD
    """
    monedas_validas = ['MXN', 'USD', 'EUR', 'CAD']
    
    if not moneda:
        return False, "Moneda es requerida"
    
    moneda = moneda.upper().strip()
    
    if moneda not in monedas_validas:
        return False, f"Moneda inválida. Valores permitidos: {', '.join(monedas_validas)}"
    
    return True, ""


def validar_saldo(saldo: any) -> tuple[bool, str, Optional[Decimal]]:
    """
    Valida y convierte saldo a Decimal.
    
    Returns:
        (es_valido, mensaje_error, saldo_decimal)
    """
    if saldo is None:
        return False, "Saldo es requerido", None
    
    try:
        saldo_decimal = Decimal(str(saldo))
        # Redondear a 2 decimales
        saldo_decimal = saldo_decimal.quantize(Decimal('0.01'))
        return True, "", saldo_decimal
    except (InvalidOperation, ValueError):
        return False, "Saldo debe ser un número válido", None


def validar_tipo_cambio(tipo_cambio: any) -> tuple[bool, str, Optional[Decimal]]:
    """
    Valida tipo de cambio.
    
    Reglas:
    - Puede ser NULL
    - Si se proporciona, debe ser > 0
    """
    if tipo_cambio is None:
        return True, "", None
    
    try:
        tc_decimal = Decimal(str(tipo_cambio))
        if tc_decimal <= 0:
            return False, "Tipo de cambio debe ser mayor a 0", None
        tc_decimal = tc_decimal.quantize(Decimal('0.0001'))
        return True, "", tc_decimal
    except (InvalidOperation, ValueError):
        return False, "Tipo de cambio debe ser un número válido", None


def validar_alias(alias: str) -> tuple[bool, str]:
    """
    Valida alias de cuenta bancaria.
    
    Reglas:
    - Entre 3 y 50 caracteres
    - Sin caracteres especiales peligrosos
    """
    if not alias:
        return False, "Alias es requerido"
    
    alias = alias.strip()
    
    if len(alias) < 3:
        return False, "Alias debe tener al menos 3 caracteres"
    
    if len(alias) > 50:
        return False, "Alias no puede exceder 50 caracteres"
    
    # Permitir letras, números, espacios, guiones y algunos caracteres
    pattern = r'^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\-_.]+$'
    if not re.match(pattern, alias):
        return False, "Alias contiene caracteres no permitidos"
    
    return True, ""


def validar_motivo(motivo: str, min_length: int = 10) -> tuple[bool, str]:
    """
    Valida motivo de cancelación/corrección.
    
    Reglas:
    - Mínimo 10 caracteres por defecto
    - Máximo 500 caracteres
    """
    if not motivo:
        return False, f"Motivo es requerido (mínimo {min_length} caracteres)"
    
    motivo = motivo.strip()
    
    if len(motivo) < min_length:
        return False, f"Motivo debe tener al menos {min_length} caracteres"
    
    if len(motivo) > 500:
        return False, "Motivo no puede exceder 500 caracteres"
    
    return True, ""


# =============================================================================
# HELPERS DE SERIALIZACIÓN
# =============================================================================

def serialize_cuenta_bancaria(cuenta: dict, include_saldo: bool = False) -> dict:
    """
    Serializa cuenta bancaria con datos enmascarados.
    
    SIEMPRE enmascara número de cuenta y CLABE.
    """
    result = {
        "cuenta_bancaria_id": cuenta.get("CuentaBancariaID"),
        "empresa_id": cuenta.get("EmpresaID"),
        "banco_id": cuenta.get("BancoID"),
        "banco_nombre": cuenta.get("NombreBanco") or cuenta.get("banco_nombre"),
        "banco_codigo": cuenta.get("CodigoBanco") or cuenta.get("banco_codigo"),
        "numero_cuenta": mask_numero_cuenta(cuenta.get("NumeroCuenta")),
        "clabe": mask_clabe(cuenta.get("CLABE")),
        "alias": cuenta.get("Alias"),
        "moneda": cuenta.get("Moneda", "MXN"),
        "es_cuenta_principal": bool(cuenta.get("EsCuentaPrincipal", False)),
        "activo": bool(cuenta.get("Activo", True)),
        "fecha_alta": cuenta.get("FechaAlta"),
    }
    
    if include_saldo and cuenta.get("ultimo_saldo"):
        result["ultimo_saldo"] = cuenta["ultimo_saldo"]
    
    return result


def serialize_saldo_bancario(saldo: dict) -> dict:
    """
    Serializa saldo bancario.
    """
    return {
        "saldo_bancario_id": saldo.get("SaldoBancarioID"),
        "cuenta_bancaria_id": saldo.get("CuentaBancariaID"),
        "fecha_saldo": str(saldo.get("FechaSaldo")) if saldo.get("FechaSaldo") else None,
        "saldo_final": float(saldo.get("SaldoFinal", 0)),
        "moneda": saldo.get("Moneda", "MXN"),
        "tipo_cambio": float(saldo.get("TipoCambio")) if saldo.get("TipoCambio") else None,
        "fuente_datos": saldo.get("FuenteDatos", "MANUAL"),
        "observaciones": saldo.get("Observaciones"),
        "es_vigente": bool(saldo.get("EsVigente", False)),
        "activo": bool(saldo.get("Activo", False)),
        "estatus": saldo.get("Estatus", "VIGENTE"),
        "fecha_creacion": saldo.get("FechaCreacion"),
        "usuario_creacion": saldo.get("NombreUsuarioCreacion") or saldo.get("usuario_creacion"),
        "fecha_cancelacion": saldo.get("FechaCancelacion"),
        "usuario_cancelacion": saldo.get("NombreUsuarioCancelacion") or saldo.get("usuario_cancelacion"),
        "motivo_cancelacion": saldo.get("MotivoCancelacion"),
    }


def serialize_banco(banco: dict) -> dict:
    """
    Serializa banco del catálogo.
    """
    return {
        "banco_id": banco.get("BancoID"),
        "codigo": banco.get("CodigoBanco"),
        "nombre": banco.get("NombreBanco"),
        "nombre_corto": banco.get("NombreCorto"),
    }
