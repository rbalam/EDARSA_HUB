def calcular_fecha_deposito_esperada(fecha_venta: str) -> str:
    """
    Calcula la fecha esperada de depósito.
    - Lunes a Jueves: Día hábil siguiente
    - Viernes, Sábado, Domingo: Lunes siguiente
    """
    try:
        if isinstance(fecha_venta, str):
            fecha = datetime.fromisoformat(fecha_venta.replace('Z', '+00:00'))
        else:
            fecha = fecha_venta
        
        dia_semana = fecha.weekday()  # 0=Lunes, 6=Domingo
        
        if dia_semana == 4:  # Viernes
            dias_agregar = 3
        elif dia_semana == 5:  # Sábado
            dias_agregar = 2
        elif dia_semana == 6:  # Domingo
            dias_agregar = 1
        else:  # Lunes a Jueves
            dias_agregar = 1
        
        fecha_deposito = fecha + timedelta(days=dias_agregar)
        return fecha_deposito.strftime('%Y-%m-%d')
    except Exception as e:
        logger.error(f"Error calculando fecha de depósito: {e}")
        return None


def validar_fecha_deposito(fecha_venta: str, fecha_deposito: str) -> bool:
    """Valida que la fecha de depósito sea correcta según las reglas"""
    fecha_esperada = calcular_fecha_deposito_esperada(fecha_venta)
    return fecha_esperada == fecha_deposito


class RepositoryCuadresZ:
    """Repositorio para operaciones CRUD de Cuadres de Cortes Z"""
    
    def __init__(self):
        self.collection_name = "tesoreria_cuadres_z"
    
    @property
    def collection(self):
        return get_db()[self.collection_name]
    
    async def crear_cuadre(self, cuadre_data: dict, user_id: str = None) -> dict:
        """Crea un nuevo registro de cuadre"""
        now = datetime.utcnow().isoformat()
        
        # Calcular fecha de depósito esperada
        fecha_deposito_esperada = calcular_fecha_deposito_esperada(
            cuadre_data['corte_z']['fecha_corte']
        )
        
        # Calcular montos
        monto_esperado = cuadre_data['corte_z'].get('monto_a_depositar', 0)
        monto_contado = 0
        monto_depositado = 0
        
        if cuadre_data.get('conteo_efectivo'):
            conteo = cuadre_data['conteo_efectivo']
            billetes = conteo.get('billetes', {})
            monedas = conteo.get('monedas', {})
            
            monto_contado = (
                billetes.get('b1000', 0) * 1000 +
                billetes.get('b500', 0) * 500 +
                billetes.get('b200', 0) * 200 +
                billetes.get('b100', 0) * 100 +
                billetes.get('b50', 0) * 50 +
                billetes.get('b20', 0) * 20 +
                monedas.get('m20', 0) * 20 +
                monedas.get('m10', 0) * 10 +
                monedas.get('m5', 0) * 5 +
                monedas.get('m2', 0) * 2 +
                monedas.get('m1', 0) * 1 +
                monedas.get('m050', 0) * 0.50
            )
        
        if cuadre_data.get('ficha_deposito'):
            monto_depositado = cuadre_data['ficha_deposito'].get('importe', 0)
        
        diferencia = monto_depositado - monto_esperado
        
        # Determinar estado
        estado = 'PENDIENTE'
        if monto_contado > 0 and monto_depositado > 0:
            if abs(diferencia) <= 1:  # Tolerancia de $1
                estado = 'CUADRADO'
            else:
                estado = 'DESCUADRE'
        elif monto_contado > 0 or monto_depositado > 0:
            estado = 'EN_PROCESO'
        
        # Validar fecha de depósito
        validacion_fecha = False
        if cuadre_data.get('ficha_deposito', {}).get('fecha_deposito'):
            validacion_fecha = validar_fecha_deposito(
                cuadre_data['corte_z']['fecha_corte'],
                cuadre_data['ficha_deposito']['fecha_deposito']
            )
        
        documento = {
            'corte_z': cuadre_data['corte_z'],
            'conteo_efectivo': cuadre_data.get('conteo_efectivo'),
            'ficha_deposito': cuadre_data.get('ficha_deposito'),
            'estado': estado,
            'monto_esperado': monto_esperado,
            'monto_contado': monto_contado,
            'monto_depositado': monto_depositado,
            'diferencia': diferencia,
            'fecha_cuadre_esperada': fecha_deposito_esperada,
            'validacion_fecha': validacion_fecha,
            'observaciones': cuadre_data.get('observaciones'),
            'created_at': now,
            'updated_at': now,
            'created_by': user_id
        }
        
        result = self.collection.insert_one(documento)
        documento['id'] = str(result.inserted_id)
        if '_id' in documento:
            del documento['_id']
        
        return documento
    
    async def obtener_cuadre(self, cuadre_id: str) -> Optional[dict]:
        """Obtiene un cuadre por ID"""
        try:
            result = self.collection.find_one({'_id': ObjectId(cuadre_id)})
            if result:
                result['id'] = str(result['_id'])
                del result['_id']
                return result
            return None
        except Exception as e:
            logger.error(f"Error obteniendo cuadre: {e}")
            return None
    
    async def obtener_cuadre_por_folio(self, folio_corte: str, sucursal_id: str) -> Optional[dict]:
        """Busca un cuadre por folio de corte y sucursal"""
        try:
            result = self.collection.find_one({
                'corte_z.folio_corte': folio_corte,
                'corte_z.sucursal_id': sucursal_id
            })
            if result:
                result['id'] = str(result['_id'])
                del result['_id']
                return result
            return None
        except Exception as e:
            logger.error(f"Error buscando cuadre por folio: {e}")
            return None
    
    async def actualizar_cuadre(self, cuadre_id: str, update_data: dict) -> Optional[dict]:
        """Actualiza un cuadre existente"""
        try:
            # Obtener cuadre actual
            cuadre = await self.obtener_cuadre(cuadre_id)
            if not cuadre:
                return None
            
            # Actualizar campos
            now = datetime.utcnow().isoformat()
            update_fields = {'updated_at': now}
            
            if 'conteo_efectivo' in update_data:
                update_fields['conteo_efectivo'] = update_data['conteo_efectivo']
                
                # Recalcular monto contado
                conteo = update_data['conteo_efectivo']
                billetes = conteo.get('billetes', {})
                monedas = conteo.get('monedas', {})
                
                monto_contado = (
                    billetes.get('b1000', 0) * 1000 +
                    billetes.get('b500', 0) * 500 +
                    billetes.get('b200', 0) * 200 +
                    billetes.get('b100', 0) * 100 +
                    billetes.get('b50', 0) * 50 +
                    billetes.get('b20', 0) * 20 +
                    monedas.get('m20', 0) * 20 +
                    monedas.get('m10', 0) * 10 +
                    monedas.get('m5', 0) * 5 +
                    monedas.get('m2', 0) * 2 +
                    monedas.get('m1', 0) * 1 +
                    monedas.get('m050', 0) * 0.50
                )
                update_fields['monto_contado'] = monto_contado
            
            if 'ficha_deposito' in update_data:
                update_fields['ficha_deposito'] = update_data['ficha_deposito']
                monto_depositado = update_data['ficha_deposito'].get('importe', 0)
                update_fields['monto_depositado'] = monto_depositado
                
                # Validar fecha
                if update_data['ficha_deposito'].get('fecha_deposito'):
                    update_fields['validacion_fecha'] = validar_fecha_deposito(
                        cuadre['corte_z']['fecha_corte'],
                        update_data['ficha_deposito']['fecha_deposito']
                    )
            
            if 'observaciones' in update_data:
                update_fields['observaciones'] = update_data['observaciones']
            
            # Recalcular diferencia y estado
            monto_esperado = cuadre.get('monto_esperado', 0)
            monto_contado = update_fields.get('monto_contado', cuadre.get('monto_contado', 0))
            monto_depositado = update_fields.get('monto_depositado', cuadre.get('monto_depositado', 0))
            
            diferencia = monto_depositado - monto_esperado
            update_fields['diferencia'] = diferencia
            
            # Determinar estado
            if 'estado' in update_data:
                update_fields['estado'] = update_data['estado']
            else:
                if monto_contado > 0 and monto_depositado > 0:
                    if abs(diferencia) <= 1:
                        update_fields['estado'] = 'CUADRADO'
                    else:
                        update_fields['estado'] = 'DESCUADRE'
                elif monto_contado > 0 or monto_depositado > 0:
                    update_fields['estado'] = 'EN_PROCESO'
            
            self.collection.update_one(
                {'_id': ObjectId(cuadre_id)},
                {'$set': update_fields}
            )
            
            return await self.obtener_cuadre(cuadre_id)
        except Exception as e:
            logger.error(f"Error actualizando cuadre: {e}")
            return None
    
    async def listar_cuadres(
        self,
        estado: Optional[str] = None,
        sucursal_id: Optional[str] = None,
        fecha_inicio: Optional[str] = None,
        fecha_fin: Optional[str] = None,
        limit: int = 100,
        skip: int = 0
    ) -> List[dict]:
        """Lista cuadres con filtros.
        
        FIX BUG 2026-05-26: Matching flexible (case-insensitive) para sucursal_id.
        """
        try:
            query = {}
            
            if estado:
                query['estado'] = estado
            if sucursal_id:
                # FIX: Hacer matching flexible (case-insensitive, parcial)
                query['$or'] = [
                    {'corte_z.sucursal_id': {'$regex': sucursal_id, '$options': 'i'}},
                    {'corte_z.sucursal_nombre': {'$regex': sucursal_id, '$options': 'i'}}
                ]
            if fecha_inicio:
                query['corte_z.fecha_corte'] = {'$gte': fecha_inicio}
            if fecha_fin:
                if 'corte_z.fecha_corte' in query:
                    query['corte_z.fecha_corte']['$lte'] = fecha_fin
                else:
                    query['corte_z.fecha_corte'] = {'$lte': fecha_fin}
            
            cursor = self.collection.find(query).sort('created_at', -1).skip(skip).limit(limit)
            
            results = []
            for doc in cursor:
                doc['id'] = str(doc['_id'])
                del doc['_id']
                results.append(doc)
            
            return results
        except Exception as e:
            logger.error(f"Error listando cuadres: {e}")
            return []
    
    async def obtener_resumen(
        self,
        fecha_inicio: Optional[str] = None,
        fecha_fin: Optional[str] = None,
        sucursal_id: Optional[str] = None
    ) -> dict:
        """Obtiene resumen de cuadres.
        
        FIX BUG 2026-05-26: Agregado filtro sucursal_id para resumen por unidad.
        """
        try:
            query = {}
            if fecha_inicio:
                query['corte_z.fecha_corte'] = {'$gte': fecha_inicio}
            if fecha_fin:
                if 'corte_z.fecha_corte' in query:
                    query['corte_z.fecha_corte']['$lte'] = fecha_fin
                else:
                    query['corte_z.fecha_corte'] = {'$lte': fecha_fin}
            
            # FIX: Agregar filtro por sucursal_id si se proporciona
            if sucursal_id:
                # Hacer matching flexible (case-insensitive, parcial)
                query['$or'] = [
                    {'corte_z.sucursal_id': {'$regex': sucursal_id, '$options': 'i'}},
                    {'corte_z.sucursal_nombre': {'$regex': sucursal_id, '$options': 'i'}}
                ]
            
            pipeline = [
                {'$match': query},
                {
                    '$group': {
                        '_id': '$estado',
                        'count': {'$sum': 1},
                        'total_esperado': {'$sum': '$monto_esperado'},
                        'total_depositado': {'$sum': '$monto_depositado'},
                        'total_diferencia': {'$sum': '$diferencia'}
                    }
                }
            ]
            
            results = list(self.collection.aggregate(pipeline))
            
            resumen = {
                'PENDIENTE': {'count': 0, 'total_esperado': 0, 'total_depositado': 0},
                'EN_PROCESO': {'count': 0, 'total_esperado': 0, 'total_depositado': 0},
                'CUADRADO': {'count': 0, 'total_esperado': 0, 'total_depositado': 0},
                'DESCUADRE': {'count': 0, 'total_esperado': 0, 'total_depositado': 0}
            }
            
            for r in results:
                estado = r['_id']
                if estado in resumen:
                    resumen[estado] = {
                        'count': r['count'],
                        'total_esperado': r['total_esperado'],
                        'total_depositado': r['total_depositado'],
                        'total_diferencia': r.get('total_diferencia', 0)
                    }
            
            return resumen
        except Exception as e:
            logger.error(f"Error obteniendo resumen: {e}")
            return {}
    
    async def eliminar_cuadre(self, cuadre_id: str) -> bool:
        """Elimina un cuadre"""
        try:
            result = self.collection.delete_one({'_id': ObjectId(cuadre_id)})
            return result.deleted_count > 0
        except Exception as e:
            logger.error(f"Error eliminando cuadre: {e}")
            return False


