            user=username,
            password=password,
            login_timeout=15
        )
        cursor = conn.cursor(as_dict=True)
        
        tables_found = {}
        for table in tables_to_check:
            cursor.execute("""
                SELECT TABLE_NAME, TABLE_TYPE
                FROM INFORMATION_SCHEMA.TABLES
                WHERE TABLE_NAME = %s
            """, (table,))
            
