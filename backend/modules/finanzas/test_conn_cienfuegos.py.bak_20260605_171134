class DiagnosticResult:
    """Resultado estructurado de cada prueba de diagnóstico"""
    
    def __init__(self, test_name: str):
        self.test_name = test_name
        self.success = False
        self.status = "PENDING"
        self.message = ""
        self.data = {}
        self.error = None
        self.error_type = None
        self.timestamp = datetime.now().isoformat()
    
    def set_success(self, message: str, data: dict = None):
        self.success = True
        self.status = "PASS"
        self.message = message
        self.data = data or {}
    
    def set_failure(self, message: str, error: str = None, error_type: str = None, data: dict = None):
        self.success = False
        self.status = "FAIL"
        self.message = message
        self.error = error
        self.error_type = error_type
        self.data = data or {}
    
    def set_warning(self, message: str, data: dict = None):
        self.success = True  # Es warning, pero puede continuar
        self.status = "WARNING"
        self.message = message
        self.data = data or {}
    
    def __str__(self):
        icon = "✅" if self.success else "❌"
        if self.status == "WARNING":
            icon = "⚠️"
        return f"{icon} [{self.test_name}] {self.status}: {self.message}"


