def test_03_dns_resolution(hostname: str) -> DiagnosticResult:
    """Prueba 3: Resolución DNS del host"""
    result = DiagnosticResult("03_DNS_RESOLUTION")
    
    if not hostname:
        result.set_failure("Hostname vacío", error_type="EMPTY_HOSTNAME")
        return result
    
    try:
        ip_address = socket.gethostbyname(hostname)
        result.set_success(
            f"DNS resuelto correctamente: {hostname} -> {ip_address}",
            data={
                'hostname': hostname,
                'ip_address': ip_address
            }
        )
    except socket.gaierror as e:
        result.set_failure(
            f"DNS NO resuelve: {hostname}",
            error=str(e),
            error_type="DNS_RESOLUTION_FAILED",
            data={'hostname': hostname}
        )
    except socket.timeout:
        result.set_failure(
            f"Timeout resolviendo DNS: {hostname}",
            error_type="DNS_TIMEOUT",
            data={'hostname': hostname}
        )
    except Exception as e:
        result.set_failure(
            f"Error inesperado en resolución DNS: {str(e)}",
            error=str(e),
            error_type="DNS_UNKNOWN_ERROR"
        )
    
    return result


def test_04_tcp_port(hostname: str, port: int, timeout: int = 10) -> DiagnosticResult:
    """Prueba 4: Verificar apertura de puerto TCP"""
    result = DiagnosticResult("04_TCP_PORT")
    
    if not hostname:
        result.set_failure("Hostname vacío", error_type="EMPTY_HOSTNAME")
        return result
    
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        
        start_time = datetime.now()
        conn_result = sock.connect_ex((hostname, port))
        elapsed = (datetime.now() - start_time).total_seconds()
        
        sock.close()
        
        if conn_result == 0:
            result.set_success(
                f"Puerto TCP {port} ABIERTO en {hostname}",
                data={
                    'hostname': hostname,
                    'port': port,
                    'latency_seconds': round(elapsed, 3)
                }
            )
        else:
            result.set_failure(
                f"Puerto TCP {port} CERRADO o no accesible en {hostname}",
                error=f"connect_ex returned {conn_result}",
                error_type="PORT_CLOSED",
                data={
                    'hostname': hostname,
                    'port': port,
                    'error_code': conn_result
                }
            )
    except socket.timeout:
        result.set_failure(
            f"Timeout conectando a {hostname}:{port}",
            error_type="TCP_TIMEOUT",
            data={'hostname': hostname, 'port': port, 'timeout_seconds': timeout}
        )
    except Exception as e:
        result.set_failure(
            f"Error en prueba TCP: {str(e)}",
            error=str(e),
            error_type="TCP_ERROR"
        )
    
    return result


