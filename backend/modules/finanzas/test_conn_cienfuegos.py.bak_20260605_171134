def test_11_edarsahub_sync_status(unidad_negocio_id: str, server_id: str) -> DiagnosticResult:
    """Prueba 11: Verificar datos ya sincronizados en EDARSAHUB"""
    result = DiagnosticResult("11_EDARSAHUB_SYNC_STATUS")
    
    try:
        conn = get_edarsahub_connection()
        cursor = conn.cursor(as_dict=True)
        
        # Verificar registros existentes de CIENFUEGOS
        cursor.execute("""
            SELECT 
                COUNT(*) as total_registros,
                SUM(CASE WHEN EsDemo = 0 THEN 1 ELSE 0 END) as registros_reales,
                SUM(CASE WHEN EsDemo = 1 THEN 1 ELSE 0 END) as registros_demo,
                SUM(TotalEfectivo + ISNULL(TotalTarjetaDebito, 0) + ISNULL(TotalTarjetaCredito, 0)) as total_ingresos,
                MIN(FechaCorte) as fecha_min,
                MAX(FechaCorte) as fecha_max
            FROM Finanzas_CortesCaja
            WHERE UnidadNegocioID = %s
              AND SistemaOrigen = 'SoftRestaurant'
        """, (unidad_negocio_id,))
        
        stats = cursor.fetchone()
        
        # Verificar último SyncLog
        cursor.execute("""
            SELECT TOP 1
                LogID,
                FechaInicio,
                Estatus,
                RegistrosInsertados,
                RegistrosOmitidos,
                ErrorMensaje
            FROM Finanzas_CortesCaja_SyncLog
            WHERE UnidadNegocioID = %s
              AND SistemaOrigen = 'SoftRestaurant'
            ORDER BY FechaInicio DESC
        """, (unidad_negocio_id,))
        
        last_sync = cursor.fetchone()
        
        # Muestra de HashOrigen si existe
        cursor.execute("""
            SELECT TOP 1 HashOrigen
            FROM Finanzas_CortesCaja
            WHERE UnidadNegocioID = %s
              AND EsDemo = 0
              AND HashOrigen IS NOT NULL
        """, (unidad_negocio_id,))
        
        hash_sample = cursor.fetchone()
        conn.close()
        
        result.set_success(
            f"Estado de sincronización verificado en EDARSAHUB",
            data={
                'total_registros': stats['total_registros'] or 0,
                'registros_reales': stats['registros_reales'] or 0,
                'registros_demo': stats['registros_demo'] or 0,
                'total_ingresos': float(stats['total_ingresos'] or 0),
                'fecha_minima': str(stats['fecha_min']) if stats['fecha_min'] else None,
                'fecha_maxima': str(stats['fecha_max']) if stats['fecha_max'] else None,
                'ultimo_sync': {
                    'log_id': last_sync['LogID'] if last_sync else None,
                    'fecha': str(last_sync['FechaInicio']) if last_sync else None,
                    'estatus': last_sync['Estatus'] if last_sync else None,
                    'insertados': last_sync['RegistrosInsertados'] if last_sync else None,
                    'error': last_sync['ErrorMensaje'] if last_sync else None
                } if last_sync else None,
                'hash_sample': hash_sample['HashOrigen'][:16] + '...' if hash_sample and hash_sample['HashOrigen'] else None
            }
        )
            
    except Exception as e:
        result.set_failure(
            f"Error verificando sync status: {str(e)}",
            error=str(e),
            error_type="SYNC_STATUS_FAILED"
        )
    
    return result


