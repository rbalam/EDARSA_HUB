            error_type = "CONNECTION_FAILED"
        elif "timed out" in error_str.lower() or "timeout" in error_str.lower():
            error_type = "TIMEOUT"
        elif "network" in error_str.lower():
            error_type = "NETWORK_ERROR"
        elif "database" in error_str.lower() and "not exist" in error_str.lower():
            error_type = "DATABASE_NOT_EXISTS"
        
        result.set_failure(
            f"Conexión pymssql FALLIDA: {error_type}",
            error=error_str,
            error_type=error_type,
            data={
                'driver': 'pymssql',
                'server': server_string,
                'port': port,
                'database': database
            }
        )
        
    except Exception as e:
        result.set_failure(
            f"Error inesperado en pymssql: {str(e)}",
            error=str(e),
            error_type="PYMSSQL_UNKNOWN"
        )
    
