def parse_host_ddns(host_raw: str, default_port: int = 1433) -> Dict[str, Any]:
    """
    Parsea cadenas de conexión en varios formatos DDNS:
    - hostname
    - hostname,port
    - hostname\\instance
    - hostname,port\\instance
    
    Retorna dict con: host, port, instance
    """
    result = {
        'host': host_raw,
        'port': default_port,
        'instance': None,
        'original': host_raw
    }
    
    if not host_raw:
        return result
    
    host = host_raw.strip()
    
    # Caso: hostname,port\instance
    if ',' in host and '\\' in host:
        parts = host.split(',')
        result['host'] = parts[0]
        rest = parts[1]
        if '\\' in rest:
            port_str, instance = rest.split('\\', 1)
            try:
                result['port'] = int(port_str)
            except ValueError:
                pass
            result['instance'] = instance
        return result
    
    # Caso: hostname\instance
    if '\\' in host:
        parts = host.split('\\', 1)
        result['host'] = parts[0]
        result['instance'] = parts[1]
        return result
    
    # Caso: hostname,port
    if ',' in host:
        parts = host.split(',')
        result['host'] = parts[0]
        try:
            result['port'] = int(parts[1])
        except ValueError:
            pass
        return result
    
    # Caso: hostname:port (alternativo)
    if ':' in host:
        parts = host.split(':')
        result['host'] = parts[0]
        try:
            result['port'] = int(parts[1])
        except ValueError:
            pass
    
    return result


