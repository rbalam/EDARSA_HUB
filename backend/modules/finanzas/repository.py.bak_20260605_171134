# SQL para crear las tablas necesarias en EDARSA HUB
SQL_CREATE_TABLES = """
-- ============================================================================
-- TABLA: FIN_Configuracion_TPV
-- Configuración de comisiones de terminales punto de venta por sucursal
-- ============================================================================
