from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
EDARSA HUB - Solicitudes de Alta en Catálogos
==============================================
Sistema para solicitar altas en catálogos desde cualquier selector.

Flujo:
1. Usuario (Solicitador) → Crea solicitud
2. Supervisor (Creador) → Revisa y crea el registro
3. Administrador (Autorizador) → Autoriza para que esté disponible

Catálogos soportados:
- Puestos
- Departamentos
- Sucursales
- Tipos de Incidencia
"""

import logging
from datetime import datetime, timezone
from typing import Dict, Any, List, Optional
from fastapi import APIRouter, Depends, HTTPException, Query
from pydantic import BaseModel, Field
from core.security import get_current_user

router = APIRouter(prefix="/rrhh/solicitudes-catalogo", tags=["Solicitudes Catálogo"])

# ============================================================================
# ALMACENAMIENTO EN MEMORIA (Producción: migrar a SQL Server)
# ============================================================================
_solicitudes_db: List[Dict] = []
_solicitud_counter = 0

# ============================================================================
# SCHEMAS
# ============================================================================

class SolicitudCatalogoCreate(BaseModel):
    """Crear nueva solicitud de alta en catálogo"""
    tipo_catalogo: str = Field(..., description="puestos|departamentos|sucursales|tipos_incidencia")
    nombre_elemento: str = Field(..., min_length=2, max_length=100)
    motivo: str = Field(..., min_length=5, max_length=500)
    datos_adicionales: Optional[Dict] = Field(default={}, description="Campos específicos del catálogo")

class SolicitudCatalogoUpdate(BaseModel):
    """Actualizar solicitud (para creador/autorizador)"""
    accion: str = Field(..., description="aprobar|rechazar|crear")
    comentario: Optional[str] = None
    datos_creacion: Optional[Dict] = None

# ============================================================================
# CONFIGURACIÓN DE CATÁLOGOS
# ============================================================================

CATALOGOS_CONFIG = {
    "puestos": {
        "nombre": "Puestos",
        "campos_requeridos": ["nombre"],
        "campos_opcionales": ["descripcion", "nivel_jerarquico"],
    },
    "departamentos": {
        "nombre": "Departamentos", 
        "campos_requeridos": ["nombre"],
        "campos_opcionales": ["descripcion", "codigo"],
    },
    "sucursales": {
        "nombre": "Sucursales",
        "campos_requeridos": ["nombre"],
        "campos_opcionales": ["ciudad", "direccion", "telefono"],
    },
    "tipos_incidencia": {
        "nombre": "Tipos de Incidencia",
        "campos_requeridos": ["nombre", "codigo"],
        "campos_opcionales": ["descripcion", "afecta_nomina"],
    }
}

ESTADOS_SOLICITUD = {
    "pendiente": "Pendiente de Revisión",
    "en_creacion": "En Proceso de Creación",
    "creado": "Creado - Pendiente Autorización",
    "autorizado": "Autorizado ✓",
    "rechazado": "Rechazado ✗"
}

# ============================================================================
# ENDPOINTS
# ============================================================================

@router.get("/catalogos-disponibles")
async def get_catalogos_disponibles():
    """Retorna la lista de catálogos disponibles para solicitar altas"""
    return {
        "catalogos": [
            {"id": k, "nombre": v["nombre"], "campos_requeridos": v["campos_requeridos"], "campos_opcionales": v["campos_opcionales"]}
            for k, v in CATALOGOS_CONFIG.items()
        ]
    }


@router.post("")
async def crear_solicitud(
    solicitud: SolicitudCatalogoCreate,
    current_user: Dict = Depends(get_current_user)
):
    """
    Crear nueva solicitud de alta en catálogo.
    Cualquier usuario puede crear solicitudes.
    """
    global _solicitud_counter
    
    if solicitud.tipo_catalogo not in CATALOGOS_CONFIG:
        raise HTTPException(status_code=400, detail=f"Tipo de catálogo no válido: {solicitud.tipo_catalogo}")
    
    _solicitud_counter += 1
    
    nueva_solicitud = {
        "id": _solicitud_counter,
        "tipo_catalogo": solicitud.tipo_catalogo,
        "nombre_catalogo": CATALOGOS_CONFIG[solicitud.tipo_catalogo]["nombre"],
        "nombre_elemento": solicitud.nombre_elemento,
        "motivo": solicitud.motivo,
        "datos_adicionales": solicitud.datos_adicionales or {},
        "estado": "pendiente",
        "estado_nombre": ESTADOS_SOLICITUD["pendiente"],
        # Trazabilidad
        "solicitante_email": current_user.get("email"),
        "solicitante_nombre": current_user.get("name", current_user.get("email")),
        "fecha_solicitud": datetime.now(timezone.utc).isoformat(),
        "creador_email": None,
        "creador_nombre": None,
        "fecha_creacion": None,
        "autorizador_email": None,
        "autorizador_nombre": None,
        "fecha_autorizacion": None,
        "comentarios": [],
        "elemento_creado_id": None
    }
    
    _solicitudes_db.append(nueva_solicitud)
    logging.info(f"[SOLICITUD] Nueva solicitud #{_solicitud_counter} de {current_user.get('email')} para {solicitud.tipo_catalogo}: {solicitud.nombre_elemento}")
    
    return {
        "success": True,
        "message": "Solicitud creada correctamente",
        "solicitud": nueva_solicitud
    }


@router.get("")
async def listar_solicitudes(
    estado: Optional[str] = None,
    tipo_catalogo: Optional[str] = None,
    mis_solicitudes: bool = False,
    current_user: Dict = Depends(get_current_user)
):
    """
    Listar solicitudes según rol:
    - Usuario: solo sus propias solicitudes
    - Supervisor: solicitudes pendientes para crear
    - Administrador: todas las solicitudes
    """
    role = current_user.get("role", "Usuario")
    email = current_user.get("email")
    
    solicitudes = _solicitudes_db.copy()
    
    # Filtrar según rol
    if role == "Usuario" or mis_solicitudes:
        solicitudes = [s for s in solicitudes if s["solicitante_email"] == email]
    elif role == "Supervisor":
        # Supervisor ve pendientes y las que él está creando
        solicitudes = [s for s in solicitudes if s["estado"] in ["pendiente", "en_creacion"] or s["creador_email"] == email]
    # Administrador ve todas
    
    # Filtros adicionales
    if estado:
        solicitudes = [s for s in solicitudes if s["estado"] == estado]
    if tipo_catalogo:
        solicitudes = [s for s in solicitudes if s["tipo_catalogo"] == tipo_catalogo]
    
    # Ordenar por fecha más reciente
    solicitudes.sort(key=lambda x: x["fecha_solicitud"], reverse=True)
    
    # Conteos por estado
    conteos = {
        "pendientes": len([s for s in _solicitudes_db if s["estado"] == "pendiente"]),
        "en_creacion": len([s for s in _solicitudes_db if s["estado"] == "en_creacion"]),
        "creados": len([s for s in _solicitudes_db if s["estado"] == "creado"]),
        "autorizados": len([s for s in _solicitudes_db if s["estado"] == "autorizado"]),
        "rechazados": len([s for s in _solicitudes_db if s["estado"] == "rechazado"]),
    }
    
    return {
        "solicitudes": solicitudes,
        "total": len(solicitudes),
        "conteos": conteos
    }


@router.get("/pendientes-notificacion")
async def get_pendientes_notificacion(
    current_user: Dict = Depends(get_current_user)
):
    """
    Obtiene solicitudes pendientes de acción para el usuario actual.
    Para mostrar en "Mis Tareas".
    """
    role = current_user.get("role", "Usuario")
    email = current_user.get("email")
    
    pendientes = []
    
    if role == "Supervisor":
        # Solicitudes pendientes de crear
        pendientes = [s for s in _solicitudes_db if s["estado"] == "pendiente"]
    elif role == "Administrador":
        # Solicitudes pendientes de autorizar
        pendientes = [s for s in _solicitudes_db if s["estado"] == "creado"]
    else:
        # Usuario: sus solicitudes rechazadas o autorizadas recientes
        pendientes = [s for s in _solicitudes_db 
                     if s["solicitante_email"] == email 
                     and s["estado"] in ["autorizado", "rechazado"]]
    
    return {
        "pendientes": pendientes,
        "total": len(pendientes),
        "rol_usuario": role
    }


@router.put("/{solicitud_id}")
async def actualizar_solicitud(
    solicitud_id: int,
    update: SolicitudCatalogoUpdate,
    current_user: Dict = Depends(get_current_user)
):
    """
    Actualizar estado de solicitud:
    - Supervisor puede: aprobar (pasar a en_creacion), crear (pasar a creado), rechazar
    - Administrador puede: autorizar, rechazar
    """
    role = current_user.get("role", "Usuario")
    email = current_user.get("email")
    nombre = current_user.get("name", email)
    
    # Buscar solicitud
    solicitud = next((s for s in _solicitudes_db if s["id"] == solicitud_id), None)
    if not solicitud:
        raise HTTPException(status_code=404, detail="Solicitud no encontrada")
    
    ahora = datetime.now(timezone.utc).isoformat()
    
    # Validar permisos y acciones
    if update.accion == "aprobar":
        if role not in ["Supervisor", "Administrador"]:
            raise HTTPException(status_code=403, detail="No tiene permisos para aprobar")
        if solicitud["estado"] != "pendiente":
            raise HTTPException(status_code=400, detail="Solo se pueden aprobar solicitudes pendientes")
        
        solicitud["estado"] = "en_creacion"
        solicitud["estado_nombre"] = "En Proceso de Creación"
        solicitud["creador_email"] = email
        solicitud["creador_nombre"] = nombre
        
    elif update.accion == "crear":
        if role not in ["Supervisor", "Administrador"]:
            raise HTTPException(status_code=403, detail="No tiene permisos para crear")
        if solicitud["estado"] not in ["pendiente", "en_creacion"]:
            raise HTTPException(status_code=400, detail="Solicitud no está en estado válido para crear")
        
        solicitud["estado"] = "creado"
        solicitud["estado_nombre"] = "Creado - Pendiente Autorización"
        solicitud["creador_email"] = email
        solicitud["creador_nombre"] = nombre
        solicitud["fecha_creacion"] = ahora
        if update.datos_creacion:
            solicitud["datos_adicionales"].update(update.datos_creacion)
        
    elif update.accion == "autorizar":
        if role != "Administrador":
            raise HTTPException(status_code=403, detail="Solo Administrador puede autorizar")
        if solicitud["estado"] != "creado":
            raise HTTPException(status_code=400, detail="Solo se pueden autorizar solicitudes creadas")
        
        solicitud["estado"] = "autorizado"
        solicitud["estado_nombre"] = "Autorizado ✓"
        solicitud["autorizador_email"] = email
        solicitud["autorizador_nombre"] = nombre
        solicitud["fecha_autorizacion"] = ahora
        
        # TODO: Aquí se insertaría en el catálogo real de SQL Server
        # Por ahora solo marcamos como autorizado
        
    elif update.accion == "rechazar":
        if role not in ["Supervisor", "Administrador"]:
            raise HTTPException(status_code=403, detail="No tiene permisos para rechazar")
        
        solicitud["estado"] = "rechazado"
        solicitud["estado_nombre"] = "Rechazado ✗"
        
    else:
        raise HTTPException(status_code=400, detail=f"Acción no válida: {update.accion}")
    
    # Agregar comentario si existe
    if update.comentario:
        solicitud["comentarios"].append({
            "usuario": nombre,
            "email": email,
            "fecha": ahora,
            "comentario": update.comentario,
            "accion": update.accion
        })
    
    logging.info(f"[SOLICITUD] #{solicitud_id} actualizada a {solicitud['estado']} por {email}")
    
    return {
        "success": True,
        "message": f"Solicitud {update.accion} correctamente",
        "solicitud": solicitud
    }


@router.get("/{solicitud_id}")
async def get_solicitud(
    solicitud_id: int,
    current_user: Dict = Depends(get_current_user)
):
    """Obtener detalle de una solicitud"""
    solicitud = next((s for s in _solicitudes_db if s["id"] == solicitud_id), None)
    if not solicitud:
        raise HTTPException(status_code=404, detail="Solicitud no encontrada")
    
    return {"solicitud": solicitud}
