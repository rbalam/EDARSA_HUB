def validar_curp(curp: Optional[str]) -> ResultadoValidacion:
    """Valida formato de CURP."""
    if not curp or curp.strip() == '':
        return ResultadoValidacion(
            campo="curp",
            valor_original=curp,
            valor_normalizado=None,
            es_valido=True,  # CURP es opcional
            mensaje="Campo vacío (opcional)"
        )
    
    curp_norm = curp.strip().upper()
    
    if len(curp_norm) != 18:
        return ResultadoValidacion(
            campo="curp",
            valor_original=curp,
            valor_normalizado=curp_norm,
            es_valido=False,
            mensaje=f"CURP debe tener 18 caracteres, tiene {len(curp_norm)}"
        )
    
    # Patrón: 4 letras + 6 dígitos + H/M + 5 letras + alfanumérico + dígito
    pattern = r'^[A-Z]{4}\d{6}[HM][A-Z]{5}[A-Z0-9]\d$'
    if not re.match(pattern, curp_norm):
        return ResultadoValidacion(
            campo="curp",
            valor_original=curp,
            valor_normalizado=curp_norm,
            es_valido=False,
            mensaje="Formato de CURP inválido"
        )
    
    return ResultadoValidacion(
        campo="curp",
        valor_original=curp,
        valor_normalizado=curp_norm,
        es_valido=True
    )


def validar_rfc(rfc: Optional[str]) -> ResultadoValidacion:
    """Valida formato de RFC."""
    if not rfc or rfc.strip() == '':
        return ResultadoValidacion(
            campo="rfc",
            valor_original=rfc,
            valor_normalizado=None,
            es_valido=True,  # RFC es opcional
            mensaje="Campo vacío (opcional)"
        )
    
    rfc_norm = rfc.strip().upper()
    
    if len(rfc_norm) not in (12, 13):
        return ResultadoValidacion(
            campo="rfc",
            valor_original=rfc,
            valor_normalizado=rfc_norm,
            es_valido=False,
            mensaje=f"RFC debe tener 12 o 13 caracteres, tiene {len(rfc_norm)}"
        )
    
    # Patrón básico RFC
    pattern = r'^[A-ZÑ&]{3,4}\d{6}[A-Z0-9]{3}$'
    if not re.match(pattern, rfc_norm):
        return ResultadoValidacion(
            campo="rfc",
            valor_original=rfc,
            valor_normalizado=rfc_norm,
            es_valido=False,
            mensaje="Formato de RFC inválido",
            advertencia="Verificar manualmente"
        )
    
    return ResultadoValidacion(
        campo="rfc",
        valor_original=rfc,
        valor_normalizado=rfc_norm,
        es_valido=True
    )


def validar_nombre(nombre: Optional[str]) -> ResultadoValidacion:
    """Valida que el nombre no esté vacío."""
    if not nombre or nombre.strip() == '':
        return ResultadoValidacion(
            campo="nombre_completo",
            valor_original=nombre,
            valor_normalizado=None,
            es_valido=False,
            mensaje="Nombre completo es requerido"
        )
    
    nombre_norm = nombre.strip().upper()
    
    if len(nombre_norm) < 3:
        return ResultadoValidacion(
            campo="nombre_completo",
            valor_original=nombre,
            valor_normalizado=nombre_norm,
            es_valido=False,
            mensaje="Nombre demasiado corto"
        )
    
    return ResultadoValidacion(
        campo="nombre_completo",
        valor_original=nombre,
        valor_normalizado=nombre_norm,
        es_valido=True
    )


