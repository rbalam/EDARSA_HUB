class ImportadorExcelService:
    """
    Servicio para importación de archivos Excel de Cienfuegos.
    
    El Excel de Cienfuegos es un cálculo de nómina semanal, NO un catálogo
    maestro limpio. Por eso se requiere:
    - Validación previa
    - Preview de registros detectados
    - Separación entre nuevos, duplicados, incompletos
    - Carga inicial a staging (NO directo a maestro)
    """
    
    # Mapeo de columnas Excel → campos internos
    MAPEO_COLUMNAS_RESUMEN = {
        'NOMBRE': 'nombre_completo',
        'ÁREA': 'area_departamento',
        'PUESTO': 'puesto_nombre',
        'SEXO': 'sexo',
        'EDAD': 'edad',
        'ANTIGUEDAD': 'antiguedad',
        'SUELDO DIARIO': 'sueldo_diario',
        'SUELDO TOTAL DIARIO': 'sueldo_diario',
        'MÉTODO DE PAGO': 'metodo_pago',
        'N°': 'numero_empleado_externo',
    }
    
    # Columnas requeridas mínimas
    COLUMNAS_REQUERIDAS = ['NOMBRE']
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self._server = None
        self._catalogo_sucursales = {}
        self._catalogo_puestos = {}
    
    async def _get_server(self):
        """Obtiene servidor EDARSA HUB."""
        if self._server is None:
            self._server = await get_edarsa_hub_server()
        return self._server
    
    async def _cargar_catalogos(self, server: Dict):
        """Carga catálogos de sucursales y puestos para resolver IDs."""
        # Cargar sucursales
        try:
            sucursales = execute_hub_query(server, """
                SELECT SucursalID, Nombre FROM RH_Cat_Sucursales
            """)
            self._catalogo_sucursales = {
                s['Nombre'].upper(): s['SucursalID'] 
                for s in sucursales if s.get('Nombre')
            }
        except Exception as e:
            self.logger.warning(f"No se pudieron cargar sucursales: {e}")
        
        # Cargar puestos
        try:
            puestos = execute_hub_query(server, """
                SELECT PuestoID, Descripcion, Departamento FROM RH_Cat_Puestos
            """)
            self._catalogo_puestos = {
                p['Descripcion'].upper(): p['PuestoID'] 
                for p in puestos if p.get('Descripcion')
            }
        except Exception as e:
            self.logger.warning(f"No se pudieron cargar puestos: {e}")
    
    def _resolver_sucursal_id(self, sucursal_nombre: Optional[str]) -> Optional[int]:
        """Resuelve el ID de sucursal a partir del nombre."""
        if not sucursal_nombre:
            return None
        nombre_upper = sucursal_nombre.strip().upper()
        return self._catalogo_sucursales.get(nombre_upper)
    
    def _resolver_puesto_id(self, puesto_nombre: Optional[str]) -> Optional[int]:
        """Resuelve el ID de puesto a partir del nombre."""
        if not puesto_nombre:
            return None
        nombre_upper = puesto_nombre.strip().upper()
        return self._catalogo_puestos.get(nombre_upper)
    
    async def extraer_datos_excel(
        self,
        contenido_archivo: bytes,
        nombre_archivo: str,
        hoja_nombre: Optional[str] = None,
        fila_inicio: int = 1
    ) -> Tuple[List[Dict], List[str]]:
        """
        Extrae datos de un archivo Excel.
        
        Args:
            contenido_archivo: Bytes del archivo Excel
            nombre_archivo: Nombre original del archivo
            hoja_nombre: Nombre de la hoja a procesar (opcional)
            fila_inicio: Fila donde inician los datos (1-indexed)
        
        Returns:
            Tuple de (lista de registros, lista de errores)
        """
        if not PANDAS_DISPONIBLE:
            return [], ["Librería pandas no disponible"]
        
        errores = []
        registros = []
        
        try:
            # Leer Excel con pandas
            excel_file = io.BytesIO(contenido_archivo)
            
            # Determinar hoja a leer
            if hoja_nombre:
                df = pd.read_excel(excel_file, sheet_name=hoja_nombre, header=fila_inicio-1)
            else:
                # Intentar encontrar hoja con "RESUMEN" o "NÓMINA"
                xls = pd.ExcelFile(excel_file)
                hoja_objetivo = None
                for sheet in xls.sheet_names:
                    if 'RESUMEN' in sheet.upper() or 'NÓMINA' in sheet.upper():
                        hoja_objetivo = sheet
                        break
                
                if hoja_objetivo:
                    df = pd.read_excel(xls, sheet_name=hoja_objetivo, header=fila_inicio-1)
                else:
                    # Usar primera hoja
                    df = pd.read_excel(xls, sheet_name=0, header=fila_inicio-1)
            
            # Normalizar nombres de columnas
            df.columns = [str(col).strip().upper() for col in df.columns]
            
            # Verificar columnas requeridas
            for col in self.COLUMNAS_REQUERIDAS:
                if col not in df.columns:
                    errores.append(f"Columna requerida '{col}' no encontrada")
            
            if errores:
                return [], errores
            
            # Procesar filas
            for idx, row in df.iterrows():
                linea = idx + fila_inicio + 1  # +1 por header
                
                # Saltar filas vacías
                nombre = row.get('NOMBRE', '')
                if pd.isna(nombre) or str(nombre).strip() == '':
                    continue
                
                registro = {
                    'linea_origen': linea,
                    'archivo_origen': nombre_archivo,
                    'fuente': 'Excel_CF',
                }
                
                # Mapear columnas
                for col_excel, campo_interno in self.MAPEO_COLUMNAS_RESUMEN.items():
                    if col_excel in df.columns:
                        valor = row.get(col_excel)
                        if pd.notna(valor):
                            # Convertir tipos
                            if campo_interno in ['edad']:
                                try:
                                    registro[campo_interno] = int(valor)
                                except (ValueError, TypeError):
                                    registro[campo_interno] = None
                            elif campo_interno in ['sueldo_diario']:
                                try:
                                    registro[campo_interno] = float(valor)
                                except (ValueError, TypeError):
                                    registro[campo_interno] = None
                            else:
                                registro[campo_interno] = str(valor).strip()
                
                registros.append(registro)
            
            self.logger.info(f"Extraídos {len(registros)} registros de {nombre_archivo}")
            
        except Exception as e:
            errores.append(f"Error leyendo Excel: {str(e)}")
            self.logger.error(f"Error en extraer_datos_excel: {e}")
        
        return registros, errores
    
    async def validar_y_clasificar_registro(
        self,
        registro: Dict,
        server: Dict
    ) -> ClasificacionRegistro:
        """
        Valida un registro y lo clasifica según reglas de deduplicación.
        
        ORDEN DE DEDUPLICACIÓN:
        1. CURP → Confianza ALTA
        2. RFC → Confianza MEDIA
        3. Número empleado → Confianza BAJA
        4. Nombre + Sucursal → Confianza MUY BAJA
        5. Coincidencias parciales → Requiere revisión
        """
        validaciones = []
        
        # Validar campos
        val_nombre = validar_nombre(registro.get('nombre_completo'))
        validaciones.append(val_nombre)
        
        val_curp = validar_curp(registro.get('curp'))
        validaciones.append(val_curp)
        
        val_rfc = validar_rfc(registro.get('rfc'))
        validaciones.append(val_rfc)
        
        # Resolver IDs de catálogo
        sucursal_id = self._resolver_sucursal_id(registro.get('area_departamento'))
        puesto_id = self._resolver_puesto_id(registro.get('puesto_nombre'))
        
        # Si no se resuelven IDs, marcar como incompleto
        if not sucursal_id and not puesto_id:
            return ClasificacionRegistro(
                linea_origen=registro.get('linea_origen', 0),
                nombre_completo=val_nombre.valor_normalizado or registro.get('nombre_completo', ''),
                curp=val_curp.valor_normalizado,
                rfc=val_rfc.valor_normalizado,
                clasificacion=CLASIFICACION_INCOMPLETO,
                razon="No se pudo resolver sucursal ni puesto en catálogos",
                validaciones=validaciones,
                es_valido_para_carga=False
            )
        
        # Si el nombre no es válido, rechazar
        if not val_nombre.es_valido:
            return ClasificacionRegistro(
                linea_origen=registro.get('linea_origen', 0),
                nombre_completo=registro.get('nombre_completo', ''),
                clasificacion=CLASIFICACION_RECHAZADO,
                razon=val_nombre.mensaje or "Nombre inválido",
                validaciones=validaciones,
                es_valido_para_carga=False
            )
        
        nombre_norm = val_nombre.valor_normalizado
        curp_norm = val_curp.valor_normalizado
        rfc_norm = val_rfc.valor_normalizado
        
        # =====================================================================
        # BÚSQUEDA DE DUPLICADOS (en orden de confianza)
        # =====================================================================
        
        colaborador_existente = None
        nivel_confianza = None
        
        # 1. Buscar por CURP (confianza ALTA)
        if curp_norm:
            matches = await buscar_duplicados_por_curp(server, curp_norm)
            if matches:
                colaborador_existente = matches[0]
                nivel_confianza = CONFIANZA_ALTA
        
        # 2. Buscar por RFC (confianza MEDIA)
        if not colaborador_existente and rfc_norm:
            matches = await buscar_duplicados_por_rfc(server, rfc_norm)
            if matches:
                colaborador_existente = matches[0]
                nivel_confianza = CONFIANZA_MEDIA
        
        # 3. Buscar por Nombre + Sucursal (confianza MUY BAJA)
        if not colaborador_existente and sucursal_id:
            matches = await buscar_duplicados_por_nombre_sucursal(
                server, nombre_norm, sucursal_id
            )
            if matches:
                colaborador_existente = matches[0]
                nivel_confianza = CONFIANZA_MUY_BAJA
        
        # 4. Buscar coincidencias parciales (requiere revisión)
        if not colaborador_existente:
            matches = await buscar_coincidencias_parciales(server, nombre_norm)
            if matches:
                # Solo marcar si hay alta similitud
                for match in matches[:3]:  # Máximo 3 candidatos
                    colaborador_existente = match
                    nivel_confianza = CONFIANZA_REVISION
                    break
        
        # =====================================================================
        # CLASIFICACIÓN FINAL
        # =====================================================================
        
        if colaborador_existente:
            # Determinar si es actualización o duplicado probable
            if nivel_confianza in [CONFIANZA_ALTA, CONFIANZA_MEDIA]:
                # Alta/Media confianza → Actualizar
                return ClasificacionRegistro(
                    linea_origen=registro.get('linea_origen', 0),
                    nombre_completo=nombre_norm,
                    curp=curp_norm,
                    rfc=rfc_norm,
                    clasificacion=CLASIFICACION_ACTUALIZAR,
                    nivel_confianza=nivel_confianza,
                    razon=f"Match encontrado por {'CURP' if nivel_confianza == CONFIANZA_ALTA else 'RFC'}",
                    colaborador_existente_id=colaborador_existente.get('ColaboradorID'),
                    colaborador_existente_nombre=colaborador_existente.get('Nombre_Completo'),
                    validaciones=validaciones,
                    es_valido_para_carga=True
                )
            else:
                # Baja/Muy baja confianza → Duplicado probable, requiere revisión
                return ClasificacionRegistro(
                    linea_origen=registro.get('linea_origen', 0),
                    nombre_completo=nombre_norm,
                    curp=curp_norm,
                    rfc=rfc_norm,
                    clasificacion=CLASIFICACION_DUPLICADO_PROBABLE,
                    nivel_confianza=nivel_confianza,
                    razon="Posible duplicado - requiere revisión manual",
                    colaborador_existente_id=colaborador_existente.get('ColaboradorID'),
                    colaborador_existente_nombre=colaborador_existente.get('Nombre_Completo'),
                    validaciones=validaciones,
                    es_valido_para_carga=False  # Requiere aprobación manual
                )
        
        # No hay match → Registro nuevo
        # Verificar si tiene datos suficientes
        if not curp_norm and not rfc_norm:
            return ClasificacionRegistro(
                linea_origen=registro.get('linea_origen', 0),
                nombre_completo=nombre_norm,
                clasificacion=CLASIFICACION_INCOMPLETO,
                razon="Sin CURP ni RFC - datos insuficientes para identificación única",
                validaciones=validaciones,
                es_valido_para_carga=False
            )
        
        return ClasificacionRegistro(
            linea_origen=registro.get('linea_origen', 0),
            nombre_completo=nombre_norm,
            curp=curp_norm,
            rfc=rfc_norm,
            clasificacion=CLASIFICACION_NUEVO,
            nivel_confianza=CONFIANZA_ALTA if curp_norm else CONFIANZA_MEDIA,
            razon="Nuevo colaborador - no existe en base de datos",
            validaciones=validaciones,
            es_valido_para_carga=True
        )
    
    async def generar_preview(
        self,
        contenido_archivo: bytes,
        nombre_archivo: str,
        usuario: str,
        hoja_nombre: Optional[str] = None
    ) -> PreviewImportacion:
        """
        Genera un preview completo de la importación para revisión.
        
        NO inserta nada en staging todavía. Solo analiza y clasifica.
        """
        server = await self._get_server()
        if not server:
            return PreviewImportacion(
                archivo_origen=nombre_archivo,
                fuente="Excel_CF",
                fecha_preview=datetime.now(),
                usuario=usuario,
                errores_globales=["Servidor EDARSA HUB no disponible"]
            )
        
        # Cargar catálogos para resolver IDs
        await self._cargar_catalogos(server)
        
        # Extraer datos del Excel
        registros, errores = await self.extraer_datos_excel(
            contenido_archivo, nombre_archivo, hoja_nombre
        )
        
        if errores:
            return PreviewImportacion(
                archivo_origen=nombre_archivo,
                fuente="Excel_CF",
                fecha_preview=datetime.now(),
                usuario=usuario,
                errores_globales=errores
            )
        
        # Clasificar cada registro
        preview = PreviewImportacion(
            archivo_origen=nombre_archivo,
            fuente="Excel_CF",
            fecha_preview=datetime.now(),
            usuario=usuario,
            total_registros=len(registros)
        )
        
        for registro in registros:
            clasificacion = await self.validar_y_clasificar_registro(registro, server)
            
            # Agregar a la lista correspondiente
            if clasificacion.clasificacion == CLASIFICACION_NUEVO:
                preview.registros_nuevos.append(clasificacion)
                preview.total_nuevos += 1
            elif clasificacion.clasificacion == CLASIFICACION_ACTUALIZAR:
                preview.registros_actualizar.append(clasificacion)
                preview.total_actualizar += 1
            elif clasificacion.clasificacion == CLASIFICACION_DUPLICADO_PROBABLE:
                preview.registros_duplicados_probables.append(clasificacion)
                preview.total_duplicados_probables += 1
            elif clasificacion.clasificacion == CLASIFICACION_INCOMPLETO:
                preview.registros_incompletos.append(clasificacion)
                preview.total_incompletos += 1
            elif clasificacion.clasificacion == CLASIFICACION_RECHAZADO:
                preview.registros_rechazados.append(clasificacion)
                preview.total_rechazados += 1
        
        # Agregar advertencias globales
        if preview.total_incompletos > 0:
            preview.advertencias_globales.append(
                f"{preview.total_incompletos} registros sin CURP/RFC - no se pueden identificar de forma única"
            )
        if preview.total_duplicados_probables > 0:
            preview.advertencias_globales.append(
                f"{preview.total_duplicados_probables} posibles duplicados requieren revisión manual"
            )
        if not self._catalogo_sucursales:
            preview.advertencias_globales.append(
                "Catálogo de sucursales vacío - no se resolvieron IDs de sucursal"
            )
        if not self._catalogo_puestos:
            preview.advertencias_globales.append(
                "Catálogo de puestos vacío - no se resolvieron IDs de puesto"
            )
        
        return preview
    
    async def cargar_a_staging(
        self,
        contenido_archivo: bytes,
        nombre_archivo: str,
        usuario: str,
        hoja_nombre: Optional[str] = None,
        solo_validos: bool = True
    ) -> Dict[str, Any]:
        """
        Carga registros a la tabla de staging para posterior aprobación.
        
        Args:
            solo_validos: Si True, solo carga registros nuevos y actualizables.
                         Si False, carga todos incluyendo incompletos.
        """
        server = await self._get_server()
        if not server:
            return {"success": False, "error": "Servidor EDARSA HUB no disponible"}
        
        # Cargar catálogos
        await self._cargar_catalogos(server)
        
        # Extraer datos
        registros, errores = await self.extraer_datos_excel(
            contenido_archivo, nombre_archivo, hoja_nombre
        )
        
        if errores:
            return {"success": False, "errores": errores}
        
        resultado = {
            "total_leidos": len(registros),
            "total_insertados_staging": 0,
            "total_omitidos": 0,
            "errores": [],
            "success": True
        }
        
        for registro in registros:
            # Clasificar
            clasificacion = await self.validar_y_clasificar_registro(registro, server)
            
            # Filtrar según solo_validos
            if solo_validos and not clasificacion.es_valido_para_carga:
                resultado["total_omitidos"] += 1
                continue
            
            # Preparar datos para staging
            staging_data = {
                **registro,
                'sucursal_id': self._resolver_sucursal_id(registro.get('area_departamento')),
                'puesto_id': self._resolver_puesto_id(registro.get('puesto_nombre')),
            }
            
            # Insertar en staging
            insert_result = await insertar_staging(server, staging_data, usuario)
            
            if insert_result.get('success'):
                resultado["total_insertados_staging"] += 1
            else:
                resultado["errores"].append({
                    "linea": registro.get('linea_origen'),
                    "error": insert_result.get('error', 'Error desconocido')
                })
        
        return resultado
