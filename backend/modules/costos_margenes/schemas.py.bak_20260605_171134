from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Schemas Pydantic para el módulo Costos y Márgenes.
FASE 1C-3C - Endpoints NO-LIVE
"""

from pydantic import BaseModel, Field
from typing import Optional, List, Dict, Any
from datetime import datetime
from decimal import Decimal
from enum import Enum


class SourceType(str, Enum):
    """Tipos de fuente permitidos - NO-LIVE."""
    EDARSAHUB_SQL = "EDARSAHUB_SQL"
    STALE_EDARSAHUB_SQL = "STALE_EDARSAHUB_SQL"
    SIN_DATOS_EDARSAHUB = "SIN_DATOS_EDARSAHUB"


class TipoComponente(str, Enum):
    """Tipos de componente en una receta."""
    INSUMO_DIRECTO = "INSUMO_DIRECTO"
    INSUMO_ELABORADO = "INSUMO_ELABORADO"
    SUBRECETA = "SUBRECETA"


# ==================== RESUMEN ====================

class CostosMargenesResumen(BaseModel):
    """Respuesta del endpoint /api/costos-margenes/resumen"""
    
    # Conteos
    total_productos: int = 0
    productos_con_receta: int = 0
    productos_sin_receta: int = 0
    total_insumos: int = 0
    total_recetas: int = 0
    total_subrecetas: int = 0
    
    # Promedios (null si no hay datos confiables)
    costo_promedio_general: Optional[float] = None
    margen_promedio_porcentaje: Optional[float] = None
    
    # Alertas
    productos_margen_bajo: int = 0
    productos_sin_costo: int = 0
    productos_sin_precio: int = 0
    
    # Metadata sync
    ultima_sincronizacion: Optional[datetime] = None
    sync_run_id: Optional[str] = None
    
    # Source
    source_type: SourceType = SourceType.EDARSAHUB_SQL
    
    class Config:
        use_enum_values = True


# ==================== PRODUCTOS ====================

class EstadoImpuesto(str, Enum):
    """Estados de impuesto para validación de pricing - FASE 1C-3G-B."""
    OK = "OK"  # Tasa válida (incluye 0% tasa cero fiscal)
    IMPUESTO_NO_CONFIGURADO = "IMPUESTO_NO_CONFIGURADO"  # Producto sin homologación fiscal


class ProductoCostoMargen(BaseModel):
    """Producto con información de costo y margen."""
    
    producto_id: str
    id_producto_origen: str
    nombre: str
    nombre_corto: Optional[str] = None
    
    # Origen
    sistema_origen: str
    server_id: str
    empresa_id: Optional[int] = None
    unidad_negocio_id: Optional[int] = None
    
    # Clasificación
    familia: Optional[str] = None
    subfamilia: Optional[str] = None
    
    # Precios y costos (null si no hay dato, NO cero falso)
    precio_venta: Optional[float] = None
    precio_sin_impuestos: Optional[float] = None
    costo_receta: Optional[float] = None
    costo_promedio: Optional[float] = None
    
    # FASE 1C-3G-B: Impuestos homologados
    # tasa_impuesto: None = IMPUESTO_NO_CONFIGURADO, 0 = Tasa cero válida, >0 = IVA/IEPS
    tasa_impuesto: Optional[float] = None
    estado_impuesto: Optional[str] = None  # OK, IMPUESTO_NO_CONFIGURADO
    
    # Márgenes (null si no se puede calcular)
    margen_pesos: Optional[float] = None
    margen_porcentaje: Optional[float] = None
    margen_objetivo: Optional[float] = None
    
    # Receta
    tiene_receta: bool = False
    tiene_subrecetas: bool = False
    numero_insumos: int = 0
    
    # Metadata
    ultima_sincronizacion: Optional[datetime] = None
    source_type: SourceType = SourceType.EDARSAHUB_SQL
    
    class Config:
        use_enum_values = True


class ProductosListResponse(BaseModel):
    """Respuesta paginada de productos."""
    
    productos: List[ProductoCostoMargen]
    total: int
    page: int
    page_size: int
    total_pages: int
    source_type: SourceType = SourceType.EDARSAHUB_SQL
    
    class Config:
        use_enum_values = True


# ==================== RECETA ====================

class ComponenteReceta(BaseModel):
    """Componente de una receta (insumo o subreceta)."""
    
    componente_id: str
    codigo_fuente: str
    nombre: str
    tipo_componente: str  # INSUMO_DIRECTO, INSUMO_ELABORADO, SUBRECETA
    
    cantidad: float
    unidad_medida: str
    
    costo_unitario: Optional[float] = None
    costo_total: Optional[float] = None
    porcentaje_costo_total: Optional[float] = None
    
    nivel_jerarquico: int = 1
    es_elaborado: bool = False
    rendimiento_elaborado: Optional[float] = None
    
    # Subcomponentes si es elaborado/subreceta
    subcomponentes: Optional[List["ComponenteReceta"]] = None


class RecetaExpandida(BaseModel):
    """Receta completa de un producto."""
    
    producto_id: str
    producto_nombre: str
    producto_codigo: str
    
    sistema_origen: str
    server_id: str
    
    # Totales
    costo_total_receta: Optional[float] = None
    total_componentes: int = 0
    total_insumos_directos: int = 0
    total_elaborados: int = 0
    total_subrecetas: int = 0
    
    # Componentes
    componentes: List[ComponenteReceta] = []
    
    # Metadata
    sync_run_id: Optional[str] = None
    ultima_sincronizacion: Optional[datetime] = None
    source_type: SourceType = SourceType.EDARSAHUB_SQL
    
    class Config:
        use_enum_values = True


# ==================== INSUMOS CONSOLIDADOS ====================

class InsumoConsolidado(BaseModel):
    """Insumo consolidado de un producto (lista plana)."""
    
    insumo_id: str
    codigo_fuente: str
    nombre: str
    
    cantidad_total: float
    unidad_medida: str
    
    costo_unitario: Optional[float] = None
    costo_total: Optional[float] = None
    porcentaje_costo_total: Optional[float] = None
    
    origen: str  # DIRECTO, SUBRECETA, ELABORADO
    nivel_origen: int = 1
    es_elaborado: bool = False


class InsumosProductoResponse(BaseModel):
    """Lista consolidada de insumos de un producto."""
    
    producto_id: str
    producto_nombre: str
    
    total_insumos: int = 0
    costo_total_insumos: Optional[float] = None
    
    insumos: List[InsumoConsolidado] = []
    
    source_type: SourceType = SourceType.EDARSAHUB_SQL
    
    class Config:
        use_enum_values = True


# ==================== SYNC STATUS ====================

class ConteoTabla(BaseModel):
    """Conteo de registros en una tabla."""
    tabla: str
    registros: int


class ConteoPorSistema(BaseModel):
    """Conteo por sistema origen."""
    sistema: str
    registros: int


class ConteoPorServidor(BaseModel):
    """Conteo por servidor."""
    servidor_id: str
    servidor_nombre: Optional[str] = None
    sistema: str
    registros: int


class SyncStatusResponse(BaseModel):
    """Estado de sincronización."""
    
    ultimo_sync_run_id: Optional[str] = None
    fecha_ultima_sincronizacion: Optional[datetime] = None
    
    # Conteos
    registros_por_tabla: List[ConteoTabla] = []
    registros_por_sistema: List[ConteoPorSistema] = []
    registros_por_servidor: List[ConteoPorServidor] = []
    
    total_registros: int = 0
    
    # Errores conocidos
    errores: List[str] = []
    warnings: List[str] = []
    
    # Estado general
    estado: SourceType = SourceType.EDARSAHUB_SQL
    
    class Config:
        use_enum_values = True


