async def obtener_detalle_factura(server_id: str, folio: str) -> List[Dict]:
    """
    Obtiene el detalle de productos de una factura/entrada.
    
    FASE 3A: Blindaje - Solo disponible en MPRO
    """
    server = await repo.get_server_by_id(server_id)
    if not server:
        raise HTTPException(status_code=404, detail="Servidor no encontrado")
    
    system_type = server.get('system_type', 'UNKNOWN')
    
    try:
        if is_mpro_system(system_type):
            log_compras_adapter_selected("detalle-factura", server_id, system_type, "MPRO_ADAPTER")
            result = repo.query_detalle_factura_mpro(server, folio)
            log_compras_query_result("detalle-factura", server_id, "SUCCESS", len(result))
            
            return [
                {
                    "codigo": r['codigo'],
                    "producto": r['producto'],
                    "cantidad": float(r['cantidad'] or 0),
                    "costo": float(r['costo'] or 0),
                    "importe": float(r['importe'] or 0)
                }
                for r in result
            ]
        
        # FASE 3A: No disponible para este sistema
        log_compras_adapter_selected("detalle-factura", server_id, system_type, "NO_ADAPTER_AVAILABLE")
        raise HTTPException(
            status_code=400,
            detail=f"El detalle de factura solo está disponible para sistemas MPRO. Sistema actual: {system_type}"
        )
        
    except HTTPException:
        raise
    except Exception as e:
        log_compras_error("detalle-factura", server_id, "QUERY_ERROR", str(e), system_type)
        raise HTTPException(status_code=500, detail=str(e))


