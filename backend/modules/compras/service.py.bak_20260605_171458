async def obtener_pedidos_vigentes(server_id: str, sucursal_id: str = None) -> List[Dict]:
    """
    Obtiene pedidos/requisiciones vigentes.
    Soporta MPRO y SoftRestaurant.
    
    FASE 3A - Blindaje:
    - Maneja resultado homologado de ComprasQueryResult
    - No propaga errores que contaminen otros módulos
    - Distingue NO_DATA de errores técnicos
    """
    server = await repo.get_server_by_id(server_id)
    if not server:
        raise HTTPException(status_code=404, detail="Servidor no encontrado")
    
    system_type = server.get('system_type', 'UNKNOWN')
    normalized = normalize_system_type(system_type)
    
    try:
        if is_mpro_system(system_type):
            log_compras_adapter_selected("pedidos-vigentes", server_id, system_type, "MPRO_ADAPTER", sucursal_id)
            result = repo.query_pedidos_vigentes_mpro(server, sucursal_id)
            # MPRO retorna lista directamente (TODO: migrar a ComprasQueryResult)
            data = result if result else []
            log_compras_query_result("pedidos-vigentes", server_id, "SUCCESS", len(data))
            
        elif is_softrestaurant_system(system_type):
            log_compras_adapter_selected("pedidos-vigentes", server_id, system_type, "SR_ADAPTER", sucursal_id)
            query_result = repo.query_pedidos_vigentes_sr(server)
            
            # Manejar resultado homologado
            if query_result.status == "TABLE_NOT_FOUND":
                log_compras_query_result("pedidos-vigentes", server_id, "TABLE_NOT_FOUND", 0)
                logging.info(f"[COMPRAS] Pedidos no disponibles en {server['name']}: {query_result.message}")
                return []  # Retornar vacío, no es error
            
            if not query_result.success:
                log_compras_error("pedidos-vigentes", server_id, query_result.status, query_result.message, system_type)
                logging.warning(f"[COMPRAS] Error en pedidos: {query_result.message}")
                return []  # Retornar vacío para no propagar error
            
            data = query_result.data
            log_compras_query_result("pedidos-vigentes", server_id, "SUCCESS", len(data))
        else:
            # FASE 3A: Sistema no soportado
            log_compras_error("pedidos-vigentes", server_id, "UNSUPPORTED_SYSTEM_TYPE", f"system_type={system_type}", system_type)
            raise HTTPException(
                status_code=400,
                detail=f"El tipo de sistema '{system_type}' (normalizado: {normalized}) no está soportado para pedidos"
            )
        
        return [
            {
                "folio": str(r.get('folio', '')),
                "fecha": r.get('fecha', ''),
                "sucursal_id": str(r.get('sucursal_id', '')),
                "sucursal": r.get('sucursal', ''),
                "almacen_id": str(r.get('almacen_id', '')),
                "almacen": r.get('almacen', ''),
                "total": float(r.get('total', 0) or 0),
                "estado": r.get('estado', ''),
                "productos": int(r.get('productos', 0)),
                "origen": r.get('origen', '')
            }
            for r in data
        ]
        
    except HTTPException:
        raise
    except Exception as e:
        log_compras_error("pedidos-vigentes", server_id, "QUERY_ERROR", str(e), system_type)
        # No propagar el error, retornar vacío (comportamiento legacy)
        return []


