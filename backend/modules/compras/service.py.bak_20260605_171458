async def obtener_facturas_proveedor(
    server_id: str,
    sucursal: str = None,
    meses: str = None,
    anio: str = None
) -> List[Dict]:
    """
    Obtiene facturas de proveedores filtradas.
    
    FASE 3A: Blindaje - Solo disponible en MPRO
    """
    server = await repo.get_server_by_id(server_id)
    if not server:
        raise HTTPException(status_code=404, detail="Servidor no encontrado")
    
    system_type = server.get('system_type', 'UNKNOWN')
    
    # Obtener ID de sucursal
    sucursal_id = None
    if sucursal and is_mpro_system(system_type):
        sucursales = server.get('sucursales', [])
        for s in sucursales:
            if s.get('nombre') == sucursal or s.get('id') == sucursal:
                sucursal_id = s.get('id')
                break
    
    try:
        if is_mpro_system(system_type):
            log_compras_adapter_selected("facturas-proveedor", server_id, system_type, "MPRO_ADAPTER", sucursal_id)
            result = repo.query_facturas_proveedor_mpro(server, sucursal_id, meses, anio)
            log_compras_query_result("facturas-proveedor", server_id, "SUCCESS", len(result))
            
            return [
                {
                    "folio": r['folio'],
                    "fecha": r['fecha'],
                    "proveedor": r['proveedor'],
                    "total": float(r['total'] or 0),
                    "sucursal": r['sucursal'],
                    "productos": int(r['productos'] or 0)
                }
                for r in result
            ]
        
        # FASE 3A: No disponible para este sistema
        log_compras_adapter_selected("facturas-proveedor", server_id, system_type, "NO_ADAPTER_AVAILABLE")
        raise HTTPException(
            status_code=400,
            detail=f"Las facturas de proveedor solo están disponibles para sistemas MPRO. Sistema actual: {system_type}"
        )
        
    except HTTPException:
        raise
    except Exception as e:
        log_compras_error("facturas-proveedor", server_id, "QUERY_ERROR", str(e), system_type)
        raise HTTPException(status_code=500, detail=str(e))


