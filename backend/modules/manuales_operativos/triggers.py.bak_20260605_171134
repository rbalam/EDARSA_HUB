from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
Triggers de Generación de Manuales Operativos

Funciones que se invocan automáticamente cuando un proceso
cambia a estado COMPLETADA o CERRADO.

Uso:
    from modules.manuales_operativos.triggers import trigger_generar_manual
    
    # Al cambiar estado de un proceso:
    await trigger_generar_manual(db, proceso_id, modulo="compras")
    
    # Versión síncrona (para servicios sync):
    trigger_generar_manual_sync(db_sync, proceso_id, modulo="compras")
"""

import logging
import asyncio
from typing import Any,  Optional

from .service import ManualOperativoService

logger = logging.getLogger(__name__)

# Estados que disparan la generación de manuales
ESTADOS_TRIGGER = ["APROBADO", "RECHAZADO", "COMPLETADA", "CERRADO", "FINALIZADO", "AUDITORIA_COMPLETADA"]


async def trigger_generar_manual(
    db: Any,
    proceso_id: str,
    modulo: str = "compras",
    forzar: bool = False
) -> Optional[str]:
    """
    Trigger principal para generar manuales automáticamente.
    
    Se invoca cuando un proceso cambia a estado COMPLETADA/CERRADO.
    
    Args:
        db: Conexión a MongoDB
        proceso_id: ID del proceso
        modulo: Módulo del proceso (compras, operaciones, etc.)
        forzar: Si True, regenera aunque ya exista
        
    Returns:
        ID del manual generado o None si error
    """
    try:
        service = ManualOperativoService(db)
        
        # Verificar si ya existe (a menos que se fuerce)
        if not forzar:
            existing = await service.obtener_manual_por_proceso(proceso_id)
            if existing:
                logger.info(f"Manual ya existe para proceso {proceso_id}")
                return existing.id
        
        if modulo == "compras":
            return await _generar_manual_compras(db, service, proceso_id)
        else:
            logger.warning(f"Módulo {modulo} no tiene generador de manuales implementado")
            return None
            
    except Exception as e:
        logger.error(f"Error en trigger de manual para {proceso_id}: {e}")
        return None


async def _generar_manual_compras(
    db: Any,
    service: ManualOperativoService,
    proceso_id: str
) -> Optional[str]:
    """Genera manual para auditoría de compras."""
    
    # Obtener el proceso
    proceso = await db.automatizaciones_operativas_compras.find_one({"id": proceso_id})
    if not proceso:
        logger.error(f"Proceso de compras no encontrado: {proceso_id}")
        return None
    
    # Verificar estado
    estado = proceso.get("estado", "")
    if estado not in ESTADOS_TRIGGER:
        logger.info(f"Proceso {proceso_id} no está en estado trigger ({estado})")
        return None
    
    # Obtener bitácora
    bitacora = await db.automatizaciones_bitacora.find(
        {"automatizacion_id": proceso_id}
    ).sort("fecha", 1).to_list(100)
    
    # Obtener nombres de usuarios
    usuarios = {}
    user_ids = set()
    user_ids.add(proceso.get("usuario_id"))
    user_ids.add(proceso.get("autorizado_por_gerencia"))
    user_ids.add(proceso.get("autorizado_por_tesoreria"))
    for ev in bitacora:
        user_ids.add(ev.get("usuario_id"))
    user_ids.discard(None)
    
    if user_ids:
        users_cursor = db.users.find({"id": {"$in": list(user_ids)}}, {"id": 1, "email": 1, "full_name": 1})
        async for u in users_cursor:
            usuarios[u["id"]] = u.get("full_name") or u.get("email", "Usuario")
    
    # Generar manual
    manual = await service.generar_manual_auditoria_compras(proceso, bitacora, usuarios)
    
    if manual:
        logger.info(f"Manual generado automáticamente: {manual.id} para proceso {proceso_id}")
        return manual.id
    
    return None


async def verificar_y_generar_manuales_pendientes(db: Any):
    """
    Verifica procesos cerrados que no tienen manual y los genera.
    
    Útil para:
    - Migración inicial
    - Recuperación de manuales faltantes
    - Ejecución en scheduler nocturno
    """
    logger.info("Verificando manuales pendientes...")
    
    service = ManualOperativoService(db)
    generados = 0
    errores = 0
    
    # Buscar procesos de compras completados sin manual
    cursor = db.automatizaciones_operativas_compras.find({
        "estado": {"$in": ESTADOS_TRIGGER}
    })
    
    async for proceso in cursor:
        proceso_id = proceso.get("id")
        
        # Verificar si ya tiene manual
        existing = await service.obtener_manual_por_proceso(proceso_id)
        if existing:
            continue
        
        # Generar manual
        resultado = await _generar_manual_compras(db, service, proceso_id)
        if resultado:
            generados += 1
        else:
            errores += 1
    
    logger.info(f"Verificación completada: {generados} manuales generados, {errores} errores")
    return {"generados": generados, "errores": errores}


def trigger_generar_manual_sync(
    db_sync: Any,
    proceso_id: str,
    modulo: str = "compras"
) -> Optional[str]:
    """
    Versión síncrona del trigger para uso desde servicios sync.
    
    Genera el manual de forma inmediata usando la DB síncrona.
    
    Args:
        db_sync: Conexión pymongo (síncrona)
        proceso_id: ID del proceso
        modulo: Módulo del proceso
        
    Returns:
        ID del manual generado o None
    """
    try:
        if modulo == "compras":
            return _generar_manual_compras_sync(db_sync, proceso_id)
        else:
            logger.warning(f"Módulo {modulo} no tiene generador sync implementado")
            return None
    except Exception as e:
        logger.error(f"Error en trigger sync de manual para {proceso_id}: {e}")
        return None


def _generar_manual_compras_sync(db_sync: Any, proceso_id: str) -> Optional[str]:
    """Genera manual para compras de forma síncrona."""
    import uuid
    from datetime import datetime, timezone
    from .schemas import (
        ModuloOrigen, FormatoManual, ResponsableManual, PasoOperativo,
        EvidenciaGenerada, ContenidoManualCienfuegos, EVENTO_A_PASO_OPERATIVO
    )
    
    collection = db_sync["manuales_operativos"]
    
    # Verificar si ya existe
    existing = collection.find_one({"proceso_id": proceso_id})
    if existing:
        logger.info(f"Manual ya existe para proceso {proceso_id}")
        return existing.get("id")
    
    # Obtener proceso
    proceso = db_sync["automatizaciones_operativas_compras"].find_one({"id": proceso_id})
    if not proceso:
        logger.error(f"Proceso no encontrado: {proceso_id}")
        return None
    
    estado = proceso.get("estado", "")
    if estado not in ESTADOS_TRIGGER:
        logger.info(f"Proceso {proceso_id} no está en estado trigger ({estado})")
        return None
    
    # Obtener bitácora
    bitacora = list(db_sync["automatizaciones_bitacora"].find(
        {"automatizacion_id": proceso_id}
    ).sort("fecha", 1))
    
    # Obtener usuarios
    usuarios = {}
    user_ids = {proceso.get("usuario_id"), proceso.get("autorizado_por_gerencia"), proceso.get("autorizado_por_tesoreria")}
    for ev in bitacora:
        user_ids.add(ev.get("usuario_id"))
    user_ids.discard(None)
    
    if user_ids:
        for u in db_sync.users.find({"id": {"$in": list(user_ids)}}):
            usuarios[u["id"]] = u.get("full_name") or u.get("email", "Usuario")
    
    # Construir datos del manual
    sucursal = proceso.get("sucursal_nombre", "Sin sucursal")
    almacen = proceso.get("almacen_nombre", "Sin almacén")
    nombre_proceso = f"Auditoría Operativa de Compras - {sucursal} - {almacen}"
    
    objetivo = (
        f"Validar y auditar el proceso de compras para {sucursal}, "
        f"asegurando la correcta recepción de productos, verificación de inventarios "
        f"y autorización de pagos según las políticas de EDARSA."
    )
    
    proceso.get("fecha_fin_periodo")
    alcance = (
        f"Este proceso cubre la auditoría de compras del período para la sucursal {sucursal}, almacén {almacen}. "
        "Incluye validación de inventarios y autorizaciones requeridas."
    )
    
    # Responsables
    responsables = []
    if proceso.get("usuario_id"):
        responsables.append(ResponsableManual(
            rol="Iniciador",
            usuario_id=proceso.get("usuario_id"),
            usuario_nombre=usuarios.get(proceso.get("usuario_id"), proceso.get("usuario_nombre", "Sistema")),
            accion="Creó la auditoría operativa",
            fecha=proceso.get("fecha_creacion")
        ).model_dump())
    
    if proceso.get("autorizado_gerencia"):
        responsables.append(ResponsableManual(
            rol="Gerencia",
            usuario_id=proceso.get("autorizado_por_gerencia"),
            usuario_nombre=usuarios.get(proceso.get("autorizado_por_gerencia"), "Gerencia"),
            accion="Autorizó la auditoría",
            fecha=proceso.get("fecha_autorizacion_gerencia")
        ).model_dump())
    
    if proceso.get("autorizado_tesoreria"):
        responsables.append(ResponsableManual(
            rol="Tesorería",
            usuario_id=proceso.get("autorizado_por_tesoreria"),
            usuario_nombre=usuarios.get(proceso.get("autorizado_por_tesoreria"), "Tesorería"),
            accion="Autorizó el pago",
            fecha=proceso.get("fecha_autorizacion_tesoreria")
        ).model_dump())
    
    # Procedimiento desde bitácora
    procedimiento = []
    for i, evento in enumerate(bitacora, 1):
        evento_tipo = evento.get("evento", "DESCONOCIDO")
        datos = evento.get("datos", {})
        accion = EVENTO_A_PASO_OPERATIVO.get(evento_tipo, f"Se ejecutó: {evento_tipo}")
        if datos and "mensaje" in datos:
            accion = f"{accion}. {datos['mensaje']}"
        
        procedimiento.append(PasoOperativo(
            numero=i,
            accion=accion,
            responsable=usuarios.get(evento.get("usuario_id"), "Sistema"),
            fecha=evento.get("fecha"),
            evento_origen=evento_tipo
        ).model_dump())
    
    # Políticas
    politicas = [
        f"Período de análisis de inventarios: {proceso.get('dias_periodo_analisis', 15)} días",
        f"Días objetivo de inventario: {proceso.get('dias_objetivo', 10)} días"
    ]
    if proceso.get("autorizado_gerencia") or proceso.get("autorizado_tesoreria"):
        politicas.append("Doble autorización requerida: Gerencia y Tesorería")
    
    # Evidencias
    evidencias = []
    if proceso.get("inventario_final_id"):
        evidencias.append(EvidenciaGenerada(
            tipo="Inventario Final",
            descripcion="Inventario físico de cierre de período",
            referencia=proceso.get("inventario_final_id")
        ).model_dump())
    
    if proceso.get("fecha_autorizacion_tesoreria"):
        evidencias.append(EvidenciaGenerada(
            tipo="Autorización Tesorería",
            descripcion=f"Comentario: {proceso.get('comentario_tesoreria', 'N/A')}"
        ).model_dump())
    
    # Métricas
    metricas = {
        "total_productos": proceso.get("total_productos", 0),
        "total_eventos": len(bitacora),
        "autorizado_gerencia": proceso.get("autorizado_gerencia", False),
        "autorizado_tesoreria": proceso.get("autorizado_tesoreria", False)
    }
    
    # Observaciones
    observaciones = []
    areas_mejora = []
    if proceso.get("motivo_rechazo"):
        observaciones.append(f"Motivo de rechazo: {proceso['motivo_rechazo']}")
    
    # Construir contenido
    contenido = {
        "nombre_proceso": nombre_proceso,
        "objetivo": objetivo,
        "alcance": alcance,
        "responsables": responsables,
        "procedimiento": procedimiento,
        "politicas": politicas,
        "evidencias": evidencias,
        "observaciones": observaciones,
        "areas_mejora": areas_mejora,
        "metricas": metricas
    }
    
    # Crear documento del manual
    manual_id = str(uuid.uuid4())
    now = datetime.now(timezone.utc)
    
    manual_doc = {
        "id": manual_id,
        "modulo": ModuloOrigen.COMPRAS.value,
        "proceso_id": proceso_id,
        "proceso_tipo": "auditoria_compras",
        "empresa_id": proceso.get("empresa_id", proceso.get("server_id", "")),
        "empresa_nombre": proceso.get("empresa_nombre", proceso.get("sucursal_nombre", "")),
        "sucursal_id": proceso.get("sucursal_id", ""),
        "sucursal_nombre": sucursal,
        "nombre_proceso": nombre_proceso,
        "formato": FormatoManual.CIENFUEGOS.value,
        "contenido": contenido,
        "estado_proceso_final": estado,
        "generado_por": "sistema",
        "created_at": now,
        "updated_at": now,
        "version": 1,
        "activo": True
    }
    
    # Guardar
    collection.insert_one(manual_doc)
    logger.info(f"Manual operativo generado (sync): {manual_id} para proceso {proceso_id}")
    
    return manual_id


