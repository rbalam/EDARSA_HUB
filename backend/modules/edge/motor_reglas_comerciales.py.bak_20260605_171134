from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
import sqlite3
import json
import time
from typing import Dict, List, Any, Optional

class MotorReglasComerciales:
    def __init__(self, db_path: str = "edarsa_edge_device.db"):
        self.db_path = db_path

    # ============================================================================
    # 2.1. DISPARADOR EN CALIENTE DE MARIDAJES ÍNCLITOS (EL TICKET PERFECTO)
    # ============================================================================
    def interceptar_producto_para_maridaje(self, id_producto_marcado: str) -> Optional[Dict[str, Any]]:
        """
        Consulta la réplica unificada para extraer el maridaje idóneo que combina
        a la perfección y representa el mayor porcentaje de ganancia para la barra.
        """
        query = '''
            SELECT c.id_producto, c.nombre, c.precio_final, m.argumento_pantalla
            FROM maridajes_menu m
            JOIN catalogo_menu c ON m.id_producto_sugerido = c.id_producto
            WHERE m.id_producto_origen = ? AND c.stock_local > 0
            ORDER BY m.prioridad_margen ASC LIMIT 1
        '''
        with sqlite3.connect(self.db_path) as conn:
            conn.row_factory = sqlite3.Row
            cursor = conn.cursor()
            cursor.execute(query, (id_producto_marcado,))
            row = cursor.fetchone()
            
            if row:
                return {
                    "id_maridaje_sugerido": row["id_producto"],
                    "nombre_sugerido": row["nombre"],
                    "precio_venta": row["precio_final"],
                    "argumento_pantalla": row["argumento_pantalla"]
                }
        return None

    # ============================================================================
    # 2.2. VALIDADOR DE STOCK CRÍTICO EN TIEMPO REAL (MITIGACIÓN DE ERRORES)
    # ============================================================================
    def escanear_alertas_stock_critico(self) -> List[Dict[str, Any]]:
        """
        Examina el estado de la bodega en caché local. Si el inventario toca el mínimo,
        envía la orden de atenuar o bloquear instantáneamente el botón en la tablet.
        """
        query = '''
            SELECT id_producto, nombre, stock_local, stock_critico, categoria_push
            FROM catalogo_menu
            WHERE stock_local <= stock_critico OR categoria_push != 'ninguna'
        '''
        with sqlite3.connect(self.db_path) as conn:
            conn.row_factory = sqlite3.Row
            cursor = conn.cursor()
            cursor.execute(query)
            registros = cursor.fetchall()
            
            instrucciones_ui = []
            for reg in registros:
                # Si el stock físico es 0 o menor, se destruye la preventa bloqueando el botón
                estado_accion = "BLOQUEAR_BOTON" if reg["stock_local"] <= 0 else "INYECTAR_BARRA_PUSH"
                instrucciones_ui.append({
                    "id_producto": reg["id_producto"],
                    "nombre": reg["nombre"],
                    "estado_ui": estado_accion,
                    "categoria_push": reg["categoria_push"],
                    "unidades_restantes": reg["stock_local"]
                })
            return instrucciones_ui

    # ============================================================================
    # 2.3. INYECCIÓN AUTOMÁTICA DE PRODUCTOS PUSH (BAJA ROTACIÓN / CAUSA)
    # ============================================================================
    def calcular_estrategia_barra_lateral(self, total_items_alimentos: int, minutos_inactivo: int) -> Dict[str, Any]:
        """
        Analiza el contexto de la comanda de forma asíncrona local para guiar al vendedor.
        Decide quirúrgicamente qué inventario de la barra lateral (40%) debe priorizarse.
        """
        payload_sugerencia = {
            "activar_flujo_push": False,
            "tipo_push": "ninguno",
            "id_producto": None,
            "argumento_script": ""
        }

        # Regla de Tiempos Muertos: Mesa abierta que lleva más de 12 minutos solo con bebidas
        if total_items_alimentos == 0 and minutos_inactivo >= 12:
            query = "SELECT id_producto, nombre FROM catalogo_menu WHERE categoria_push = 'baja_rotacion' AND stock_local > 0 LIMIT 1"
            with sqlite3.connect(self.db_path) as conn:
                conn.row_factory = sqlite3.Row
                cursor = conn.cursor()
                cursor.execute(query)
                row = cursor.fetchone()
                if row:
                    payload_sugerencia.update({
                        "activar_flujo_push": True,
                        "tipo_push": "baja_rotacion",
                        "id_producto": row["id_producto"],
                        "argumento_script": f"¡Alerta de estancamiento! Ofrece inmediatamente {row['nombre']} como entrada de alta velocidad."
                    })
                    return payload_sugerencia

        # Regla de Cierre: Si los minutos están en 0 significa que se presionó el botón de pre-cuenta
        if minutos_inactivo == 0:
            query = "SELECT id_producto, nombre FROM catalogo_menu WHERE categoria_push = 'causa_altruista' AND stock_local > 0 LIMIT 1"
            with sqlite3.connect(self.db_path) as conn:
                conn.row_factory = sqlite3.Row
                cursor = conn.cursor()
                cursor.execute(query)
                row = cursor.fetchone()
                if row:
                    payload_sugerencia.update({
                        "activar_flujo_push": True,
                        "tipo_push": "causa_altruista",
                        "id_producto": row["id_producto"],
                        "argumento_script": f"Cierre emocional: Recuerda mencionar que un porcentaje del postre {row['nombre']} va directo a beneficencia."
                    })
                    
        return payload_sugerencia
