"""
EDARSA HUB - SQL-First Health Endpoint
======================================
Audita en tiempo real el cumplimiento de la arquitectura SQL-First.
"""

from fastapi import APIRouter
from pathlib import Path
import json
import subprocess
import sys
from typing import Dict, Any

router = APIRouter(prefix="/api/sqlfirst-health", tags=["SQL-First Health"])


@router.get("", response_model=Dict[str, Any])
async def get_sqlfirst_health():
    """
    Ejecuta auditoría SQL-First y retorna resultados.
    
    Verifica:
    - Credenciales hardcodeadas en código productivo
    - Referencias MongoDB activas
    - Conexiones LIVE no autorizadas
    """
    try:
        # Ejecutar script de auditoría
        result = subprocess.run(
            [sys.executable, "/app/backend/scripts/sqlfirst_health_audit.py"],
            capture_output=True,
            text=True,
            timeout=30
        )

        # Leer resultado JSON
        audit_path = Path("/app/docs/auditorias/SQLFIRST_HEALTH_AUDIT.json")
        if not audit_path.exists():
            return {
                "status": "ERROR",
                "message": "No se pudo generar auditoría SQL-First",
                "stderr": result.stderr[:500] if result.stderr else None
            }

        audit_data = json.loads(audit_path.read_text(encoding="utf-8"))
        
        # Resumen compacto para el endpoint
        return {
            "status": audit_data.get("status", "UNKNOWN"),
            "message": audit_data.get("message", ""),
            "generated_at": audit_data.get("generated_at"),
            "counts": audit_data.get("counts", {}),
            "architecture": {
                "sql_server": "FUENTE_UNICA_PRODUCTIVA",
                "mongodb": "LEGACY_CACHE_ONLY",
                "credentials": "CENTRALIZED_CONFIG"
            }
        }

    except subprocess.TimeoutExpired:
        return {
            "status": "ERROR",
            "message": "Timeout ejecutando auditoría"
        }
    except Exception as e:
        return {
            "status": "ERROR",
            "message": str(e)
        }


@router.get("/details", response_model=Dict[str, Any])
async def get_sqlfirst_health_details():
    """Retorna detalles completos de la última auditoría (incluye hallazgos)."""
    audit_path = Path("/app/docs/auditorias/SQLFIRST_HEALTH_AUDIT.json")
    if not audit_path.exists():
        return {"status": "ERROR", "message": "Auditoría no encontrada. Ejecutar /api/sqlfirst-health primero."}
    
    return json.loads(audit_path.read_text(encoding="utf-8"))
