# =============================================================================
# CAB-003 FASE 1B.1 - QUERIES SOFTRESTAURANT
# =============================================================================
# Constantes SQL para detección de inventarios válidos en SoftRestaurant
# 
# REGLAS DE NEGOCIO SOFT:
# - Inventario válido: cancelado = 0
# - Inventario inicial: Primer inventario válido del MES del inventario final
# - Duplicados mismo día: Mayor folio, mayor timestamp
# =============================================================================

# -----------------------------------------------------------------------------
# QUERY: Último inventario válido (inventario final detectado)
# -----------------------------------------------------------------------------
QUERY_ULTIMO_INVENTARIO_VALIDO = """
WITH inventarios_validos AS (
    SELECT
        i.folio,
        i.fecha,
        i.idalmacen1,
        ROW_NUMBER() OVER (
            PARTITION BY i.idalmacen1, CONVERT(date, i.fecha)
            ORDER BY i.folio DESC, i.fecha DESC
        ) AS rn_dia
    FROM invfisico i
    WHERE i.idalmacen1 = :almacen_id
      AND i.cancelado = 0
)
SELECT TOP 1
    folio,
    fecha,
    idalmacen1 AS almacen_id
FROM inventarios_validos
WHERE rn_dia = 1
ORDER BY fecha DESC, folio DESC
"""

# -----------------------------------------------------------------------------
# QUERY: Primer inventario válido del mes (inventario inicial)
# -----------------------------------------------------------------------------
QUERY_PRIMER_INVENTARIO_MES = """
WITH inventarios_validos AS (
    SELECT
        i.folio,
        i.fecha,
        i.idalmacen1,
        ROW_NUMBER() OVER (
            PARTITION BY i.idalmacen1, CONVERT(date, i.fecha)
            ORDER BY i.folio DESC, i.fecha DESC
        ) AS rn_dia
    FROM invfisico i
    WHERE i.idalmacen1 = :almacen_id
      AND i.cancelado = 0
      AND i.fecha >= :inicio_mes
      AND i.fecha < :inicio_mes_siguiente
)
SELECT TOP 1
    folio,
    fecha,
    idalmacen1 AS almacen_id
FROM inventarios_validos
WHERE rn_dia = 1
ORDER BY fecha ASC, folio ASC
"""

# -----------------------------------------------------------------------------
# QUERY: Listar todos los inventarios válidos de un almacén (para detección)
# -----------------------------------------------------------------------------
QUERY_INVENTARIOS_VALIDOS_ALMACEN = """
WITH inventarios_validos AS (
    SELECT
        i.folio,
        i.fecha,
        i.idalmacen1,
        ROW_NUMBER() OVER (
            PARTITION BY i.idalmacen1, CONVERT(date, i.fecha)
            ORDER BY i.folio DESC, i.fecha DESC
        ) AS rn_dia
    FROM invfisico i
    WHERE i.idalmacen1 = :almacen_id
      AND i.cancelado = 0
)
SELECT
    folio,
    fecha,
    idalmacen1 AS almacen_id
FROM inventarios_validos
WHERE rn_dia = 1
ORDER BY fecha DESC
"""

# -----------------------------------------------------------------------------
# QUERY: Listar almacenes disponibles
# Nota: Algunas versiones de SoftRestaurant no tienen columna 'activo'
# -----------------------------------------------------------------------------
QUERY_ALMACENES = """
SELECT DISTINCT
    idalmacen AS almacen_id,
    nombre AS almacen_nombre
FROM almacen
ORDER BY nombre
"""
