async def mongo_update_one(
    collection_name: str,
    filter_query: Dict,
    update: Dict,
    upsert: bool = False
) -> bool:
    """
    Actualiza un documento en MongoDB.
    
    Si MongoDB no está disponible, retorna False.
    """
    if _mongo_db is None:
        logger.warning(f"[MONGO_COMPAT] update_one({collection_name}) - MongoDB no disponible")
        return False
    
    try:
        collection = _mongo_db[collection_name]
        result = await collection.update_one(filter_query, update, upsert=upsert)
        return result.modified_count > 0 or result.upserted_id is not None
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en update_one({collection_name}): {e}")
        return False


async def mongo_update_many(
    collection_name: str,
    filter_query: Dict,
    update: Dict
) -> int:
    """
    Actualiza múltiples documentos en MongoDB.
    
    Si MongoDB no está disponible, retorna 0.
    """
    if _mongo_db is None:
        logger.warning(f"[MONGO_COMPAT] update_many({collection_name}) - MongoDB no disponible")
        return 0
    
    try:
        collection = _mongo_db[collection_name]
        result = await collection.update_many(filter_query, update)
        return result.modified_count
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en update_many({collection_name}): {e}")
        return 0


