from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
"""
EDARSA HUB - MongoDB Compatibility Layer
========================================
Capa de compatibilidad para operaciones MongoDB durante la migración a SQL Server.

Este módulo proporciona funciones helper que manejan el caso cuando MongoDB
no está disponible (db=None), retornando respuestas apropiadas sin fallar.

NOTA: Este es un módulo transitorio. Una vez que todas las colecciones
estén migradas a SQL Server, este módulo puede eliminarse.

Autor: Agente E1
Fecha: Mayo 2026
"""

from typing import Optional, List, Dict, Any
from datetime import datetime, timezone
import logging

logger = logging.getLogger(__name__)

# Referencia global a la conexión MongoDB (puede ser None)
_mongo_db = None


def init_mongo_compat(db) -> None:
    """
    Inicializa el módulo con la conexión MongoDB.
    
    Args:
        db: Instancia de Any o None
    """
    global _mongo_db
    _mongo_db = db
    if _mongo_db is None:
        logger.warning("[MONGO_COMPAT] Inicializado SIN MongoDB - Operaciones retornarán datos vacíos")
    else:
        logger.info("[MONGO_COMPAT] Inicializado con conexión MongoDB")


def get_mongo_db():
    """Obtiene la conexión MongoDB (puede ser None)."""
    return _mongo_db


def is_mongo_available() -> bool:
    """Verifica si MongoDB está disponible."""
    return _mongo_db is not None


# =============================================================================
# OPERACIONES FIND
# =============================================================================

async def mongo_find_one(
    collection_name: str,
    filter_query: Dict,
    projection: Dict = None
) -> Optional[Dict]:
    """
    Busca un documento en MongoDB.
    
    Si MongoDB no está disponible, retorna None.
    """
    if _mongo_db is None:
        logger.debug(f"[MONGO_COMPAT] find_one({collection_name}) - MongoDB no disponible")
        return None
    
    try:
        collection = _mongo_db[collection_name]
        if projection:
            return await collection.find_one(filter_query, projection)
        return await collection.find_one(filter_query)
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en find_one({collection_name}): {e}")
        return None


async def mongo_find(
    collection_name: str,
    filter_query: Dict = None,
    projection: Dict = None,
    sort: List = None,
    limit: int = None,
    skip: int = None
) -> List[Dict]:
    """
    Busca documentos en MongoDB.
    
    Si MongoDB no está disponible, retorna lista vacía.
    """
    if _mongo_db is None:
        logger.debug(f"[MONGO_COMPAT] find({collection_name}) - MongoDB no disponible")
        return []
    
    try:
        collection = _mongo_db[collection_name]
        filter_query = filter_query or {}
        
        cursor = collection.find(filter_query, projection or {"_id": 0})
        
        if sort:
            cursor = cursor.sort(sort)
        if skip:
            cursor = cursor.skip(skip)
        if limit:
            cursor = cursor.limit(limit)
        
        return await cursor.to_list(limit or 1000)
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en find({collection_name}): {e}")
        return []


async def mongo_count(
    collection_name: str,
    filter_query: Dict = None
) -> int:
    """
    Cuenta documentos en MongoDB.
    
    Si MongoDB no está disponible, retorna 0.
    """
    if _mongo_db is None:
        return 0
    
    try:
        collection = _mongo_db[collection_name]
        return await collection.count_documents(filter_query or {})
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en count({collection_name}): {e}")
        return 0


# =============================================================================
# OPERACIONES INSERT
# =============================================================================

async def mongo_insert_one(
    collection_name: str,
    document: Dict
) -> Optional[str]:
    """
    Inserta un documento en MongoDB.
    
    Si MongoDB no está disponible, retorna None y loguea warning.
    """
    if _mongo_db is None:
        logger.warning(f"[MONGO_COMPAT] insert_one({collection_name}) - MongoDB no disponible, documento NO persistido")
        return document.get('id')  # Retornar ID si existe para compatibilidad
    
    try:
        collection = _mongo_db[collection_name]
        result = await collection.insert_one(document)
        return str(result.inserted_id)
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en insert_one({collection_name}): {e}")
        return None


async def mongo_insert_many(
    collection_name: str,
    documents: List[Dict]
) -> List[str]:
    """
    Inserta múltiples documentos en MongoDB.
    
    Si MongoDB no está disponible, retorna lista vacía.
    """
    if _mongo_db is None:
        logger.warning(f"[MONGO_COMPAT] insert_many({collection_name}) - MongoDB no disponible, {len(documents)} documentos NO persistidos")
        return [d.get('id', '') for d in documents]
    
    try:
        collection = _mongo_db[collection_name]
        result = await collection.insert_many(documents)
        return [str(id) for id in result.inserted_ids]
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en insert_many({collection_name}): {e}")
        return []


