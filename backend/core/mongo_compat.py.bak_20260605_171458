async def mongo_aggregate(
    collection_name: str,
    pipeline: List[Dict]
) -> List[Dict]:
    """
    Ejecuta un pipeline de agregación en MongoDB.
    
    Si MongoDB no está disponible, retorna lista vacía.
    """
    if _mongo_db is None:
        logger.debug(f"[MONGO_COMPAT] aggregate({collection_name}) - MongoDB no disponible")
        return []
    
    try:
        collection = _mongo_db[collection_name]
        cursor = collection.aggregate(pipeline)
        return await cursor.to_list(1000)
    except Exception as e:
        logger.error(f"[MONGO_COMPAT] Error en aggregate({collection_name}): {e}")
        return []


# =============================================================================
# HELPER PARA ENDPOINTS QUE REQUIEREN MONGO
# =============================================================================

def require_mongo(func):
    """
    Decorador para endpoints que requieren MongoDB.
    
    Si MongoDB no está disponible, retorna error 503.
    """
    from functools import wraps
    from fastapi import HTTPException
    
    @wraps(func)
    async def wrapper(*args, **kwargs):
        if _mongo_db is None:
            raise HTTPException(
                status_code=503,
                detail="Este endpoint requiere MongoDB que actualmente no está disponible. "
                       "Funcionalidad en migración a SQL Server."
            )
        return await func(*args, **kwargs)
    return wrapper


def mongo_optional(default_value=None):
    """
    Decorador para endpoints donde MongoDB es opcional.
    
    Si MongoDB no está disponible, retorna el valor por defecto.
    """
    def decorator(func):
        from functools import wraps
        
        @wraps(func)
        async def wrapper(*args, **kwargs):
            if _mongo_db is None:
                logger.info(f"[MONGO_COMPAT] {func.__name__} - Retornando valor por defecto (MongoDB no disponible)")
                return default_value
            return await func(*args, **kwargs)
        return wrapper
    return decorator


