from typing import Optional, Dict, Any, List
from datetime import datetime, timezone, timedelta
import logging

from ..notifications.repository import NotificationRepository

logger = logging.getLogger(__name__)


class NotificationAuditService:
    """
    Servicio de auditoría de notificaciones.
    
    MIGRACIÓN SQL SERVER (Mayo 2026):
    - Operaciones de MongoDB pasan por StubDatabase
    """
    
    def __init__(self, db):
        self.db = db
        self._is_stub = self._check_is_stub(db)
        self.repository = NotificationRepository(db)
    
    def _check_is_stub(self, db) -> bool:
        """Verifica si estamos usando StubDatabase."""
        if db is None:
            return True
        try:
            from core.mongo_stub import StubDatabase
            return isinstance(db, StubDatabase)
        except ImportError:
            return False
    
    async def get_logs(
        self,
        workflow_id: Optional[str] = None,
        referencia_id: Optional[str] = None,
        evento_negocio: Optional[str] = None,
        destinatario: Optional[str] = None,
        estado_envio: Optional[str] = None,
        fecha_desde: Optional[str] = None,
        fecha_hasta: Optional[str] = None,
        modulo: Optional[str] = None,
        canal: Optional[str] = None,
        skip: int = 0,
        limit: int = 100
    ) -> Dict[str, Any]:
        """
        Obtiene logs de notificaciones con filtros.
        
        Returns:
            Dict con items y total
        """
        # Construir filtro
        filtro = {}
        if workflow_id:
            filtro["workflow_id"] = workflow_id
        if referencia_id:
            filtro["referencia_id"] = referencia_id
        if evento_negocio:
            filtro["evento_negocio"] = evento_negocio
        if destinatario:
            filtro["destinatario"] = {"$regex": destinatario, "$options": "i"}
        if estado_envio:
            filtro["estado_envio"] = estado_envio
        if modulo:
            filtro["modulo"] = modulo
        if canal:
            filtro["canal"] = canal
        if fecha_desde:
            filtro["fecha_intento"] = {"$gte": fecha_desde}
        if fecha_hasta:
            if "fecha_intento" in filtro:
                filtro["fecha_intento"]["$lte"] = fecha_hasta
            else:
                filtro["fecha_intento"] = {"$lte": fecha_hasta}
        
        # Obtener items
        items = await self.repository.get_logs(
            workflow_id=workflow_id,
            referencia_id=referencia_id,
            evento_negocio=evento_negocio,
            destinatario=destinatario,
            estado_envio=estado_envio,
            fecha_desde=fecha_desde,
            fecha_hasta=fecha_hasta,
            skip=skip,
            limit=limit
        )
        
        # Contar total
        total = await self.repository.count_logs(filtro)
        
        return {
            "items": items,
            "total": total,
            "skip": skip,
            "limit": limit
        }
    
    async def get_stats(
        self,
        modulo: Optional[str] = None,
        fecha_desde: Optional[str] = None,
        fecha_hasta: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Obtiene estadísticas de notificaciones.
        
        Returns:
            Dict con métricas agregadas
        """
        # Construir filtro de tiempo
        match_stage = {}
        if modulo:
            match_stage["modulo"] = modulo
        if fecha_desde or fecha_hasta:
            match_stage["fecha_intento"] = {}
            if fecha_desde:
                match_stage["fecha_intento"]["$gte"] = fecha_desde
            if fecha_hasta:
                match_stage["fecha_intento"]["$lte"] = fecha_hasta
        
        # Pipeline de agregación
        pipeline = []
        if match_stage:
            pipeline.append({"$match": match_stage})
        
        pipeline.extend([
            {
                "$group": {
                    "_id": {
                        "canal": "$canal",
                        "estado": "$estado_envio"
                    },
                    "count": {"$sum": 1}
                }
            },
            {
                "$group": {
                    "_id": "$_id.canal",
                    "estados": {
                        "$push": {
                            "estado": "$_id.estado",
                            "count": "$count"
                        }
                    },
                    "total": {"$sum": "$count"}
                }
            }
        ])
        
        # En modo stub, retornar stats vacías
        if self._is_stub:
            return {
                "por_canal": {},
                "totales": {
                    "enviados": 0,
                    "fallidos": 0,
                    "duplicados": 0,
                    "pendientes": 0
                },
                "filtros_aplicados": {
                    "modulo": modulo,
                    "fecha_desde": fecha_desde,
                    "fecha_hasta": fecha_hasta
                }
            }
        
        cursor = self.db.notification_log.aggregate(pipeline)
        
        stats_por_canal = {}
        async for doc in cursor:
            canal = doc["_id"]
            stats_por_canal[canal] = {
                "total": doc["total"],
                "por_estado": {item["estado"]: item["count"] for item in doc["estados"]}
            }
        
        # Calcular totales generales
        total_enviados = 0
        total_fallidos = 0
        total_duplicados = 0
        
        for canal_stats in stats_por_canal.values():
            por_estado = canal_stats.get("por_estado", {})
            total_enviados += por_estado.get("enviado", 0) + por_estado.get("entregado", 0)
            total_fallidos += por_estado.get("fallido", 0)
            total_duplicados += por_estado.get("duplicado", 0)
        
        return {
            "por_canal": stats_por_canal,
            "totales": {
                "enviados": total_enviados,
                "fallidos": total_fallidos,
                "duplicados": total_duplicados,
                "total": total_enviados + total_fallidos + total_duplicados
            },
            "fecha_calculo": datetime.now(timezone.utc).isoformat()
        }
    
    async def get_failed_notifications(
        self,
        hours: int = 24,
        limit: int = 50
    ) -> List[Dict]:
        """
        Obtiene notificaciones fallidas recientes.
        
        Args:
            hours: Ventana de tiempo hacia atrás
            limit: Máximo de resultados
            
        Returns:
            Lista de notificaciones fallidas
        """
        fecha_desde = (datetime.now(timezone.utc) - timedelta(hours=hours)).isoformat()
        
        return await self.repository.get_logs(
            estado_envio="fallido",
            fecha_desde=fecha_desde,
            limit=limit
        )
    
    async def get_notification_history(
        self,
        workflow_id: str
    ) -> List[Dict]:
        """
        Obtiene historial completo de notificaciones para un workflow.
        
        Args:
            workflow_id: ID del workflow
            
        Returns:
            Lista de notificaciones ordenadas por fecha
        """
        return await self.repository.get_logs(
            workflow_id=workflow_id,
            limit=500
        )
    
    async def get_queue_status(self) -> Dict[str, Any]:
        """
        Obtiene estado actual de la cola.
        """
        stats = await self.repository.get_queue_stats()
        
        return {
            "pendientes": stats.get("pendiente", 0),
            "enviados": stats.get("enviado", 0),
            "fallidos": stats.get("fallido", 0),
            "total_en_cola": sum(stats.values()),
            "detalle": stats
        }


