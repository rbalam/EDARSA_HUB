from typing import Optional, List, Dict, Any
from datetime import datetime, timezone
import uuid
import logging

from .repository_sql import RBACRepositorySQL, get_rbac_repository_sql

logger = logging.getLogger(__name__)


class RBACRepository:
    """
    Repository para operaciones RBAC.
    
    FASE 4B-RBAC: Migrado a SQL Server.
    Todas las operaciones ahora usan EDARSAHUB SQL.
    """
    
    def __init__(self, db=None):
        """
        Inicializa el repositorio RBAC.
        
        Args:
            db: Parámetro legacy (ignorado). Se mantiene para compatibilidad.
        """
        # FASE 4B: Usar repositorio SQL
        self._sql_repo = get_rbac_repository_sql()
        logger.debug("[RBAC] Inicializado con fuente SQL (EDARSAHUB)")
    
    def _ensure_indexes(self):
        """
        Legacy: Los índices ahora están en SQL Server.
        Este método se mantiene para compatibilidad pero no hace nada.
        """
        pass
    
    # =========================================================================
    # PERMISOS
    # =========================================================================
    
    def get_all_permisos(self, activos_only: bool = True) -> List[Dict]:
        """Obtiene todos los permisos desde SQL."""
        return self._sql_repo.get_all_permisos(activos_only)
    
    def get_permiso_by_codigo(self, codigo: str) -> Optional[Dict]:
        """Obtiene un permiso por su código."""
        return self._sql_repo.get_permiso_by_codigo(codigo)
    
    def create_permiso(self, permiso: Dict) -> Dict:
        """
        Crea un nuevo permiso.
        
        Nota: En SQL, los permisos se derivan de Usuario_Modulos × Usuario_Acciones.
        Para crear un nuevo permiso, agregar el módulo y/o acción correspondiente.
        """
        logger.warning("[RBAC] create_permiso: En SQL los permisos son derivados. "
                      "Agregar módulo/acción en Usuario_Modulos/Usuario_Acciones.")
        # Retornar el permiso como si se hubiera creado
        permiso["id"] = permiso.get("id") or str(uuid.uuid4())
        permiso["created_at"] = datetime.now(timezone.utc).isoformat()
        permiso["activo"] = True
        return permiso
    
    def seed_permisos(self, permisos: List[Dict]) -> int:
        """Siembra permisos del sistema si no existen."""
        return self._sql_repo.seed_permisos(permisos)
    
    # =========================================================================
    # ROLES
    # =========================================================================
    
    def get_all_roles(self, activos_only: bool = True) -> List[Dict]:
        """Obtiene todos los roles desde SQL."""
        return self._sql_repo.get_all_roles(activos_only)
    
    def get_rol_by_id(self, rol_id: str) -> Optional[Dict]:
        """Obtiene un rol por ID."""
        return self._sql_repo.get_rol_by_id(rol_id)
    
    def get_rol_by_nombre(self, nombre: str) -> Optional[Dict]:
        """Obtiene un rol por nombre."""
        return self._sql_repo.get_rol_by_nombre(nombre)
    
    def create_rol(self, rol: Dict) -> Dict:
        """Crea un nuevo rol."""
        return self._sql_repo.create_rol(rol)
    
    def update_rol(self, rol_id: str, data: Dict) -> Optional[Dict]:
        """Actualiza un rol."""
        return self._sql_repo.update_rol(rol_id, data)
    
    def delete_rol(self, rol_id: str) -> bool:
        """Elimina un rol (soft delete)."""
        return self._sql_repo.delete_rol(rol_id)
    
    def seed_roles(self, roles: List[Dict]) -> int:
        """Siembra roles del sistema si no existen."""
        return self._sql_repo.seed_roles(roles)
    
    # =========================================================================
    # ASIGNACIONES USUARIO-ROL
    # =========================================================================
    
    def get_roles_usuario(self, user_id: str, activos_only: bool = True) -> List[Dict]:
        """Obtiene los roles asignados a un usuario desde SQL."""
        return self._sql_repo.get_roles_usuario(user_id, activos_only)
    
    def asignar_rol(self, user_id: str, rol_id: str, asignado_por: str, 
                    sucursal_id: Optional[str] = None) -> Dict:
        """Asigna un rol a un usuario."""
        return self._sql_repo.asignar_rol(user_id, rol_id, asignado_por, sucursal_id)
    
    def revocar_rol(self, user_id: str, rol_id: str, sucursal_id: Optional[str] = None) -> bool:
        """Revoca un rol de un usuario."""
        return self._sql_repo.revocar_rol(user_id, rol_id, sucursal_id)
    
    def get_permisos_usuario(self, user_id: str) -> List[str]:
        """Obtiene todos los permisos efectivos de un usuario."""
        return self._sql_repo.get_permisos_usuario(user_id)
    
    def get_nivel_jerarquia_usuario(self, user_id: str) -> int:
        """Obtiene el nivel jerárquico máximo del usuario."""
        return self._sql_repo.get_nivel_jerarquia_usuario(user_id)
    
    # =========================================================================
    # AUDITORÍA
    # =========================================================================
    
    def log_verificacion(
        self,
        user_id: str,
        permiso_requerido: str,
        resultado: str,
        user_email: Optional[str] = None,
        endpoint: Optional[str] = None,
        metodo_http: Optional[str] = None,
        ip_address: Optional[str] = None,
        detalles: Optional[Dict] = None
    ) -> str:
        """Registra una verificación de permiso en el log de auditoría SQL."""
        return self._sql_repo.log_verificacion(
            user_id=user_id,
            permiso_requerido=permiso_requerido,
            resultado=resultado,
            user_email=user_email,
            endpoint=endpoint,
            metodo_http=metodo_http,
            ip_address=ip_address,
            detalles=detalles
        )
    
    def get_audit_logs(
        self,
        user_id: Optional[str] = None,
        resultado: Optional[str] = None,
        limit: int = 100
    ) -> List[Dict]:
        """Obtiene logs de auditoría desde SQL."""
        return self._sql_repo.get_audit_logs(user_id, resultado, limit)


__all__ = ['RBACRepository']
