class SystemType(Enum):
    """Tipos de sistema soportados"""
    SOFT_RESTAURANT = "SoftRestaurant"
    MPRO = "MPRO"


class MetricType(Enum):
    """Tipos de métricas para resolución de fuentes"""
    ACCUMULATED_SALES = "accumulated_sales"        # Ventas acumuladas del período
    DAILY_SALES = "daily_sales"                    # Ventas del día (tempcheques/API)
    DAILY_CHECKS = "daily_checks"                  # Cheques del día
    COMPARATIVE_SALES = "comparative_sales"        # Ventas comparativas (vs mes/año ant)
    PROJECTION = "projection"                      # Proyección de ventas
    PAX = "pax"                                    # Comensales
    INVENTORY = "inventory"                        # Inventarios


class SourceType(Enum):
    """Tipo de fuente de datos"""
    SQL = "sql"                                    # Consulta SQL directa
    API = "api"                                    # API local


class ConnectionOrigin(Enum):
    """Origen de la configuración de conexión"""
    MENU_SERVIDORES_SQL = "menu_servidores_sql"   # Menú oficial de Servidores SQL
    MPRO_SQL = "mpro_sql"                         # SQL del servidor MPRO
    LOCAL_API = "local_api"                       # API de servidor local


