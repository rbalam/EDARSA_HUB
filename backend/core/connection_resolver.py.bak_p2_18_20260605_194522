class ConnectionResolver:
    """
    Resolver centralizado de conexiones y fuentes de datos.
    
    Responsabilidades:
    - Resolver la fuente correcta según unidad y tipo de métrica
    - Obtener configuración de conexión desde menú Servidores SQL
    - Garantizar que TODOS los módulos pasen por esta capa
    - Auditoría de resoluciones
    
    Uso:
        from core.connection_resolver import ConnectionResolver, MetricType
        
        resolver = ConnectionResolver()
        source = resolver.resolve_source(
            server_id="abc-123",
            metric_type=MetricType.ACCUMULATED_SALES
        )
        
        if source.is_valid():
            if source.source_type == SourceType.SQL:
                # Usar execute_sql_query con source.host, etc.
            elif source.source_type == SourceType.API:
                # Usar API con source.api_base_url
    """
    
    _instance = None
    _db = None
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._initialized = False
        return cls._instance
    
    def __init__(self):
        if self._initialized:
            return
        self._initialized = True
        self._cache = {}
        self._resolution_log = []
        logger.info("[ConnectionResolver] Inicializado - EDARSA HUB es el cerebro")
    
    def _get_db(self):
        """MongoDB DEPRECADO - SQL Server es fuente única (P2-02)"""
        logger.warning("[ConnectionResolver] _get_db() llamado pero MongoDB está deprecado")
        return None
    
    def _get_server_config(self, server_id: str) -> Optional[Dict[str, Any]]:
        """
        Obtiene configuración de servidor desde EDARSAHUB SQL.
        P2-02: Migrado de MongoDB a SQL Server (Servidores_Conexiones).
        """
        try:
            cn = get_edarsahub_connection(timeout=20)
            cur = cn.cursor(as_dict=True)
            
            # Buscar por id (UUID) o nombre
            cur.execute("""
                SELECT TOP 1 *
                FROM Servidores_Conexiones
                WHERE CAST(id AS NVARCHAR(100)) = %s
                   OR nombre = %s
                   AND activo = 1
            """, (server_id, server_id))
            
            row = cur.fetchone()
            cn.close()
            
            if not row:
                logger.warning(f"[ConnectionResolver] Servidor no encontrado en SQL: {server_id}")
                return None
            
            # Mapear a formato esperado por el código existente
            return {
                "id": str(row.get("id", "")),
                "nombre": row.get("nombre"),
                "system_type": row.get("system_type"),
                "host": row.get("host"),
                "port": row.get("port"),
                "database": row.get("database_name"),
                "username": row.get("username"),
                "password": row.get("password_encrypted"),  # Cifrado
                "api_url": row.get("api_url"),
                "api_key": row.get("api_key_encrypted"),  # Cifrado
                "active": row.get("activo", False),
                "sucursales": row.get("sucursales"),
                "categorias": row.get("categorias"),
            }
            
        except Exception as e:
            logger.error(f"[ConnectionResolver] Error SQL obteniendo servidor {server_id}: {e}")
            return None
    
    def _get_api_config(self, server_host: str, sucursal: str) -> Optional[Dict[str, Any]]:
        """
        Obtiene configuración de API local desde EDARSAHUB SQL.
        P2-02: Migrado de MongoDB a SQL Server (Servidores_Conexiones con tipo_conexion='API_LOCAL').
        """
        try:
            cn = get_edarsahub_connection(timeout=20)
            cur = cn.cursor(as_dict=True)
            
            # Buscar API_LOCAL que coincida con host y tenga la sucursal
            cur.execute("""
                SELECT TOP 1 *
                FROM Servidores_Conexiones
                WHERE tipo_conexion = 'API_LOCAL'
                  AND activo = 1
                  AND (host = %s OR api_url LIKE %s)
            """, (server_host, f"%{server_host}%"))
            
            row = cur.fetchone()
            cn.close()
            
            if not row:
                logger.warning(f"[ConnectionResolver] API config no encontrada en SQL: host={server_host}, sucursal={sucursal}")
                return None
            
            return {
                "id": str(row.get("id", "")),
                "server_host": row.get("host"),
                "api_url": row.get("api_url"),
                "api_key": row.get("api_key_encrypted"),
                "sucursal": sucursal,
                "tipo": "api_mpro",
                "activo": row.get("activo", False),
            }
            
        except Exception as e:
            logger.error(f"[ConnectionResolver] Error SQL obteniendo API config: {e}")
            return None
    
    def resolve_source(
        self,
        server_id: str,
        metric_type: MetricType,
        sucursal_nombre: Optional[str] = None
    ) -> ResolvedSource:
        """
        Resuelve la fuente de datos correcta para un servidor y tipo de métrica.
        
        Args:
            server_id: UUID del servidor desde menú Servidores SQL
            metric_type: Tipo de métrica a consultar
            sucursal_nombre: Nombre de sucursal (para MPRO API local)
            
        Returns:
            ResolvedSource con toda la información necesaria para conectar
        """
        logger.info(f"[ConnectionResolver] Resolviendo: server={server_id}, metric={metric_type.value}")
        
        # Obtener configuración del servidor desde menú Servidores SQL
        server_config = self._get_server_config(server_id)
        
        if not server_config:
            return ResolvedSource(
                unit_code="UNKNOWN",
                unit_name="Servidor no encontrado",
                system_type=None,
                metric_type=metric_type,
                source_type=None,
                connection_origin=None,
                status="error",
                error_message=f"Servidor {server_id} no encontrado en menú Servidores SQL"
            )
        
        # Determinar tipo de sistema
        system_type_str = server_config.get('system_type', '')
        try:
            system_type = SystemType(system_type_str)
        except ValueError:
            return ResolvedSource(
                unit_code=server_config.get('name', 'UNKNOWN'),
                unit_name=server_config.get('name', 'Desconocido'),
                system_type=None,
                metric_type=metric_type,
                source_type=None,
                connection_origin=None,
                server_id=server_id,
                status="error",
                error_message=f"Tipo de sistema desconocido: {system_type_str}"
            )
        
        # Obtener matriz de resolución
        matrix_entry = RESOLUTION_MATRIX.get(system_type, {}).get(metric_type)
        
        if not matrix_entry:
            return ResolvedSource(
                unit_code=server_config.get('name', 'UNKNOWN'),
                unit_name=server_config.get('name', 'Desconocido'),
                system_type=system_type,
                metric_type=metric_type,
                source_type=None,
                connection_origin=None,
                server_id=server_id,
                status="error",
                error_message=f"Sin matriz de resolución para {system_type.value}/{metric_type.value}"
            )
        
        source_type = matrix_entry["source_type"]
        connection_origin = matrix_entry["connection_origin"]
        
        # Construir ResolvedSource según el tipo de fuente
        if source_type == SourceType.SQL:
            resolved = ResolvedSource(
                unit_code=server_config.get('name', 'UNKNOWN'),
                unit_name=server_config.get('name', 'Desconocido'),
                system_type=system_type,
                metric_type=metric_type,
                source_type=source_type,
                connection_origin=connection_origin,
                host=server_config.get('host'),
                port=server_config.get('port', 1433),
                instance=server_config.get('instance'),
                database_name=server_config.get('database'),
                username=server_config.get('username'),
                password=server_config.get('password'),
                server_id=server_id,
                timeout_seconds=90,
                status="resolved",
                metadata={
                    "tables": matrix_entry.get("tables", []),
                    "description": matrix_entry.get("description", "")
                }
            )
        
        elif source_type == SourceType.API:
            # Para API local, buscar configuración específica
            api_config = self._get_api_config(
                server_config.get('host', ''),
                sucursal_nombre or server_config.get('name', '')
            )
            
            if api_config:
                resolved = ResolvedSource(
                    unit_code=server_config.get('name', 'UNKNOWN'),
                    unit_name=server_config.get('name', 'Desconocido'),
                    system_type=system_type,
                    metric_type=metric_type,
                    source_type=source_type,
                    connection_origin=connection_origin,
                    api_base_url=api_config.get('api_base_url'),
                    server_id=server_id,
                    timeout_seconds=30,
                    status="resolved",
                    metadata={
                        "api_config_id": api_config.get('id'),
                        "description": matrix_entry.get("description", "")
                    }
                )
            else:
                # API no configurada - fallback a SQL para métricas que lo soporten
                if metric_type in [MetricType.ACCUMULATED_SALES, MetricType.COMPARATIVE_SALES]:
                    logger.warning(f"[ConnectionResolver] API no disponible para {sucursal_nombre}, usando SQL")
                    resolved = ResolvedSource(
                        unit_code=server_config.get('name', 'UNKNOWN'),
                        unit_name=server_config.get('name', 'Desconocido'),
                        system_type=system_type,
                        metric_type=metric_type,
                        source_type=SourceType.SQL,  # Fallback a SQL
                        connection_origin=ConnectionOrigin.MPRO_SQL,
                        host=server_config.get('host'),
                        port=server_config.get('port', 1433),
                        database_name=server_config.get('database'),
                        username=server_config.get('username'),
                        password=server_config.get('password'),
                        server_id=server_id,
                        timeout_seconds=90,
                        status="fallback",
                        metadata={
                            "fallback_reason": "API local no configurada",
                            "original_source": "api"
                        }
                    )
                else:
                    resolved = ResolvedSource(
                        unit_code=server_config.get('name', 'UNKNOWN'),
                        unit_name=server_config.get('name', 'Desconocido'),
                        system_type=system_type,
                        metric_type=metric_type,
                        source_type=source_type,
                        connection_origin=connection_origin,
                        server_id=server_id,
                        status="error",
                        error_message=f"API local no configurada para {sucursal_nombre}"
                    )
        else:
            resolved = ResolvedSource(
                unit_code=server_config.get('name', 'UNKNOWN'),
                unit_name=server_config.get('name', 'Desconocido'),
                system_type=system_type,
                metric_type=metric_type,
                source_type=None,
                connection_origin=None,
                server_id=server_id,
                status="error",
                error_message=f"Tipo de fuente no soportado: {source_type}"
            )
        
        # Log de resolución (sin passwords)
        self._log_resolution(resolved)
        
        return resolved
    
    def _log_resolution(self, resolved: ResolvedSource):
        """Registra la resolución para auditoría"""
        log_entry = resolved.get_safe_dict()
        self._resolution_log.append(log_entry)
        
        # Mantener solo últimas 1000 resoluciones en memoria
        if len(self._resolution_log) > 1000:
            self._resolution_log = self._resolution_log[-500:]
        
        logger.info(
            f"[ConnectionResolver] RESOLVED: {resolved.unit_code} | "
            f"metric={resolved.metric_type.value if resolved.metric_type else 'N/A'} | "
            f"source={resolved.source_type.value if resolved.source_type else 'N/A'} | "
            f"origin={resolved.connection_origin.value if resolved.connection_origin else 'N/A'} | "
            f"status={resolved.status}"
        )
    
    def get_resolution_matrix(self) -> Dict[str, Any]:
        """Devuelve la matriz de resolución actual (para documentación/debug)"""
        return {
            system_type.value: {
                metric_type.value: {
                    "source_type": entry["source_type"].value,
                    "connection_origin": entry["connection_origin"].value,
                    "tables": entry.get("tables", []),
                    "description": entry.get("description", "")
                }
                for metric_type, entry in metrics.items()
            }
            for system_type, metrics in RESOLUTION_MATRIX.items()
        }
    
    def health_check(self, server_id: str) -> Dict[str, Any]:
        """
        Verifica la salud de conexión de un servidor.
        
        Returns:
            Dict con estado de SQL y API (si aplica)
        """
        from core.db import execute_sql_query
        
        result = {
            "server_id": server_id,
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "sql_status": "unknown",
            "api_status": "unknown"
        }
        
        # Resolver para SQL
        sql_source = self.resolve_source(server_id, MetricType.ACCUMULATED_SALES)
        
        if sql_source.is_valid() and sql_source.source_type == SourceType.SQL:
            try:
                test_result = execute_sql_query(
                    sql_source.host,
                    sql_source.port,
                    sql_source.database_name,
                    sql_source.username,
                    sql_source.password,
                    "SELECT 1 AS health"
                )
                result["sql_status"] = "ok" if test_result else "no_response"
            except Exception as e:
                result["sql_status"] = "error"
                result["sql_error"] = str(e)[:200]
        else:
            result["sql_status"] = "not_configured"
        
        return result


