_resolver_instance = None

def get_connection_resolver() -> ConnectionResolver:
    """Obtiene la instancia singleton del ConnectionResolver"""
    global _resolver_instance
    if _resolver_instance is None:
        _resolver_instance = ConnectionResolver()
    return _resolver_instance


def resolve_source(
    server_id: str,
    metric_type: MetricType,
    sucursal_nombre: Optional[str] = None
) -> ResolvedSource:
    """
    Función de conveniencia para resolver fuente de datos.
    
    Args:
        server_id: UUID del servidor
        metric_type: Tipo de métrica
        sucursal_nombre: Nombre de sucursal (opcional, para API local)
        
    Returns:
        ResolvedSource con configuración de conexión
        
    Ejemplo:
        source = resolve_source("abc-123", MetricType.ACCUMULATED_SALES)
        if source.is_valid():
            result = execute_sql_query(source.host, source.port, ...)
    """
    return get_connection_resolver().resolve_source(server_id, metric_type, sucursal_nombre)


def get_resolution_matrix() -> Dict[str, Any]:
    """Devuelve la matriz de resolución actual"""
    return get_connection_resolver().get_resolution_matrix()
