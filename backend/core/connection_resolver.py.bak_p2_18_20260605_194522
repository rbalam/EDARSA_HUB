@dataclass
class ResolvedSource:
    """Estructura de salida del resolver"""
    unit_code: str                                # Código de unidad (CIENFUEGOS, ORIGEN, etc.)
    unit_name: str                                # Nombre para mostrar
    system_type: SystemType                       # Tipo de sistema
    metric_type: MetricType                       # Tipo de métrica solicitada
    source_type: SourceType                       # SQL o API
    connection_origin: ConnectionOrigin           # De dónde viene la config
    
    # Datos de conexión SQL
    host: Optional[str] = None
    port: Optional[int] = None
    instance: Optional[str] = None
    database_name: Optional[str] = None
    username: Optional[str] = None
    password: Optional[str] = None                # NUNCA loggear
    
    # Datos de API
    api_base_url: Optional[str] = None
    
    # Configuración adicional
    server_id: Optional[str] = None
    timeout_seconds: int = 90
    status: str = "unknown"
    error_message: Optional[str] = None
    metadata: Dict[str, Any] = field(default_factory=dict)
    resolved_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
    
    def is_valid(self) -> bool:
        """Verifica si la resolución es válida para usar"""
        if self.source_type == SourceType.SQL:
            return bool(self.host and self.database_name and self.username)
        elif self.source_type == SourceType.API:
            return bool(self.api_base_url)
        return False
    
    def get_safe_dict(self) -> Dict[str, Any]:
        """Devuelve dict sin campos sensibles (para logs)"""
        return {
            "unit_code": self.unit_code,
            "unit_name": self.unit_name,
            "system_type": self.system_type.value if self.system_type else None,
            "metric_type": self.metric_type.value if self.metric_type else None,
            "source_type": self.source_type.value if self.source_type else None,
            "connection_origin": self.connection_origin.value if self.connection_origin else None,
            "host": self.host,
            "port": self.port,
            "database_name": self.database_name,
            "api_base_url": self.api_base_url,
            "server_id": self.server_id,
            "status": self.status,
            "resolved_at": self.resolved_at.isoformat() if self.resolved_at else None
        }


