from core.unidades_service import UnidadesService
from core.corporate_filters.service import CorporateFilterService
import os


class ServerSecretKeyMissing(RuntimeError):
    pass


def require_server_secret_key() -> str:
    """
    Valida que SERVER_SECRET_KEY exista antes de intentar descifrar secretos.

    Regla EDARSAHUB:
    Todo proceso que use password_encrypted o api_key_encrypted debe tener
    SERVER_SECRET_KEY configurada.
    """
    key = os.getenv("SERVER_SECRET_KEY")

    if not key or not key.strip():
        raise ServerSecretKeyMissing(
            "SERVER_SECRET_KEY no está configurada. "
            "No se pueden descifrar credenciales de Servidores_Conexiones."
        )

    return key
