"""
EDARSA HUB - Providers de Datos
===============================
Providers centralizados por tipo de sistema y fuente.

PRINCIPIOS:
- Cada provider es responsable de un solo tipo de fuente
- NO construyen connection strings - los reciben del Resolver
- Manejan errores de forma consistente
- Logging detallado para auditoría

CREADO: 2026-04-19
"""

import logging
from typing import Dict, Optional, Any, List
from datetime import datetime, timezone
from dataclasses import dataclass

logger = logging.getLogger(__name__)


# ============================================================================
# BASE PROVIDER
# ============================================================================

@dataclass
class ProviderResult:
    """Resultado estandarizado de providers"""
    success: bool
    data: Any = None
    rows_count: int = 0
    duration_ms: float = 0
    source_type: str = ""
    connection_origin: str = ""
    error_type: Optional[str] = None
    error_message: Optional[str] = None
    metadata: Dict[str, Any] = None
    
    def __post_init__(self):
        if self.metadata is None:
            self.metadata = {}


class BaseProvider:
    """Clase base para todos los providers"""
    
    def __init__(self, name: str):
        self.name = name
        self.logger = logging.getLogger(f"providers.{name}")
    
    def _log_query(self, unit: str, query_type: str, duration_ms: float, 
                   rows: int, status: str, extra: Dict = None):
        """Log estandarizado de queries"""
        log_data = {
            "provider": self.name,
            "unit": unit,
            "query_type": query_type,
            "duration_ms": round(duration_ms, 2),
            "rows": rows,
            "status": status,
            "timestamp": datetime.now(timezone.utc).isoformat()
        }
        if extra:
            log_data.update(extra)
        
        if status == "ok":
            self.logger.info(f"[{self.name}] {unit} | {query_type} | {rows} filas | {duration_ms:.0f}ms")
        else:
            self.logger.warning(f"[{self.name}] {unit} | {query_type} | {status} | {duration_ms:.0f}ms")


# ============================================================================
# SQL CLASSIC PROVIDER (SoftRestaurant: CIENFUEGOS, LA ESTELAR, 130 MID)
# ============================================================================

class SQLClassicProvider(BaseProvider):
    """
    Provider para SoftRestaurant (SQL clásico).
    
    Responsabilidades:
    - Ventas acumuladas (cheques + turnos)
    - Ventas del día (tempcheques o cheques último turno)
    - PAX, cheques, comparativos
    
    Conexión: Menú Servidores SQL
    """
    
    def __init__(self):
        super().__init__("sql_classic")
    
    def get_accumulated_sales(
        self,
        host: str, port: int, database: str, 
        username: str, password: str,
        fecha_ini: str, fecha_fin: str,
        unit_name: str = ""
    ) -> ProviderResult:
        """
        Obtiene ventas acumuladas de SoftRestaurant.
        
        Args:
            host, port, database, username, password: Conexión SQL
            fecha_ini, fecha_fin: Rango de fechas (YYYY-MM-DD)
            unit_name: Nombre de unidad para logging
            
        Returns:
            ProviderResult con ventas, pax, cheques
        """
        from core.db import execute_sql_query
        import time
        
        start_time = time.time()
        
        try:
            # Formato de fecha para SQL Server
            fi = fecha_ini.replace('-', '')
            ff = fecha_fin.replace('-', '')
            
            query = f"""
            SELECT 
                SUM(c.total) as ventas,
                SUM(c.nopersonas) as pax,
                COUNT(c.folio) as cheques,
                MIN(CONVERT(DATE, c.fecha)) as fecha_inicio,
                MAX(CONVERT(DATE, c.fecha)) as fecha_fin
            FROM cheques c
            INNER JOIN turnos t ON c.idturno = t.idturno
            WHERE c.cancelado = 0 
              AND c.pagado = 1
              AND t.apertura >= '{fi}' AND t.apertura <= '{ff}'
            """
            
            result = execute_sql_query(host, port, database, username, password, query)
            
            duration_ms = (time.time() - start_time) * 1000
            
            if result and len(result) > 0:
                row = result[0]
                data = {
                    "ventas": float(row.get('ventas') or 0),
                    "pax": int(row.get('pax') or 0),
                    "cheques": int(row.get('cheques') or 0),
                    "fecha_inicio": str(row.get('fecha_inicio') or ''),
                    "fecha_fin": str(row.get('fecha_fin') or '')
                }
                
                self._log_query(unit_name, "accumulated_sales", duration_ms, 1, "ok")
                
                return ProviderResult(
                    success=True,
                    data=data,
                    rows_count=1,
                    duration_ms=duration_ms,
                    source_type="sql",
                    connection_origin="menu_servidores_sql"
                )
            else:
                self._log_query(unit_name, "accumulated_sales", duration_ms, 0, "no_data")
                
                return ProviderResult(
                    success=True,
                    data={"ventas": 0, "pax": 0, "cheques": 0},
                    rows_count=0,
                    duration_ms=duration_ms,
                    source_type="sql",
                    connection_origin="menu_servidores_sql",
                    metadata={"reason": "No hay datos en el período"}
                )
                
        except Exception as e:
            duration_ms = (time.time() - start_time) * 1000
            error_msg = str(e)[:300]
            
            self._log_query(unit_name, "accumulated_sales", duration_ms, 0, "error",
                          {"error": error_msg})
            
            return ProviderResult(
                success=False,
                duration_ms=duration_ms,
                source_type="sql",
                connection_origin="menu_servidores_sql",
                error_type="sql_error",
                error_message=error_msg
            )
    
    def get_daily_sales(
        self,
        host: str, port: int, database: str,
        username: str, password: str,
        unit_name: str = ""
    ) -> ProviderResult:
        """
        Obtiene ventas del día de SoftRestaurant.
        
        Usa tempcheques o cheques del último turno abierto.
        """
        from core.db import execute_sql_query
        import time
        
        start_time = time.time()
        
        try:
            # Primero intentar tempcheques
            query_temp = """
            SELECT 
                SUM(total) as ventas,
                SUM(nopersonas) as pax,
                COUNT(folio) as cheques,
                'tempcheques' as origen
            FROM tempcheques
            WHERE cancelado = 0
            """
            
            result = execute_sql_query(host, port, database, username, password, query_temp)
            
            if result and result[0].get('ventas'):
                duration_ms = (time.time() - start_time) * 1000
                row = result[0]
                data = {
                    "ventas": float(row.get('ventas') or 0),
                    "pax": int(row.get('pax') or 0),
                    "cheques": int(row.get('cheques') or 0),
                    "origen": "tempcheques"
                }
                
                self._log_query(unit_name, "daily_sales", duration_ms, 1, "ok",
                              {"origen": "tempcheques"})
                
                return ProviderResult(
                    success=True,
                    data=data,
                    rows_count=1,
                    duration_ms=duration_ms,
                    source_type="sql",
                    connection_origin="menu_servidores_sql",
                    metadata={"origen": "tempcheques"}
                )
            
            # Fallback a último turno cerrado hoy
            query_fallback = """
            SELECT 
                SUM(c.total) as ventas,
                SUM(c.nopersonas) as pax,
                COUNT(c.folio) as cheques,
                'ultimo_turno' as origen
            FROM cheques c
            INNER JOIN turnos t ON c.idturno = t.idturno
            WHERE c.cancelado = 0 
              AND c.pagado = 1
              AND CONVERT(DATE, t.apertura) = CONVERT(DATE, GETDATE())
            """
            
            result = execute_sql_query(host, port, database, username, password, query_fallback)
            
            duration_ms = (time.time() - start_time) * 1000
            
            if result and len(result) > 0:
                row = result[0]
                data = {
                    "ventas": float(row.get('ventas') or 0),
                    "pax": int(row.get('pax') or 0),
                    "cheques": int(row.get('cheques') or 0),
                    "origen": "ultimo_turno"
                }
                
                self._log_query(unit_name, "daily_sales", duration_ms, 1, "ok",
                              {"origen": "ultimo_turno"})
                
                return ProviderResult(
                    success=True,
                    data=data,
                    rows_count=1,
                    duration_ms=duration_ms,
                    source_type="sql",
                    connection_origin="menu_servidores_sql",
                    metadata={"origen": "ultimo_turno"}
                )
            
            return ProviderResult(
                success=True,
                data={"ventas": 0, "pax": 0, "cheques": 0, "origen": "sin_datos"},
                rows_count=0,
                duration_ms=duration_ms,
                source_type="sql",
                connection_origin="menu_servidores_sql"
            )
            
        except Exception as e:
            duration_ms = (time.time() - start_time) * 1000
            error_msg = str(e)[:300]
            
            self._log_query(unit_name, "daily_sales", duration_ms, 0, "error",
                          {"error": error_msg})
            
            return ProviderResult(
                success=False,
                duration_ms=duration_ms,
                source_type="sql",
                connection_origin="menu_servidores_sql",
                error_type="sql_error",
                error_message=error_msg
            )


# ============================================================================
# MPRO SQL PROVIDER (ORIGEN, 130 QUERETARO - Acumulados)
# ============================================================================

class MPROSQLProvider(BaseProvider):
    """
    Provider para MPRO SQL (acumulados).
    
    Responsabilidades:
    - Ventas acumuladas (Venta_Encabezado)
    - PAX, cheques, comparativos
    
    Conexión: SQL MPRO
    """
    
    def __init__(self):
        super().__init__("mpro_sql")
    
    def get_accumulated_sales(
        self,
        host: str, port: int, database: str,
        username: str, password: str,
        fecha_ini: str, fecha_fin: str,
        sucursal_id: Optional[str] = None,
        unit_name: str = ""
    ) -> ProviderResult:
        """
        Obtiene ventas acumuladas de MPRO.
        
        Args:
            host, port, database, username, password: Conexión SQL
            fecha_ini, fecha_fin: Rango de fechas (YYYY-MM-DD)
            sucursal_id: Código de sucursal MPRO (Sc_Cve_Sucursal)
            unit_name: Nombre de unidad para logging
            
        Returns:
            ProviderResult con ventas, pax, cheques
        """
        from core.db import execute_sql_query
        import time
        
        start_time = time.time()
        
        try:
            fi = fecha_ini.replace('-', '')
            ff = fecha_fin.replace('-', '')
            
            # Filtro de sucursal si se proporciona
            sucursal_filter = ""
            if sucursal_id:
                sucursal_filter = f"AND S.Sc_Cve_Sucursal = '{sucursal_id}'"
            
            query = f"""
            SELECT 
                SUM(VE.Vn_Precio_Neto_Importe) as ventas,
                COUNT(DISTINCT VE.Vn_Folio) as cheques,
                MIN(CONVERT(DATE, VE.Vn_Fecha)) as fecha_inicio,
                MAX(CONVERT(DATE, VE.Vn_Fecha)) as fecha_fin
            FROM Venta_Encabezado VE
            INNER JOIN Sucursal S ON VE.Sc_Cve_Sucursal = S.Sc_Cve_Sucursal
            WHERE VE.Vn_Fecha >= '{fi}' AND VE.Vn_Fecha <= '{ff}'
              AND ISNULL(VE.Es_Cve_Estado, '') <> 'CA'
              {sucursal_filter}
            """
            
            result = execute_sql_query(host, port, database, username, password, query)
            
            duration_ms = (time.time() - start_time) * 1000
            
            if result and len(result) > 0:
                row = result[0]
                ventas = float(row.get('ventas') or 0)
                
                # Si hay ventas, obtener PAX
                pax = 0
                if ventas > 0:
                    query_pax = f"""
                    SELECT ISNULL(SUM(C.Co_Personas), 0) as pax
                    FROM Comanda C
                    INNER JOIN Venta_Encabezado VE ON C.Vn_Folio = VE.Vn_Folio AND C.Sc_Cve_Sucursal = VE.Sc_Cve_Sucursal
                    WHERE VE.Vn_Fecha >= '{fi}' AND VE.Vn_Fecha <= '{ff}'
                      AND ISNULL(VE.Es_Cve_Estado, '') <> 'CA'
                      {sucursal_filter.replace('S.Sc_Cve_Sucursal', 'VE.Sc_Cve_Sucursal')}
                    """
                    try:
                        result_pax = execute_sql_query(host, port, database, username, password, query_pax)
                        if result_pax and result_pax[0].get('pax'):
                            pax = int(result_pax[0]['pax'])
                    except Exception:
                        pass
                
                data = {
                    "ventas": ventas,
                    "pax": pax,
                    "cheques": int(row.get('cheques') or 0),
                    "fecha_inicio": str(row.get('fecha_inicio') or ''),
                    "fecha_fin": str(row.get('fecha_fin') or '')
                }
                
                self._log_query(unit_name, "accumulated_sales", duration_ms, 1, "ok")
                
                return ProviderResult(
                    success=True,
                    data=data,
                    rows_count=1,
                    duration_ms=duration_ms,
                    source_type="sql",
                    connection_origin="mpro_sql"
                )
            else:
                self._log_query(unit_name, "accumulated_sales", duration_ms, 0, "no_data")
                
                return ProviderResult(
                    success=True,
                    data={"ventas": 0, "pax": 0, "cheques": 0},
                    rows_count=0,
                    duration_ms=duration_ms,
                    source_type="sql",
                    connection_origin="mpro_sql"
                )
                
        except Exception as e:
            duration_ms = (time.time() - start_time) * 1000
            error_msg = str(e)[:300]
            
            self._log_query(unit_name, "accumulated_sales", duration_ms, 0, "error",
                          {"error": error_msg})
            
            return ProviderResult(
                success=False,
                duration_ms=duration_ms,
                source_type="sql",
                connection_origin="mpro_sql",
                error_type="sql_error",
                error_message=error_msg
            )


# ============================================================================
# LOCAL API PROVIDER (MPRO - Ventas del día)
# ============================================================================

class LocalAPIProvider(BaseProvider):
    """
    Provider para API local MPRO (ventas del día).
    
    Responsabilidades:
    - Ventas del día via API de servidores locales
    
    Conexión: API servidores locales
    """
    
    def __init__(self):
        super().__init__("local_api")
    
    def get_daily_sales(
        self,
        api_base_url: str,
        unit_name: str = ""
    ) -> ProviderResult:
        """
        Obtiene ventas del día de MPRO via API local.
        
        Args:
            api_base_url: URL base de la API local
            unit_name: Nombre de unidad para logging
            
        Returns:
            ProviderResult con ventas del día
        """
        import time
        import requests
        
        start_time = time.time()
        
        try:
            # Endpoint típico de ventas del día en API local MPRO
            url = f"{api_base_url}/api/ventas/dia"
            
            response = requests.get(url, timeout=30)
            
            duration_ms = (time.time() - start_time) * 1000
            
            if response.status_code == 200:
                data = response.json()
                
                # Normalizar respuesta
                result_data = {
                    "ventas": float(data.get('total_ventas') or data.get('ventas') or 0),
                    "cheques": int(data.get('total_cheques') or data.get('cheques') or 0),
                    "pax": int(data.get('total_pax') or data.get('pax') or 0),
                    "origen": "api_local"
                }
                
                self._log_query(unit_name, "daily_sales", duration_ms, 1, "ok")
                
                return ProviderResult(
                    success=True,
                    data=result_data,
                    rows_count=1,
                    duration_ms=duration_ms,
                    source_type="api",
                    connection_origin="local_api"
                )
            else:
                self._log_query(unit_name, "daily_sales", duration_ms, 0, f"http_{response.status_code}")
                
                return ProviderResult(
                    success=False,
                    duration_ms=duration_ms,
                    source_type="api",
                    connection_origin="local_api",
                    error_type="http_error",
                    error_message=f"HTTP {response.status_code}: {response.text[:200]}"
                )
                
        except requests.exceptions.Timeout:
            duration_ms = (time.time() - start_time) * 1000
            
            self._log_query(unit_name, "daily_sales", duration_ms, 0, "timeout")
            
            return ProviderResult(
                success=False,
                duration_ms=duration_ms,
                source_type="api",
                connection_origin="local_api",
                error_type="timeout",
                error_message="API no respondió en tiempo"
            )
            
        except Exception as e:
            duration_ms = (time.time() - start_time) * 1000
            error_msg = str(e)[:300]
            
            self._log_query(unit_name, "daily_sales", duration_ms, 0, "error",
                          {"error": error_msg})
            
            return ProviderResult(
                success=False,
                duration_ms=duration_ms,
                source_type="api",
                connection_origin="local_api",
                error_type="api_error",
                error_message=error_msg
            )


