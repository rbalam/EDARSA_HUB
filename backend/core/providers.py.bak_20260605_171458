_sql_classic_provider = None
_mpro_sql_provider = None
_local_api_provider = None


def get_sql_classic_provider() -> SQLClassicProvider:
    """Obtiene instancia de SQLClassicProvider"""
    global _sql_classic_provider
    if _sql_classic_provider is None:
        _sql_classic_provider = SQLClassicProvider()
    return _sql_classic_provider


def get_mpro_sql_provider() -> MPROSQLProvider:
    """Obtiene instancia de MPROSQLProvider"""
    global _mpro_sql_provider
    if _mpro_sql_provider is None:
        _mpro_sql_provider = MPROSQLProvider()
    return _mpro_sql_provider


def get_local_api_provider() -> LocalAPIProvider:
    """Obtiene instancia de LocalAPIProvider"""
    global _local_api_provider
    if _local_api_provider is None:
        _local_api_provider = LocalAPIProvider()
    return _local_api_provider
