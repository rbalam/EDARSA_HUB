def normalize_system_type(value: Any) -> str:
    cleaned = clean_text(value).replace(" ", "_")

    for canonical, aliases in SYSTEM_TYPE_ALIASES.items():
        normalized_aliases = {clean_text(alias).replace(" ", "_") for alias in aliases}
        if cleaned in normalized_aliases:
            return canonical

    return cleaned or "OTRO"


def get_system_type_aliases(canonical_type: str) -> List[str]:
    canonical = normalize_system_type(canonical_type)
    aliases = SYSTEM_TYPE_ALIASES.get(canonical, [canonical])

    values = set()
    for alias in aliases:
        values.add(alias)
        values.add(clean_text(alias))
        values.add(clean_text(alias).replace(" ", "_"))

    values.add(canonical)
    return sorted(values)


def build_system_type_sql_filter(column_name: str, canonical_type: str) -> str:
    values = ", ".join("'" + sql_literal(v).replace(" ", "_") + "'" for v in get_system_type_aliases(canonical_type))
    return (
        f"UPPER(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNULL(CAST({column_name} AS NVARCHAR(255)), ''))), "
        f"'-', '_'), ' ', '_'), '°', '')) IN ({values})"
    )


# ============================================================
# Alias corporativos operativos
# ============================================================

def generate_operational_aliases(value: Any) -> List[str]:
    cleaned = clean_text(value)
    compact = compact_text(value)

    aliases = {cleaned, compact}

    if "130" in cleaned and ("MERIDA" in cleaned or "MID" in cleaned):
        aliases.update({
            "130MID",
            "130 MID",
            "130 MERIDA",
            "130 MERIDA SOFTRESTAURANT",
            "130 MERIDA SOFT",
        })

    if "130" in cleaned and ("QUERETARO" in cleaned or "QRO" in cleaned):
        aliases.update({
            "130QRO",
            "130 QRO",
            "130 QUERETARO",
            "130 QUERETARO MPRO",
        })

    if "ESTELAR" in cleaned:
        aliases.update({
            "ESTELAR",
            "LA ESTELAR",
        })

    if "CIENFUEGOS" in cleaned:
        aliases.update({
            "CIENFUEGOS",
        })

    if "ORIGEN" in cleaned:
        aliases.update({
            "ORIGEN",
        })

    return sorted(a for a in aliases if a)


