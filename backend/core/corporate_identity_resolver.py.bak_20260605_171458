"""
EDARSAHUB - Resolver Corporativo Global

Responsabilidad:
Resolver entradas flexibles a identidades canónicas EDARSAHUB SQL.

Aplica para:
- empresa
- unidad_negocio
- sucursal
- almacen
- proveedor
- producto
- servidor
- system_type

Entrada aceptada:
- UUID
- código
- nombre
- alias operativo

Salida esperada:
- ID canónico
- código
- nombre
- metadata relacionada

Regla:
Los repositories deben consultar por ID canónico.
Los endpoints pueden recibir texto por compatibilidad, pero deben resolver antes de consultar.
"""

from typing import Any, Dict, List, Optional
import re


# ============================================================
# Normalización general
# ============================================================

def clean_text(value: Any) -> str:
    if value is None:
        return ""

    text = str(value).strip().upper()
    text = text.replace("°", "")
    text = text.replace("_", " ")
    text = text.replace("-", " ")
    text = text.replace(".", " ")
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def compact_text(value: Any) -> str:
    return clean_text(value).replace(" ", "")


def is_uuid_like(value: Any) -> bool:
    if value is None:
        return False

    text = str(value).strip()

    return bool(re.match(
        r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        text
    ))


def sql_literal(value: Any) -> str:
    return str(value or "").replace("'", "''")


def is_all_value(value: Any) -> bool:
    cleaned = clean_text(value)
    return cleaned in {"", "TODAS", "TODOS", "TODO", "ALL", "TODAS LAS UNIDADES", "TODAS LAS EMPRESAS"}


