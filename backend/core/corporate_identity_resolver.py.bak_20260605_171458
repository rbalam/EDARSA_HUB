def build_entity_lookup_where(entity_type: str, input_value: Any, table_alias: str = "") -> str:
    if is_all_value(input_value):
        return "1 = 0"

    entity = ENTITY_COLUMN_MAP.get(entity_type)
    if not entity:
        raise ValueError(f"Entidad corporativa no soportada: {entity_type}")

    prefix = f"{table_alias}." if table_alias else ""

    id_col = prefix + entity["id"]
    code_col = prefix + entity.get("codigo", entity["id"])
    name_col = prefix + entity.get("nombre", entity["id"])
    alt_col = entity.get("alt_nombre")
    alt_col = prefix + alt_col if alt_col else None

    raw = str(input_value or "").strip()
    raw_sql = sql_literal(raw)
    cleaned = clean_text(raw)
    cleaned_sql = sql_literal(cleaned)
    compact = compact_text(raw)
    compact_sql = sql_literal(compact)

    predicates: List[str] = []

    if is_uuid_like(raw):
        predicates.append(f"CAST({id_col} AS NVARCHAR(50)) = '{raw_sql}'")

    base_cols = [code_col, name_col]
    if alt_col:
        base_cols.append(alt_col)

    for col in base_cols:
        predicates.extend([
            f"UPPER(LTRIM(RTRIM(ISNULL(CAST({col} AS NVARCHAR(255)), '')))) = '{cleaned_sql}'",
            f"REPLACE(UPPER(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNULL(CAST({col} AS NVARCHAR(255)), ''))), '°', ''), '_', ' '), '-', ' ')), ' ', '') = '{compact_sql}'",
        ])

    for alias in generate_operational_aliases(raw):
        alias_clean = sql_literal(clean_text(alias))
        alias_compact = sql_literal(compact_text(alias))

        for col in base_cols:
            predicates.extend([
                f"UPPER(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNULL(CAST({col} AS NVARCHAR(255)), ''))), '°', ''), '_', ' '), '-', ' ')) = '{alias_clean}'",
                f"REPLACE(UPPER(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(ISNULL(CAST({col} AS NVARCHAR(255)), ''))), '°', ''), '_', ' '), '-', ' ')), ' ', '') = '{alias_compact}'",
            ])

    if entity_type == "proveedor" and entity.get("rfc"):
        rfc_col = prefix + entity["rfc"]
        predicates.append(f"UPPER(LTRIM(RTRIM(ISNULL(CAST({rfc_col} AS NVARCHAR(255)), '')))) = '{cleaned_sql}'")

    return "(" + " OR ".join(predicates) + ")"


def build_canonical_subquery(entity_type: str, input_value: Any, table_alias: str = "") -> str:
    entity = ENTITY_COLUMN_MAP.get(entity_type)
    if not entity:
        raise ValueError(f"Entidad corporativa no soportada: {entity_type}")

    table = entity["table"]
    id_col = entity["id"]

    alias = table_alias or "x"
    where = build_entity_lookup_where(entity_type, input_value, alias)

    return f"SELECT {alias}.{id_col} FROM {table} {alias} WHERE {where}"


