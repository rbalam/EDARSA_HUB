# ==============================================================================
# CONSTANTES - Jerarquía de roles
# ==============================================================================

ROLE_HIERARCHY_V2 = {
    'SUPER_ADMIN': 100,
    'ADMIN': 90,
    'DIRECCION': 80,
    'GERENTE': 70,
    'SUPERVISOR': 50,
    'AUDITOR': 40,
    'OPERADOR': 30,
    'CONSULTA': 10,
}

# Mapeo legacy -> nuevo (para compatibilidad)
ROLE_LEGACY_MAP = {
    'SuperAdministrador': 'SUPER_ADMIN',
    'Administrador': 'ADMIN',
    'Supervisor': 'SUPERVISOR',
    'Usuario': 'OPERADOR',
}


# ==============================================================================
# FUNCIONES HELPER - NO CONECTADAS A PRODUCCIÓN
# ==============================================================================

def get_role_level_v2(role: str) -> int:
    """
    Obtiene el nivel de un rol en el nuevo sistema.
    
    NOTA: Esta función NO está conectada a producción.
    Se usará cuando se active la Fase 2+.
    """
    # Primero intentar mapeo directo
    if role in ROLE_HIERARCHY_V2:
        return ROLE_HIERARCHY_V2[role]
    
    # Luego intentar mapeo legacy
    mapped = ROLE_LEGACY_MAP.get(role)
    if mapped:
        return ROLE_HIERARCHY_V2.get(mapped, 0)
    
    return 0


def can_manage_role_v2(current_role: str, target_role: str) -> bool:
    """
    Verifica si un rol puede gestionar a otro.
    
    NOTA: Esta función NO está conectada a producción.
    """
    current_level = get_role_level_v2(current_role)
    target_level = get_role_level_v2(target_role)
    
    # SUPER_ADMIN puede gestionar a todos
    if current_level >= 100:
        return True
    
    # Solo puede gestionar roles de menor nivel
    return current_level > target_level


def build_permission_code(modulo: str, submodulo: str, accion: str) -> str:
    """
    Construye un código de permiso estandarizado.
    
    Ejemplo: build_permission_code('comercial', 'dashboard', 'ver')
    Retorna: 'COMERCIAL_DASHBOARD_VER'
    """
    return f"{modulo.upper()}_{submodulo.upper()}_{accion.upper()}"


def translate_server_to_sucursal(server_id: str, mapeos: List[Dict]) -> Optional[str]:
    """
    Traduce un server_id al sucursal_id correspondiente.
    
    NOTA: Esta función NO está conectada a producción.
    Requiere pasar la lista de mapeos externamente.
    """
    for mapeo in mapeos:
        if mapeo.get('server_id') == server_id:
            return mapeo.get('sucursal_id')
    return None


def translate_sucursal_to_server(sucursal_id: str, mapeos: List[Dict]) -> Optional[str]:
    """
    Traduce un sucursal_id al server_id correspondiente.
    
    NOTA: Esta función NO está conectada a producción.
    """
    for mapeo in mapeos:
        if mapeo.get('sucursal_id') == sucursal_id:
            return mapeo.get('server_id')
    return None


def create_audit_entry(
    usuario_id: str,
    usuario_email: str,
    accion: str,
    recurso: str,
    metodo: str,
    resultado: str,
    ip: str = "",
    detalles: Dict = None
) -> Dict:
    """
    Crea una entrada de bitácora de acceso.
    
    NOTA: Esta función NO está conectada a producción.
    Solo genera el documento, no lo inserta.
    """
    return {
        "id": str(uuid.uuid4()),
        "timestamp": datetime.now(timezone.utc),
        "usuario_id": usuario_id,
        "usuario_email": usuario_email,
        "accion": accion,
        "recurso": recurso,
        "metodo": metodo,
        "resultado": resultado,
        "ip": ip,
        "detalles": detalles or {},
        "sistema_verificacion": "V2_PASIVO"  # Indicador de que viene del sistema nuevo
    }


def validate_permission_format(codigo: str) -> bool:
    """
    Valida que un código de permiso tenga el formato correcto.
    Formato: MODULO_SUBMODULO_ACCION
    """
    parts = codigo.split('_')
    return len(parts) >= 3 and all(part.isupper() for part in parts)


def get_permissions_for_module(modulo: str, permisos_catalogo: List[Dict]) -> List[Dict]:
    """
    Obtiene todos los permisos de un módulo específico.
    
    NOTA: Requiere pasar el catálogo externamente (no consulta BD).
    """
    return [p for p in permisos_catalogo if p.get('modulo') == modulo]


def check_user_has_permission_v2(
    user_permissions: List[str],
    required_permission: str
) -> bool:
    """
    Verifica si un usuario tiene un permiso específico.
    
    NOTA: Esta función NO está conectada a producción.
    Requiere pasar la lista de permisos del usuario externamente.
    """
    return required_permission in user_permissions


def get_user_accessible_sucursales(
    user_contextos: List[Dict],
    tipo: str = "sucursal"
) -> List[str]:
    """
    Obtiene las sucursales a las que un usuario tiene acceso.
    
    NOTA: Esta función NO está conectada a producción.
    Requiere pasar los contextos del usuario externamente.
    """
    return [
        c.get('contexto_id') 
        for c in user_contextos 
        if c.get('tipo_contexto') == tipo and c.get('activo')
    ]


