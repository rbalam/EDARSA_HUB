class PermisoV2:
    """Modelo conceptual de permiso v2 (no conectado a BD)."""
    
    def __init__(self, codigo: str, modulo: str, submodulo: str, accion: str):
        self.codigo = codigo
        self.modulo = modulo
        self.submodulo = submodulo
        self.accion = accion
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'PermisoV2':
        return cls(
            codigo=data.get('codigo', ''),
            modulo=data.get('modulo', ''),
            submodulo=data.get('submodulo', ''),
            accion=data.get('accion', '')
        )


class ContextoAccesoV2:
    """Modelo conceptual de contexto de acceso (no conectado a BD)."""
    
    def __init__(
        self, 
        usuario_id: str, 
        tipo_contexto: str, 
        contexto_id: str,
        activo: bool = True
    ):
        self.usuario_id = usuario_id
        self.tipo_contexto = tipo_contexto  # empresa|unidad_negocio|sucursal
        self.contexto_id = contexto_id
        self.activo = activo


