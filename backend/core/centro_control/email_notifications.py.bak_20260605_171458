def _send_email_sync(recipient: str, subject: str, html_content: str, text_content: str = None) -> Dict[str, Any]:
    """
    Envía un email de forma síncrona (para usar en thread pool).
    
    Returns:
        Dict con resultado del envío
    """
    result = {
        "success": False,
        "recipient": recipient,
        "error": None
    }
    
    try:
        # Crear mensaje
        msg = MIMEMultipart('alternative')
        msg['Subject'] = subject
        msg['From'] = f"{EMAIL_FROM_NAME} <{EMAIL_FROM}>"
        msg['To'] = recipient
        
        # Texto plano como fallback
        if text_content:
            part1 = MIMEText(text_content, 'plain', 'utf-8')
            msg.attach(part1)
        
        # HTML
        part2 = MIMEText(html_content, 'html', 'utf-8')
        msg.attach(part2)
        
        # Conectar y enviar
        if EMAIL_USE_TLS:
            # STARTTLS
            server = smtplib.SMTP(EMAIL_HOST, EMAIL_PORT, timeout=30)
            server.ehlo()
            server.starttls()
            server.ehlo()
        else:
            server = smtplib.SMTP(EMAIL_HOST, EMAIL_PORT, timeout=30)
        
        server.login(EMAIL_USER, EMAIL_PASSWORD)
        server.sendmail(EMAIL_FROM, recipient, msg.as_string())
        server.quit()
        
        result["success"] = True
        logger.info(f"[EMAIL] Alerta enviada exitosamente a {recipient}")
        
    except smtplib.SMTPAuthenticationError as e:
        result["error"] = f"Error de autenticación SMTP: {str(e)[:100]}"
        logger.error(f"[EMAIL] Error de auth enviando a {recipient}: {e}")
    except smtplib.SMTPException as e:
        result["error"] = f"Error SMTP: {str(e)[:100]}"
        logger.error(f"[EMAIL] Error SMTP enviando a {recipient}: {e}")
    except Exception as e:
        result["error"] = f"Error: {str(e)[:100]}"
        logger.error(f"[EMAIL] Error enviando a {recipient}: {e}")
    
    return result


async def send_critical_alert_email(alerta: Dict[str, Any]) -> Dict[str, Any]:
    """
    Envía un email de alerta crítica a los destinatarios configurados.
    
    Args:
        alerta: Diccionario con datos de la alerta
        
    Returns:
        Dict con resultado del envío
    """
    result = {
        "success": False,
        "message": "",
        "recipients": [],
        "enviados": 0,
        "errors": []
    }
    
    # Verificar si está habilitado
    if not EMAIL_ENABLED:
        result["message"] = "Servicio de email deshabilitado (EMAIL_ENABLED=false)"
        logger.info("[EMAIL] Servicio de email deshabilitado")
        return result
    
    # Verificar configuración
    if not EMAIL_HOST or not EMAIL_USER or not EMAIL_PASSWORD:
        result["message"] = "Configuración SMTP incompleta en .env"
        logger.warning("[EMAIL] Configuración SMTP incompleta")
        return result
    
    recipients = get_email_recipients()
    if not recipients:
        result["message"] = "No hay destinatarios configurados (ALERT_EMAIL_TO)"
        logger.warning("[EMAIL] No hay destinatarios configurados")
        return result
    
    result["recipients"] = recipients
    
    # Generar contenido
    titulo_alerta = alerta.get('titulo', 'Alerta Crítica')
    modulo = alerta.get('modulo', 'Sistema')
    severidad = alerta.get('severidad', 'critical').upper()
    
    subject = f"[{severidad}] {titulo_alerta} - {modulo}"
    html_content = generate_alert_html(alerta)
    text_content = f"""
ALERTA {severidad} - Centro de Control EDARSA

{titulo_alerta}

Módulo: {modulo}
Severidad: {severidad}
Detalle: {alerta.get('detalle', alerta.get('mensaje', 'Sin detalles'))}

---
Este es un mensaje automático del Centro de Control EDARSA HUB.
    """
    
    # Enviar emails en paralelo usando thread pool
    loop = asyncio.get_event_loop()
    tasks = []
    
    for recipient in recipients:
        task = loop.run_in_executor(
            _executor,
            _send_email_sync,
            recipient,
            subject,
            html_content,
            text_content
        )
        tasks.append(task)
    
    # Esperar resultados
    results = await asyncio.gather(*tasks, return_exceptions=True)
    
    for res in results:
        if isinstance(res, Exception):
            result["errors"].append(str(res)[:100])
        elif isinstance(res, dict):
            if res.get("success"):
                result["enviados"] += 1
            elif res.get("error"):
                result["errors"].append(f"{res.get('recipient')}: {res.get('error')}")
    
    if result["enviados"] > 0:
        result["success"] = True
        result["message"] = f"Email enviado a {result['enviados']}/{len(recipients)} destinatarios"
    else:
        result["message"] = "No se pudo enviar a ningún destinatario"
    
    return result


def get_email_config_status() -> Dict[str, Any]:
    """Retorna el estado de configuración del servicio de email"""
    recipients = get_email_recipients()
    
    return {
        "configured": is_email_configured(),
        "enabled": EMAIL_ENABLED,
        "smtp_host": EMAIL_HOST if EMAIL_HOST else None,
        "smtp_port": EMAIL_PORT,
        "from_email": EMAIL_FROM if EMAIL_FROM else None,
        "use_tls": EMAIL_USE_TLS,
        "recipients_count": len(recipients),
        "recipients": [r[:3] + "***" + r[r.find("@"):] if "@" in r else "***" for r in recipients]
    }


async def send_test_email(recipient: str = None) -> Dict[str, Any]:
    """
    Envía un email de prueba para verificar la configuración.
    
    Args:
        recipient: Email destino (opcional, usa el primer configurado si no se especifica)
        
    Returns:
        Dict con resultado del envío
    """
    recipients = get_email_recipients()
    
    if not recipient:
        if recipients:
            recipient = recipients[0]
        else:
            return {
                "success": False,
                "message": "No hay destinatarios configurados"
            }
    
    test_alerta = {
        "id": f"test_{datetime.now(timezone.utc).strftime('%H%M%S')}",
        "titulo": "Prueba de Notificaciones",
        "severidad": "medium",
        "modulo": "Centro de Control",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "detalle": "Este es un correo de prueba para verificar que las notificaciones por email están funcionando correctamente."
    }
    
    # Temporalmente usar solo el recipient especificado
    try:
        # Enviar
        loop = asyncio.get_event_loop()
        res = await loop.run_in_executor(
            _executor,
            _send_email_sync,
            recipient,
            "[TEST] Prueba de Notificaciones - Centro de Control EDARSA",
            generate_alert_html(test_alerta),
            "Este es un correo de prueba del Centro de Control EDARSA."
        )
        
        return {
            "success": res.get("success", False),
            "message": "Email de prueba enviado" if res.get("success") else res.get("error", "Error desconocido"),
            "recipient": recipient
        }
        
    except Exception as e:
        return {
            "success": False,
            "message": f"Error: {str(e)[:200]}",
            "recipient": recipient
        }
