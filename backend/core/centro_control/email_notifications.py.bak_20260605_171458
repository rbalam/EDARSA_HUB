"""
CENTRO DE CONTROL EDARSA - Servicio de Notificaciones por Email
================================================================
Envío de emails para alertas críticas usando SMTP nativo de EDARSA.

Los destinatarios se obtienen de:
1. MongoDB (colección alert_recipients) - Prioridad
2. Variable de entorno ALERT_EMAIL_TO - Fallback

Configuración requerida en backend/.env:
- EMAIL_HOST: Servidor SMTP
- EMAIL_PORT: Puerto SMTP
- EMAIL_USER: Usuario SMTP
- EMAIL_PASSWORD: Contraseña SMTP
- EMAIL_FROM: Email remitente

Uso:
    from core.centro_control.email_notifications import send_critical_alert_email
    
    await send_critical_alert_email(alerta_data)
"""

import os
import ssl
import logging
import smtplib
import asyncio
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from datetime import datetime, timezone
from typing import Dict, Any, List
from concurrent.futures import ThreadPoolExecutor

logger = logging.getLogger(__name__)

# Configuración SMTP desde .env
EMAIL_HOST = os.environ.get('EMAIL_HOST', '')
EMAIL_PORT = int(os.environ.get('EMAIL_PORT', '587'))
EMAIL_USER = os.environ.get('EMAIL_USER', '')
EMAIL_PASSWORD = os.environ.get('EMAIL_PASSWORD', '')
EMAIL_FROM = os.environ.get('EMAIL_FROM', '')
EMAIL_FROM_NAME = os.environ.get('EMAIL_FROM_NAME', 'EDARSA HUB')
EMAIL_USE_TLS = os.environ.get('EMAIL_USE_TLS', 'true').lower() == 'true'
EMAIL_ENABLED = os.environ.get('EMAIL_ENABLED', 'true').lower() == 'true'

# Destinatarios de alertas críticas (fallback desde .env)
ALERT_EMAIL_TO = os.environ.get('ALERT_EMAIL_TO', '')

# Thread pool para envío asíncrono
_executor = ThreadPoolExecutor(max_workers=2)


def get_email_recipients() -> List[str]:
    """
    Obtiene la lista de destinatarios de email.
    Prioridad: MongoDB > Variable de entorno
    """
    # Intentar obtener de MongoDB primero
    try:
        from core.centro_control.recipients_manager import get_email_recipients as get_db_recipients
        db_recipients = get_db_recipients()
        if db_recipients:
            return db_recipients
    except Exception as e:
        logger.debug(f"[EMAIL] No se pudo obtener recipients de MongoDB: {e}")
    
    # Fallback a variable de entorno
    if not ALERT_EMAIL_TO:
        return []
    return [email.strip() for email in ALERT_EMAIL_TO.split(',') if email.strip()]


def is_email_configured() -> bool:
    """Verifica si el servicio de email está configurado"""
    return bool(
        EMAIL_ENABLED and 
        EMAIL_HOST and 
        EMAIL_USER and 
        EMAIL_PASSWORD and 
        EMAIL_FROM and
        get_email_recipients()
    )


