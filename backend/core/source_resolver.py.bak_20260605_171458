"""
EDARSA HUB - Source Query Result Envelope
==========================================
Capa centralizada de resolución de fuentes por módulo.

REGLA ARQUITECTÓNICA OBLIGATORIA:
"Un resultado en cero solo es válido si hubo consulta real exitosa a la fuente correcta.
Si no hubo acceso a la fuente, el resultado no es cero: es fuente no consultada."

"No conviertas limitaciones de infraestructura en datos de negocio."

ESTADOS FUNCIONALES:
- SUCCESS_WITH_DATA: Consulta exitosa con resultados
- SUCCESS_EMPTY: Consulta exitosa, cero resultados reales
- SOURCE_UNREACHABLE: Fuente no accesible (timeout, red, túnel)
- SOURCE_NOT_CONFIGURED: Configuración faltante o inválida
- QUERY_TIMEOUT: Consulta excedió tiempo límite
- PARTIAL_SUCCESS: Algunas fuentes respondieron, otras no
- AUTH_ERROR: Credenciales inválidas o permisos insuficientes
- EXECUTION_SKIPPED: Ejecución omitida por cooldown o política
- CONNECTION_COOLDOWN: Servidor en periodo de espera por fallas previas
- UNKNOWN_ERROR: Error no clasificado

Autor: EDARSA HUB
Fecha: Abril 2026
"""

from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import List, Dict, Any, Optional
import logging

logger = logging.getLogger(__name__)


class QueryStatus(str, Enum):
    """Estados de consulta a fuente de datos."""
    
    # Consulta exitosa
    SUCCESS_WITH_DATA = "SUCCESS_WITH_DATA"
    SUCCESS_EMPTY = "SUCCESS_EMPTY"
    
    # Errores de conectividad
    SOURCE_UNREACHABLE = "SOURCE_UNREACHABLE"
    CONNECTION_COOLDOWN = "CONNECTION_COOLDOWN"
    QUERY_TIMEOUT = "QUERY_TIMEOUT"
    
    # Errores de configuración
    SOURCE_NOT_CONFIGURED = "SOURCE_NOT_CONFIGURED"
    AUTH_ERROR = "AUTH_ERROR"
    
    # Estados compuestos
    PARTIAL_SUCCESS = "PARTIAL_SUCCESS"
    EXECUTION_SKIPPED = "EXECUTION_SKIPPED"
    
    # Fallback
    UNKNOWN_ERROR = "UNKNOWN_ERROR"
    
    def is_success(self) -> bool:
        """Retorna True solo si la consulta fue exitosa (con o sin datos)."""
        return self in (QueryStatus.SUCCESS_WITH_DATA, QueryStatus.SUCCESS_EMPTY)
    
    def is_data_available(self) -> bool:
        """Retorna True solo si hay datos disponibles."""
        return self == QueryStatus.SUCCESS_WITH_DATA
    
    def is_connection_error(self) -> bool:
        """Retorna True si es error de conectividad."""
        return self in (
            QueryStatus.SOURCE_UNREACHABLE,
            QueryStatus.CONNECTION_COOLDOWN,
            QueryStatus.QUERY_TIMEOUT
        )
    
    def is_retriable(self) -> bool:
        """Retorna True si la operación puede reintentarse."""
        return self in (
            QueryStatus.SOURCE_UNREACHABLE,
            QueryStatus.QUERY_TIMEOUT,
            QueryStatus.UNKNOWN_ERROR
        )


@dataclass
class SourceQueryResult:
    """
    Envelope de resultado de consulta a fuente de datos.
    
    NUNCA devuelve datos sin indicar el estado de la consulta.
    NUNCA usa [] o 0 para indicar error de conectividad.
    
    Attributes:
        status: Estado de la consulta (QueryStatus)
        data: Datos retornados (solo válido si status.is_success())
        source_type: Tipo de fuente (MPRO, SoftRestaurant, MongoDB, API)
        source_id: Identificador de la fuente (server_id, api_name)
        query_executed: True si la consulta se ejecutó realmente
        row_count: Cantidad de registros (solo si query_executed=True)
        error_message: Mensaje de error técnico
        error_code: Código de error específico
        timestamp: Momento de la consulta
        duration_ms: Duración en milisegundos
        is_retriable: Si la operación puede reintentarse
        cooldown_remaining_seconds: Segundos restantes de cooldown
        metadata: Información adicional
    """
    
    status: QueryStatus
    data: List[Dict[str, Any]] = field(default_factory=list)
    source_type: str = ""
    source_id: str = ""
    query_executed: bool = False
    row_count: int = 0
    error_message: str = ""
    error_code: str = ""
    timestamp: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
    duration_ms: int = 0
    is_retriable: bool = False
    cooldown_remaining_seconds: int = 0
    metadata: Dict[str, Any] = field(default_factory=dict)
    
    def __post_init__(self):
        """Validaciones post-inicialización."""
        # Si hay datos, asegurar que el status es SUCCESS_WITH_DATA
        if self.data and len(self.data) > 0 and self.status != QueryStatus.SUCCESS_WITH_DATA:
            self.status = QueryStatus.SUCCESS_WITH_DATA
        
        # Actualizar row_count si hay datos
        if self.status == QueryStatus.SUCCESS_WITH_DATA:
            self.row_count = len(self.data)
            self.query_executed = True
        elif self.status == QueryStatus.SUCCESS_EMPTY:
            self.row_count = 0
            self.query_executed = True
        
        # Actualizar is_retriable
        self.is_retriable = self.status.is_retriable()
    
    def to_dict(self) -> Dict[str, Any]:
        """Serializa a diccionario para JSON/MongoDB."""
        return {
            "status": self.status.value,
            "query_executed": self.query_executed,
            "row_count": self.row_count,
            "source_type": self.source_type,
            "source_id": self.source_id,
            "error_message": self.error_message,
            "error_code": self.error_code,
            "timestamp": self.timestamp,
            "duration_ms": self.duration_ms,
            "is_retriable": self.is_retriable,
            "cooldown_remaining_seconds": self.cooldown_remaining_seconds,
            "metadata": self.metadata
        }
    
    def to_dict_with_data(self) -> Dict[str, Any]:
        """Serializa incluyendo los datos."""
        result = self.to_dict()
        result["data"] = self.data
        return result
    
    @staticmethod
    def success_with_data(
        data: List[Dict],
        source_type: str,
        source_id: str,
        duration_ms: int = 0,
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para resultado exitoso con datos."""
        return SourceQueryResult(
            status=QueryStatus.SUCCESS_WITH_DATA,
            data=data,
            source_type=source_type,
            source_id=source_id,
            query_executed=True,
            row_count=len(data),
            duration_ms=duration_ms,
            metadata=metadata or {}
        )
    
    @staticmethod
    def success_empty(
        source_type: str,
        source_id: str,
        duration_ms: int = 0,
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para consulta exitosa sin resultados."""
        return SourceQueryResult(
            status=QueryStatus.SUCCESS_EMPTY,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=True,
            row_count=0,
            duration_ms=duration_ms,
            metadata=metadata or {}
        )
    
    @staticmethod
    def source_unreachable(
        source_type: str,
        source_id: str,
        error_message: str,
        error_code: str = "",
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para fuente no accesible."""
        return SourceQueryResult(
            status=QueryStatus.SOURCE_UNREACHABLE,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=False,
            row_count=0,
            error_message=error_message,
            error_code=error_code,
            is_retriable=True,
            metadata=metadata or {}
        )
    
    @staticmethod
    def connection_cooldown(
        source_type: str,
        source_id: str,
        cooldown_remaining_seconds: int,
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para servidor en cooldown."""
        return SourceQueryResult(
            status=QueryStatus.CONNECTION_COOLDOWN,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=False,
            row_count=0,
            error_message=f"Servidor en cooldown. Reintentar en {cooldown_remaining_seconds}s",
            cooldown_remaining_seconds=cooldown_remaining_seconds,
            is_retriable=True,
            metadata=metadata or {}
        )
    
    @staticmethod
    def query_timeout(
        source_type: str,
        source_id: str,
        timeout_seconds: int,
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para timeout de consulta."""
        return SourceQueryResult(
            status=QueryStatus.QUERY_TIMEOUT,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=False,
            row_count=0,
            error_message=f"Consulta excedió timeout de {timeout_seconds}s",
            is_retriable=True,
            metadata=metadata or {}
        )
    
    @staticmethod
    def auth_error(
        source_type: str,
        source_id: str,
        error_message: str,
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para error de autenticación."""
        return SourceQueryResult(
            status=QueryStatus.AUTH_ERROR,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=False,
            row_count=0,
            error_message=error_message,
            is_retriable=False,
            metadata=metadata or {}
        )
    
    @staticmethod
    def source_not_configured(
        source_type: str,
        source_id: str,
        error_message: str,
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para fuente no configurada."""
        return SourceQueryResult(
            status=QueryStatus.SOURCE_NOT_CONFIGURED,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=False,
            row_count=0,
            error_message=error_message,
            is_retriable=False,
            metadata=metadata or {}
        )
    
    @staticmethod
    def unknown_error(
        source_type: str,
        source_id: str,
        error_message: str,
        error_code: str = "",
        metadata: Dict = None
    ) -> "SourceQueryResult":
        """Factory para error desconocido."""
        return SourceQueryResult(
            status=QueryStatus.UNKNOWN_ERROR,
            data=[],
            source_type=source_type,
            source_id=source_id,
            query_executed=False,
            row_count=0,
            error_message=error_message,
            error_code=error_code,
            is_retriable=True,
            metadata=metadata or {}
        )


@dataclass
class AggregatedQueryResult:
    """
    Resultado agregado de múltiples consultas a fuentes.
    
    Útil para jobs que consultan múltiples servidores/empresas.
    """
    
    total_sources: int = 0
    sources_success: int = 0
    sources_empty: int = 0
    sources_unreachable: int = 0
    sources_error: int = 0
    sources_skipped: int = 0
    
    total_rows: int = 0
    
    # Detalle por fuente
    results: List[SourceQueryResult] = field(default_factory=list)
    
    # Timestamps
    started_at: str = ""
    completed_at: str = ""
    duration_ms: int = 0
    
    def add_result(self, result: SourceQueryResult):
        """Agrega un resultado y actualiza contadores."""
        self.results.append(result)
        self.total_sources += 1
        
        if result.status == QueryStatus.SUCCESS_WITH_DATA:
            self.sources_success += 1
            self.total_rows += result.row_count
        elif result.status == QueryStatus.SUCCESS_EMPTY:
            self.sources_empty += 1
        elif result.status in (QueryStatus.SOURCE_UNREACHABLE, QueryStatus.CONNECTION_COOLDOWN, QueryStatus.QUERY_TIMEOUT):
            self.sources_unreachable += 1
        elif result.status == QueryStatus.EXECUTION_SKIPPED:
            self.sources_skipped += 1
        else:
            self.sources_error += 1
    
    def get_overall_status(self) -> QueryStatus:
        """Determina el estado general de la ejecución."""
        if self.total_sources == 0:
            return QueryStatus.EXECUTION_SKIPPED
        
        if self.sources_unreachable == self.total_sources:
            return QueryStatus.SOURCE_UNREACHABLE
        
        if self.sources_success > 0 or self.sources_empty > 0:
            if self.sources_unreachable > 0 or self.sources_error > 0:
                return QueryStatus.PARTIAL_SUCCESS
            elif self.sources_success > 0:
                return QueryStatus.SUCCESS_WITH_DATA
            else:
                return QueryStatus.SUCCESS_EMPTY
        
        if self.sources_error > 0:
            return QueryStatus.UNKNOWN_ERROR
        
        return QueryStatus.EXECUTION_SKIPPED
    
    def to_dict(self) -> Dict[str, Any]:
        """Serializa a diccionario."""
        return {
            "overall_status": self.get_overall_status().value,
            "total_sources": self.total_sources,
            "sources_success": self.sources_success,
            "sources_empty": self.sources_empty,
            "sources_unreachable": self.sources_unreachable,
            "sources_error": self.sources_error,
            "sources_skipped": self.sources_skipped,
            "total_rows": self.total_rows,
            "started_at": self.started_at,
            "completed_at": self.completed_at,
            "duration_ms": self.duration_ms,
            "results_summary": [r.to_dict() for r in self.results]
        }


def classify_sql_error(error: Exception) -> QueryStatus:
    """
    Clasifica un error SQL en el QueryStatus apropiado.
    
    Args:
        error: Excepción capturada
        
    Returns:
        QueryStatus correspondiente al tipo de error
    """
    error_str = str(error).lower()
    
    # Errores de conectividad
    connectivity_indicators = [
        "connection refused",
        "network is unreachable",
        "no route to host",
        "connection timed out",
        "timeout",
        "unable to connect",
        "cannot connect",
        "connection reset",
        "broken pipe",
        "host not found",
        "name or service not known",
        "network error",
        "socket error",
        "dbprocess is dead",
        "dead connection"
    ]
    
    if any(ind in error_str for ind in connectivity_indicators):
        return QueryStatus.SOURCE_UNREACHABLE
    
    # Errores de autenticación
    auth_indicators = [
        "login failed",
        "access denied",
        "permission denied",
        "authentication failed",
        "invalid credentials",
        "unauthorized"
    ]
    
    if any(ind in error_str for ind in auth_indicators):
        return QueryStatus.AUTH_ERROR
    
    # Timeout específico
    if "timeout" in error_str:
        return QueryStatus.QUERY_TIMEOUT
    
    return QueryStatus.UNKNOWN_ERROR


