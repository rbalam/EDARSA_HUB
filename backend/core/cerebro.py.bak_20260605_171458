# =============================================================================

def validar_rfc(rfc: str) -> bool:
    """Valida formato de RFC mexicano"""
    import re
    patron = r'^[A-ZÑ&]{3,4}[0-9]{6}[A-Z0-9]{3}$'
    return bool(re.match(patron, rfc.upper()))


def validar_clabe(clabe: str) -> bool:
    """Valida CLABE bancaria mexicana (18 dígitos)"""
    return len(clabe) == 18 and clabe.isdigit()


def validar_email_corporativo(email: str, dominios_permitidos: List[str] = None) -> bool:
    """Valida que el email pertenezca a dominios permitidos"""
    if not dominios_permitidos:
        return True
    dominio = email.split('@')[-1]
    return dominio in dominios_permitidos


