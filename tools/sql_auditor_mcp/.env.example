# Identidad solicitante. Se valida en dbo.Usuario_Catalogo / Usuario_Roles.
EDARSA_SQL_AUDITOR_REQUESTER_EMAIL=usuario@empresa.com

# Limite duro de filas por consulta.
EDARSA_SQL_AUDITOR_MAX_ROWS=5000

# stdio para desarrollo local; streamable-http para exponerlo a ChatGPT.
EDARSA_SQL_AUDITOR_TRANSPORT=stdio

# El agente reutiliza la configuracion canonica del backend EDARSAHUB
# (incluyendo SERVER_SECRET_KEY y credenciales EDARSAHUB existentes).
