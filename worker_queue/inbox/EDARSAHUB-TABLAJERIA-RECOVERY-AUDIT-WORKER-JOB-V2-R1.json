    {
      "type": "sql_readonly_audit",
      "source": "EDARSAHUB",
      "queries": [
        {
          "name": "tablajeria_sql_objects_by_name",
          "sql": "SELECT s.name AS schema_name, o.name AS object_name, o.type_desc, o.create_date, o.modify_date FROM sys.objects o INNER JOIN sys.schemas s ON s.schema_id = o.schema_id WHERE o.name LIKE '%Tablaje%' OR o.name LIKE '%Tablajeria%' OR o.name LIKE '%Tablajería%' OR o.name LIKE '%Merma%' OR o.name LIKE '%Rendimiento%' OR o.name LIKE '%Genealogia%' OR o.name LIKE '%Genealogía%' OR o.name LIKE '%Derivado%' OR o.name LIKE '%Plantilla%' ORDER BY s.name, o.name;"
        },
        {
          "name": "tablajeria_columns_identity_rbac_fechaoperacion",
          "sql": "SELECT s.name AS schema_name, t.name AS table_name, c.name AS column_name, ty.name AS data_type, c.max_length, c.precision, c.scale, c.is_nullable FROM sys.tables t INNER JOIN sys.schemas s ON s.schema_id = t.schema_id INNER JOIN sys.columns c ON c.object_id = t.object_id INNER JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE (t.name LIKE '%Tablaje%' OR t.name LIKE '%Tablajeria%' OR t.name LIKE '%Tablajería%' OR t.name LIKE '%Merma%' OR t.name LIKE '%Rendimiento%' OR t.name LIKE '%Derivado%' OR t.name LIKE '%Plantilla%') AND (c.name IN ('EmpresaID','UnidadNegocioID','ServerID','SucursalID','AlmacenID','FechaOperacion','FechaOperación') OR c.name LIKE '%Estado%' OR c.name LIKE '%RBAC%' OR c.name LIKE '%Peso%' OR c.name LIKE '%Costo%' OR c.name LIKE '%Merma%' OR c.name LIKE '%Lote%' OR c.name LIKE '%Proveedor%') ORDER BY s.name, t.name, c.column_id;"
        },
        {
          "name": "tablajeria_sql_modules_references",
          "sql": "SELECT s.name AS schema_name, o.name AS object_name, o.type_desc FROM sys.sql_modules m INNER JOIN sys.objects o ON o.object_id = m.object_id INNER JOIN sys.schemas s ON s.schema_id = o.schema_id WHERE m.definition LIKE '%Tablaje%' OR m.definition LIKE '%Tablajeria%' OR m.definition LIKE '%Tablajería%' OR m.definition LIKE '%FechaOperacion%' OR m.definition LIKE '%Operaciones_Tablaje%' OR m.definition LIKE '%Merma%' OR m.definition LIKE '%Rendimiento%' OR m.definition LIKE '%Prorrateo%' ORDER BY s.name, o.name;"
        },
        {
          "name": "tablajeria_foreign_keys_and_indexes",
          "sql": "SELECT OBJECT_SCHEMA_NAME(t.object_id) AS schema_name, t.name AS table_name, fk.name AS foreign_key_name, OBJECT_SCHEMA_NAME(fk.referenced_object_id) AS referenced_schema, OBJECT_NAME(fk.referenced_object_id) AS referenced_table FROM sys.foreign_keys fk INNER JOIN sys.tables t ON t.object_id = fk.parent_object_id WHERE t.name LIKE '%Tablaje%' OR t.name LIKE '%Tablajeria%' OR t.name LIKE '%Tablajería%' OR t.name LIKE '%Merma%' OR t.name LIKE '%Derivado%' ORDER BY schema_name, table_name, foreign_key_name;"
        }
      ]
    }
