              [
                "AC_vwSaldoCxp",
                "CREATE VIEW AC_vwSaldoCxp\r\nAS\r\nWITH ProvSaldo AS (\r\nSELECT 1 AS tipodecompra,\r\n       p.idproveedor,\r\n       p.nombre,\r\n       folio,\r\n       foliofactura,\r\n       fechafactura,\r\n\t   CONVERT(DATETIME, CONVERT(CHAR(10), c.fechaaplicacion, 102) + ' 00:00:00.00', 102) AS fechaaplicacion,\r\n       fechavencimiento,\r\n       CASE WHEN DATEDIFF(day,fechavencimiento,GETDATE())  <0 THEN 0 ELSE DATEDIFF(day,fechavencimiento,GETDATE()) END  AS diasvencidos,\r\n       CASE WHEN DATEDIFF(day,fechavencimiento,GETDATE())  >0 THEN 0 ELSE DATEDIFF(day,fechavencimiento,GETDATE()) END AS  diasvencimiento,\r\n\t   c.total,\r\n       ISNULL((SELECT SUM(abono) AS abono FROM pagosproveedores WHERE foliocompra =c.idcompra ),0) AS   abono,\r\n       descuento\r\nFROM proveedores  AS p\r\n    INNER JOIN compras AS c\r\n        ON p.idproveedor = c.idproveedor\r\nWHERE  CAST(ISNULL(cancelado, 0) AS INT) = 0\r\n), Cxp AS (\r\nSELECT '['+ p.idproveedor+'] '+p.nombre AS PROVEEDOR,\r\n       folio,\r\n       foliofactura,\r\n       fechafactura,\r\n       fechavencimiento,\r\n\t   p.diasvencidos,\r\n\t   p.diasvencimiento,\r\n\t   CASE WHEN p.diasvencidos+p.diasvencimiento <= 0 THEN SUM(p.total-p.abono) ELSE 0 END AS [POR VENCER],\r\n\t   CASE WHEN p.diasvencidos >= 1 AND p.diasvencidos <= 15  then  SUM(p.total-p.abono) ELSE 0 END  AS [01-15],\r\n\t   CASE WHEN p.diasvencidos >= 16 AND p.diasvencidos <= 30 then  SUM(p.total-p.abono) ELSE 0 END  AS [16-30],\r\n\t   CASE WHEN p.diasvencidos >= 31 AND p.diasvencidos <= 60 then  SUM(p.total-p.abono) ELSE 0 END  AS [31-60],\r\n\t   CASE WHEN p.diasvencidos >= 61 AND p.diasvencidos <= 90 then SUM(p.total-p.abono) ELSE 0 END  AS [61-90],\r\n\t   CASE WHEN p.diasvencidos >= 91 AND p.diasvencidos <= 120 then  SUM(p.total-p.abono) ELSE 0 END  AS [91-120],\r\n\t   CASE WHEN p.diasvencidos >= 121 AND p.diasvencidos <= 150 then  SUM(p.total-p.abono) ELSE 0 END  AS [121-150],\r\n\t   CASE WHEN p.diasvencidos >= 150 then  SUM(p.total-p.abono) ELSE 0 END  AS [+151],\r\n\t   p.fechaaplicacion\r\n  FROM ProvSaldo AS p\r\n  GROUP BY p.nombre,\r\n\t\t\tp.idproveedor,\r\n\t\t   p.diasvencidos,\r\n\t\tfolio,\r\n       foliofactura,\r\n       fechafactura,\r\n       fechavencimiento,\r\n\t\t   p.diasvencimiento,\r\n\t\t   p.fechaaplicacion\r\n HAVING SUM(p.total-p.abono)>0\r\n)\t\r\nSELECT Cxp.PROVEEDOR,\r\n\t   SUM(Cxp.[POR VENCER]) [POR VENCER],\r\n       SUM(Cxp.[01-15]) [01-15],\r\n       SUM(Cxp.[16-30]) [16-30],\r\n       SUM(Cxp.[31-60]) [31-60],\r\n       SUM(Cxp.[61-90]) [61-90],\r\n       SUM(Cxp.[91-120]) [91-120],\r\n       SUM(Cxp.[121-150]) [121-150],\r\n       SUM(Cxp.[+151]) [+151],\r\n\t   SUM(Cxp.[POR VENCER])+ SUM(Cxp.[01-15])+ SUM(Cxp.[16-30])+ SUM(Cxp.[31-60]) + SUM(Cxp.[61-90]) + SUM(Cxp.[91-120]) + SUM(Cxp.[121-150]) + SUM(Cxp.[+151]) AS [Total CXP],\r\n\t   Cxp.fechaaplicacion\r\nFROM Cxp\r\n--WHERE Cxp.fechaaplicacion  BETWEEN '01/01/2024 06:00:00 AM' AND '12/09/2024 05:59:59 AM'\r\nGROUP BY Cxp.PROVEEDOR,Cxp.fechaaplicacion;\r\n"
              ]
            ],
