// Formateo de fechas
const formatDateTime = (isoString) => {
  if (!isoString) return '-';
  const date = new Date(isoString);
  return date.toLocaleString('es-MX', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
};

const formatTime = (isoString) => {
  if (!isoString) return '-';
  const date = new Date(isoString);
  return date.toLocaleTimeString('es-MX', {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
};

const formatDuration = (ms) => {
  if (!ms && ms !== 0) return '-';
  if (ms < 1000) return `${ms}ms`;
  if (ms < 60000) return `${(ms / 1000).toFixed(1)}s`;
  return `${(ms / 60000).toFixed(1)}m`;
};

// Componente de estado del job
const JobStatusBadge = ({ status, paused }) => {
  if (paused) {
    return (
      <Badge variant="outline" className="bg-amber-50 text-amber-700 border-amber-200">
        <Pause className="w-3 h-3 mr-1" />
        Pausado
      </Badge>
    );
  }
  
  switch (status) {
    case 'success':
      return (
        <Badge variant="outline" className="bg-emerald-50 text-emerald-700 border-emerald-200">
          <CheckCircle2 className="w-3 h-3 mr-1" />
          Activo
        </Badge>
      );
    case 'failed':
      return (
        <Badge variant="outline" className="bg-red-50 text-red-700 border-red-200">
          <XCircle className="w-3 h-3 mr-1" />
          Error
        </Badge>
      );
    case 'running':
      return (
        <Badge variant="outline" className="bg-blue-50 text-blue-700 border-blue-200">
          <Loader2 className="w-3 h-3 mr-1 animate-spin" />
          Ejecutando
        </Badge>
      );
    default:
      return (
        <Badge variant="outline" className="bg-zinc-50 text-zinc-700 border-zinc-200">
          <Activity className="w-3 h-3 mr-1" />
          Activo
        </Badge>
      );
  }
};

// Componente de estado de ejecución en historial
const ExecutionStatusBadge = ({ status }) => {
  switch (status) {
    case 'success':
      return (
        <Badge className="bg-emerald-100 text-emerald-800 hover:bg-emerald-100">
          <CheckCircle2 className="w-3 h-3 mr-1" />
          Éxito
        </Badge>
      );
    case 'failed':
      return (
        <Badge className="bg-red-100 text-red-800 hover:bg-red-100">
          <XCircle className="w-3 h-3 mr-1" />
          Error
        </Badge>
      );
    case 'skipped':
      return (
        <Badge className="bg-amber-100 text-amber-800 hover:bg-amber-100">
          <AlertCircle className="w-3 h-3 mr-1" />
          Omitido
        </Badge>
      );
    case 'running':
      return (
        <Badge className="bg-blue-100 text-blue-800 hover:bg-blue-100">
          <Loader2 className="w-3 h-3 mr-1 animate-spin" />
          Ejecutando
        </Badge>
      );
    default:
      return (
        <Badge variant="outline">
          {status || 'Desconocido'}
        </Badge>
      );
  }
};

export default function Scheduler() {
  const user = getUser();
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [autoRefreshInterval, setAutoRefreshInterval] = useState(30); // segundos
  
  // Estado del scheduler
  const [schedulerStatus, setSchedulerStatus] = useState(null);
  const [schedulerConfig, setSchedulerConfig] = useState(null);
  const [logs, setLogs] = useState([]);
  const [stats, setStats] = useState(null);
  
  // Filtros de historial
  const [filterJob, setFilterJob] = useState('all');
  const [filterStatus, setFilterStatus] = useState('all');
  const [filterHours, setFilterHours] = useState('24');
  const [searchText, setSearchText] = useState('');
  
  // Diálogos de confirmación
  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null, // 'run', 'pause', 'resume'
    jobId: null,
    jobName: null,
  });

  const [newJobDialog, setNewJobDialog] = useState({
    open: false,
  });
  const [actionLoading, setActionLoading] = useState(false);
  
  // Permisos RBAC (derivados del rol)
  const userPermissions = {
    canView: ['Administrador', 'Supervisor', 'Gerente', 'Director', 'Auditor'].includes(user?.role),
    canManage: ['Administrador', 'Supervisor', 'Gerente', 'Director'].includes(user?.role),
    canAdmin: ['Administrador', 'Director'].includes(user?.role),
  };

  // Fetch scheduler status
  const fetchSchedulerStatus = useCallback(async () => {
    try {
      const response = await api.get('/v2/scheduler/status');
      setSchedulerStatus(response.data);
    } catch (error) {
      logger.error('Error fetching scheduler status:', error);
    }
  }, []);

  // Fetch scheduler config
  const fetchSchedulerConfig = useCallback(async () => {
    try {
      const response = await api.get('/v2/scheduler/config');
      setSchedulerConfig(response.data);
    } catch (error) {
      logger.error('Error fetching scheduler config:', error);
    }
  }, []);

  // Fetch logs
  const fetchLogs = useCallback(async () => {
    try {
      const params = new URLSearchParams({
        hours: filterHours,
        limit: '100',
      });
      if (filterJob !== 'all') params.append('job_name', filterJob);
      if (filterStatus !== 'all') params.append('status', filterStatus);
      
      const response = await api.get(`/v2/scheduler/logs?${params}`);
      setLogs(response.data.items || []);
    } catch (error) {
      logger.error('Error fetching logs:', error);
    }
  }, [filterJob, filterStatus, filterHours]);

  // Fetch stats
  const fetchStats = useCallback(async () => {
    try {
      const response = await api.get('/v2/scheduler/logs/stats?hours=24');
      setStats(response.data.stats || {});
    } catch (error) {
      logger.error('Error fetching stats:', error);
    }
  }, []);

  // Fetch all data
  const fetchAllData = useCallback(async (showRefreshing = false) => {
    if (showRefreshing) setRefreshing(true);
    await Promise.all([
      fetchSchedulerStatus(),
      fetchSchedulerConfig(),
      fetchLogs(),
      fetchStats(),
    ]);
    setLoading(false);
    if (showRefreshing) setRefreshing(false);
  }, [fetchSchedulerStatus, fetchSchedulerConfig, fetchLogs, fetchStats]);

  // Initial load
  useEffect(() => {
    fetchAllData();
  }, [fetchAllData]);

  // Refetch logs when filters change
  useEffect(() => {
    if (!loading) {
      fetchLogs();
    }
  }, [filterJob, filterStatus, filterHours, fetchLogs, loading]);

  // Auto-refresh
  useEffect(() => {
    if (!autoRefresh) return;
    
    const interval = setInterval(() => {
      fetchAllData(false);
    }, autoRefreshInterval * 1000);
    
    return () => clearInterval(interval);
  }, [autoRefresh, autoRefreshInterval, fetchAllData]);

  // Job actions
  const handleJobAction = async (action, jobId) => {
    setActionLoading(true);
    try {
      await api.post(`/v2/scheduler/jobs/${jobId}/${action}`);
      // Refresh data
      await fetchAllData(true);
    } catch (error) {
      logger.error('Error executing action:', error);
      alert(`Error: ${error.response?.data?.detail || 'Error de conexión'}`);
    } finally {
      setActionLoading(false);
      setConfirmDialog({ open: false, type: null, jobId: null, jobName: null });
    }
  };

  // Calculate KPIs
  const calculateKPIs = () => {
    const activeJobs = schedulerStatus?.jobs?.filter(j => j.next_run)?.length || 0;
    const pausedJobs = Object.values(schedulerConfig?.jobs || {}).filter(j => !j.enabled)?.length || 0;
    
    let executions24h = 0;
    let failures24h = 0;
    
    Object.values(stats || {}).forEach(jobStats => {
      Object.entries(jobStats.executions || {}).forEach(([status, data]) => {
        executions24h += data.count || 0;
        if (status === 'failed') failures24h += data.count || 0;
      });
    });
    
    return {
      schedulerActive: schedulerStatus?.running ?? false,
      activeJobs,
      pausedJobs,
      executions24h,
      failures24h,
    };
  };

  const kpis = calculateKPIs();

  // Get last execution for a job
  const getLastExecution = (jobId) => {
    return logs.find(log => log.job_name === jobId);
  };

  // Filter logs by search text
  const filteredLogs = logs.filter(log => {
    if (!searchText) return true;
    const search = searchText.toLowerCase();
    return (
      log.job_name?.toLowerCase().includes(search) ||
      log.message?.toLowerCase().includes(search) ||
      log.error_detail?.toLowerCase().includes(search) ||
      log.status?.toLowerCase().includes(search)
    );
  });

  if (loading) {
    return (
      <div className="flex items-center justify-center h-96" data-testid="scheduler-loading">
        <Loader2 className="w-8 h-8 animate-spin text-zinc-400" />
        <span className="ml-2 text-zinc-500">Cargando scheduler...</span>
      </div>
    );
  }

  return (
    <div className="space-y-6" data-testid="scheduler-page">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-zinc-900">Scheduler del Sistema</h1>
          <p className="text-zinc-500 text-sm mt-1">
            Monitoreo de jobs, sincronizaciones, auditorías y procesos automáticos
          </p>
        </div>
        
        <div className="flex items-center gap-3">
          {/* Auto-refresh toggle */}
          <div className="flex items-center gap-2 text-sm">
            <Switch
              id="auto-refresh"
              checked={autoRefresh}
              onCheckedChange={setAutoRefresh}
              data-testid="auto-refresh-toggle"
            />
            <Label htmlFor="auto-refresh" className="text-zinc-600">
              Auto-refresh ({autoRefreshInterval}s)
            </Label>
          </div>
          
          {/* Manual refresh */}
          <Button
            variant="outline"
            size="sm"
            onClick={() => fetchAllData(true)}
            disabled={refreshing}
            data-testid="manual-refresh-btn"
          >
            <RefreshCw className={`w-4 h-4 mr-1 ${refreshing ? 'animate-spin' : ''}`} />
            Actualizar
          </Button>
        </div>
      </div>

      {/* Tabs: Dashboard | Re-sync Manual */}
      <Tabs defaultValue="dashboard" className="w-full">
        <TabsList className="grid w-full max-w-md grid-cols-2">
          <TabsTrigger value="dashboard" className="flex items-center gap-2" data-testid="tab-dashboard">
            <Activity className="w-4 h-4" />
            Dashboard
          </TabsTrigger>
          <TabsTrigger value="resync" className="flex items-center gap-2" data-testid="tab-resync">
            <Database className="w-4 h-4" />
            Re-sync Manual
          </TabsTrigger>
        </TabsList>

        {/* Tab: Dashboard */}
        <TabsContent value="dashboard" className="space-y-6 mt-4">
          {/* KPIs */}
          <div className="grid grid-cols-2 md:grid-cols-5 gap-4" data-testid="scheduler-kpis">
        {/* Scheduler Status */}
        <Card className={kpis.schedulerActive ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50'}>
          <CardContent className="p-4">
            <div className="flex items-center gap-2">
              <Activity className={`w-5 h-5 ${kpis.schedulerActive ? 'text-emerald-600' : 'text-red-600'}`} />
              <span className="text-sm font-medium text-zinc-600">Scheduler</span>
            </div>
            <p className={`text-xl font-bold mt-1 ${kpis.schedulerActive ? 'text-emerald-700' : 'text-red-700'}`}>
              {kpis.schedulerActive ? 'ACTIVO' : 'INACTIVO'}
            </p>
          </CardContent>
        </Card>

        {/* Active Jobs */}
        <Card>
          <CardContent className="p-4">
            <div className="flex items-center gap-2">
              <Zap className="w-5 h-5 text-blue-600" />
              <span className="text-sm font-medium text-zinc-600">Jobs Activos</span>
            </div>
            <p className="text-xl font-bold mt-1 text-zinc-900">{kpis.activeJobs}</p>
          </CardContent>
        </Card>

        {/* Paused Jobs */}
        <Card>
          <CardContent className="p-4">
            <div className="flex items-center gap-2">
              <Pause className="w-5 h-5 text-amber-600" />
              <span className="text-sm font-medium text-zinc-600">Jobs Pausados</span>
            </div>
            <p className="text-xl font-bold mt-1 text-zinc-900">{kpis.pausedJobs}</p>
          </CardContent>
        </Card>

        {/* Executions 24h */}
        <Card>
          <CardContent className="p-4">
            <div className="flex items-center gap-2">
              <TrendingUp className="w-5 h-5 text-violet-600" />
              <span className="text-sm font-medium text-zinc-600">Ejecuciones 24h</span>
            </div>
            <p className="text-xl font-bold mt-1 text-zinc-900">{kpis.executions24h}</p>
          </CardContent>
        </Card>

        {/* Failures 24h */}
        <Card className={kpis.failures24h > 0 ? 'border-red-200 bg-red-50' : ''}>
          <CardContent className="p-4">
            <div className="flex items-center gap-2">
              <AlertTriangle className={`w-5 h-5 ${kpis.failures24h > 0 ? 'text-red-600' : 'text-zinc-400'}`} />
              <span className="text-sm font-medium text-zinc-600">Fallos 24h</span>
            </div>
            <p className={`text-xl font-bold mt-1 ${kpis.failures24h > 0 ? 'text-red-700' : 'text-zinc-900'}`}>
              {kpis.failures24h}
            </p>
          </CardContent>
        </Card>
      </div>

      {/* Jobs List */}
        <Card data-testid="jobs-list">
          <CardHeader>
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-3">
              <div>
                <CardTitle className="flex items-center gap-2">
                  <Clock className="w-5 h-5" />
                  Jobs Programados
                </CardTitle>
                <CardDescription>
                  Tareas automatizadas del sistema
                </CardDescription>
              </div>
              <Button variant="outline" size="sm" onClick={() => setNewJobDialog({ open: true })} data-testid="nuevo-job-btn">
                <Plus className="w-4 h-4 mr-2" />
                Nuevo Job
              </Button>
            </div>
          </CardHeader>
        <CardContent>
          <div className="space-y-4">
            {schedulerStatus?.jobs?.map((job) => {
              const config = schedulerConfig?.jobs?.[job.id];
              const lastExec = getLastExecution(job.id);
              // Check if paused: either config.enabled is false OR job.next_run is null
              const isPaused = (config && !config.enabled) || !job.next_run;
              
              return (
                <div
                  key={job.id}
                  className="border rounded-lg p-4 bg-white hover:bg-zinc-50 transition-colors"
                  data-testid={`job-card-${job.id}`}
                >
                  <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    {/* Job Info */}
                    <div className="flex-1">
                      <div className="flex items-center gap-3">
                        <h3 className="font-semibold text-zinc-900">{job.name}</h3>
                        <JobStatusBadge status={lastExec?.status} paused={isPaused} />
                      </div>
                      <p className="text-sm text-zinc-500 mt-1">
                        {config?.description || job.id}
                      </p>
                      
                      {/* Execution times */}
                      <div className="flex flex-wrap gap-4 mt-3 text-sm">
                        <div className="flex items-center gap-1.5 text-zinc-600">
                          <Timer className="w-4 h-4 text-zinc-400" />
                          <span>Intervalo: {config?.interval_seconds ? `${config.interval_seconds}s` : job.trigger}</span>
                        </div>
                        <div className="flex items-center gap-1.5 text-zinc-600">
                          <Calendar className="w-4 h-4 text-blue-500" />
                          <span>Próxima: <strong>{formatTime(job.next_run)}</strong></span>
                        </div>
                        <div className="flex items-center gap-1.5 text-zinc-600">
                          <Clock className="w-4 h-4 text-zinc-400" />
                          <span>Última: {formatDateTime(lastExec?.started_at)}</span>
                        </div>
                      </div>
                      
                      {/* Last error if any */}
                      {lastExec?.status === 'failed' && lastExec?.error_detail && (
                        <div className="mt-2 p-2 bg-red-50 border border-red-200 rounded text-sm text-red-700">
                          <strong>Último error:</strong> {lastExec.error_detail}
                        </div>
                      )}
                    </div>

                    {/* Actions */}
                    <div className="flex items-center gap-2">
                      {/* Run Now */}
                      <Button
                        variant="outline"
                        size="sm"
                        onClick={() => setConfirmDialog({
                          open: true,
                          type: 'run',
                          jobId: job.id,
                          jobName: job.name,
                        })}
                        disabled={!userPermissions.canAdmin || isPaused}
                        title={!userPermissions.canAdmin ? 'Sin permiso' : isPaused ? 'Job pausado' : 'Ejecutar ahora'}
                        data-testid={`run-btn-${job.id}`}
                      >
                        <Play className="w-4 h-4" />
                      </Button>
                      
                      {/* Pause/Resume */}
                      {isPaused ? (
                        <Button
                          variant="outline"
                          size="sm"
                          onClick={() => setConfirmDialog({
                            open: true,
                            type: 'resume',
                            jobId: job.id,
                            jobName: job.name,
                          })}
                          disabled={!userPermissions.canManage}
                          title={!userPermissions.canManage ? 'Sin permiso' : 'Reanudar'}
                          data-testid={`resume-btn-${job.id}`}
                        >
                          <Play className="w-4 h-4 text-emerald-600" />
                        </Button>
                      ) : (
                        <Button
                          variant="outline"
                          size="sm"
                          onClick={() => setConfirmDialog({
                            open: true,
                            type: 'pause',
                            jobId: job.id,
                            jobName: job.name,
                          })}
                          disabled={!userPermissions.canManage}
                          title={!userPermissions.canManage ? 'Sin permiso' : 'Pausar'}
                          data-testid={`pause-btn-${job.id}`}
                        >
                          <Pause className="w-4 h-4 text-amber-600" />
                        </Button>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
            
            {(!schedulerStatus?.jobs || schedulerStatus.jobs.length === 0) && (
              <div className="text-center py-8 text-zinc-500">
                No hay jobs programados
              </div>
            )}
          </div>
        </CardContent>
      </Card>

      {/* Execution History */}
      <Card data-testid="execution-history">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Activity className="w-5 h-5" />
            Historial de Ejecuciones
          </CardTitle>
          <CardDescription>
            Registro de ejecuciones de jobs
          </CardDescription>
        </CardHeader>
        <CardContent>
          {/* Filters */}
          <div className="flex flex-wrap gap-4 mb-4 p-4 bg-zinc-50 rounded-lg" data-testid="history-filters">
            <div className="flex items-center gap-2">
              <Filter className="w-4 h-4 text-zinc-400" />
              <Select value={filterJob} onValueChange={setFilterJob}>
                <SelectTrigger className="w-[180px]" data-testid="filter-job">
                  <SelectValue placeholder="Todos los jobs" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Todos los jobs</SelectItem>
                  {schedulerStatus?.jobs?.map(job => (
                    <SelectItem key={job.id} value={job.id}>{job.name}</SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
            
            <Select value={filterStatus} onValueChange={setFilterStatus}>
              <SelectTrigger className="w-[150px]" data-testid="filter-status">
                <SelectValue placeholder="Estado" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">Todos</SelectItem>
                <SelectItem value="success">Éxito</SelectItem>
                <SelectItem value="failed">Error</SelectItem>
                <SelectItem value="skipped">Omitido</SelectItem>
              </SelectContent>
            </Select>
            
            <Select value={filterHours} onValueChange={setFilterHours}>
              <SelectTrigger className="w-[150px]" data-testid="filter-hours">
                <SelectValue placeholder="Período" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="1">Última hora</SelectItem>
                <SelectItem value="6">Últimas 6h</SelectItem>
                <SelectItem value="24">Últimas 24h</SelectItem>
                <SelectItem value="48">Últimas 48h</SelectItem>
                <SelectItem value="168">Última semana</SelectItem>
              </SelectContent>
            </Select>
            
            <div className="relative flex-1 min-w-[200px]">
              <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-zinc-400" />
              <Input
                placeholder="Buscar por mensaje o error..."
                value={searchText}
                onChange={(e) => setSearchText(e.target.value)}
                className="pl-9"
                data-testid="filter-search"
              />
            </div>
          </div>

          {/* Table */}
          <div className="border rounded-lg overflow-hidden">
            <Table>
              <TableHeader>
                <TableRow className="bg-zinc-50">
                  <TableHead>Job</TableHead>
                  <TableHead>Estado</TableHead>
                  <TableHead>Duración</TableHead>
                  <TableHead>Procesados</TableHead>
                  <TableHead>Éxito/Fallo</TableHead>
                  <TableHead>Fecha</TableHead>
                  <TableHead>Mensaje</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {filteredLogs.map((log) => (
                  <TableRow key={log.id} data-testid={`log-row-${log.id}`}>
                    <TableCell className="font-medium">{log.job_name}</TableCell>
                    <TableCell>
                      <ExecutionStatusBadge status={log.status} />
                    </TableCell>
                    <TableCell>{formatDuration(log.duration_ms)}</TableCell>
                    <TableCell>{log.processed_count || 0}</TableCell>
                    <TableCell>
                      <span className="text-emerald-600">{log.success_count || 0}</span>
                      {' / '}
                      <span className="text-red-600">{log.failed_count || 0}</span>
                    </TableCell>
                    <TableCell className="text-sm text-zinc-600">
                      {formatDateTime(log.started_at)}
                    </TableCell>
                    <TableCell className="max-w-xs truncate text-sm text-zinc-500" title={log.message || log.error_detail}>
                      {log.error_detail || log.message || '-'}
                    </TableCell>
                  </TableRow>
                ))}
                
                {filteredLogs.length === 0 && (
                  <TableRow>
                    <TableCell colSpan={7} className="text-center py-8 text-zinc-500">
                      No hay registros que coincidan con los filtros
                    </TableCell>
                  </TableRow>
                )}
              </TableBody>
            </Table>
          </div>
          
          <div className="mt-2 text-sm text-zinc-500">
            Mostrando {filteredLogs.length} de {logs.length} registros
          </div>
        </CardContent>
      </Card>

      {/* New Job Dialog - Fase B visual only */}
      <Dialog open={newJobDialog.open} onOpenChange={(open) => setNewJobDialog({ open })}>
        <DialogContent data-testid="nuevo-job-dialog">
          <DialogHeader>
            <DialogTitle>Nuevo Job</DialogTitle>
            <DialogDescription>Formulario visual. No guarda ni llama al backend.</DialogDescription>
          </DialogHeader>
          <div className="grid gap-4 py-2">
            <div className="grid gap-2">
              <Label htmlFor="new-job-id">JobID</Label>
              <Input id="new-job-id" defaultValue="netpay-backfill-marzo-2026" />
            </div>
            <div className="grid gap-2">
              <Label htmlFor="new-job-name">Nombre</Label>
              <Input id="new-job-name" defaultValue="NetPay Backfill Marzo 2026" />
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div className="grid gap-2">
                <Label htmlFor="new-job-fecha-desde">Fecha desde</Label>
                <Input id="new-job-fecha-desde" type="date" defaultValue="2026-03-01" />
              </div>
              <div className="grid gap-2">
                <Label htmlFor="new-job-fecha-hasta">Fecha hasta</Label>
                <Input id="new-job-fecha-hasta" type="date" defaultValue="2026-03-31" />
              </div>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setNewJobDialog({ open: false })}>Cancelar</Button>
            <Button disabled data-testid="nuevo-job-save-disabled">Guardar en Fase C</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Confirmation Dialog */}
      <Dialog open={confirmDialog.open} onOpenChange={(open) => !actionLoading && setConfirmDialog({ ...confirmDialog, open })}>
        <DialogContent data-testid="confirm-dialog">
          <DialogHeader>
            <DialogTitle>
              {confirmDialog.type === 'run' && 'Ejecutar Job Manualmente'}
              {confirmDialog.type === 'pause' && 'Pausar Job'}
              {confirmDialog.type === 'resume' && 'Reanudar Job'}
            </DialogTitle>
            <DialogDescription>
              {confirmDialog.type === 'run' && (
                <>
                  ¿Estás seguro de que deseas ejecutar <strong>{confirmDialog.jobName}</strong> manualmente?
                  <br />
                  Esta acción ejecutará el job inmediatamente, independientemente de su programación.
                </>
              )}
              {confirmDialog.type === 'pause' && (
                <>
                  ¿Estás seguro de que deseas pausar <strong>{confirmDialog.jobName}</strong>?
                  <br />
                  El job dejará de ejecutarse hasta que sea reanudado.
                </>
              )}
              {confirmDialog.type === 'resume' && (
                <>
                  ¿Estás seguro de que deseas reanudar <strong>{confirmDialog.jobName}</strong>?
                  <br />
                  El job volverá a ejecutarse según su programación.
                </>
              )}
            </DialogDescription>
          </DialogHeader>
          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setConfirmDialog({ open: false, type: null, jobId: null, jobName: null })}
              disabled={actionLoading}
            >
              Cancelar
            </Button>
            <Button
              onClick={() => handleJobAction(confirmDialog.type, confirmDialog.jobId)}
              disabled={actionLoading}
              className={
                confirmDialog.type === 'pause' ? 'bg-amber-600 hover:bg-amber-700' :
                confirmDialog.type === 'run' ? 'bg-blue-600 hover:bg-blue-700' :
                'bg-emerald-600 hover:bg-emerald-700'
              }
              data-testid="confirm-action-btn"
            >
              {actionLoading ? (
                <>
                  <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                  Procesando...
                </>
              ) : (
                <>
                  {confirmDialog.type === 'run' && 'Ejecutar'}
                  {confirmDialog.type === 'pause' && 'Pausar'}
                  {confirmDialog.type === 'resume' && 'Reanudar'}
                </>
              )}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
        </TabsContent>

        {/* Tab: Re-sync Manual */}
        <TabsContent value="resync" className="mt-4">
          <ResyncPanel />
        </TabsContent>
      </Tabs>
    </div>
  );
}
